{
 "meta": {
  "creator": "cds-dk 7.0.2"
 },
 "$version": "2.0",
 "definitions": {
  "S4ODataService": {
   "kind": "service",
   "@cds.external": true,
   "@m.IsDefaultEntityContainer": "true",
   "@sap.supported.formats": "atom json xlsx"
  },
  "S4ODataService.headerSet": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "@sap.creatable": "false",
   "@sap.updatable": "false",
   "@sap.deletable": "false",
   "@sap.pageable": "false",
   "@sap.addressable": "false",
   "@sap.content.version": "1",
   "elements": {
    "UniqueId": {
     "key": true,
     "type": "cds.String",
     "length": 6,
     "@sap.unicode": "false",
     "@sap.label": "Configuration ID",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    },
    "Message": {
     "type": "cds.String",
     "length": 50,
     "@sap.unicode": "false",
     "@sap.label": "c",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    },
    "CustMaterial": {
     "type": "cds.String",
     "length": 35,
     "@sap.unicode": "false",
     "@sap.label": "Customer Mat.",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    },
    "Werks": {
     "type": "cds.String",
     "length": 4,
     "@sap.unicode": "false",
     "@sap.label": "Plant",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    },
    "Matnr": {
     "type": "cds.String",
     "length": 40,
     "@sap.unicode": "false",
     "@sap.label": "Material",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    },
    "Datum": {
     "type": "cds.Timestamp",
     "@odata.Type": "Edm.DateTime",
     "@odata.Precision": 7,
     "@sap.unicode": "false",
     "@sap.label": "Date",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false"
    },
    "Quantity": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "@sap.unicode": "false",
     "@sap.label": "Target Quantity",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    },
    "External_Id": {
     "type": "cds.String",
     "length": 40,
     "@sap.unicode": "false",
     "@sap.label": "External ID",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    },
    "HeaderConfig": {
     "@cds.ambiguous": "missing on condition?",
     "type": "cds.Association",
     "target": "S4ODataService.configSet",
     "cardinality": {
      "max": "*"
     },
     "on": [
      {
       "ref": [
        "HeaderConfig",
        "UniqueId"
       ]
      },
      "=",
      {
       "ref": [
        "UniqueId"
       ]
      }
     ]
    }
   }
  },
  "S4ODataService.configSet": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "@sap.creatable": "false",
   "@sap.updatable": "false",
   "@sap.deletable": "false",
   "@sap.pageable": "false",
   "@sap.addressable": "false",
   "@sap.content.version": "1",
   "elements": {
    "UniqueId": {
     "key": true,
     "type": "cds.String",
     "length": 6,
     "@sap.unicode": "false",
     "@sap.label": "Configuration ID",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    },
    "Charc": {
     "type": "cds.String",
     "length": 30,
     "@sap.unicode": "false",
     "@sap.label": "Characteristic",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    },
    "Value": {
     "type": "cds.String",
     "length": 70,
     "@sap.unicode": "false",
     "@sap.label": "Char. Value",
     "@sap.creatable": "false",
     "@sap.updatable": "false",
     "@sap.sortable": "false",
     "@sap.filterable": "false",
     "notNull": true
    }
   }
  }
 }
}