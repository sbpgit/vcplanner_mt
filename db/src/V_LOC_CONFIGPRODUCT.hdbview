VIEW "V_LOC_CONFIGPRODUCT" AS
SELECT DISTINCT L.LOCATION_ID,LOC.LOCATION_DESC,P.PRODUCT_ID,P.PROD_DESC,COALESCE(L.MRP_GROUP, '') AS MRP_GROUP  FROM "CP_LOCATION_PRODUCT" L
LEFT OUTER JOIN "CP_PRODUCT" P ON 
P.PRODUCT_ID = L.PRODUCT_ID AND P.PROD_TYPE='KMAT'
LEFT OUTER JOIN "CP_LOCATION" LOC ON L.LOCATION_ID = LOC.LOCATION_ID;