TRIGGER "trigger"
AFTER INSERT ON "CP_IBP_FCHARPLAN"
REFERENCING NEW ROW AS MYNEWROWROW
FOR EACH ROW
BEGIN
    DELETE FROM "CP_DEMAND_OPT_QUANTITY_DELTA" WHERE "LOCATION_ID" = :MYNEWROWROW.LOCATION_ID AND "PRODUCT_ID" =  :MYNEWROWROW.PRODUCT_ID AND "VERSION" = :MYNEWROWROW.VERSION AND "SCENARIO" = :MYNEWROWROW.SCENARIO AND "WEEK_DATE"=:MYNEWROWROW.WEEK_DATE;
    -- INSERT INTO "CP_DEMAND_OPT_QUANTITY_DELTA" VALUES (:MYNEWROWROW.LOCATION_ID, :MYNEWROWROW.PRODUCT_ID, :MYNEWROWROW.VERSION, :MYNEWROWROW.SCENARIO, :MYNEWROWROW.WEEK_DATE, :MYNEWROWROW.MODEL_VERSION, CURRENT_TIMESTAMP);
    INSERT INTO "CP_DEMAND_OPT_QUANTITY_DELTA" VALUES (:MYNEWROWROW.LOCATION_ID, :MYNEWROWROW.PRODUCT_ID, :MYNEWROWROW.VERSION, :MYNEWROWROW.SCENARIO, :MYNEWROWROW.WEEK_DATE, :MYNEWROWROW.MODEL_VERSION);
END