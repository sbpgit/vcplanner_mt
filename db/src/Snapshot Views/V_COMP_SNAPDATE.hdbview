VIEW "V_COMP_SNAPDATE" AS
SELECT 
	A."SNAP_TIMESTAMP",
	A."SNAPSHOT_DESC",
	A."FROM_DATE",
	A."TO_DATE",
    A."TYPE",
    B."FACTORY_LOC",
    B."LOCATION_ID",
    B."PRODUCT_ID",
    B."COMPONENT",
    B."WEEK_DATE",
	MAX(B."SNAP_TIMESTAMP") AS "SNAP_TIMESTAMP_DATA"
FROM 
	"V_SNAPHEAD" AS A
	LEFT OUTER JOIN
	"V_COMP_SNAPDATA" AS B
	ON B."SNAP_TIMESTAMP" <= A."SNAP_TIMESTAMP"
WHERE A."TYPE" = 'COMP'
GROUP BY 
	A."SNAP_TIMESTAMP",
	A."SNAPSHOT_DESC",
	A."FROM_DATE",
	A."TO_DATE",
    A."TYPE",
    B."FACTORY_LOC",
    B."LOCATION_ID",
    B."PRODUCT_ID",
    B."COMPONENT",
    B."WEEK_DATE"