VIEW "V_COMP_SNAPSHOT" AS
SELECT DISTINCT
  A."SNAP_TIMESTAMP",
  A."SNAPSHOT_DESC",
  A."FROM_DATE",
  A."TO_DATE",
  A."TYPE",
  A."FACTORY_LOC",
  C."LOCATION_DESC",
  A."LOCATION_ID",
  A."PRODUCT_ID",
  D."PROD_DESC",
  A."COMPONENT",
  E."COMP_DESC",
  A."WEEK_DATE",
  A."SNAP_TIMESTAMP_DATA",
  B.CIR_QTY,
  B.COMP_QTY
FROM V_COMP_SNAPDATE AS A
  INNER JOIN "V_COMP_SNAPDATA" AS B 
  ON A."LOCATION_ID" = B."LOCATION_ID"
  AND A."PRODUCT_ID" = B."PRODUCT_ID"
  AND A."FACTORY_LOC" = B."FACTORY_LOC"
  AND A."COMPONENT" = B."COMPONENT"
  AND A."WEEK_DATE" = B."WEEK_DATE"
  AND A."SNAP_TIMESTAMP_DATA" = B."SNAP_TIMESTAMP"
  LEFT OUTER JOIN CP_LOCATION AS C
 ON A."FACTORY_LOC" = C."LOCATION_ID"
  LEFT OUTER JOIN "CP_PRODUCT" AS D
 ON A."PRODUCT_ID" = D."PRODUCT_ID"
 LEFT OUTER JOIN "V_COMPREQ_SNAPSHOT" AS E
 ON A."COMPONENT" = E."COMPONENT" AND 
 A."LOCATION_ID" = E."LOCATION_ID";