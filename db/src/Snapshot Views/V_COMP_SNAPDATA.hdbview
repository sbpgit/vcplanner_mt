VIEW "V_COMP_SNAPDATA" AS
SELECT 
	"SNAP_TIMESTAMP",
	"FACTORY_LOC",
	"LOCATION_ID",
	"PRODUCT_ID",
	"COMPONENT",
	"WEEK_DATE",
	"CIR_QTY",
	"COMP_QTY"
	-- "IBP_DEMAND",
	-- "PERCENTAGE"
FROM "CP_COMP_SNAPSHOT_DATA"

UNION ALL

SELECT 
CURRENT_TIMESTAMP AS "SNAP_TIMESTAMP",
"FACTORY_LOC",
"LOCATION_ID",
"PRODUCT_ID",
"COMPONENT",
"WEEK_DATE",
"CIR_QTY",
"COMP_QTY"
-- "IBP_DEMAND",
-- "PERCENTAGE"
FROM "V_COMPREQ_SNAPSHOT"
WHERE "VERSION" = '__BASELINE'
AND "SCENARIO" = '_PLAN';
