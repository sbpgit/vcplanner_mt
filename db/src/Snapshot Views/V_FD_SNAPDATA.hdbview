VIEW "V_FD_SNAPDATA" AS
SELECT
    "SNAP_TIMESTAMP",
    "LOCATION_ID",
    "PRODUCT_ID",
    "WEEK_DATE",
    "QUANTITY"
FROM
    "CP_FD_SNAPSHOT_DATA"
union all
   Select
    CURRENT_TIMESTAMP AS "SNAP_TIMESTAMP",
        "LOCATION_ID",
        "PRODUCT_ID",
        "WEEK_DATE",
        "QUANTITY"
FROM "CP_IBP_FUTUREDEMAND"
WHERE   "VERSION"  = '__BASELINE' AND
        "SCENARIO"  = '_PLAN'