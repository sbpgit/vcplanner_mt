VIEW "V_SNAPSHOT_LAG_CIR" AS
---Get Top 6 snapshots of type CIR from CP_SNAPSHOT_HEAD
	WITH MonthlyLatest AS (
    SELECT 
        MAX(SNAP_TIMESTAMP) AS SNAP_TIMESTAMP
    FROM "CP_SNAPSHOT_HEAD"
    WHERE TYPE = 'CIR'
    GROUP BY YEAR(SNAP_TIMESTAMP), MONTH(SNAP_TIMESTAMP)
),
LatestSnaps AS (
    SELECT 
        SNAP_TIMESTAMP,
        ROW_NUMBER() OVER (ORDER BY SNAP_TIMESTAMP DESC) AS RN
    FROM MonthlyLatest
    ORDER BY SNAP_TIMESTAMP DESC
    LIMIT 6
), 
	SnapshotAgg AS
	(
		SELECT 
			D.SNAP_TIMESTAMP,
			D.LOCATION_ID,
			D.PRODUCT_ID,
			D.UNIQUE_ID,
			TO_VARCHAR( D.WEEK_DATE, 'YYYY-MM' ) AS YEAR_MONTH,
			SUM(D.CIR_QTY) AS TOTAL_CIR_QTY,
			SUM(D.ACTUAL_QTY) AS TOTAL_ACTUAL_QTY
		FROM 
			"CP_SNAPSHOT_DATA" AS D
			INNER JOIN
			LatestSnaps AS L
			ON D.SNAP_TIMESTAMP = L.SNAP_TIMESTAMP
		GROUP BY 
			D.SNAP_TIMESTAMP,
			D.LOCATION_ID,
			D.PRODUCT_ID,
			D.UNIQUE_ID,
			TO_VARCHAR( D.WEEK_DATE, 'YYYY-MM' )
	), 
	PivotedSnap AS
	(
		SELECT 
			MA.LOCATION_ID,
			MA.PRODUCT_ID,
			MA.UNIQUE_ID,
			MA.YEAR_MONTH,
			MAX(CASE
					WHEN 
-- CIR

			L.RN = 1 THEN MA.TOTAL_CIR_QTY
				END) AS SNAP1_CIR,
			MAX(CASE
					WHEN -- latest

			L.RN = 2 THEN MA.TOTAL_CIR_QTY
				END) AS SNAP2_CIR,
			MAX(CASE
					WHEN -- 2nd latest

			L.RN = 3 THEN MA.TOTAL_CIR_QTY
				END) AS SNAP3_CIR,
			MAX(CASE
					WHEN -- 3rd latest

			L.RN = 4 THEN MA.TOTAL_CIR_QTY
				END) AS SNAP4_CIR,
			MAX(CASE
					WHEN -- 4th latest

			L.RN = 5 THEN MA.TOTAL_CIR_QTY
				END) AS SNAP5_CIR,
			MAX(CASE
					WHEN -- 5th latest

			L.RN = 6 THEN MA.TOTAL_CIR_QTY
				END) AS SNAP6_CIR,
			MAX(CASE
					WHEN -- 6th latest

			-- ACTUALS

			L.RN = 1 THEN MA.TOTAL_ACTUAL_QTY
				END) AS SNAP1_ACTUAL,
			MAX(CASE
					WHEN L.RN = 2 THEN MA.TOTAL_ACTUAL_QTY
				END) AS SNAP2_ACTUAL,
			MAX(CASE
					WHEN L.RN = 3 THEN MA.TOTAL_ACTUAL_QTY
				END) AS SNAP3_ACTUAL,
			MAX(CASE
					WHEN L.RN = 4 THEN MA.TOTAL_ACTUAL_QTY
				END) AS SNAP4_ACTUAL,
			MAX(CASE
					WHEN L.RN = 5 THEN MA.TOTAL_ACTUAL_QTY
				END) AS SNAP5_ACTUAL,
			MAX(CASE
					WHEN L.RN = 6 THEN MA.TOTAL_ACTUAL_QTY
				END) AS SNAP6_ACTUAL
		FROM 
			SnapshotAgg AS MA
			INNER JOIN
			LatestSnaps AS L
			ON MA.SNAP_TIMESTAMP = L.SNAP_TIMESTAMP
		GROUP BY 
			MA.LOCATION_ID,
			MA.PRODUCT_ID,
			MA.UNIQUE_ID,
			MA.YEAR_MONTH
	), 
	GeneratedAgg AS
	(
		SELECT 
			G.LOCATION_ID,
			G.PRODUCT_ID,
			G.UNIQUE_ID,
			TO_VARCHAR( G.WEEK_DATE, 'YYYY-MM' ) AS YEAR_MONTH,
			SUM(G.CIR_QTY) AS C_QTY,
			SUM(G.ACTUAL_QTY) AS A_QTY
		FROM "CP_CIR_GENERATED" AS G
		WHERE G.VERSION = '__BASELINE'
			AND G.MODEL_VERSION = 'Active'
		GROUP BY 
			G.LOCATION_ID,
			G.PRODUCT_ID,
			G.UNIQUE_ID,
			TO_VARCHAR( G.WEEK_DATE, 'YYYY-MM' )
	)
SELECT 
	S.LOCATION_ID,
	S.PRODUCT_ID,
	S.UNIQUE_ID,
	S.YEAR_MONTH,
	ABS(
--CIR

	C_QTY - SNAP1_CIR) AS LAG1_CIR,
	ABS(C_QTY - SNAP2_CIR) AS LAG2_CIR,
	ABS(C_QTY - SNAP3_CIR) AS LAG3_CIR,
	ABS(C_QTY - SNAP4_CIR) AS LAG4_CIR,
	ABS(C_QTY - SNAP5_CIR) AS LAG5_CIR,
	ABS(C_QTY - SNAP6_CIR) AS LAG6_CIR,
	CASE
		WHEN G.C_QTY IS NOT NULL AND G.C_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.C_QTY - S.SNAP1_CIR ) * 100.0 / S.SNAP1_CIR, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG1_CIR_PCT,
	CASE
		WHEN G.C_QTY IS NOT NULL AND G.C_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.C_QTY - S.SNAP2_CIR ) * 100.0 / S.SNAP2_CIR, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG2_CIR_PCT,
	CASE
		WHEN G.C_QTY IS NOT NULL AND G.C_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.C_QTY - S.SNAP3_CIR ) * 100.0 / S.SNAP3_CIR, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG3_CIR_PCT,
	CASE
		WHEN G.C_QTY IS NOT NULL AND G.C_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.C_QTY - S.SNAP4_CIR ) * 100.0 / S.SNAP4_CIR, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG4_CIR_PCT,
	CASE
		WHEN G.C_QTY IS NOT NULL AND G.C_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.C_QTY - S.SNAP5_CIR ) * 100.0 / S.SNAP5_CIR, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG5_CIR_PCT,
	CASE
		WHEN G.C_QTY IS NOT NULL AND G.C_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.C_QTY - S.SNAP6_CIR ) * 100.0 / S.SNAP6_CIR, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG6_CIR_PCT,
	ABS(

--Actual

	A_QTY - SNAP1_ACTUAL) AS LAG1_ACT,
	ABS(A_QTY - SNAP2_ACTUAL) AS LAG2_ACT,
	ABS(A_QTY - SNAP3_ACTUAL) AS LAG3_ACT,
	ABS(A_QTY - SNAP4_ACTUAL) AS LAG4_ACT,
	ABS(A_QTY - SNAP5_ACTUAL) AS LAG5_ACT,
	ABS(A_QTY - SNAP6_ACTUAL) AS LAG6_ACT,
	CASE
		WHEN G.A_QTY IS NOT NULL AND G.A_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.A_QTY - S.SNAP1_ACTUAL ) * 100.0 / S.SNAP1_ACTUAL, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG1_ACT_PCT,
	CASE
		WHEN G.A_QTY IS NOT NULL AND G.A_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.A_QTY - S.SNAP2_ACTUAL ) * 100.0 / S.SNAP2_ACTUAL, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG2_ACT_PCT,
	CASE
		WHEN G.A_QTY IS NOT NULL AND G.A_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.A_QTY - S.SNAP3_ACTUAL ) * 100.0 / S.SNAP3_ACTUAL, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG3_ACT_PCT,
	CASE
		WHEN G.A_QTY IS NOT NULL AND G.A_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.A_QTY - S.SNAP4_ACTUAL ) * 100.0 / S.SNAP4_ACTUAL, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG4_ACT_PCT,
	CASE
		WHEN G.A_QTY IS NOT NULL AND G.A_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.A_QTY - S.SNAP5_ACTUAL ) * 100.0 / S.SNAP5_ACTUAL, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG5_ACT_PCT,
	CASE
		WHEN G.A_QTY IS NOT NULL AND G.A_QTY <> 0 THEN ABS(ROUND(TO_DECIMAL( ( G.A_QTY - S.SNAP6_ACTUAL ) * 100.0 / S.SNAP6_ACTUAL, 15, 3 ), 3
		))
		ELSE 0
	END AS LAG6_ACT_PCT
FROM 
	PivotedSnap AS S
	LEFT OUTER JOIN
	GeneratedAgg AS G
	ON S.LOCATION_ID = G.LOCATION_ID
		AND S.PRODUCT_ID = G.PRODUCT_ID
		AND S.YEAR_MONTH = G.YEAR_MONTH
		AND S.UNIQUE_ID = G.UNIQUE_ID
ORDER BY 
	S.LOCATION_ID ASC, 
	S.PRODUCT_ID ASC, 
	S.YEAR_MONTH ASC;


