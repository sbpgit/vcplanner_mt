VIEW "V_RTR_SNAPSHOT" AS
SELECT 
  A."SNAP_TIMESTAMP",
  A."SNAPSHOT_DESC",
  A."FROM_DATE",
  A."TO_DATE",
  A."TYPE",
  A."FACTORY_LOC",
  C."LOCATION_DESC",
  A."LOCATION_ID",
  A."PRODUCT_ID",
  D."PROD_DESC",
  A."ITEM_NUM",
  A."COMPONENT",
  A."WEEK_DATE",
  A."REF_PRODID",
  E."RTR_DESC",
  E."LINE_ID",
  F."LINE_DESC",
  A."SNAP_TIMESTAMP_DATA",
  B.CIR_QTY,
  B.COMPCIR_QTY
FROM V_RTR_SNAPDATE AS A
  INNER JOIN "V_RTR_SNAPDATA" AS B 
  ON  A."LOCATION_ID" = B."LOCATION_ID"
  AND A."PRODUCT_ID" = B."PRODUCT_ID"
  AND A."FACTORY_LOC" = B."FACTORY_LOC"
  AND A."ITEM_NUM" = B."ITEM_NUM"
  AND A."COMPONENT" = B."COMPONENT"
  AND A."WEEK_DATE" = B."WEEK_DATE"
  AND A."REF_PRODID" = B."REF_PRODID"
  AND A."SNAP_TIMESTAMP_DATA" =B."SNAP_TIMESTAMP"
  LEFT OUTER JOIN CP_LOCATION AS C
 ON A."FACTORY_LOC" = C."LOCATION_ID"
  LEFT OUTER JOIN "CP_PRODUCT" AS D
 ON A."REF_PRODID" = D."PRODUCT_ID"
 JOIN "CP_RESTRICT_HEADER" AS E
 ON A."COMPONENT" = E."RESTRICTION" AND 
 A."LOCATION_ID" = E."LOCATION_ID"
 LEFT OUTER JOIN "CP_LINEMASTER" AS F
 ON E."LINE_ID" = F."LINE_ID";