VIEW "V_RTR_SNAPDATA" AS
SELECT
    "SNAP_TIMESTAMP",
    "FACTORY_LOC",
    "LOCATION_ID",
    "PRODUCT_ID",
    "ITEM_NUM",
    "COMPONENT",
    "WEEK_DATE",
    "TYPE",
    "REF_PRODID",
    "CIR_QTY",
    "COMPCIR_QTY"
FROM
    "CP_RTR_SNAPSHOT_DATA"
union all
   Select
    CURRENT_TIMESTAMP AS "SNAP_TIMESTAMP",
        "FACTORY_LOC",
        "LOCATION_ID",
        "PRODUCT_ID",
        "ITEM_NUM",
        "COMPONENT",
        "WEEK_DATE",
        "TYPE",
        "REF_PRODID",
        "CIR_QTY",
        "COMPCIR_QTY"
FROM "CP_ASSEMBLY_REQ"
WHERE   "VERSION"  = '__BASELINE' AND
        "SCENARIO"  = '_PLAN' AND
        TYPE = 'RT'