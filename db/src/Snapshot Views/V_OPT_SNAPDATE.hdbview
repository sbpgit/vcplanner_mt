VIEW "V_OPT_SNAPDATE" AS
SELECT 
	A."SNAP_TIMESTAMP",
	A."SNAPSHOT_DESC",
	A."FROM_DATE",
	A."TO_DATE",
    A."TYPE",
    B."LOCATION_ID",
    B."PRODUCT_ID",
    B."CUSTOMER_GROUP",
    B."CLASS_NUM",
    B."CHAR_NUM",
    B."CHARVAL_NUM",
    B."WEEK_DATE",
    B."KEY_TYPE",
	MAX(B."SNAP_TIMESTAMP") AS "SNAP_TIMESTAMP_DATA"
FROM 
	"V_SNAPHEAD" AS A
	LEFT OUTER JOIN
	"V_OPT_SNAPDATA" AS B
	ON B."SNAP_TIMESTAMP" <= A."SNAP_TIMESTAMP"
WHERE A."TYPE" = 'OPT'
GROUP BY 
	A."SNAP_TIMESTAMP",
	A."SNAPSHOT_DESC",
	A."FROM_DATE",
	A."TO_DATE",
    A."TYPE",
    B."LOCATION_ID",
    B."PRODUCT_ID",
    B."CUSTOMER_GROUP",
    B."CLASS_NUM",
    B."CHAR_NUM",
    B."CHARVAL_NUM",
    B."WEEK_DATE",
    B."KEY_TYPE";