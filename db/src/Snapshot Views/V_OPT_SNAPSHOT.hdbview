VIEW "V_OPT_SNAPSHOT" AS
SELECT A."SNAP_TIMESTAMP",
  A."SNAPSHOT_DESC",
  A."FROM_DATE",
  A."TO_DATE",
  A."TYPE",
  A."LOCATION_ID",
  A."PRODUCT_ID",
  A."CUSTOMER_GROUP",
  A."CHAR_NUM",
  A."CHARVAL_NUM",
  C.LOCATION_DESC,
  C.PROD_DESC,
  C.CHAR_DESC,
  C.CHARVAL_DESC,
  A."WEEK_DATE",
  A."KEY_TYPE",
  A."SNAP_TIMESTAMP_DATA",
  B.OPT_PERCENT,
  B.OPT_QTY
FROM V_OPT_SNAPDATE AS A
  INNER JOIN "V_OPT_SNAPDATA" AS B
 ON A."LOCATION_ID" = B."LOCATION_ID"
  AND A."PRODUCT_ID" = B."PRODUCT_ID"
  AND A."CUSTOMER_GROUP" = B."CUSTOMER_GROUP"
  AND A."CHAR_NUM" = B."CHAR_NUM"
  AND A."CHARVAL_NUM" = B."CHARVAL_NUM"
  AND A."WEEK_DATE" = B."WEEK_DATE"
  AND A."KEY_TYPE" = B."KEY_TYPE"
  AND A."SNAP_TIMESTAMP_DATA" = B."SNAP_TIMESTAMP"
  LEFT OUTER JOIN V_OPTION_PERCENTAGE AS C
 ON A."LOCATION_ID" = C."LOCATION_ID"
  AND A."PRODUCT_ID" = C."PRODUCT_ID"
  AND A."CUSTOMER_GROUP" = C."CUSTOMER_GROUP"
  AND A."CHAR_NUM" = C."CHAR_NUM"
  AND A."CHARVAL_NUM" = C."CHARVAL_NUM"


