----------------------------------------------------------------------------------------
-- Name:            V_BOM_DEMDFACLOC
-- Description:     Demand location for BOM factory location
-- Join Details:    A: CP_BOMHEADER -  BOM header
--                  B: CP_FACTORY_SALESLOC - Factory Location
-----------------------------------------------------------------------------------------
VIEW "V_BOM_DEMDFACLOC" AS
SELECT B.LOCATION_ID,
  B.FACTORY_LOC,
  C.LOCATION_DESC,
  A.PRODUCT_ID,
  A.ITEM_NUM,
  A.COMPONENT,
  A.COMP_DESC,
  A.COMP_TYPE,
  A.COMP_QTY,
  A.VALID_FROM,
  A.VALID_TO,  
  A.CRITICAL_ASM
FROM "CP_BOMHEADER" AS A
  INNER JOIN "CP_FACTORY_SALESLOC" AS B
 ON A.LOCATION_ID = B.FACTORY_LOC
 INNER JOIN "CP_LOCATION" AS C 
 ON C.LOCATION_ID = B.FACTORY_LOC;