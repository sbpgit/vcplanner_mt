VIEW "V_SNAPSHOT_FILTERS" AS SELECT DISTINCT 
	V."SNAP_TIMESTAMP",
	V."SNAPSHOT_DESC",
	A."LOCATION_ID",
	A."PRODUCT_ID",
	B."LOCATION_DESC",
	B."PROD_DESC"
FROM 
	"CP_SNAPSHOT_HEAD" AS V
	INNER JOIN
	"V_SNAPSHOT" AS A
	ON V."SNAP_TIMESTAMP" = A."SNAP_TIMESTAMP"
	INNER JOIN
	"V_LOCPROD" AS B
	ON  A."LOCATION_ID" = B."LOCATION_ID"
		AND A."PRODUCT_ID" = B."PRODUCT_ID";
