VIEW "V_FPLAN_CONS_FDEMAND" AS 
SELECT
  A."LOCATION_ID",
  A."PRODUCT_ID",
  '' AS "CHAR_NUM",
  '' AS "CHAR_NAME",
  '' AS "CHAR_DESC",
  '' AS "CHARVAL_NUM",
  '' AS "CHAR_VALUE",
  '' AS "CHARVAL_DESC",
  A."VERSION",
  A."SCENARIO",
  B."CALENDAR_WEEK",
  B."TELESCOPIC_WEEK",
  B."WEEK_STARTDATE",
  B."WEEK_ENDDATE",
  A."QUANTITY" AS "OPT_PERCENT",
  -- A."QUANTITY" AS "OPT_PERCENT",
  A."QUANTITY" ,
  CP_IBPVERSIONSCENARIO.VERSION_NAME,
  CP_IBPVERSIONSCENARIO.SCENARIO_NAME
FROM "CP_IBP_FUTUREDEMAND" A
  LEFT OUTER JOIN "V_WEEK_DESCRIPTOR" B
 ON A."WEEK_DATE" >= B."WEEK_STARTDATE"
  AND A."WEEK_DATE" <= B."WEEK_ENDDATE"
  
LEFT OUTER JOIN CP_IBPVERSIONSCENARIO
ON CP_IBPVERSIONSCENARIO.VERSION = A."VERSION"
AND CP_IBPVERSIONSCENARIO.SCENARIO = A."SCENARIO"
  

-- ORDER BY 
--   A."LOCATION_ID" ASC,
--   A."PRODUCT_ID" ASC,
--   A."CHAR_NUM" ASC,
--   A."CHARVAL_NUM" ASC,
--   B."CALENDAR_WEEK" ASC,
--   B."TELESCOPIC_WEEK" ASC