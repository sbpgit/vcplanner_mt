----------------------------------------------------------------------------------------
-- Name:            V_SALES_H
-- Description:     View to get sales history configuration with charanteristic values
-- Join Details:    A: CP_SALESH-  Table for sales history
--                  B: V_CHARVAL  - View to characteristics and char. values for its internal counters
--                  C: CP_SALESHM - Table for sales history with unique ID
-----------------------------------------------------------------------------------------
VIEW "V_SALES_H"
AS SELECT DISTINCT
CP_SALESH.SALES_DOC,
CP_SALESH.SALESDOC_ITEM,
CP_SALESH.PRODUCT_ID as REF_PRODID,
CP_SALES_HM.PRODUCT_ID,
CP_SALES_HM.UNIQUE_ID,
CP_SALES_HM.PRIMARY_ID,
CP_SALESH.DOC_CREATEDDATE,
CP_SALESH.SCHEDULELINE_NUM,
CP_SALESH.REASON_REJ,
CP_SALESH.UOM,
CP_SALESH.CONFIRMED_QTY,
CP_SALESH.ORD_QTY,
CP_SALESH.MAT_AVAILDATE,
CP_SALESH.NET_VALUE,
CP_SALESH.CUSTOMER_GROUP,
CP_SALESH.OPEN_ORDER,
CP_SALES_HM.LOCATION_ID,
CP_SALESH.LOCATION_ID as SALE_LOCATION,
CP_FACTORY_SALESLOC.PLAN_LOC,
CP_FACTORY_SALESLOC.FACTORY_LOC,
CP_SALESH.SEEDORD_CHK,
CP_SALESH.SALES_ORG,
CP_SALESH.DISTR_CHANNEL,
CP_SALESH.DIVISION,
CP_SALESH.SAL_DOCU_TYPE,
CP_SALESH.ITEM_CREATED_DATE,
CP_SALESH.ITEM_CHANGE_DATE,
CP_SALESH.IBP_CUSTOMER,
CP_SALESH.RELEVENT_FOR_PLAN,
CP_SALESH.ON_HAND_STOCK,
CP_SALESH.IN_TRANSIT,
CP_SALESH.SHIP_FROM_LOC, 
CP_SALESH.TRANS_TO_LOC,
CP_SALESH.TRANS_FROM_LOC,   
CP_SALESH.CHANGED_DATE,
CP_SALESH.CHANGED_BY,
CP_SALESH.CREATED_DATE,
CP_SALESH.CREATED_BY,
CP_SALESH.CHANGED_TIME,
CP_SALESH.CREATED_TIME,
CP_UNIQUE_ID_HEADER.UNIQUE_DESC,
CP_UNIQUE_ID_HEADER.EX_IDENTIFICATION,
CP_LOCATION.LOCATION_DESC,
CP_PARTIALPROD_INTRO.PROD_DESC,
CP_CUSTOMERGROUP.CUSTOMER_DESC,
CP_PARTIALPROD_INTRO.CONFIGPROD_CHK,
CP_SALESH.DELETE_FLAG
FROM CP_SALESH 
INNER JOIN CP_SALES_HM
ON ( CP_SALESH.SALES_DOC = CP_SALES_HM.SALES_DOC
AND CP_SALESH.SALESDOC_ITEM = CP_SALES_HM.SALESDOC_ITEM )
INNER JOIN CP_UNIQUE_ID_HEADER
ON CP_SALES_HM.UNIQUE_ID = CP_UNIQUE_ID_HEADER.UNIQUE_ID
AND CP_UNIQUE_ID_HEADER.ACTIVE = true
LEFT OUTER JOIN CP_FACTORY_SALESLOC
ON CP_SALESH.LOCATION_ID = CP_FACTORY_SALESLOC.LOCATION_ID
AND CP_SALES_HM.PRODUCT_ID = CP_FACTORY_SALESLOC.PRODUCT_ID
LEFT OUTER JOIN CP_LOCATION
ON CP_SALESH.LOCATION_ID = CP_LOCATION.LOCATION_ID
LEFT OUTER JOIN CP_PARTIALPROD_INTRO
ON CP_SALES_HM.LOCATION_ID = CP_PARTIALPROD_INTRO.LOCATION_ID
AND CP_SALES_HM.PRODUCT_ID = CP_PARTIALPROD_INTRO.PRODUCT_ID
LEFT OUTER JOIN CP_CUSTOMERGROUP
ON CP_SALESH.CUSTOMER_GROUP = CP_CUSTOMERGROUP.CUSTOMER_GROUP
