VIEW "V_ROLES_ACCESS" AS 
WITH "ROLES_INFO" AS (
    SELECT DISTINCT 
        "USER", CP_ROLE_DETAILS.ROLE_NAME, PARAMETER, VALUE,
        "READ", "CREATE", "UPDATE", "DELETE" 
    FROM "CP_ROLE_DETAILS"
    INNER JOIN "CP_ROLES" ON CP_ROLES.ROLE_NAME = CP_ROLE_DETAILS.ROLE_NAME AND CP_ROLES.ACTIVE = true
    INNER JOIN "CP_USER_ROLES" ON CP_USER_ROLES.ROLE_NAME = CP_ROLES.ROLE_NAME
),
-- For each role, pivot parameters into columns with NULL = "not defined in this role"
ROLE_LOC AS (
    SELECT "USER", ROLE_NAME, VALUE AS LOCATION,
        MAX(CASE WHEN "CREATE" = true THEN 1 ELSE 0 END) AS "CREATE",
        MAX(CASE WHEN "UPDATE" = true THEN 1 ELSE 0 END) AS "UPDATE",
        MAX(CASE WHEN "DELETE" = true THEN 1 ELSE 0 END) AS "DELETE"
    FROM ROLES_INFO WHERE PARAMETER = 'LOCATION_ID'
    GROUP BY "USER", ROLE_NAME, VALUE
),
ROLE_PROD AS (
    SELECT "USER", ROLE_NAME, VALUE AS PRODUCT,
        MAX(CASE WHEN "CREATE" = true THEN 1 ELSE 0 END) AS "CREATE",
        MAX(CASE WHEN "UPDATE" = true THEN 1 ELSE 0 END) AS "UPDATE",
        MAX(CASE WHEN "DELETE" = true THEN 1 ELSE 0 END) AS "DELETE"
    FROM ROLES_INFO WHERE PARAMETER = 'REF_PRODID'
    GROUP BY "USER", ROLE_NAME, VALUE
),
ROLE_MRP AS (
    SELECT "USER", ROLE_NAME, VALUE AS MRP_GROUP,
        MAX(CASE WHEN "CREATE" = true THEN 1 ELSE 0 END) AS "CREATE",
        MAX(CASE WHEN "UPDATE" = true THEN 1 ELSE 0 END) AS "UPDATE",
        MAX(CASE WHEN "DELETE" = true THEN 1 ELSE 0 END) AS "DELETE"
    FROM ROLES_INFO WHERE PARAMETER = 'MRP_GROUP'
    GROUP BY "USER", ROLE_NAME, VALUE
),
ROLE_MAT AS (
    SELECT "USER", ROLE_NAME, VALUE AS MATERIAL_TYPE,
        MAX(CASE WHEN "CREATE" = true THEN 1 ELSE 0 END) AS "CREATE",
        MAX(CASE WHEN "UPDATE" = true THEN 1 ELSE 0 END) AS "UPDATE",
        MAX(CASE WHEN "DELETE" = true THEN 1 ELSE 0 END) AS "DELETE"
    FROM ROLES_INFO WHERE PARAMETER = 'MATERIAL_TYPE'
    GROUP BY "USER", ROLE_NAME, VALUE
),
-- Get all distinct roles per user
ALL_USER_ROLES AS (
    SELECT DISTINCT "USER", ROLE_NAME FROM ROLES_INFO
),
-- For each role + view row combination, check if this role grants access
-- A role grants a permission if ALL dimensions defined in that role match AND grant it
-- Dimensions not defined in the role = unconstrained (true)
ROLE_GRANTS AS (
    SELECT
        V."USER",
        V.FACTORY_LOC, V.DEMAND_LOC, V.PRODUCT_ID, V.REF_PRODID,
        V.MRP_GROUP, V.MATERIAL_TYPE,
        R.ROLE_NAME,
        -- Location: NULL if role has no location dimension
        COALESCE(
            MAX(CASE 
                WHEN RL.ROLE_NAME IS NOT NULL 
                 AND (RL.LOCATION = V.DEMAND_LOC OR RL.LOCATION = V.FACTORY_LOC OR RL.LOCATION = '*')
                THEN RL."CREATE" END),
            CASE WHEN MAX(RL_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS LOC_CREATE,
        COALESCE(
            MAX(CASE 
                WHEN RL.ROLE_NAME IS NOT NULL 
                 AND (RL.LOCATION = V.DEMAND_LOC OR RL.LOCATION = V.FACTORY_LOC OR RL.LOCATION = '*')
                THEN RL."UPDATE" END),
            CASE WHEN MAX(RL_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS LOC_UPDATE,
        COALESCE(
            MAX(CASE 
                WHEN RL.ROLE_NAME IS NOT NULL 
                 AND (RL.LOCATION = V.DEMAND_LOC OR RL.LOCATION = V.FACTORY_LOC OR RL.LOCATION = '*')
                THEN RL."DELETE" END),
            CASE WHEN MAX(RL_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS LOC_DELETE,

        COALESCE(
            MAX(CASE 
                WHEN RP.ROLE_NAME IS NOT NULL 
                 AND (RP.PRODUCT = V.PRODUCT_ID OR RP.PRODUCT = V.REF_PRODID OR RP.PRODUCT = '*')
                THEN RP."CREATE" END),
            CASE WHEN MAX(RP_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS PROD_CREATE,
        COALESCE(
            MAX(CASE 
                WHEN RP.ROLE_NAME IS NOT NULL 
                 AND (RP.PRODUCT = V.PRODUCT_ID OR RP.PRODUCT = V.REF_PRODID OR RP.PRODUCT = '*')
                THEN RP."UPDATE" END),
            CASE WHEN MAX(RP_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS PROD_UPDATE,
        COALESCE(
            MAX(CASE 
                WHEN RP.ROLE_NAME IS NOT NULL 
                 AND (RP.PRODUCT = V.PRODUCT_ID OR RP.PRODUCT = V.REF_PRODID OR RP.PRODUCT = '*')
                THEN RP."DELETE" END),
            CASE WHEN MAX(RP_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS PROD_DELETE,

        COALESCE(
            MAX(CASE 
                WHEN RM.ROLE_NAME IS NOT NULL 
                 AND (RM.MRP_GROUP = V.MRP_GROUP OR RM.MRP_GROUP = '*')
                THEN RM."CREATE" END),
            CASE WHEN MAX(RM_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS MRP_CREATE,
        COALESCE(
            MAX(CASE 
                WHEN RM.ROLE_NAME IS NOT NULL 
                 AND (RM.MRP_GROUP = V.MRP_GROUP OR RM.MRP_GROUP = '*')
                THEN RM."UPDATE" END),
            CASE WHEN MAX(RM_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS MRP_UPDATE,
        COALESCE(
            MAX(CASE 
                WHEN RM.ROLE_NAME IS NOT NULL 
                 AND (RM.MRP_GROUP = V.MRP_GROUP OR RM.MRP_GROUP = '*')
                THEN RM."DELETE" END),
            CASE WHEN MAX(RM_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS MRP_DELETE,

        COALESCE(
            MAX(CASE 
                WHEN RMT.ROLE_NAME IS NOT NULL 
                 AND (RMT.MATERIAL_TYPE = V.MATERIAL_TYPE OR RMT.MATERIAL_TYPE = '*')
                THEN RMT."CREATE" END),
            CASE WHEN MAX(RMT_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS MAT_CREATE,
        COALESCE(
            MAX(CASE 
                WHEN RMT.ROLE_NAME IS NOT NULL 
                 AND (RMT.MATERIAL_TYPE = V.MATERIAL_TYPE OR RMT.MATERIAL_TYPE = '*')
                THEN RMT."UPDATE" END),
            CASE WHEN MAX(RMT_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS MAT_UPDATE,
        COALESCE(
            MAX(CASE 
                WHEN RMT.ROLE_NAME IS NOT NULL 
                 AND (RMT.MATERIAL_TYPE = V.MATERIAL_TYPE OR RMT.MATERIAL_TYPE = '*')
                THEN RMT."DELETE" END),
            CASE WHEN MAX(RMT_ANY.ROLE_NAME) IS NOT NULL THEN 0 ELSE NULL END
        ) AS MAT_DELETE

    FROM "V_ROLES_LOCPROD" V
    JOIN ALL_USER_ROLES R ON R."USER" = V."USER"

    -- Matching location rows for this role
    LEFT JOIN ROLE_LOC RL ON RL."USER" = R."USER" AND RL.ROLE_NAME = R.ROLE_NAME
        AND (RL.LOCATION = V.DEMAND_LOC OR RL.LOCATION = V.FACTORY_LOC OR RL.LOCATION = '*')
    -- Any location rows for this role (to detect if role defines location at all)
    LEFT JOIN ROLE_LOC RL_ANY ON RL_ANY."USER" = R."USER" AND RL_ANY.ROLE_NAME = R.ROLE_NAME

    LEFT JOIN ROLE_PROD RP ON RP."USER" = R."USER" AND RP.ROLE_NAME = R.ROLE_NAME
        AND (RP.PRODUCT = V.PRODUCT_ID OR RP.PRODUCT = V.REF_PRODID OR RP.PRODUCT = '*')
    LEFT JOIN ROLE_PROD RP_ANY ON RP_ANY."USER" = R."USER" AND RP_ANY.ROLE_NAME = R.ROLE_NAME

    LEFT JOIN ROLE_MRP RM ON RM."USER" = R."USER" AND RM.ROLE_NAME = R.ROLE_NAME
        AND (RM.MRP_GROUP = V.MRP_GROUP OR RM.MRP_GROUP = '*')
    LEFT JOIN ROLE_MRP RM_ANY ON RM_ANY."USER" = R."USER" AND RM_ANY.ROLE_NAME = R.ROLE_NAME

    LEFT JOIN ROLE_MAT RMT ON RMT."USER" = R."USER" AND RMT.ROLE_NAME = R.ROLE_NAME
        AND (RMT.MATERIAL_TYPE = V.MATERIAL_TYPE OR RMT.MATERIAL_TYPE = '*')
    LEFT JOIN ROLE_MAT RMT_ANY ON RMT_ANY."USER" = R."USER" AND RMT_ANY.ROLE_NAME = R.ROLE_NAME

    GROUP BY V."USER", V.FACTORY_LOC, V.DEMAND_LOC, V.PRODUCT_ID, V.REF_PRODID,
             V.MRP_GROUP, V.MATERIAL_TYPE, R.ROLE_NAME
)

-- Final: OR across all roles — if ANY role grants it, user gets it
SELECT
    "USER", FACTORY_LOC, DEMAND_LOC, PRODUCT_ID, REF_PRODID, MRP_GROUP, MATERIAL_TYPE,
    CASE WHEN SUM(CASE WHEN 
        COALESCE(LOC_CREATE, 1) = 1 AND COALESCE(PROD_CREATE, 1) = 1 AND 
        COALESCE(MRP_CREATE, 1) = 1 AND COALESCE(MAT_CREATE, 1) = 1 
    THEN 1 ELSE 0 END) > 0 THEN true ELSE false END AS "CREATE",
    CASE WHEN SUM(CASE WHEN 
        COALESCE(LOC_UPDATE, 1) = 1 AND COALESCE(PROD_UPDATE, 1) = 1 AND 
        COALESCE(MRP_UPDATE, 1) = 1 AND COALESCE(MAT_UPDATE, 1) = 1 
    THEN 1 ELSE 0 END) > 0 THEN true ELSE false END AS "UPDATE",
    CASE WHEN SUM(CASE WHEN 
        COALESCE(LOC_DELETE, 1) = 1 AND COALESCE(PROD_DELETE, 1) = 1 AND 
        COALESCE(MRP_DELETE, 1) = 1 AND COALESCE(MAT_DELETE, 1) = 1 
    THEN 1 ELSE 0 END) > 0 THEN true ELSE false END AS "DELETE"
FROM ROLE_GRANTS
GROUP BY "USER", FACTORY_LOC, DEMAND_LOC, PRODUCT_ID, REF_PRODID, MRP_GROUP, MATERIAL_TYPE