-- INNER JOIN "CP_UNIQUE_ID_ITEM" AS C ON C.UNIQUE_ID = A.UNIQUE_ID AND C.PRODUCT_ID = A.REF_PRODID 


VIEW "V_SALESUNQ_DATA" AS

( (WITH 
"CHARTOTALS" AS
(
SELECT 
"LOCATION_ID",
"REF_PRODID",
"PRODUCT_ID",
"WEEK_DATE",
SUM(ORD_QTY) AS CHAR_TOT_ORD_QTY,
SUM(CONFIRMED_QTY) AS CHAR_TOT_CONFIRMED_QTY
FROM "V_SALESALL_WEEK"
GROUP BY 
"LOCATION_ID",
"REF_PRODID",
"PRODUCT_ID",
"WEEK_DATE"
), 
"CHARDETAILS" AS
(
SELECT 
CHAR_NUM,
MAX(CHAR_NAME) AS CHAR_NAME,
MAX(CHAR_DESC) AS CHAR_DESC
FROM "CP_CHARACTERISTICS"
GROUP BY CHAR_NUM
)
SELECT 
A.SALES_DOC,
A.SALESDOC_ITEM,
A.REF_PRODID,
A.PRODUCT_ID,
A.UNIQUE_ID,
A.PRIMARY_ID,
A.SCHEDULELINE_NUM,
A.REASON_REJ,
A.CONFIRMED_QTY,
A.ORD_QTY,
A.ORD_QTY AS ORD_QTY_MAX,
A.MAT_AVAILDATE,
A.WEEK_DATE,
YEAR(A.WEEK_DATE) AS YEAR,
QUARTER(A.WEEK_DATE) AS QUARTER,
MONTH(A.WEEK_DATE) AS MONTH,
A.PERIODDESC,
A.CUSTOMER_GROUP,
A.LOCATION_ID,
A.SEEDORD_CHK,
A.SALES_ORG,
A.DISTR_CHANNEL,
A.DIVISION,
A.RESERVE_FIELD1,
A.RESERVE_FIELD2,
A.RESERVE_FIELD3,
A.RESERVE_FIELD4,
A.RESERVE_FIELD5,
B.UNIQUE_DESC,
C.CHAR_NUM,
-- Get CHAR_NAME from the CharDetails CTE
cd.CHAR_NAME AS CHAR_NAME,
-- Get CHAR_DESC from the CharDetails CTE
cd.CHAR_DESC AS CHAR_DESC,
C.CHARVAL_NUM,
C.CHAR_VALUE,
-- Get CHARVAL_DESC by joining CP_CHAR_VALUES directly
cv.CHARVAL_DESC AS CHARVAL_DESC,
C.UID_CHAR_RATE,
B.VALID_FROM,
B.VALID_TO,
ct.CHAR_TOT_ORD_QTY,
CT.CHAR_TOT_CONFIRMED_QTY,
CASE
WHEN CT.CHAR_TOT_ORD_QTY <> 0 AND CT.CHAR_TOT_ORD_QTY IS NOT NULL THEN ( ( A.ORD_QTY / CT.CHAR_TOT_ORD_QTY ) * 100 )
ELSE 0
END AS ORD_QTY_PERCENT,
CASE
WHEN CT.CHAR_TOT_CONFIRMED_QTY <> 0 AND CT.CHAR_TOT_CONFIRMED_QTY IS NOT NULL THEN ( ( A.CONFIRMED_QTY / CT.CHAR_TOT_CONFIRMED_QTY ) * 100 )
ELSE 0
END AS ASONFIRMED_QTY_PERCENT
FROM 
"V_SALESALL_WEEK" AS A
INNER JOIN
"CP_UNIQUE_ID_HEADER" AS B
ON A.UNIQUE_ID = B.UNIQUE_ID
AND A.REF_PRODID = B.PRODUCT_ID
INNER JOIN
"CP_UNIQUE_ID_ITEM" AS C
ON C.UNIQUE_ID = A.UNIQUE_ID
AND C.PRODUCT_ID = A.REF_PRODID
LEFT OUTER JOIN
CHARTOTALS AS CT
ON CT.LOCATION_ID = A.LOCATION_ID
AND CT.REF_PRODID = A.REF_PRODID
AND CT.PRODUCT_ID = A.PRODUCT_ID
AND CT.WEEK_DATE = A.WEEK_DATE
LEFT OUTER JOIN
CharDetails AS -- Join CTE to get Char Name and Description
cd
ON cd.CHAR_NUM = C.CHAR_NUM
LEFT OUTER JOIN
"CP_CHAR_VALUES" AS -- Join CP_CHAR_VALUES to get the value description
cv
ON cv.CHAR_NUM = C.CHAR_NUM
AND cv.CHAR_VALUE = C.CHAR_VALUE));
