VIEW "V_DAILYHISVC"
AS SELECT DISTINCT
ADD_DAYS(
		ADD_DAYS(
			TO_DATE( '01/01/' || substr( "PERIOD_NUM", 1, 4 ), 'DD/MM/YYYY' ), 
			- (WEEKDAY(TO_DATE( '01/01/' || substr( "PERIOD_NUM", 1, 4 ), 'DD/MM/YYYY' )))
		), 
		(substr( "PERIOD_NUM", 5, 2 ) - 1 ) * 7
	) AS CAL_DATE,
A.LOCATION_ID,
A.PRODUCT_ID,
A.TYPE,
A.GROUP_ID,
A."ROW" as ROW_ID,
A.CHAR_COUNT,
A.CHAR_COUNT_RATE,
A.GROUP_COUNT,
A.GROUP_COUNT_RATE,
A.CHAR_NUM,
B.CHAR_DESC,
B.CHAR_VALUE,
B.CHARVAL_DESC
FROM "CP_VC_HISTORY_DAILY_TS" AS A 
LEFT OUTER JOIN
"V_CHARVAL" AS B
ON
A.CHAR_NUM = B.CHAR_NUM; 
