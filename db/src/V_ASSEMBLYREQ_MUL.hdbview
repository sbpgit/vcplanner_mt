--
-- Name:            V_COMPOD_TSPRED
-- Description:     Get component requirement for location product component based on Version scenario and week date
-- Join Details:    V_BOM_CONFIG_PARTIAL -  Master table for BOM
--                  CP_IBP_FUTUREDEMAND - IBP future demand tables
--                  CP_PVS_BOM -  PVS-BOM assignment table
--                  V_BOM_TSPREDICTIONV2-  View to fet BOM timeseries predictions for Object dependency
--                  V_STRUC_NODE_QTY-    View to get structure node quantity


VIEW "V_ASSEMBLYREQ_MUL" AS
SELECT DISTINCT 
	V_BOM_CONFIG_PARTIAL.LOCATION_ID,
	CP_FACTORY_SALESLOC.FACTORY_LOC,
	V_BOM_CONFIG_PARTIAL.REF_PRODID,
	V_BOM_CONFIG_PARTIAL.PRODUCT_ID,
	V_BOM_CONFIG_PARTIAL.ITEM_NUM,
	V_BOM_CONFIG_PARTIAL.COMPONENT,
	CP_IBP_FUTUREDEMAND.VERSION,
	CP_IBP_FUTUREDEMAND.SCENARIO,
	CP_IBP_FUTUREDEMAND.WEEK_DATE,
	CP_IBP_FUTUREDEMAND.QUANTITY,
	V_BOM_CONFIG_PARTIAL.COMP_QTY AS COMPONENT_QTY,
	V_BOM_TSPREDICTIONV2.MODEL_VERSION,
	CASE
		WHEN V_BOM_TSPREDICTIONV2.PREDICTED IS NULL THEN ROUND(CP_IBP_FUTUREDEMAND.QUANTITY * V_BOM_CONFIG_PARTIAL.COMP_QTY, 2
	)
		ELSE ROUND(V_BOM_TSPREDICTIONV2.PREDICTED * V_BOM_CONFIG_PARTIAL.COMP_QTY, 2
	)
	END AS ACT_COMP_QTY,
	CASE
		WHEN V_BOM_TSPREDICTIONV2.PREDICTED IS NULL THEN ROUND(CP_IBP_FUTUREDEMAND.QUANTITY * V_BOM_CONFIG_PARTIAL.COMP_QTY, 2
	)
		ELSE ROUND(V_BOM_TSPREDICTIONV2.PREDICTED * V_BOM_CONFIG_PARTIAL.COMP_QTY, 2
	)
	END AS COMP_QTY
FROM 
	V_BOM_CONFIG_PARTIAL
	INNER JOIN
	CP_IBP_FUTUREDEMAND
	ON CP_IBP_FUTUREDEMAND.LOCATION_ID = V_BOM_CONFIG_PARTIAL.LOCATION_ID
		AND CP_IBP_FUTUREDEMAND.PRODUCT_ID = V_BOM_CONFIG_PARTIAL.PRODUCT_ID
	LEFT OUTER JOIN
	V_BOM_TSPREDICTIONV2
	ON V_BOM_TSPREDICTIONV2.LOCATION_ID = CP_IBP_FUTUREDEMAND.LOCATION_ID
		AND V_BOM_TSPREDICTIONV2.PRODUCT_ID = CP_IBP_FUTUREDEMAND.PRODUCT_ID
		AND V_BOM_TSPREDICTIONV2.ITEM_NUM = V_BOM_CONFIG_PARTIAL.ITEM_NUM
		AND V_BOM_TSPREDICTIONV2.COMPONENT = V_BOM_CONFIG_PARTIAL.COMPONENT
		AND V_BOM_TSPREDICTIONV2.VERSION = CP_IBP_FUTUREDEMAND.VERSION
		AND V_BOM_TSPREDICTIONV2.SCENARIO = CP_IBP_FUTUREDEMAND.SCENARIO
		AND V_BOM_TSPREDICTIONV2.CAL_DATE = CP_IBP_FUTUREDEMAND.WEEK_DATE
	INNER JOIN
	CP_FACTORY_SALESLOC
	ON V_BOM_CONFIG_PARTIAL.LOCATION_ID = CP_FACTORY_SALESLOC.PLAN_LOC
		AND CP_IBP_FUTUREDEMAND.PRODUCT_ID = CP_FACTORY_SALESLOC.PRODUCT_ID
