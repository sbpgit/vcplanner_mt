-- Level 1 Iteration
-- 1.	Derive Level 1: The engine fires rules for Level 1 characters (e.g., CHASSIS_TYPE).
-- 2.	Calculate Gaps: It adds the UNRESOLVED row for Level 1.
-- 3.	Normalize Level 1: It looks at the sum of Level 1 (Resolved + Unresolved). If the sum is 0.78 or 1.10, it scales every Level 1 row so the sum is exactly 1.0.
-- 4.	Update Buffer: The #BUFFER now contains the Normalized Level 1 values.
-- Level 2 Iteration
-- 1.	Derive Level 2: The engine fires rules for Level 2 characters (e.g., BRAKE_SYSTEM). Crucially, the math for these rules (EXP(SUM(LN(prob)))) now uses the Normalized probabilities from the Level 1 buffer.
-- 2.	Calculate Gaps: It adds the UNRESOLVED row for Level 2.
-- 3.	Normalize Level 2: It scales every Level 2 row so their sum is exactly 1.0.
-- 4.	Update Buffer: The #BUFFER is updated with Normalized Level 2 values.

-- Normalization Excluding Gaps
-- json{
--     "CHASSIS_TYPE": "['ECO_CHASSIS', 'SPORT_CHASSIS']",
--     "COOLING_TYPE": "['HYBRID_THERMAL', 'STANDARD_LIQUID']"
-- }
-- Result of this "Flattening":	
-- CHARKEY	VALUECODE
-- CHASSIS_TYPE	ECO_CHASSIS
-- CHASSIS_TYPE	SPORT_CHASSIS
-- COOLING_TYPE	HYBRID_THERMAL
-- COOLING_TYPE	STANDARD_LIQUID


-- Procedure With DAG_PRODUCT_CONFIG
PROCEDURE "P_DERIVE_PROBABILISTIC"(
    IN  iv_session_id NVARCHAR(36),
    OUT ov_status     NVARCHAR(20),
    OUT ov_message    NVARCHAR(500)
) 
LANGUAGE SQLSCRIPT 
SQL SECURITY INVOKER AS
BEGIN
    -- ── 1. INITIALIZATION ───────────────────────────────────────────────
    DECLARE v_current_level INTEGER := 1;
    DECLARE v_max_level     INTEGER := 0;
    DECLARE v_region        NVARCHAR(10);
    DECLARE v_product       NVARCHAR(20);
    DECLARE v_json_config   NCLOB; 

    DELETE FROM "DAG_DERIVATIONRESULTS" WHERE "SESSIONID" = :iv_session_id;

    -- Fetch Session Context
    SELECT "REGIONID", "PRODUCTID" INTO v_region, v_product 
    FROM "DAG_SESSIONS" WHERE "SESSIONID" = :iv_session_id;

    -- PRE-FETCH JSON (Using the correct column 'PRODUCT')
    SELECT "INF_COND_CHAR_VALUES" INTO v_json_config 
    FROM "DAG_PRODUCT_CONFIG" 
    WHERE "PRODUCT" = :v_product;

    CREATE LOCAL TEMPORARY TABLE #BUFFER (
        "CHARKEY"    NVARCHAR(50),
        "VALUECODE"  NVARCHAR(50),
        "PROBABILITY" DOUBLE,
        PRIMARY KEY ("CHARKEY", "VALUECODE")
    );

    -- ── 2. SEEDING ────────────────────────────────────
    INSERT INTO #BUFFER ("CHARKEY", "VALUECODE", "PROBABILITY")
    SELECT "CHARKEY", "VALUECODE", CAST("PROBABILITY" AS DOUBLE)
    FROM "DAG_SESSIONINPUTS" WHERE "SESSIONID" = :iv_session_id;

    IF NOT EXISTS (SELECT 1 FROM #BUFFER WHERE "CHARKEY" = 'REGION') THEN 
        INSERT INTO #BUFFER VALUES ('REGION', COALESCE(NULLIF(:v_region, ''), 'ALL'), 1.0); 
    END IF;
    -- IF NOT EXISTS (SELECT 1 FROM #BUFFER WHERE "CHARKEY" = 'REGION') THEN INSERT INTO #BUFFER VALUES ('REGION', :v_region, 1.0); END IF;
    IF NOT EXISTS (SELECT 1 FROM #BUFFER WHERE "CHARKEY" = 'PRODUCT') THEN INSERT INTO #BUFFER VALUES ('PRODUCT', :v_product, 1.0); END IF;

    SELECT COALESCE(MAX(PATH_LENGTH), 0) INTO v_max_level FROM "T_DERIVATION_PATHS";

    -- ── 3. ITERATIVE DERIVATION ENGINE ──────────────────────────────────
    WHILE :v_current_level <= :v_max_level DO
        
        -- STEP A: Find Fired Rules with Improved JSON Key/Value Mapping
        lt_fired = SELECT 
            p.TARGET_CHAR,
            p.TARGET_VALUE,
            SUBSTRING_REGEXPR('([^"]+)(?="\]$)' IN p.RULE_CHAIN) as RULE_ID,
            rules.rule_prob
        FROM "T_DERIVATION_PATHS" p
        INNER JOIN (
            -- This handles JSON objects like {"CHAR1": "['VAL1']"} 
            -- by mapping the key as the CHARKEY.
            SELECT 
                jt.CHAR_KEY, 
                jt.VAL_CODE
            FROM JSON_TABLE(:v_json_config, '$.*' 
                COLUMNS (
                    CHAR_KEY NVARCHAR(50) PATH '$' ,
                    NESTED PATH '$[*]' COLUMNS (
                        VAL_CODE NVARCHAR(50) PATH '$'
                    )
                )
            ) AS jt
        ) allow
           ON allow.CHAR_KEY   = p.TARGET_CHAR
          AND allow.VAL_CODE   = p.TARGET_VALUE
        INNER JOIN (
            SELECT 
                rc.RULE_ID,
                EXP(SUM(LN(NULLIF(b.PROBABILITY, 0)))) as rule_prob
            FROM "T_RULE_CONDITIONS" rc
            JOIN #BUFFER b ON b."CHARKEY" = rc."COND_CHAR" AND b."VALUECODE" = rc."COND_VALUE"
            GROUP BY rc.RULE_ID
            HAVING COUNT(*) = (SELECT COUNT(*) FROM "T_RULE_CONDITIONS" sub WHERE sub.RULE_ID = rc.RULE_ID)
        ) AS rules ON rules.RULE_ID = SUBSTRING_REGEXPR('([^"]+)(?="\]$)' IN p.RULE_CHAIN)
        WHERE p.PATH_LENGTH = :v_current_level;

        -- STEP B: Log Resolved Rules
        INSERT INTO "DAG_DERIVATIONRESULTS" 
            ("RESULTID", "SESSIONID", "CHARKEY", "VALUECODE", "PROBABILITY", "DERIVELEVEL", "STATUS", "RULECHAIN", "COMPUTEDAT")
        SELECT 
            "SQ_RESULT_ID".NEXTVAL, :iv_session_id, f.TARGET_CHAR, f.TARGET_VALUE, f.rule_prob,        
            :v_current_level, 'RESOLVED', f.RULE_ID, CURRENT_TIMESTAMP
        FROM (
            SELECT 
                TARGET_CHAR, 
                TARGET_VALUE, 
                RULE_ID, 
                rule_prob,
                ROW_NUMBER() OVER (PARTITION BY TARGET_CHAR, TARGET_VALUE ORDER BY rule_prob DESC, RULE_ID ASC) as rank
            FROM :lt_fired
        ) f
        WHERE f.rank = 1;

        -- STEP C: NORMALIZATION
        MERGE INTO "DAG_DERIVATIONRESULTS" AS r
        USING (
            SELECT CHARKEY, SUM(PROBABILITY) as total_prob
            FROM "DAG_DERIVATIONRESULTS"
            WHERE SESSIONID = :iv_session_id AND DERIVELEVEL = :v_current_level
            GROUP BY CHARKEY
        ) AS s
        ON r.SESSIONID = :iv_session_id 
           AND r.DERIVELEVEL = :v_current_level 
           AND r.CHARKEY = s.CHARKEY
        WHEN MATCHED AND s.total_prob > 0 THEN 
            UPDATE SET r."PROBABILITY" = r."PROBABILITY" / s.total_prob;

        -- STEP D: Update Buffer
        MERGE INTO #BUFFER AS b
        USING (
            SELECT "CHARKEY", "VALUECODE", SUM("PROBABILITY") as TOTAL_PROB
            FROM "DAG_DERIVATIONRESULTS" 
            WHERE "SESSIONID" = :iv_session_id AND "DERIVELEVEL" = :v_current_level
            GROUP BY "CHARKEY", "VALUECODE"
        ) AS src
        ON b."CHARKEY" = src."CHARKEY" AND b."VALUECODE" = src."VALUECODE"
        WHEN MATCHED THEN UPDATE SET b."PROBABILITY" = src.TOTAL_PROB
        WHEN NOT MATCHED THEN INSERT VALUES (src."CHARKEY", src."VALUECODE", src.TOTAL_PROB);

        v_current_level := :v_current_level + 1;
    END WHILE;

    DROP TABLE #BUFFER;
    ov_status := 'SUCCESS';
    ov_message := 'Derivation complete.';
END;









