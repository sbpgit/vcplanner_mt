-- PROCEDURE "P_REBUILD_GRAPH"()
-- LANGUAGE SQLSCRIPT
-- SQL SECURITY INVOKER
-- AS
-- BEGIN
--     -- ── All declarations at top of BEGIN block ────────────────────────────
