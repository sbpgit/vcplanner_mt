--     DELETE FROM "T_DERIVATION_PATHS";

--     -- Seed: direct 1-hop paths from INPUT vertices to L1 DERIVED vertices
--     lt_paths = SELECT
--         ROW_NUMBER() OVER (ORDER BY e.SOURCE, e.TARGET) AS PATH_ID,
--         vs.CHAR_KEY    AS SOURCE_CHAR,
--         vs.VALUE_CODE  AS SOURCE_VALUE,
--         vt.CHAR_KEY    AS TARGET_CHAR,
--         vt.VALUE_CODE  AS TARGET_VALUE,
--         1              AS PATH_LENGTH,
