PROCEDURE "P_REBUILD_GRAPH"()
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
AS
BEGIN
    /* 
       =========================================================================
       1. DECLARATIONS & INITIALIZATION
       =========================================================================
    */
    DECLARE i_level      INTEGER := 1;
    DECLARE v_row_count  BIGINT  := 0;
    DECLARE v_base_id    BIGINT;

    -- Results from the Topological Sort (Kahn's Algorithm)
    DECLARE lt_topo_result TABLE (
        "VERTEX_ID"    NVARCHAR(50),
        "CHAR_KEY"     NVARCHAR(50),
        "VALUE_CODE"   NVARCHAR(50),
        "DERIVE_LEVEL" INTEGER,
        "TOPO_ORDER"   INTEGER
    );

    -- Buffer tables for BFS path exploration
    DECLARE lt_paths TABLE (
        "SOURCE_CHAR"  NVARCHAR(50), "SOURCE_VALUE" NVARCHAR(50),
        "TARGET_CHAR"  NVARCHAR(50), "TARGET_VALUE" NVARCHAR(50),
        "PATH_LENGTH"  INTEGER,
        "PATH_NODES"   NVARCHAR(2000), 
        "RULE_CHAIN"   NVARCHAR(2000),
        "LAST_VERTEX"  NVARCHAR(50)
    );

    DECLARE lt_extensions TABLE (
        "SOURCE_CHAR"  NVARCHAR(50), "SOURCE_VALUE" NVARCHAR(50),
        "TARGET_CHAR"  NVARCHAR(50), "TARGET_VALUE" NVARCHAR(50),
        "PATH_LENGTH"  INTEGER,
        "PATH_NODES"   NVARCHAR(2000), 
        "RULE_CHAIN"   NVARCHAR(2000),
        "LAST_VERTEX"  NVARCHAR(50)
    );

    /* 
       =========================================================================
       2. GRAPH RECONSTRUCTION (CLEANUP & RELEVANCE FILTERING)
       =========================================================================
    */
    DELETE FROM "T_GRAPH_EDGES";
    DELETE FROM "T_GRAPH_VERTICES";

    -- Step 2.1: Create Vertices (Filters orphans like eCVT)
    INSERT INTO "T_GRAPH_VERTICES" (VERTEX_ID, CHAR_KEY, VALUE_CODE, CHAR_TYPE, DERIVE_LEVEL, LABEL)
    SELECT 
        cv.CHAR_KEY || '__' || cv.VALUE_CODE, 
        cv.CHAR_KEY, 
        cv.VALUE_CODE, 
        cd.CHAR_TYPE, 
        0, 
        cv.VALUE_LABEL
    FROM "T_CHAR_VALUES" cv 
    JOIN "T_CHAR_DEFINITIONS" cd ON cd.CHAR_KEY = cv.CHAR_KEY
    WHERE cd.CHAR_TYPE = 'INPUT'
       OR EXISTS (
          SELECT 1 FROM "T_DERIVATION_RULES" r 
          WHERE r.TARGET_CHAR = cv.CHAR_KEY AND r.DERIVED_VALUE = cv.VALUE_CODE AND r.ACTIVE = 1
       )
       OR EXISTS (
          SELECT 1 FROM "T_RULE_CONDITIONS" rc
          JOIN "T_DERIVATION_RULES" ar ON ar.RULE_ID = rc.RULE_ID
          WHERE rc.COND_CHAR = cv.CHAR_KEY AND rc.COND_VALUE = cv.VALUE_CODE AND ar.ACTIVE = 1
       );

    -- Step 2.2: Create Edges
    INSERT INTO "T_GRAPH_EDGES" (EDGE_ID, SOURCE, TARGET, RULE_ID, EDGE_WEIGHT)
    SELECT 
        "SQ_EDGE_ID".NEXTVAL, 
        rc.COND_CHAR || '__' || rc.COND_VALUE, 
        r.TARGET_CHAR || '__' || r.DERIVED_VALUE, 
        rc.RULE_ID, 
        rc.COND_WEIGHT
    FROM "T_RULE_CONDITIONS" rc 
    JOIN "T_DERIVATION_RULES" r ON r.RULE_ID = rc.RULE_ID
    WHERE r.ACTIVE = 1;

    /* 
       =========================================================================
       3. TOPOLOGICAL RANKING
       =========================================================================
    */
    CALL "P_GRAPH_TOPO_SORT"(ot_sorted_vertices => :lt_topo_result);

    MERGE INTO "T_GRAPH_VERTICES" AS v
    USING :lt_topo_result AS t
    ON v.VERTEX_ID = t.VERTEX_ID
    WHEN MATCHED THEN 
        UPDATE SET v.DERIVE_LEVEL = t.DERIVE_LEVEL;

    /* 
       =========================================================================
       4. BFS PATH EXPLORATION
       =========================================================================
    */
    DELETE FROM "T_DERIVATION_PATHS";

    lt_paths = SELECT 
        vs.CHAR_KEY AS SOURCE_CHAR, vs.VALUE_CODE AS SOURCE_VALUE,
        vt.CHAR_KEY AS TARGET_CHAR, vt.VALUE_CODE AS TARGET_VALUE,
        1 AS PATH_LENGTH,
        CAST('["' || e.SOURCE || '","' || e.TARGET || '"]' AS NVARCHAR(2000)) AS PATH_NODES,
        CAST('["' || e.RULE_ID || '"]' AS NVARCHAR(2000)) AS RULE_CHAIN,
        e.TARGET AS LAST_VERTEX
    FROM "T_GRAPH_EDGES" e
    JOIN "T_GRAPH_VERTICES" vs ON vs.VERTEX_ID = e.SOURCE AND vs.CHAR_TYPE = 'INPUT'
    JOIN "T_GRAPH_VERTICES" vt ON vt.VERTEX_ID = e.TARGET AND vt.CHAR_TYPE = 'DERIVED';

    v_row_count := RECORD_COUNT(:lt_paths);

    WHILE :v_row_count > 0 DO
        lt_extensions = SELECT 
            p.SOURCE_CHAR, p.SOURCE_VALUE,
            vt.CHAR_KEY AS TARGET_CHAR, vt.VALUE_CODE AS TARGET_VALUE,
            p.PATH_LENGTH + 1 AS PATH_LENGTH,
            -- Explicit CAST to NVARCHAR(2000) avoids Type Mismatch warnings
            CAST(SUBSTRING(p.PATH_NODES, 1, LENGTH(p.PATH_NODES) - 1) || ',"' || e.TARGET || '"]' AS NVARCHAR(2000)) AS PATH_NODES,
            CAST(SUBSTRING(p.RULE_CHAIN, 1, LENGTH(p.RULE_CHAIN) - 1) || ',"' || e.RULE_ID || '"]' AS NVARCHAR(2000)) AS RULE_CHAIN,
            e.TARGET AS LAST_VERTEX
        FROM :lt_paths p
        JOIN "T_GRAPH_EDGES" e ON e.SOURCE = p.LAST_VERTEX
        JOIN "T_GRAPH_VERTICES" vt ON vt.VERTEX_ID = e.TARGET
        WHERE p.PATH_LENGTH = :i_level;

        v_row_count := RECORD_COUNT(:lt_extensions);
        
        IF :v_row_count > 0 THEN
            lt_paths = SELECT * FROM :lt_paths UNION ALL SELECT * FROM :lt_extensions;
        END IF;
        
        i_level := :i_level + 1;
        IF :i_level > 20 THEN BREAK; END IF; 
    END WHILE;

    /* 
       =========================================================================
       5. PERSISTENCE & DEDUPLICATION (Sanitized for Keywords)
       =========================================================================
    */
    SELECT COALESCE(MAX(PATH_ID), 0) INTO v_base_id FROM "T_DERIVATION_PATHS";

    INSERT INTO "T_DERIVATION_PATHS" (
        PATH_ID, SOURCE_CHAR, SOURCE_VALUE, TARGET_CHAR, TARGET_VALUE, 
        PATH_LENGTH, PATH_NODES, RULE_CHAIN, COMPUTED_AT
    )
    SELECT 
        :v_base_id + ROW_NUMBER() OVER(),
        "SOURCE_CHAR", "SOURCE_VALUE", "TARGET_CHAR", "TARGET_VALUE", 
        "PATH_LENGTH", "PATH_NODES", "RULE_CHAIN", CURRENT_TIMESTAMP
    FROM (
        SELECT 
            "SOURCE_CHAR", "SOURCE_VALUE", "TARGET_CHAR", "TARGET_VALUE", 
            "PATH_LENGTH", "PATH_NODES", "RULE_CHAIN",
            -- Aliased to "DEPTH_INDICATOR" to avoid "Rank" keyword error
            ROW_NUMBER() OVER (
                PARTITION BY "TARGET_CHAR", "TARGET_VALUE" 
                ORDER BY "PATH_LENGTH" DESC
            ) AS "DEPTH_INDICATOR"
        FROM :lt_paths
    ) AS "BASE_PATHS"
    WHERE "BASE_PATHS"."DEPTH_INDICATOR" = 1; 

END;




