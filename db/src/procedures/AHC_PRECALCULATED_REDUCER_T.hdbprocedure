PROCEDURE AHC_PRECALCULATED_REDUCER_T(
IN iv_group_id NVARCHAR(100),
IN it_data PAL_PRECALCULATED_DATA_T,
OUT ot_ahc_cp PAL_AHC_PRECALC_COMBINE_PROCESS_GRP_T,
OUT ot_ahc_results PAL_AHC_PRECALC_RESULTS_GRP_T
) 
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
READS SQL DATA AS
BEGIN
lt_param = SELECT "PARAM_NAME", "INT_VALUE", "DOUBLE_VALUE", "STRING_VALUE" FROM PAL_AHC_PARAMETER_GRP_TAB WHERE "GROUP_ID" = :iv_group_id;
CALL HIERARCHICAL_CLUSTERING(:it_data, :lt_param, lt_ahc_cp, lt_ahc_results);
ot_ahc_cp = SELECT :iv_group_id AS "GROUP_ID", "STAGE", "LEFT_LEFT_POINT", "RIGHT_LEFT_POINT", "DISTANCE" FROM :lt_ahc_cp;
ot_ahc_results = SELECT :iv_group_id AS "GROUP_ID", "LEFT_POINT", "CLUSTER_ID" FROM :lt_ahc_results;

END;