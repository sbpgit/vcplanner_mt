PROCEDURE AES_REDUCER(
IN iv_group_id NVARCHAR(100),
IN it_data PAL_AES_DATA,
OUT ot_stats PAL_AES_STATS_GRP_T,
OUT ot_forecast PAL_AES_FORECAST_GRP_T
) 
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
READS SQL DATA AS
BEGIN
    lt_param = SELECT "PARAM_NAME", "INT_VALUE", "DOUBLE_VALUE", "STRING_VALUE" FROM PAL_AES_PARAMETER_GRP_TAB WHERE "GROUP_ID" = :iv_group_id;
    --lt_param = SELECT "PARAM_NAME", "INT_VALUE", "DOUBLE_VALUE", "STRING_VALUE" FROM PAL_AES_PARAMETER_GRP_TAB WHERE "GROUP_ID" = :iv_group_id;
    CALL AUTO_EXPSMOOTH(:it_data, :lt_param, lt_forecast,lt_stats);
    ot_stats = SELECT :iv_group_id AS "GROUP_ID", "STAT_NAME", "STAT_VALUE" FROM :lt_stats;
    ot_forecast = SELECT :iv_group_id AS "GROUP_ID", "TIMESTAMP", "VALUE", "PI1_LOWER", "PI1_UPPER", "PI2_LOWER", "PI2_UPPER" FROM :lt_forecast;

END;