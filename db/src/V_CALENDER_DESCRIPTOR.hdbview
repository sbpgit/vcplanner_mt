VIEW "V_CALENDER_DESCRIPTOR" AS 
SELECT 
A.PERIODSTART,
A.PERIODEND,
A.WEEK_STARTDATE,
A.WEEK_ENDDATE,
A.CALENDAR_WEEK,
A.TELESCOPIC_WEEK,
B.PERIODDESC AS MONTH
FROM 
V_WEEK_DESCRIPTOR AS A
LEFT OUTER JOIN
CP_IBPCALENDER_WEEK AS B
ON (A.WEEK_STARTDATE >= B.WEEK_STARTDATE
  AND A.WEEK_STARTDATE <= B.WEEK_ENDDATE) 
WHERE B.LEVEL = 'M' 
ORDER BY 
A.WEEK_STARTDATE ASC,
A.PERIODSTART ASC