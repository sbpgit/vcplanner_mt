VIEW V_IBP_FCHARPLAN_TELESCOPIC AS 
SELECT IFP.LOCATION_ID, IFP.PRODUCT_ID, CLASS_NUM, CHAR_NUM, CHARVAL_NUM, 
IFP.VERSION, IFP.SCENARIO, IFP.WEEK_DATE, MODEL_VERSION, OPT_QTY, 
CASE WHEN QUANTITY != 0 THEN ROUND(100*OPT_QTY/QUANTITY, 2) ELSE 0 END AS OPT_PERCENT
FROM V_IBP_FOPTQTYPLAN_TELESCOPIC AS IFP
INNER JOIN  V_IBP_FUTUREDEMAND_TELESCOPIC AS IFB ON
IFP.LOCATION_ID = IFB.LOCATION_ID
AND IFP.PRODUCT_ID = IFB.PRODUCT_ID
AND IFP.VERSION = IFB.VERSION
AND IFP.SCENARIO = IFB.SCENARIO
AND IFP.WEEK_DATE = IFB.WEEK_DATE
ORDER BY IFP.WEEK_DATE, CHAR_NUM, CHARVAL_NUM;