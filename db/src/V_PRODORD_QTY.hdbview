-- Name:            V_PRODORD_QTY
-- Description:     Get order quantity for production orders
-- Join Details:    CP_PROD_ORD_CONSUMPTION -  Production Orders Consumption Data
--                  V_SALES_H - Sales Orders with Unique Ids

VIEW "V_PRODORD_QTY" AS
SELECT DISTINCT A.LOCATION_ID,
  A.SALES_DOC,
  A.SALESDOC_ITEM,
  A.REF_PRODID,
  B.UNIQUE_ID,
  B.PRODUCT_ID,
  ADD_DAYS("MAT_AVAILDATE", WEEKDAY("MAT_AVAILDATE") * -1) AS "WEEK_DATE",
  B.ORD_QTY AS PRODORD_QTY
FROM CP_PROD_ORD_CONSUMPTION AS A
  INNER JOIN V_SALES_H AS B
--  ON A.LOCATION_ID = B.LOCATION_ID
--   AND 
  ON A.REF_PRODID = B.REF_PRODID
  AND A.SALES_DOC = B.SALES_DOC
  AND LTRIM(A.SALESDOC_ITEM, 0) = LTRIM(B.SALESDOC_ITEM, 0)
ORDER BY A.LOCATION_ID,
  A.SALES_DOC,
  A.SALESDOC_ITEM,
  A.REF_PRODID,
  B.UNIQUE_ID,
  B.PRODUCT_ID,
  ADD_DAYS("MAT_AVAILDATE", WEEKDAY("MAT_AVAILDATE") * -1);


-- GROUP BY
-- 	A.LOCATION_ID,
--  	A.SALES_DOC,
-- 	A.SALESDOC_ITEM,
-- 	A.REF_PRODID,
-- 	B.UNIQUE_ID,
-- 	B.PRODUCT_ID,
-- 	ADD_DAYS("MAT_AVAILDATE",WEEKDAY("MAT_AVAILDATE") * -1 )