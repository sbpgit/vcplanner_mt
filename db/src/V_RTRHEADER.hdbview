VIEW "V_RTRHEADER" AS
SELECT DISTINCT
A.LOCATION_ID,
B.LOCATION_DESC,
A.LINE_ID,
C.LINE_DESC,
B.PRODUCT_ID,
A.RESTRICTION,
A.RTR_DESC,
A.RTR_TYPE,
A.RTR_QTY,
A.VALID_FROM,
A.VALID_TO,
A.CHANGED_DATE,
A.CHANGED_BY,
A.CREATED_DATE,
A.CREATED_BY,
A.CHANGED_TIME
FROM CP_RESTRICT_HEADER as A
INNER JOIN V_LOCPROD AS B
ON A.LOCATION_ID = B.LOCATION_ID
LEFT OUTER JOIN CP_LINEMASTER AS C
ON A.LOCATION_ID = C.LOCATION_ID
AND A.LINE_ID = C.LINE_ID
ORDER BY A.LOCATION_ID,
B.LOCATION_DESC,
A.LINE_ID,
C.LINE_DESC,
A.RESTRICTION;

