
VIEW "V_CIRUNIQUECHAR" AS

WITH "TOTALS" AS (
    SELECT
        "LOCATION_ID",
        "PRODUCT_ID",
        "WEEK_DATE",
        "MODEL_VERSION",
        "VERSION",
        "SCENARIO",
        SUM(CIR_QTY) AS CIR_QTY_TOT
    FROM "CP_CIR_GENERATED"
    GROUP BY
        "LOCATION_ID",
        "PRODUCT_ID",
        "WEEK_DATE",
        "MODEL_VERSION",
        "VERSION",
        "SCENARIO"
)

-- =========================================================
-- FIRST BRANCH: NON-NUMERIC CHARACTERISTICS
-- =========================================================

SELECT DISTINCT
    A."LOCATION_ID",
    A."PRODUCT_ID",
    P."REF_PRODID",
    A."WEEK_DATE",
    YEAR(A."WEEK_DATE") AS YEAR,
    QUARTER(A."WEEK_DATE") AS QUARTER,
    MONTH(A."WEEK_DATE") AS MONTH,
    A."CIR_ID",
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    IBPV.VERSION_NAME,
    IBPV.SCENARIO_NAME,
    C.RESERVE_FIELD1,
    C.RESERVE_FIELD2,
    C.RESERVE_FIELD3,
    C.RESERVE_FIELD4,
    C.RESERVE_FIELD5,
    A."UNIQUE_ID",
    A."CIR_QTY",
    A."CIR_QTY" AS CIR_QTY_AVG,
    B."CHAR_NUM",
    E."CHAR_DESC",
    E."CHARVAL_DESC",
    E."CHAR_NAME",
    B."CHARVAL_NUM",
    E."CHAR_VALUE",
    F."CALENDAR_WEEK",
    F."TELESCOPIC_WEEK" AS "PERIODDESC",
    T."CIR_QTY_TOT",

    CASE
        WHEN T."CIR_QTY_TOT" <> 0
         AND T."CIR_QTY_TOT" IS NOT NULL
        THEN
            (A."CIR_QTY" / T."CIR_QTY_TOT") * 100
        ELSE 0
    END AS CIR_QTY_PERCENT

FROM "CP_CIR_GENERATED" A

INNER JOIN "CP_PARTIALPROD_INTRO" P
    ON A."LOCATION_ID" = P."LOCATION_ID"
   AND A."PRODUCT_ID" = P."PRODUCT_ID"

INNER JOIN "CP_UNIQUE_ID_ITEM" B
    ON B."UNIQUE_ID" = A."UNIQUE_ID"
   AND P."REF_PRODID" = B."PRODUCT_ID"

INNER JOIN "CP_PRODUCT" C
    ON P."REF_PRODID" = C."PRODUCT_ID"

INNER JOIN "CP_CHARACTERISTICS" CH
    ON CH."CHAR_NUM" = B."CHAR_NUM"
   AND CH."CHAR_TYPE" != 'NUM'

-- =========================================================
-- CORRECTED CHARACTER VALUE MATCHING
--
-- 2 = 2.0 = 2.00
-- 3 = 3.0 = 3.00
--
-- Works for numeric-looking character values generally.
-- Non-numeric values retain exact matching.
-- =========================================================

INNER JOIN "V_PRODCLSCHARVAL" E
    ON E."PRODUCT_ID" = B."PRODUCT_ID"
   AND E."CHAR_NUM" = B."CHAR_NUM"

   AND (
        E."CHARVAL_NUM" = B."CHARVAL_NUM"

        OR

        (
            B."CHARVAL_NUM" LIKE_REGEXPR
                '^[+-]?[0-9]+([.][0-9]+)?$'

            AND

            E."CHARVAL_NUM" LIKE_REGEXPR
                '^[+-]?[0-9]+([.][0-9]+)?$'

            AND

            TO_DECIMAL(
                CASE
                    WHEN B."CHARVAL_NUM" LIKE_REGEXPR
                        '^[+-]?[0-9]+([.][0-9]+)?$'
                    THEN B."CHARVAL_NUM"
                    ELSE NULL
                END,
                34,
                10
            )

            =

            TO_DECIMAL(
                CASE
                    WHEN E."CHARVAL_NUM" LIKE_REGEXPR
                        '^[+-]?[0-9]+([.][0-9]+)?$'
                    THEN E."CHARVAL_NUM"
                    ELSE NULL
                END,
                34,
                10
            )
        )
   )

INNER JOIN "V_WEEK_DESCRIPTOR" F
    ON F."WEEK_STARTDATE" <= A."WEEK_DATE"
   AND F."WEEK_ENDDATE" >= A."WEEK_DATE"

LEFT OUTER JOIN "TOTALS" T
    ON T."LOCATION_ID" = A."LOCATION_ID"
   AND T."PRODUCT_ID" = A."PRODUCT_ID"
   AND T."WEEK_DATE" = A."WEEK_DATE"
   AND T."MODEL_VERSION" = A."MODEL_VERSION"
   AND T."VERSION" = A."VERSION"
   AND T."SCENARIO" = A."SCENARIO"

LEFT OUTER JOIN "CP_IBPVERSIONSCENARIO" IBPV
    ON IBPV.VERSION = A."VERSION"
   AND IBPV.SCENARIO = A."SCENARIO"


UNION


-- =========================================================
-- SECOND BRANCH: NUMERIC CHARACTERISTICS
-- ORIGINAL BUCKET MAPPING LOGIC PRESERVED
-- =========================================================

SELECT DISTINCT
    A."LOCATION_ID",
    A."PRODUCT_ID",
    P."REF_PRODID",
    A."WEEK_DATE",
    YEAR(A."WEEK_DATE") AS YEAR,
    QUARTER(A."WEEK_DATE") AS QUARTER,
    MONTH(A."WEEK_DATE") AS MONTH,
    A."CIR_ID",
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    IBPV.VERSION_NAME,
    IBPV.SCENARIO_NAME,
    C.RESERVE_FIELD1,
    C.RESERVE_FIELD2,
    C.RESERVE_FIELD3,
    C.RESERVE_FIELD4,
    C.RESERVE_FIELD5,
    A."UNIQUE_ID",
    A."CIR_QTY",
    A."CIR_QTY" AS CIR_QTY_AVG,
    B."CHAR_NUM",
    E."CHAR_DESC",
    E."CHARVAL_DESC",
    E."CHAR_NAME",
    B."CHARVAL_NUM",
    E."CHAR_VALUE",
    F."CALENDAR_WEEK",
    F."TELESCOPIC_WEEK" AS "PERIODDESC",
    T."CIR_QTY_TOT",

    CASE
        WHEN T."CIR_QTY_TOT" <> 0
         AND T."CIR_QTY_TOT" IS NOT NULL
        THEN
            (A."CIR_QTY" / T."CIR_QTY_TOT") * 100
        ELSE 0
    END AS CIR_QTY_PERCENT

FROM "CP_CIR_GENERATED" A

INNER JOIN "CP_PARTIALPROD_INTRO" P
    ON A."LOCATION_ID" = P."LOCATION_ID"
   AND A."PRODUCT_ID" = P."PRODUCT_ID"

INNER JOIN "CP_UNIQUE_ID_ITEM" B
    ON B."UNIQUE_ID" = A."UNIQUE_ID"
   AND P."REF_PRODID" = B."PRODUCT_ID"

INNER JOIN "CP_PRODUCT" C
    ON P."REF_PRODID" = C."PRODUCT_ID"

INNER JOIN "CP_CHARACTERISTICS" CH
    ON CH."CHAR_NUM" = B."CHAR_NUM"
   AND CH."CHAR_TYPE" = 'NUM'

INNER JOIN "V_PRODCLSCHARVAL" E
    ON E."PRODUCT_ID" = B."PRODUCT_ID"
   AND E."CHAR_NUM" = B."CHAR_NUM"

   AND (
        E."CHARVAL_NUM" = B."CHARVAL_NUM"

        OR

        (
            B."CHARVAL_NUM" LIKE_REGEXPR
                '^[+-]?[0-9]+([.][0-9]+)?$'

            AND

            E."CHARVAL_NUM" LIKE_REGEXPR
                '^[+-]?[0-9]+([.][0-9]+)?$'

            AND

            TO_DECIMAL(
                CASE
                    WHEN B."CHARVAL_NUM" LIKE_REGEXPR
                        '^[+-]?[0-9]+([.][0-9]+)?$'
                    THEN B."CHARVAL_NUM"
                    ELSE NULL
                END,
                34,
                10
            )

            =

            TO_DECIMAL(
                CASE
                    WHEN E."CHARVAL_NUM" LIKE_REGEXPR
                        '^[+-]?[0-9]+([.][0-9]+)?$'
                    THEN E."CHARVAL_NUM"
                    ELSE NULL
                END,
                34,
                10
            )
        )
   )

INNER JOIN "CP_CHARVAL_BUCKET" BUCKET
    ON BUCKET."CHAR_NUM" = E."CHAR_NUM"
   AND B."CHARVAL_NUM" LIKE_REGEXPR
       '^[0-9]+(\\.[0-9]+)?$'
   AND TO_DECIMAL(B."CHARVAL_NUM")
       BETWEEN BUCKET."RANGE_FROM"
           AND BUCKET."RANGE_TO"

INNER JOIN "V_WEEK_DESCRIPTOR" F
    ON F."WEEK_STARTDATE" <= A."WEEK_DATE"
   AND F."WEEK_ENDDATE" >= A."WEEK_DATE"

LEFT OUTER JOIN "TOTALS" T
    ON T."LOCATION_ID" = A."LOCATION_ID"
   AND T."PRODUCT_ID" = A."PRODUCT_ID"
   AND T."WEEK_DATE" = A."WEEK_DATE"
   AND T."MODEL_VERSION" = A."MODEL_VERSION"
   AND T."VERSION" = A."VERSION"
   AND T."SCENARIO" = A."SCENARIO"

LEFT OUTER JOIN "CP_IBPVERSIONSCENARIO" IBPV
    ON IBPV.VERSION = A."VERSION"
   AND IBPV.SCENARIO = A."SCENARIO";

 