VIEW "V_CIRUNIQUECHAR" as
WITH "TOTALS" AS (SELECT 
"LOCATION_ID",
"PRODUCT_ID",
"WEEK_DATE",
"MODEL_VERSION",
"VERSION",
"SCENARIO",
SUM(CIR_QTY) AS CIR_QTY_TOT
FROM "CP_CIR_GENERATED"
GROUP BY 
"LOCATION_ID",
"PRODUCT_ID",
"WEEK_DATE",
"MODEL_VERSION",
"VERSION",
"SCENARIO")
 
(SELECT DISTINCT
A."LOCATION_ID",
A."PRODUCT_ID",
P."REF_PRODID",
A."WEEK_DATE",
YEAR(A.WEEK_DATE) AS YEAR,
QUARTER(A.WEEK_DATE) AS QUARTER,
MONTH(A.WEEK_DATE) AS MONTH,
A."CIR_ID",
A."MODEL_VERSION",
A."VERSION",
A."SCENARIO",
IBPV.VERSION_NAME,
IBPV.SCENARIO_NAME,
C.RESERVE_FIELD1,
C.RESERVE_FIELD2,
C.RESERVE_FIELD3,
C.RESERVE_FIELD4,
C.RESERVE_FIELD5,
-- A."METHOD",
A."UNIQUE_ID",
A."CIR_QTY",
A."CIR_QTY" AS CIR_QTY_AVG,
B."CHAR_NUM",
E."CHAR_DESC",
E."CHARVAL_DESC",
E."CHAR_NAME",
B."CHARVAL_NUM",
E."CHAR_VALUE",
F."CALENDAR_WEEK",
F."TELESCOPIC_WEEK" AS "PERIODDESC",
T."CIR_QTY_TOT",
CASE
WHEN T.CIR_QTY_TOT <> 0 AND T.CIR_QTY_TOT IS NOT NULL THEN ( ( A.CIR_QTY / T.CIR_QTY_TOT ) * 100 )
ELSE 0
END AS CIR_QTY_PERCENT
FROM 
CP_CIR_GENERATED AS A
INNER JOIN
CP_PARTIALPROD_INTRO AS P
ON A.LOCATION_ID = P.LOCATION_ID
AND A.PRODUCT_ID = P.PRODUCT_ID
INNER JOIN
CP_UNIQUE_ID_ITEM AS B
ON B.UNIQUE_ID = A.UNIQUE_ID
AND 
P.REF_PRODID = B.PRODUCT_ID
INNER JOIN
CP_PRODUCT AS C
ON P.REF_PRODID = C.PRODUCT_ID
INNER JOIN "CP_CHARACTERISTICS" AS CH
    ON CH.CHAR_NUM = B.CHAR_NUM AND CH.CHAR_TYPE !='NUM'
INNER JOIN
V_PRODCLSCHARVAL AS E
ON E.PRODUCT_ID = B.PRODUCT_ID
AND E.CHAR_NUM = B.CHAR_NUM
AND E.CHARVAL_NUM = B.CHARVAL_NUM
INNER JOIN
V_WEEK_DESCRIPTOR AS F
ON F.WEEK_STARTDATE <= A.WEEK_DATE
AND F.WEEK_ENDDATE >= A.WEEK_DATE
LEFT OUTER JOIN
TOTALS AS T
ON T."LOCATION_ID" = A."LOCATION_ID"
AND T."PRODUCT_ID" = A."PRODUCT_ID"
AND T."WEEK_DATE" = A."WEEK_DATE"
AND T."MODEL_VERSION" = A."MODEL_VERSION"
AND T."VERSION" = A."VERSION"
AND T."SCENARIO" = A."SCENARIO"
LEFT OUTER JOIN
CP_IBPVERSIONSCENARIO AS IBPV
ON IBPV.VERSION = A."VERSION"
AND IBPV.SCENARIO = A."SCENARIO" 
ORDER BY 
A.LOCATION_ID ASC, 
A.PRODUCT_ID ASC, 
A.WEEK_DATE ASC, 
A.CIR_ID ASC)
UNION 
(SELECT DISTINCT
A."LOCATION_ID",
A."PRODUCT_ID",
P."REF_PRODID",
A."WEEK_DATE",
YEAR(A.WEEK_DATE) AS YEAR,
QUARTER(A.WEEK_DATE) AS QUARTER,
MONTH(A.WEEK_DATE) AS MONTH,
A."CIR_ID",
A."MODEL_VERSION",
A."VERSION",
A."SCENARIO",
IBPV.VERSION_NAME,
IBPV.SCENARIO_NAME,
C.RESERVE_FIELD1,
C.RESERVE_FIELD2,
C.RESERVE_FIELD3,
C.RESERVE_FIELD4,
C.RESERVE_FIELD5,
-- A."METHOD",
A."UNIQUE_ID",
A."CIR_QTY",
A."CIR_QTY" AS CIR_QTY_AVG,
B."CHAR_NUM",
E."CHAR_DESC",
E."CHARVAL_DESC",
E."CHAR_NAME",
B."CHARVAL_NUM",
E."CHAR_VALUE",
F."CALENDAR_WEEK",
F."TELESCOPIC_WEEK" AS "PERIODDESC",
T."CIR_QTY_TOT",
CASE
WHEN T.CIR_QTY_TOT <> 0 AND T.CIR_QTY_TOT IS NOT NULL THEN ( ( A.CIR_QTY / T.CIR_QTY_TOT ) * 100 )
ELSE 0
END AS CIR_QTY_PERCENT
FROM 
CP_CIR_GENERATED AS A
INNER JOIN
CP_PARTIALPROD_INTRO AS P
ON A.LOCATION_ID = P.LOCATION_ID
AND A.PRODUCT_ID = P.PRODUCT_ID
INNER JOIN
CP_UNIQUE_ID_ITEM AS B
ON B.UNIQUE_ID = A.UNIQUE_ID
AND 
P.REF_PRODID = B.PRODUCT_ID
INNER JOIN
CP_PRODUCT AS C
ON P.REF_PRODID = C.PRODUCT_ID
INNER JOIN "CP_CHARACTERISTICS" AS CH
    ON CH.CHAR_NUM = B.CHAR_NUM AND CH.CHAR_TYPE ='NUM'
INNER JOIN
V_PRODCLSCHARVAL AS E
ON E.PRODUCT_ID = B.PRODUCT_ID
AND E.CHAR_NUM = B.CHAR_NUM
INNER JOIN "CP_CHARVAL_BUCKET" AS BUCKET 
ON BUCKET.CHAR_NUM = E.CHAR_NUM
   AND B.CHARVAL_NUM LIKE_REGEXPR '^[0-9]+(\\.[0-9]+)?$'
   AND TO_DECIMAL(B.CHARVAL_NUM) 
       BETWEEN BUCKET.RANGE_FROM AND BUCKET.RANGE_TO
INNER JOIN
V_WEEK_DESCRIPTOR AS F
ON F.WEEK_STARTDATE <= A.WEEK_DATE
AND F.WEEK_ENDDATE >= A.WEEK_DATE
LEFT OUTER JOIN
TOTALS AS T
ON T."LOCATION_ID" = A."LOCATION_ID"
AND T."PRODUCT_ID" = A."PRODUCT_ID"
AND T."WEEK_DATE" = A."WEEK_DATE"
AND T."MODEL_VERSION" = A."MODEL_VERSION"
AND T."VERSION" = A."VERSION"
AND T."SCENARIO" = A."SCENARIO"
LEFT OUTER JOIN
CP_IBPVERSIONSCENARIO AS IBPV
ON IBPV.VERSION = A."VERSION"
AND IBPV.SCENARIO = A."SCENARIO" 
ORDER BY 
A.LOCATION_ID ASC, 
A.PRODUCT_ID ASC, 
A.WEEK_DATE ASC, 
A.CIR_ID ASC)