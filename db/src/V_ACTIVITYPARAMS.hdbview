VIEW "V_ACTIVITYPARAMS" AS
SELECT DISTINCT
A.ACTIVITY_ID,
A.PARAMETER_ID,
B.PARAM_DESC,
CASE 
WHEN (A.OPTION_SELECT = 'S') THEN 'Single Selection'
WHEN (A.OPTION_SELECT = 'M') THEN 'Multiple Selection'
WHEN (A.OPTION_SELECT = 'C') THEN 'Checkbox'
WHEN (A.OPTION_SELECT = 'O') THEN 'Dropdown'
WHEN (A.OPTION_SELECT = 'D') THEN 'Date Range'
END AS OPTION_SELECT,
A.MANDATORY
FROM "JS_ACTIVITY_ITEM" AS A
Inner JOIN "JS_ACTIVITY_PARAMETERS" AS B
ON A."PARAMETER_ID" = B."PARAMETER_ID"