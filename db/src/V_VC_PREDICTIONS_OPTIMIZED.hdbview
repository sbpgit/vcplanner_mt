VIEW "V_VC_PREDICTIONS_OPTIMIZED" AS
SELECT CAL_DATE,
  POPT.LOCATION_ID,
  POPT.PRODUCT_ID,
  POPT.MODEL_VERSION,
  POPT."VERSION",
  POPT."SCENARIO",
  ALGORITHM,
  POPT.CHARVAL_NUM,
  PREDICTED_QTY,
  IBP_PLANNED_QTY,
  BTP_REVISED_QTY AS OPTIMIZED_QTY,
  CIRQTY,
  PREDICTED_DEVIATION,
  POST_PREDICTED_DEVIATION AS OPTIMIZED_DEVIATION,
  ABS(100 *(IBP_PLANNED_QTY - CIRQTY) / IBP_PLANNED_QTY) AS CIR_DEVIATION
FROM CP_VC_PREDICTIONS_OPTIMIZED AS POPT
  INNER JOIN V_CIRTOIBP AS CIR
 ON POPT.LOCATION_ID = CIR.LOCATION_ID
  AND POPT.PRODUCT_ID = CIR.PRODUCT_ID
  AND POPT.CAL_DATE = CIR.WEEK_DATE
  AND POPT.MODEL_VERSION = CIR.MODEL_VERSION
  AND POPT.CHARVAL_NUM = CIR.CHARVAL_NUM 
-- WHERE POPT.LOCATION_ID = '1520' AND POPT.PRODUCT_ID IN ('VCP_220')
  AND IBP_PLANNED_QTY != 0
  AND ALGORITHM IN ('LINEAR')
  AND POPT.MODEL_VERSION = 'Active'
ORDER BY CAL_DATE,
  POPT.LOCATION_ID,
  POPT.PRODUCT_ID,
  POPT.MODEL_VERSION,
  POPT."VERSION",
  POPT."SCENARIO",
  ALGORITHM,
  POPT.CHARVAL_NUM;