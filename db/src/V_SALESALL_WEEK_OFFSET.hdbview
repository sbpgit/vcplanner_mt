VIEW "V_SALESALL_WEEK_OFFSET" AS 
SELECT  
	curr."LOCATION_ID",
	curr."PRODUCT_ID",
	 CASE
        WHEN WEEKDAY(ADD_YEARS(WEEK_DATE,1)) = 0 THEN ADD_DAYS((ADD_YEARS(WEEK_DATE,1)), 0)
        WHEN WEEKDAY(ADD_YEARS(WEEK_DATE,1)) = 1 THEN ADD_DAYS(ADD_YEARS(WEEK_DATE,1), -1)
        WHEN WEEKDAY(ADD_YEARS(WEEK_DATE,1)) = 2 THEN ADD_DAYS(ADD_YEARS(WEEK_DATE,1), -2)
        WHEN WEEKDAY(ADD_YEARS(WEEK_DATE,1)) = 3 THEN ADD_DAYS(ADD_YEARS(WEEK_DATE,1), -3)
        WHEN WEEKDAY(ADD_YEARS(WEEK_DATE,1)) = 4 THEN ADD_DAYS(ADD_YEARS(WEEK_DATE,1), -4)
        WHEN WEEKDAY(ADD_YEARS(WEEK_DATE,1)) = 5 THEN ADD_DAYS(ADD_YEARS(WEEK_DATE,1), -5)
        WHEN WEEKDAY(ADD_YEARS(WEEK_DATE,1)) = 6 THEN ADD_DAYS(ADD_YEARS(WEEK_DATE,1), -6)
    END AS "WEEK_DATE",
	-- curr."WEEK_DATE"  as OG_WEEK_DATE,
	curr."PERIODDESC",
	curr."CUSTOMER_GROUP",
	SUM(curr."CONFIRMED_QTY") AS "CURRENT_TOTAL_CONFIRMED_QTY",
	SUM(curr."ORD_QTY") AS "CURRENT_TOTAL_ORD_QTY",
	SUM(curr."CONFIRMED_QTY") AS "OFFSET_TOTAL_CONFIRMED_QTY",
	SUM(curr."ORD_QTY") AS "OFFSET_TOTAL_ORD_QTY"
FROM 
	"V_SALESALL_WEEK" AS curr
GROUP BY 
	curr."LOCATION_ID",
	curr."PRODUCT_ID",
	curr."WEEK_DATE",
	curr."PERIODDESC",
	curr."CUSTOMER_GROUP";
