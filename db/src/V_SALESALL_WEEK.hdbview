VIEW "V_SALESALL_WEEK" AS
SELECT
    "SALES_DOC",
    "SALESDOC_ITEM",
    "REF_PRODID",
    A."PRODUCT_ID",
    "UNIQUE_ID",
    "PRIMARY_ID",
    "DOC_CREATEDDATE",
    "SCHEDULELINE_NUM",
    "REASON_REJ",
    A."UOM",
    "CONFIRMED_QTY",
    "ORD_QTY",
    "MAT_AVAILDATE",
    C.RESERVE_FIELD1,
    C.RESERVE_FIELD2,
    C.RESERVE_FIELD3,
    C.RESERVE_FIELD4,
    C.RESERVE_FIELD5,
    CASE
        WHEN WEEKDAY("MAT_AVAILDATE") = 0 THEN ADD_DAYS("MAT_AVAILDATE", 0)
        WHEN WEEKDAY("MAT_AVAILDATE") = 1 THEN ADD_DAYS("MAT_AVAILDATE", -1)
        WHEN WEEKDAY("MAT_AVAILDATE") = 2 THEN ADD_DAYS("MAT_AVAILDATE", -2)
        WHEN WEEKDAY("MAT_AVAILDATE") = 3 THEN ADD_DAYS("MAT_AVAILDATE", -3)
        WHEN WEEKDAY("MAT_AVAILDATE") = 4 THEN ADD_DAYS("MAT_AVAILDATE", -4)
        WHEN WEEKDAY("MAT_AVAILDATE") = 5 THEN ADD_DAYS("MAT_AVAILDATE", -5)
        WHEN WEEKDAY("MAT_AVAILDATE") = 6 THEN ADD_DAYS("MAT_AVAILDATE", -6)
    END AS "WEEK_DATE",
    YEAR(
        CASE
            WHEN WEEKDAY("MAT_AVAILDATE") = 0 THEN ADD_DAYS("MAT_AVAILDATE", 0)
            WHEN WEEKDAY("MAT_AVAILDATE") = 1 THEN ADD_DAYS("MAT_AVAILDATE", -1)
            WHEN WEEKDAY("MAT_AVAILDATE") = 2 THEN ADD_DAYS("MAT_AVAILDATE", -2)
            WHEN WEEKDAY("MAT_AVAILDATE") = 3 THEN ADD_DAYS("MAT_AVAILDATE", -3)
            WHEN WEEKDAY("MAT_AVAILDATE") = 4 THEN ADD_DAYS("MAT_AVAILDATE", -4)
            WHEN WEEKDAY("MAT_AVAILDATE") = 5 THEN ADD_DAYS("MAT_AVAILDATE", -5)
            WHEN WEEKDAY("MAT_AVAILDATE") = 6 THEN ADD_DAYS("MAT_AVAILDATE", -6)
        END
    ) AS "YEAR",
    QUARTER(
        CASE
            WHEN WEEKDAY("MAT_AVAILDATE") = 0 THEN ADD_DAYS("MAT_AVAILDATE", 0)
            WHEN WEEKDAY("MAT_AVAILDATE") = 1 THEN ADD_DAYS("MAT_AVAILDATE", -1)
            WHEN WEEKDAY("MAT_AVAILDATE") = 2 THEN ADD_DAYS("MAT_AVAILDATE", -2)
            WHEN WEEKDAY("MAT_AVAILDATE") = 3 THEN ADD_DAYS("MAT_AVAILDATE", -3)
            WHEN WEEKDAY("MAT_AVAILDATE") = 4 THEN ADD_DAYS("MAT_AVAILDATE", -4)
            WHEN WEEKDAY("MAT_AVAILDATE") = 5 THEN ADD_DAYS("MAT_AVAILDATE", -5)
            WHEN WEEKDAY("MAT_AVAILDATE") = 6 THEN ADD_DAYS("MAT_AVAILDATE", -6)
        END
    ) AS "QUARTER",
    MONTH(
        CASE
            WHEN WEEKDAY("MAT_AVAILDATE") = 0 THEN ADD_DAYS("MAT_AVAILDATE", 0)
            WHEN WEEKDAY("MAT_AVAILDATE") = 1 THEN ADD_DAYS("MAT_AVAILDATE", -1)
            WHEN WEEKDAY("MAT_AVAILDATE") = 2 THEN ADD_DAYS("MAT_AVAILDATE", -2)
            WHEN WEEKDAY("MAT_AVAILDATE") = 3 THEN ADD_DAYS("MAT_AVAILDATE", -3)
            WHEN WEEKDAY("MAT_AVAILDATE") = 4 THEN ADD_DAYS("MAT_AVAILDATE", -4)
            WHEN WEEKDAY("MAT_AVAILDATE") = 5 THEN ADD_DAYS("MAT_AVAILDATE", -5)
            WHEN WEEKDAY("MAT_AVAILDATE") = 6 THEN ADD_DAYS("MAT_AVAILDATE", -6)
        END
    ) AS "MONTH",
    B.PERIODDESC,
    "NET_VALUE",
    "CUSTOMER_GROUP",
    "LOCATION_ID",
    "SALE_LOCATION",
    "PLAN_LOC",
    "FACTORY_LOC",
    "SEEDORD_CHK",
    "SALES_ORG",
    "DISTR_CHANNEL",
    "DIVISION",
    "SAL_DOCU_TYPE",
    "ITEM_CREATED_DATE",
    "ITEM_CHANGE_DATE",
    "IBP_CUSTOMER",
    "RELEVENT_FOR_PLAN",
    "ON_HAND_STOCK",
    "IN_TRANSIT",
    "SHIP_FROM_LOC",
    "CHANGED_DATE",
    "CHANGED_BY",
    "CREATED_DATE",
    "CREATED_BY",
    "CHANGED_TIME",
    "CREATED_TIME"
FROM "V_SALES_H" AS A
INNER JOIN "CP_IBPCALENDER_WEEK" AS B
ON A.MAT_AVAILDATE >= B.WEEK_STARTDATE AND 
   A.MAT_AVAILDATE <= B.WEEK_ENDDATE
   AND B.LEVEL = 'W'
LEFT OUTER JOIN "CP_PRODUCT" AS C
ON A.PRODUCT_ID = C.PRODUCT_ID
WHERE SEEDORD_CHK IS NULL;
