VIEW "V_RESTRICTION_ANALYTIC_VIEW" AS
SELECT
    A."LOCATION_ID",
    A."RESTRICTION",
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    A."LINE_ID",
    A."WEEK_DATE",
    YEAR(A.WEEK_DATE) AS YEAR,
    QUARTER(A.WEEK_DATE) AS QUARTER,
    MONTH(A.WEEK_DATE) AS MONTH,
    B."RTR_DESC",
    C."PRODID" AS "PRODUCT_ID",
    F."LINE_DESC",
    G."LOCATION_DESC",
    G."PROD_DESC",
    H."PERIODDESC",
    I."VERSION_NAME",
    I."SCENARIO_NAME",
    J."RESERVE_FIELD1",
	J."RESERVE_FIELD2",
	J."RESERVE_FIELD3",
	J."RESERVE_FIELD4",
	J."RESERVE_FIELD5",
    SUM(A."RTR_QTY") AS "PLANNED_QTY",
    SUM(D."RESTRICTIONAVAIL_QTY") AS "RTR_CAP",
    SUM(E."ORD_QTY") AS "ORD_QTY",
    SUM(CASE
            WHEN COALESCE( D."RESTRICTIONAVAIL_QTY", 0 ) - ( COALESCE( A."RTR_QTY", 0 ) + COALESCE( E."ORD_QTY", 0 ) ) < 0 THEN ABS(COALESCE( D."RESTRICTIONAVAIL_QTY", 0 ) - ( COALESCE( A."RTR_QTY", 0 ) + COALESCE( E."ORD_QTY", 0 ) ))
            ELSE 0
        END) AS "DIFF_QTY",
    SUM(CASE
            WHEN COALESCE( A."RTR_QTY", 0 ) - COALESCE( E."ORD_QTY", 0 ) > 0 THEN ABS(COALESCE( A."RTR_QTY", 0 ) - COALESCE( E."ORD_QTY", 0 ))
            ELSE 0
        END) AS "OPEN_RTR_QTY"
FROM
    "V_RTRQTYCONSD" AS A
    INNER JOIN
    "CP_RESTRICT_HEADER" AS B
    ON B."LOCATION_ID" = A."LOCATION_ID"
        AND B."LINE_ID" = A."LINE_ID"
        AND B."RESTRICTION" = A."RESTRICTION"
    INNER JOIN
    "CP_LINECAPACITY" AS C
    ON C."LOCATION_ID" = A."LOCATION_ID"
        AND C."LINE_ID" = A."LINE_ID"
    LEFT OUTER JOIN
    "CP_RESTRICTION_AVAIL" AS D
    ON D."WEEK_DATE" = A."WEEK_DATE"
        AND D."LOCATION_ID" = A."LOCATION_ID"
        AND D."RESTRICTION" = A."RESTRICTION"
    LEFT OUTER JOIN
    "V_SAC_SALESH" AS E
    ON E."LOCATION_ID" = A."LOCATION_ID"
        AND E."PRODUCT_ID" = C."PRODID"
        AND
-- Ensure this is correct as it may cause invalid column errors
        E."WEEK_DATE" = A."WEEK_DATE"
        AND E."ORD_QTY" > 0
        AND (E."UNIQUE_ID" IN (SELECT "UNIQUE_ID"
            FROM "CP_BOM_UID"
            WHERE "LOCATION_ID" = A."LOCATION_ID"
                AND "PRODUCT_ID" = C."PRODID"
                AND "RULE_TYPE" = 'RT'
                AND "ASSEMBLY" = A."RESTRICTION"))
    INNER JOIN
    "CP_LINEMASTER" AS F
    ON F."LOCATION_ID" = A."LOCATION_ID"
        AND F."LINE_ID" = A."LINE_ID"
    INNER JOIN
    "V_LOCPROD" AS G
    ON G."LOCATION_ID" = A."LOCATION_ID"
        AND G."PRODUCT_ID" = C."PRODID"
    INNER JOIN
    "CP_IBPCALENDER_WEEK" AS H
    ON H."WEEK_STARTDATE" <= A."WEEK_DATE"
        AND H."WEEK_ENDDATE" >= A."WEEK_DATE"
    INNER JOIN
    "CP_IBPVERSIONSCENARIO" AS I
    ON I."VERSION" = A."VERSION"
        AND I."SCENARIO" = A."SCENARIO"
    INNER JOIN "CP_PRODUCT" AS J
    ON C."PRODID" = J.PRODUCT_ID
GROUP BY
    A."WEEK_DATE",
    A."LOCATION_ID",
    A."LINE_ID",
    F."LINE_DESC",
    A."RESTRICTION",
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    B."RTR_DESC",
    C."PRODID",
    G."LOCATION_DESC",
    G."PROD_DESC",
    H."PERIODDESC",
    I."VERSION_NAME",
    I."SCENARIO_NAME",
    J."RESERVE_FIELD1",
	J."RESERVE_FIELD2",
	J."RESERVE_FIELD3",
	J."RESERVE_FIELD4",
	J."RESERVE_FIELD5";