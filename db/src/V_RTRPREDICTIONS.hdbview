VIEW V_RTRPREDICTIONS AS
SELECT 
  "LOCATION_ID",
  "PRODUCT_ID",
  "OBJ_DEP",
  MODEL_VERSION,
  VERSION,
  SCENARIO,
  CAL_DATE,
  MAX(PREDICTED) AS PREDICTED
FROM CP_TS_PREDICTIONS
WHERE OBJ_TYPE = 'RT'
GROUP BY "LOCATION_ID",
  "PRODUCT_ID",
  "OBJ_DEP",
  MODEL_VERSION,
  VERSION,
  SCENARIO,
  CAL_DATE;