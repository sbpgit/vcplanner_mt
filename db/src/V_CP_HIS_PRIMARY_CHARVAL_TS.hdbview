VIEW V_CP_HIS_PRIMARY_CHARVAL_TS AS
SELECT DISTINCT 
ADD_DAYS(
		ADD_DAYS(
			TO_DATE( '01/01/' || substr( "PERIOD_NUM", 1, 4 ), 'DD/MM/YYYY' ), 
			- (WEEKDAY(TO_DATE( '01/01/' || substr( "PERIOD_NUM", 1, 4 ), 'DD/MM/YYYY' )))
		), 
		(substr( "PERIOD_NUM", 5, 2 ) - 1 ) * 7
	) AS CAL_DATE, 
VCH.LOCATION_ID, 
VCH.PRODUCT_ID, 
TYPE, 
GROUP_ID, 
"ROW", 
ATTRIBUTE, 
VCH.CHAR_NUM,
CHARVAL_NUM, 
CHAR_NAME, 
CHAR_VALUE, 
CHAR_COUNT, 
CHAR_COUNT_RATE, 
GROUP_COUNT, 
GROUP_COUNT_RATE, 
CASE WHEN GROUP_COUNT_RATE!= 0 THEN ROUND(100*(GROUP_COUNT/GROUP_COUNT_RATE), 0) ELSE 0 END AS ORDER_COUNT FROM  
CP_VC_HISTORY_TS VCH 
LEFT JOIN V_HIS_M2_TS_SALESDOC AS TSS ON
VCH.LOCATION_ID = TSS.LOCATION_ID
AND VCH.PRODUCT_ID = TSS.PRODUCT_ID
AND  VCH.GROUP_ID LIKE_REGEXPR TSS.PRIMARY_ID 
AND VCH."ROW" = TSS.SEQUENCE
ORDER BY CAL_DATE, VCH.LOCATION_ID, VCH.PRODUCT_ID, VCH.GROUP_ID, VCH."ROW";