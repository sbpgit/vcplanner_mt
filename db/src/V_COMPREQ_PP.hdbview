-- Name: V_COMPREQ_PP
-- Description: Fetch Comp req at Partial product level
VIEW "V_COMPREQ_PP" AS
SELECT 
	V_ASMREQ_PP.WEEK_DATE,
	V_ASMREQ_PP.FACTORY_LOC,
    V_ASMREQ_PP.PRODUCT_ID,
	CP_ASSEMBLY_COMP.COMPONENT,
	V_ASMREQ_PP.VERSION,
	V_ASMREQ_PP.SCENARIO,
	V_ASMREQ_PP.MODEL_VERSION,
	CP_ASSEMBLY_COMP.COMP_DESC,
	SUM(CASE
			WHEN ( V_ASMREQ_PP.COMP_QTY * CP_ASSEMBLY_COMP.COMP_QTY ) > 0 THEN ROUND( ( V_ASMREQ_PP.COMP_QTY * CP_ASSEMBLY_COMP.COMP_QTY ), 0 )
			ELSE 0
		END) AS COMP_QTY
FROM 
	"V_ASMREQ_PP"
	INNER JOIN
	CP_ASSEMBLY_COMP
	ON V_ASMREQ_PP.FACTORY_LOC = CP_ASSEMBLY_COMP.LOCATION_ID
		AND V_ASMREQ_PP.ASSEMBLY = CP_ASSEMBLY_COMP.ASSEMBLY
WHERE 
    --   VP-528 Change Begin
	V_ASMREQ_PP.WEEK_DATE >= CP_ASSEMBLY_COMP.VALID_FROM
	AND V_ASMREQ_PP.WEEK_DATE <= CP_ASSEMBLY_COMP.VALID_TO
    --   VP-528 Change End
GROUP BY 
	V_ASMREQ_PP.WEEK_DATE,
	V_ASMREQ_PP.FACTORY_LOC,
    V_ASMREQ_PP.PRODUCT_ID,
	CP_ASSEMBLY_COMP.COMPONENT,
	V_ASMREQ_PP.VERSION,
	V_ASMREQ_PP.SCENARIO,
	V_ASMREQ_PP.MODEL_VERSION,
	CP_ASSEMBLY_COMP.COMP_DESC;