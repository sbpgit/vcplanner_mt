VIEW "V_COMPONENT_REQ" AS
SELECT LOCATION_ID,
  PRODUCT_ID,
  WEEK_DATE,
  FACTORY_LOC,
  VERSION,
  SCENARIO,
  "ASSEMBLY",
  COMPONENT,
  MODEL_VERSION,
  IBP_DEMAND,
  ASMB_DESC,
  COMP_DESC,
  STRUC_NODE,
  SUM(ASM_COM_QTY) AS ASM_COM_QTY,
  SUM(COMP_QTY) AS COMP_QTY,
  SUM(ROW_COUNT) AS ROW_COUNT,
  AVG(ASSEM_QTY)  AS ACT_ASSEM_QTY
FROM "V_COMPONENT_REQ2"
GROUP BY LOCATION_ID,
PRODUCT_ID,
WEEK_DATE,
FACTORY_LOC,
VERSION,
SCENARIO,
"ASSEMBLY",
COMPONENT,
COMP_DESC,
MODEL_VERSION,
IBP_DEMAND,
ASMB_DESC,
STRUC_NODE