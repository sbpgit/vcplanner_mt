VIEW "V_PRODCONFIGAPI_UPDATED" AS 
SELECT DISTINCT 
	V_IBP_SALESHCONFIG_VC."LOCATION_ID",
	CP_LOCATION."LOCATION_DESC",
	V_IBP_SALESHCONFIG_VC."PRODUCT_ID",
	V_PARTIALPRODCHAR."PROD_DESC",
	V_PARTIALPRODCHAR."PROD_TYPE",
	V_IBP_SALESHCONFIG_VC."CUSTOMER_GROUP",	
	V_IBP_SALESHCONFIG_VC."CLASS_NUM",
	V_IBP_SALESHCONFIG_VC."CHAR_NUM",
	V_IBP_SALESHCONFIG_VC."CHARVAL_NUM",
	CP_PARTIALPROD_CHAR_VALIDITY."VALID_FROM",
	CP_PARTIALPROD_CHAR_VALIDITY."VALID_TO",
	V_IBP_SALESHCONFIG_VC."IBPCHAR_CHK",
	V_CLASSCHARVAL."CLASS_NAME",
	V_CLASSCHARVAL."CLASS_DESC",
	V_CLASSCHARVAL."CHAR_NAME",
	V_CLASSCHARVAL."CHAR_DESC",
	V_CLASSCHARVAL."CHAR_VALUE",
	V_CLASSCHARVAL."CHARVAL_DESC",
	V_CLASSCHARVAL."REF_CHAR_NUM",
	V_CLASSCHARVAL."REF_CHAR_NAME",
	V_CLASSCHARVAL."REF_CHAR_DESC",
	V_CLASSCHARVAL."REF_CHARVAL_NUM",
	V_CLASSCHARVAL."REF_CHAR_VALUE",
	V_CLASSCHARVAL."GENFLAG"
FROM 
	V_IBP_SALESHCONFIG_VC
	INNER JOIN V_CLASSCHARVAL
	ON 	V_IBP_SALESHCONFIG_VC.CLASS_NUM = V_CLASSCHARVAL.CLASS_NUM
 	    AND V_IBP_SALESHCONFIG_VC.CHAR_NUM = V_CLASSCHARVAL.CHAR_NUM
	    AND V_IBP_SALESHCONFIG_VC.CHARVAL_NUM = V_CLASSCHARVAL.CHARVAL_NUM
	INNER JOIN
	CP_PARTIALPROD_CHAR_VALIDITY
	ON V_IBP_SALESHCONFIG_VC.PRODUCT_ID = CP_PARTIALPROD_CHAR_VALIDITY.PRODUCT_ID
		AND V_IBP_SALESHCONFIG_VC.CLASS_NUM = CP_PARTIALPROD_CHAR_VALIDITY.CLASS_NUM
		AND V_IBP_SALESHCONFIG_VC.CHAR_NUM = CP_PARTIALPROD_CHAR_VALIDITY.CHAR_NUM
		AND V_IBP_SALESHCONFIG_VC.CHARVAL_NUM = CP_PARTIALPROD_CHAR_VALIDITY.CHARVAL_NUM
	INNER JOIN 	CP_LOCATION
	ON V_IBP_SALESHCONFIG_VC.LOCATION_ID = CP_LOCATION.LOCATION_ID
	INNER JOIN V_PARTIALPRODCHAR
       ON V_PARTIALPRODCHAR.LOCATION_ID = V_IBP_SALESHCONFIG_VC.LOCATION_ID
	  AND V_PARTIALPRODCHAR.PRODUCT_ID = V_IBP_SALESHCONFIG_VC.PRODUCT_ID
	ORDER BY 
	V_IBP_SALESHCONFIG_VC."LOCATION_ID" ASC, 
	V_IBP_SALESHCONFIG_VC."PRODUCT_ID" ASC, 
	V_IBP_SALESHCONFIG_VC."CUSTOMER_GROUP" ASC, 
	V_IBP_SALESHCONFIG_VC."CLASS_NUM" ASC, 
	V_IBP_SALESHCONFIG_VC."CHAR_NUM" ASC, 
	V_IBP_SALESHCONFIG_VC."CHARVAL_NUM" ASC;
