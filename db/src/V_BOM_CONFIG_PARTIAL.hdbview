VIEW V_BOM_CONFIG_PARTIAL AS
SELECT DISTINCT 
	B.LOCATION_ID,
	B.FACTORY_LOC,
	C.REF_PRODID,
	C.PRODUCT_ID,
	A.ITEM_NUM,
	A.COMPONENT,
	A.OBJ_DEP,
	A.OBJDEP_DESC,
	A.COMP_QTY,
	A.VALID_FROM,
	A.VALID_TO
FROM 
	"CP_BOM_OBJDEPENDENCY" AS A
	INNER JOIN
	"CP_FACTORY_SALESLOC" AS B
	ON A.LOCATION_ID = B.FACTORY_LOC
	INNER JOIN
	CP_PARTIALPROD_INTRO AS C
	ON B.LOCATION_ID = C.LOCATION_ID
		AND A.PRODUCT_ID = C.REF_PRODID
ORDER BY C.PRODUCT_ID ASC;