COLUMN TABLE "T_DERIVATION_PATHS" (
    "PATH_ID"        BIGINT       NOT NULL,
    "SOURCE_CHAR"    NVARCHAR(50) NOT NULL,
    "SOURCE_VALUE"   NVARCHAR(50) NOT NULL,
    "TARGET_CHAR"    NVARCHAR(50) NOT NULL,
    "TARGET_VALUE"   NVARCHAR(50) NOT NULL,
    "PATH_LENGTH"    INTEGER      NOT NULL DEFAULT 1,
    "PATH_NODES"     NVARCHAR(2000),         -- JSON array of vertexIds
    "RULE_CHAIN"     NVARCHAR(2000),         -- JSON array of ruleIds
    "TOPO_SEQUENCE"  NVARCHAR(500),          -- comma-separated topo positions
    "COMPUTED_AT"    TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY ("PATH_ID")
);
