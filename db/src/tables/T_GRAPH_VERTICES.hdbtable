COLUMN TABLE "T_GRAPH_VERTICES" (
  "VERTEX_ID"    NVARCHAR(50)  NOT NULL,
  "CHAR_KEY"     NVARCHAR(50)  NOT NULL,
  "VALUE_CODE"   NVARCHAR(50)  NOT NULL,
  "CHAR_TYPE"    NVARCHAR(10)  NOT NULL,
  "DERIVE_LEVEL" INTEGER       DEFAULT 0,
  "LABEL"        NVARCHAR(150),
  "TOPO_ORDER"   INTEGER       DEFAULT NULL,
  PRIMARY KEY ("VERTEX_ID")
);