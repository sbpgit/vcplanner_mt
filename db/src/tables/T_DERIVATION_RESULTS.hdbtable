COLUMN TABLE "T_DERIVATION_RESULTS" (
  "RESULT_ID"    BIGINT        NOT NULL,
  "SESSION_ID"   NVARCHAR(36)  NOT NULL,
  "CHAR_KEY"     NVARCHAR(50)  NOT NULL,
  "VALUE_CODE"   NVARCHAR(50),
  "PROBABILITY"  DOUBLE, --DECIMAL(15,10),
  "RULECHAIN"    NVARCHAR(2000),
  "DERIVE_LEVEL" INTEGER,
  "STATUS"       NVARCHAR(15),
  "COMPUTED_AT"  TIMESTAMP     DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY ("RESULT_ID")
);
