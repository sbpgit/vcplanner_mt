VIEW "V_CHARBASE_PLAN" AS
SELECT A.LOCATION_ID,
  A.PRODUCT_ID,
  A.CLASS_NUM,
  A.CHAR_NUM,
  A.CHARVAL_NUM,
  B.LOCATION_DESC,
  B.PROD_DESC,
  C.CLASS_DESC,
  C.CHAR_DESC,
  C.CHARVAL_DESC
FROM "V_IBP_SALESHCONFIG_VC" AS A
  LEFT OUTER JOIN "V_LOCPRODDATA" AS B
 ON A.LOCATION_ID = B.LOCATION_ID
  AND A.PRODUCT_ID = B.PRODUCT_ID
  LEFT OUTER JOIN "V_CLASSCHARVAL" AS C
 ON A.CLASS_NUM = C.CLASS_NUM
  AND A.CHAR_NUM = C.CHAR_NUM
  AND A.CHARVAL_NUM = C.CHARVAL_NUM