-- VIEW "V_OBJECTDEPCHARDESC"
-- AS SELECT DISTINCT
-- A.CAL_DATE,
-- A.LOCATION_ID,
-- A.PRODUCT_ID,
-- A.OBJ_TYPE,
-- A.OBJ_DEP,
-- A.OBJ_COUNTER,
-- A.ROW_ID,
-- A.VERSION,
-- A.SCENARIO,
-- A.CHAR_NUM,
-- A.SUCCESS,
-- A.SUCCESS_RATE,
-- B.CHAR_DESC,
-- B.CHAR_VALUE,
-- B.CHARVAL_DESC
-- FROM "CP_TS_OBJDEP_CHARHDR_F" AS A 
-- LEFT OUTER JOIN
-- "V_UNIQUE_ID_ITEM" AS B
-- ON
-- A.CHAR_NUM = B.CHAR_NUM 
-- AND
-- A.OBJ_DEP = CAST(B.UNIQUE_ID AS VARCHAR);

VIEW "V_OBJECTDEPCHARDESC"
AS SELECT DISTINCT
A.CAL_DATE,
A.LOCATION_ID,
A.PRODUCT_ID,
A.OBJ_TYPE,
A.OBJ_DEP,
A.OBJ_COUNTER,
A.ROW_ID,
A.VERSION,
A.SCENARIO,
A.CHAR_NUM,
A.SUCCESS,
A.SUCCESS_RATE,
(SELECT MAX(V_UNIQUE_ID_ITEM.CHAR_VALUE) FROM "V_UNIQUE_ID_ITEM"
WHERE A.OBJ_DEP = CAST(V_UNIQUE_ID_ITEM.UNIQUE_ID AS VARCHAR)) AS CHAR_VALUE,
(SELECT MAX(CP_CHARACTERISTICS.CHAR_DESC) FROM "CP_CHARACTERISTICS"
WHERE A.CHAR_NUM = CP_CHARACTERISTICS.CHAR_NUM ) AS CHAR_DESC,
(SELECT MAX(CP_CHAR_VALUES.CHARVAL_DESC) FROM "CP_CHAR_VALUES"
WHERE A.CHAR_NUM = CP_CHAR_VALUES.CHAR_NUM AND CP_CHAR_VALUES.CHAR_VALUE =  (SELECT MAX(V_UNIQUE_ID_ITEM.CHAR_VALUE) FROM "V_UNIQUE_ID_ITEM"
WHERE A.OBJ_DEP = CAST(V_UNIQUE_ID_ITEM.UNIQUE_ID AS VARCHAR))
) AS CHARVAL_DESC

FROM "CP_TS_OBJDEP_CHARHDR_F" AS A 