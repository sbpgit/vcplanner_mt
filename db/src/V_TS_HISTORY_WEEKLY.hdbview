VIEW V_TS_HISTORY_WEEKLY as 
SELECT CP_PARTIALPROD_INTRO.PRODUCT_ID,
	   CP_PARTIALPROD_INTRO.LOCATION_ID,
	   CP_VARCHAR_PS.CHAR_NUM,
	   ADD_DAYS(
		ADD_DAYS(
			TO_DATE( '01/01/' || substr( "PERIOD_NUM", 1, 4 ), 'DD/MM/YYYY' ), 
			- (WEEKDAY(TO_DATE( '01/01/' || substr( "PERIOD_NUM", 1, 4 ), 'DD/MM/YYYY' )))
		), 
		(substr( "PERIOD_NUM", 5, 2 ) - 1 ) * 7
	) AS CAL_DATE, 
	   CP_VC_HISTORY_TS.PERIOD_NUM,
	   CP_VC_HISTORY_TS.TYPE,
	   CP_VC_HISTORY_TS.GROUP_ID,
	   CP_VC_HISTORY_TS."ROW",
	   CP_VC_HISTORY_TS.ATTRIBUTE,
	   CP_VC_HISTORY_TS.CHAR_COUNT,
	   CP_VC_HISTORY_TS.CHAR_COUNT_RATE,
	   CP_VC_HISTORY_TS.GROUP_COUNT,
	   CP_VC_HISTORY_TS.GROUP_COUNT_RATE,
	   V_UNIQUE_ID.CHAR_VALUE
from CP_PARTIALPROD_INTRO
join CP_VARCHAR_PS
on CP_PARTIALPROD_INTRO.REF_PRODID = CP_VARCHAR_PS.PRODUCT_ID
and CP_VARCHAR_PS.CHAR_TYPE = 'P'
JOIN CP_VC_HISTORY_TS
ON CP_VC_HISTORY_TS.LOCATION_ID = CP_PARTIALPROD_INTRO.LOCATION_ID
AND CP_VC_HISTORY_TS.PRODUCT_ID = CP_PARTIALPROD_INTRO.PRODUCT_ID
AND CP_VC_HISTORY_TS.CHAR_NUM = CP_VARCHAR_PS.CHAR_NUM
left outer JOIN V_UNIQUE_ID
ON V_UNIQUE_ID.UNIQUE_ID = SUBSTRING(CP_VC_HISTORY_TS.GROUP_ID, 1, LENGTH(CP_VC_HISTORY_TS.GROUP_ID) - 2 ) 
AND V_UNIQUE_ID.PRODUCT_ID = CP_PARTIALPROD_INTRO.REF_PRODID
and V_UNIQUE_ID.CHAR_NUM = CP_VC_HISTORY_TS.CHAR_NUM
and v_unique_id.uid_type = 'P' ORDER BY
CAL_DATE,CP_VC_HISTORY_TS.LOCATION_ID,CP_VC_HISTORY_TS.PRODUCT_ID,CP_VC_HISTORY_TS.GROUP_ID,CP_VC_HISTORY_TS."ROW";