VIEW "V_TELESCOPIC_PLAN" AS
( 		(WITH "PRODEMAND" AS
		(
					SELECT 
				FD."LOCATION_ID",
				FD."PRODUCT_ID",
				FD."CUSTOMER_GROUP",
				FD.VERSION,
				FD."SCENARIO",
				B.TELESCOPIC_WEEK,
				SUM(FD.QUANTITY) AS QUANTITY
			FROM 
				"CP_IBP_FUTUREDEMAND_LOCPRODCUST" AS FD
				LEFT OUTER JOIN
				"V_WEEK_DESCRIPTOR" AS B
				ON FD."WEEK_DATE" >= B."WEEK_STARTDATE"
					AND FD."WEEK_DATE" <= B."WEEK_ENDDATE"
			GROUP BY 
				FD."LOCATION_ID",
				FD."PRODUCT_ID",
				FD."CUSTOMER_GROUP",
				FD.VERSION,
				FD."SCENARIO",
				B.TELESCOPIC_WEEK
		)
		SELECT 
			A."LOCATION_ID",
			A."PRODUCT_ID",
			A."CUSTOMER_GROUP",
			"MODEL_VERSION",
			"CHAR_NUM",
			"CHARVAL_NUM",
			A."VERSION",
			A."SCENARIO",
			"TYPE",
			CASE
				WHEN A.TYPE = 1 THEN AVG(A.OPT_PERCENT)
				WHEN ROUND( ( sum(A.OPT_QTY) / NULLIF( max(FD.QUANTITY), 0 ) ) * 100, 2 ) IS NULL THEN 0
				ELSE ROUND( ( sum(A.OPT_QTY) / NULLIF( max(FD.QUANTITY), 0 ) ) * 100, 2 )
			END AS OPT_PERCENT,
			sum(-- ROUND(AVG("OPT_PERCENT"),2) AS OPT_PERCENT,
			--- OPT_PERCENT As diff,
			A."OPT_QTY") AS "OPT_QTY",
			(FD.QUANTITY),
			"CHAR_DESC",
			"CHAR_NAME",
			"CHAR_TYPE",
			"CHARVAL_DESC",
			"VERSION_NAME",
			"SCENARIO_NAME",
			"LOCATION_DESC",
			"PROD_DESC",
			"KEY_FIG_ID",
			"KEY_FIG_DESC",
			"DISPLAY_ORDER",
			"PRIORITY_ORDER",
			A."TELESCOPIC_WEEK",
			"PERIODSTART",
			"PERIODEND"
		FROM 
			V_FINAL_OPTION_PLAN AS A
			LEFT OUTER JOIN
			PRODEMAND AS FD
			ON FD."LOCATION_ID" = A."LOCATION_ID"
				AND FD."PRODUCT_ID" = A."PRODUCT_ID"
				AND (FD."CUSTOMER_GROUP" = A."CUSTOMER_GROUP"
					OR A."CUSTOMER_GROUP" IS NULL)
				AND FD."VERSION" = A."VERSION"
				AND FD."SCENARIO" = A."SCENARIO"
				AND FD."TELESCOPIC_WEEK" = A."TELESCOPIC_WEEK"
		GROUP BY 
			A."LOCATION_ID",
			A."PRODUCT_ID",
			A."CUSTOMER_GROUP",
			"MODEL_VERSION",
			"CHAR_NUM",
			"CHARVAL_NUM",
			A."VERSION",
			A."SCENARIO",
			-- A.OPT_QTY ,
			FD.QUANTITY,
			"TYPE",
			"CHAR_DESC",
			"CHAR_NAME",
			"CHAR_TYPE",
			"CHARVAL_DESC",
			"VERSION_NAME",
			"SCENARIO_NAME",
			"LOCATION_DESC",
			"PROD_DESC",
			"KEY_FIG_ID",
			"KEY_FIG_DESC",
			"DISPLAY_ORDER",
			"PRIORITY_ORDER",
			A."TELESCOPIC_WEEK",
			"PERIODSTART",
			"PERIODEND"
		ORDER BY 
			A."LOCATION_ID" ASC, 
			A."PRODUCT_ID" ASC, 
			A."CUSTOMER_GROUP" ASC, 
			A.CHAR_NUM ASC, 
			"PERIODSTART" ASC) )