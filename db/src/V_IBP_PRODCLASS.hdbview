VIEW "V_IBP_PRODCLASS"
AS SELECT A."PRODUCT_ID",
A."CLASS_NUM",
B."CLASS_NAME",
B."CLASS_TYPE",
B."CLASS_DESC",
B."IBPCHAR_CHK",
C."PROD_DESC",
B."CHANGED_BY",
B."CHANGED_DATE",
B."CHANGED_TIME"
FROM "CP_PRODUCT_CLASS" AS A
INNER JOIN "CP_CLASS" AS B
ON A.CLASS_NUM = B.CLASS_NUM
INNER JOIN "CP_PARTIALPROD_INTRO" AS C
ON A.PRODUCT_ID = C.REF_PRODID
WHERE B."CLASS_TYPE" != '200'