VIEW "V_LOC_CONFIG_PROD_TYPE" AS 
SELECT DISTINCT P.LOCATION_ID,P.PRODUCT_ID,COALESCE(P.PROD_TYPE, '') AS PROD_TYPE,COALESCE(LOC_PROD.MRP_GROUP, '') AS MRP_GROUP FROM "CP_PARTIALPROD_INTRO" AS P
LEFT OUTER JOIN "CP_LOCATION_PRODUCT" AS LOC_PROD
ON P.LOCATION_ID = LOC_PROD.LOCATION_ID AND P.PRODUCT_ID = LOC_PROD.PRODUCT_ID