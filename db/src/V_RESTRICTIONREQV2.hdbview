VIEW V_RESTRICTIONREQV2 AS
SELECT 
	A."WEEK_DATE",
	A."LOCATION_ID",
	E."LOCATION_DESC",
	A."PRODUCT_ID",
	F."PROD_DESC",
	D."FACTORY_LOC",
	B."LINE_ID",
	B."RESTRICTION",
	A."MODEL_VERSION",
	A."VERSION",
	A."SCENARIO",
	SUM(A.COMPCIR_QTY) AS RTR_QTY
FROM 
	CP_ASSEMBLY_REQ AS A
	INNER JOIN
	CP_FACTORY_SALESLOC AS D
	ON A.LOCATION_ID = D.LOCATION_ID
		AND A.PRODUCT_ID = D.PRODUCT_ID
	INNER JOIN
	V_LOCPRODLINERTR AS B
	ON D."FACTORY_LOC" = B."FACTORY_LOC"
		AND A."REF_PRODID" = B."PRODUCT_ID"
		AND A."COMPONENT" = B."RESTRICTION"
		INNER JOIN
		CP_LOCATION as E
		ON E."LOCATION_ID" = A."LOCATION_ID"
		INNER JOIN
		CP_PARTIALPROD_INTRO as F
		ON F."LOCATION_ID" = A."LOCATION_ID"
		AND F."PRODUCT_ID" = A."PRODUCT_ID"
WHERE A.WEEK_DATE >= B.VALID_FROM
	AND A.WEEK_DATE <= B.VALID_TO
	
GROUP BY 
	A."WEEK_DATE",
	A."LOCATION_ID",
	E."LOCATION_DESC",
	D."FACTORY_LOC",
	B."LINE_ID",
	A."PRODUCT_ID",
	F."PROD_DESC",
	B."RESTRICTION",
	A."MODEL_VERSION",
	A."VERSION",
	A."SCENARIO";
	
