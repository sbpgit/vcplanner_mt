VIEW "V_OPTIMIZEDFILTERS"
AS SELECT
DISTINCT
A."LOCATION_ID",
B."LOCATION_DESC",
A."PRODUCT_ID",
C."PROD_DESC",
A."ALGORITHM",
A."MODEL_VERSION",
A."CAL_DATE",
A."VERSION",
A."SCENARIO",
A."CHARVAL_NUM"
FROM "V_OPTIMIZEDPREDICTIONS" AS A
INNER JOIN "CP_LOCATION" AS B
ON A.LOCATION_ID = B.LOCATION_ID
INNER JOIN "CP_PARTIALPROD_INTRO" AS C
ON A.PRODUCT_ID = C.PRODUCT_ID
GROUP BY
A.LOCATION_ID,
B.LOCATION_DESC,
A.PRODUCT_ID,
C.PROD_DESC,
A.ALGORITHM,
A.MODEL_VERSION,
A.CAL_DATE,
A.VERSION,
A.SCENARIO,
A.CHARVAL_NUM;