VIEW V_HIS_M2_SHBY_PRIMARY AS
SELECT DISTINCT 
SH.SALES_DOC,  
SH.MAT_AVAILDATE AS CAL_DATE , 
SH.PLAN_LOC  AS LOCATION_ID, 
SH.PRODUCT_ID, 
SH.REF_PRODID, 
SH.UNIQUE_ID,
SH.PRIMARY_ID, 
SHCFG.CHAR_NAME, 
SHCFG.CHAR_VALUE, 
CHVAL.CHAR_NUM, 
CHVAL.CHARVAL_NUM, 
SH.ORD_QTY 
FROM V_SALES_H AS SH 
INNER JOIN V_SALESHCFG_CHARVAL AS SHCFG ON 
SH.SALES_DOC = SHCFG.SALES_DOC
INNER JOIN V_CHARVAL AS CHVAL ON
SHCFG.CHAR_NAME = CHVAL.CHAR_NAME
AND SHCFG.CHAR_VALUE = CHVAL.CHAR_VALUE
INNER JOIN CP_PRODUCT_CLASS AS CP_PCL ON
SH.REF_PRODID = CP_PCL.PRODUCT_ID 
AND CHVAL.CLASS_NUM = CP_PCL.CLASS_NUM
-- WHERE SH.PLAN_LOC = 'PLSE' AND SH.PRODUCT_ID = '000000000000000055' 
ORDER BY SH.SALES_DOC,  SH.MAT_AVAILDATE, SH.PLAN_LOC, SH.PRODUCT_ID, SH.UNIQUE_ID, SH.PRIMARY_ID, CHAR_NUM, CHARVAL_NUM;
