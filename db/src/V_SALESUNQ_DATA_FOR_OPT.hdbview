VIEW "V_SALESUNQ_DATA_FOR_OPT" AS
    SELECT 
      A.REF_PRODID,
      A.PRODUCT_ID,
      A.CONFIRMED_QTY,
      A.ORD_QTY,
      A.WEEK_DATE,
      A.CUSTOMER_GROUP,
      A.LOCATION_ID,
      C.CHAR_NUM,
      C.CHARVAL_NUM,  
      C.CHAR_VALUE,
      (SELECT DISTINCT MAX(CP_CHARACTERISTICS.CLASS_NUM) FROM CP_CHARACTERISTICS
  	WHERE CP_CHARACTERISTICS.CHAR_NUM = C.CHAR_NUM 
  ) AS CLASS_NUM,
  A.SEEDORD_CHK
    FROM "V_SALESALL_WEEK" AS A
    INNER JOIN "CP_UNIQUE_ID_ITEM" AS C ON C.UNIQUE_ID = A.UNIQUE_ID AND C.PRODUCT_ID = A.REF_PRODID;