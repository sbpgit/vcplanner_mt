----------------------------------------------------------------------------------------
-- Name:            V_BOMCRITICALCOMP
-- Description:     View to fetch BOM object dependecy with counter
-- Join Details:    CP_CRITICAL_COMP -  TABLE for critical component
--                  V_BOM_DEMDFACLOC - Table for BOM object Dep.
-----------------------------------------------------------------------------------------
VIEW "V_BOMCRITICALCOMP"
AS SELECT V_GETASSEMBLY.LOCATION_ID,
V_GETASSEMBLY.PRODUCT_ID,
V_GETASSEMBLY.ITEM_NUM,
V_GETASSEMBLY.ASSEMBLY,
V_GETASSEMBLY.COMPONENT,
V_GETASSEMBLY.COMP_DESC,
V_GETASSEMBLY.VALID_FROM,
V_GETASSEMBLY.VALID_TO,
CP_CRITICAL_COMP.CRITICALKEY
 FROM V_GETASSEMBLY
 LEFT OUTER JOIN CP_CRITICAL_COMP 
 ON V_GETASSEMBLY.LOCATION_ID = CP_CRITICAL_COMP.LOCATION_ID
   AND V_GETASSEMBLY.PRODUCT_ID = CP_CRITICAL_COMP.PRODUCT_ID
   AND V_GETASSEMBLY.ITEM_NUM = CP_CRITICAL_COMP.ITEM_NUM
   AND V_GETASSEMBLY.ASSEMBLY = CP_CRITICAL_COMP.ASSEMBLY
   AND V_GETASSEMBLY.COMPONENT = CP_CRITICAL_COMP.COMPONENT





