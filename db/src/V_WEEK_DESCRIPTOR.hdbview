VIEW "V_WEEK_DESCRIPTOR" AS 
SELECT 
 B.PERIODSTART,
 B.PERIODEND,
 A.WEEK_STARTDATE,
 A.WEEK_ENDDATE,
A.PERIODDESC  AS CALENDAR_WEEK,
COALESCE( B.PERIODDESC, A.PERIODDESC ) AS TELESCOPIC_WEEK
FROM 
 CP_IBPCALENDER_WEEK AS A
 LEFT OUTER JOIN
 CP_TELESCOPIC_PERIODS AS B
 ON (A.WEEK_STARTDATE >= B.PERIODSTART
  AND A.WEEK_STARTDATE <= B.PERIODEND) 
 WHERE A.LEVEL = 'W'
 ORDER BY
 A.WEEK_STARTDATE ASC,
 B.PERIODSTART ASC;