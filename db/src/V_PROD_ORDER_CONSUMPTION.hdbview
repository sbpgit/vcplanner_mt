VIEW "V_PROD_ORDER_CONSUMPTION"
AS SELECT DISTINCT
CP_PROD_ORD_CONSUMPTION.REF_PRODID,
CP_PROD_ORD_CONSUMPTION.LOCATION_ID,
LTRIM(CP_PROD_ORD_CONSUMPTION.SALES_DOC, '0') AS SALES_DOC,
LTRIM(CP_PROD_ORD_CONSUMPTION.SALESDOC_ITEM, '0') AS SALESDOC_ITEM,
-- LTRIM(CP_PROD_ORD_CONSUMPTION.PROD_ORDER, '0') AS PROD_ORDER,
CP_PROD_ORD_CONSUMPTION.COMPONENT,
CP_PROD_ORD_CONSUMPTION.COMP_LOC as MANU_LOC,
CP_PROD_ORD_CONSUMPTION.MAT_PARENT,
CP_PROD_ORD_CONSUMPTION.PARENT_LOC,
CP_PROD_ORD_CONSUMPTION.COMP_PROCURE_TYPE,
CP_PROD_ORD_CONSUMPTION.COMP_QTY,
-- CP_PROD_ORD_CONSUMPTION.ORD_TYPE,
ADD_DAYS (TO_DATE ("WEEK_DATE", 'YYYY-MM-DD') , -WEEKDAY (TO_DATE ("WEEK_DATE", 'YYYY-MM-DD'))) AS WEEK_DATE,
CP_SALES_HM.UNIQUE_ID,
V_LOCPROD.LOCATION_DESC,
V_LOCPROD.PROD_DESC
FROM CP_PROD_ORD_CONSUMPTION
INNER JOIN CP_SALES_HM ON LTRIM(CP_PROD_ORD_CONSUMPTION.SALES_DOC, '0') = LTRIM(CP_SALES_HM.SALES_DOC, '0') AND LTRIM(CP_PROD_ORD_CONSUMPTION.SALESDOC_ITEM, '0') = LTRIM(CP_SALES_HM.SALESDOC_ITEM, '0') 
LEFT OUTER JOIN V_LOCPROD
    ON CP_PROD_ORD_CONSUMPTION.LOCATION_ID = V_LOCPROD.LOCATION_ID
    AND CP_PROD_ORD_CONSUMPTION.REF_PRODID = V_LOCPROD.PRODUCT_ID;
 