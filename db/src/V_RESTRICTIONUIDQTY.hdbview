VIEW "V_RESTRICTIONUIDQTY" AS
SELECT A.WEEK_DATE,
  A.LOCATION_ID,
  A.LOCATION_DESC,
  A.PRODUCT_ID,
  A.PROD_DESC,
  A.RESTRICTION,
  A.MODEL_VERSION,
  A.VERSION,
  A.SCENARIO,
  B.UNIQUE_ID,
  B.ASMB_QTY,
  B.RULE_TYPE,
  C.CIR_QTY,
  (C.CIR_QTY * B.ASMB_QTY) AS TOTAL_RTR_QTY
FROM V_RESTRICTIONREQV2 AS A
  INNER JOIN CP_BOM_UID AS B
 ON A.LOCATION_ID = B.LOCATION_ID
  AND A.PRODUCT_ID = B.PRODUCT_ID
  AND A.RESTRICTION = B.ASSEMBLY
  AND B.RULE_TYPE = 'RT'
  INNER JOIN CP_CIR_GENERATED AS C
 ON B.UNIQUE_ID = C.UNIQUE_ID
  AND C.LOCATION_ID = A.LOCATION_ID
  AND C.PRODUCT_ID = A.PRODUCT_ID
  AND A.WEEK_DATE = C.WEEK_DATE
  AND A.VERSION = C.VERSION
  AND A.SCENARIO = C.SCENARIO
  AND A.MODEL_VERSION = C.MODEL_VERSION
  AND C.CIR_QTY > 0;