VIEW "V_FPLAN_CONS_FCHAR" AS 
SELECT 
  A."LOCATION_ID",
  A."PRODUCT_ID",
  A."CHAR_NUM",
  A."CHAR_NAME",
  A."CHAR_DESC",
  A."CHARVAL_NUM",
  A."CHAR_VALUE",
  A."CHARVAL_DESC",
  A."VERSION",
  A."SCENARIO",
  B."CALENDAR_WEEK",
  B."TELESCOPIC_WEEK",
  B."WEEK_STARTDATE",
  B."WEEK_ENDDATE",
  A."OPT_PERCENT",
  A."OPT_QTY" AS "QUANTITY",
  CP_IBPVERSIONSCENARIO.VERSION_NAME,
  CP_IBPVERSIONSCENARIO.SCENARIO_NAME
FROM "V_FCHARPLAN" A
  LEFT OUTER JOIN "V_WEEK_DESCRIPTOR" AS B
 ON A."WEEK_DATE" >= B."WEEK_STARTDATE"
  AND A."WEEK_DATE" <= B."WEEK_ENDDATE"
  
LEFT OUTER JOIN CP_IBPVERSIONSCENARIO
ON CP_IBPVERSIONSCENARIO.VERSION = A."VERSION"
AND CP_IBPVERSIONSCENARIO.SCENARIO = A."SCENARIO"