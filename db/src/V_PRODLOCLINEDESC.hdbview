VIEW "V_PRODLOCLINEDESC" AS
SELECT A.LOCATION_ID,
       B.LOCATION_DESC,
       A.PRODUCT_ID,
       C.PROD_DESC,
       A.LINE_ID,
       B.LINE_DESC
FROM "CP_PROD_LOC_LINE" AS A
INNER JOIN V_LINEMASTERDESC AS B
ON A.LOCATION_ID = B.LOCATION_ID
AND A.LINE_ID = B.LINE_ID
INNER JOIN CP_PRODUCT AS C
ON A.PRODUCT_ID = C.PRODUCT_ID;