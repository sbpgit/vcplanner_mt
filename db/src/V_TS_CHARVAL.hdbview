VIEW V_TS_CHARVAL as 
SELECT 
    V_SALES_H."LOCATION_ID",
    V_SALES_H."PRODUCT_ID",
    ADD_DAYS( "MAT_AVAILDATE", WEEKDAY("MAT_AVAILDATE") * -1 ) AS WEEK_DAY,
    V_UNIQUE_ID.CHAR_NUM,
    V_UNIQUE_ID.CHARVAL_NUM,
    SUM(V_SALES_H."ORD_QTY") AS CHAR_QTY,
    V_ORD_COUNT.ORD_QTY,
    ROUND( ( SUM(V_SALES_H."ORD_QTY") / V_ORD_COUNT.ORD_QTY ) * 100, 2 ) AS percentage
FROM 
    "V_SALES_H"
    INNER JOIN
    V_UNIQUE_ID
    ON V_SALES_H.UNIQUE_ID = V_UNIQUE_ID.UNIQUE_ID
        AND V_SALES_H.PRODUCT_ID = V_UNIQUE_ID.PRODUCT_ID
    INNER JOIN
    V_ORD_COUNT
    ON V_ORD_COUNT.LOCATION_ID = V_SALES_H.LOCATION_ID
        AND V_ORD_COUNT.PRODUCT_ID = V_SALES_H.PRODUCT_ID
        AND V_ORD_COUNT.WEEK_DATE = ADD_DAYS( "MAT_AVAILDATE", WEEKDAY("MAT_AVAILDATE") * -1 )
WHERE ADD_DAYS( "MAT_AVAILDATE", WEEKDAY("MAT_AVAILDATE") * -1 ) <= CURRENT_DATE
GROUP BY 
    V_SALES_H.LOCATION_ID,
    V_SALES_H.PRODUCT_ID,
    MAT_AVAILDATE,
    V_UNIQUE_ID.CHAR_NUM,
    V_UNIQUE_ID.CHARVAL_NUM,
    V_ORD_COUNT.ORD_QTY
ORDER BY 
    V_SALES_H.LOCATION_ID ASC, 
    V_SALES_H.PRODUCT_ID ASC, 
    MAT_AVAILDATE DESC, 
    CHAR_NUM ASC, 
    CHARVAL_NUM ASC;