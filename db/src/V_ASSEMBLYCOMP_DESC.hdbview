-- For using common filter for man location V_FACTORYLOC- Pradeep 04/09/2025
VIEW "V_ASSEMBLYCOMP_DESC" AS
SELECT DISTINCT A."LOCATION_ID",
        B."LOCATION_DESC",
        A."ASSEMBLY",
        C."COMP_DESC" AS "ASMB_DESC",
        A."COMPONENT",
        A."CRITICAL_COMP",
        A."COMP_TYPE",
        A."COMP_DESC",
        A."COMP_QTY",
        A."VALID_FROM",
        A."VALID_TO",
        B.USER
FROM "CP_ASSEMBLY_COMP" AS A
INNER JOIN "V_ROLES_LOCPROD" AS B
ON A."LOCATION_ID" = B."FACTORY_LOC"
INNER JOIN "CP_BOMHEADER" AS C
ON A."LOCATION_ID" = C."LOCATION_ID"
AND A."ASSEMBLY" = C."COMPONENT";
