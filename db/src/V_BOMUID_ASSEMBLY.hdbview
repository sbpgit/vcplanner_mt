VIEW "V_BOMUID_ASSEMBLY" AS
-- SELECT
--     B.LOCATION_ID,
--     B.PRODUCT_ID,                        
--     C.COUNTER AS ITEM_NUM,
--     A.COMPONENT,
--     ADD_DAYS("MAT_AVAILDATE", WEEKDAY("MAT_AVAILDATE") * -1) AS WEEK_DATE,
--     'Active' AS MODEL_VERSION,
--     'PI' AS TYPE,
--     A.REF_PRODID,
--     A.COMP_LOC AS  FACTORY_LOC,
--     B.UNIQUE_ID ,
--     0 AS CIR_QTY,                                          
--     0 AS COMPCIR_QTY,                           
--     SUM(A.COMP_QTY) AS ACTUAL_QTY,
--     C.COMPONENT_FLAG
-- FROM 
--     CP_PROD_ORD_CONSUMPTION AS A
-- INNER JOIN V_SALES_H AS B
--     ON 
--     -- A.LOCATION_ID = B.LOCATION_ID
--     -- AND A.REF_PRODID = B.REF_PRODID
--     -- AND 
--     A.SALES_DOC = B.SALES_DOC
--     AND LTRIM(A.SALESDOC_ITEM, '0') = LTRIM(B.SALESDOC_ITEM, '0')
-- INNER JOIN CP_BOM_MAT AS C
--     -- ON A.COMP_LOC = C.LOCATION_ID
--     ON A.LOCATION_ID = C.LOCATION_ID
--     AND A.MAT_PARENT = C.MAT_PARENT
--     AND A.COMPONENT = C.MAT_CHILD
--     AND A.COMP_LOC = C.CHILD_LOC
--     AND B.MAT_AVAILDATE >= C.VALID_FROM
--     AND B.MAT_AVAILDATE <= C.VALID_TO
-- --     INNER JOIN CP_BOM_UID as F
-- --    ON F.LOCATION_ID = A.LOCATION_ID
-- --    and C.COUNTER = F.ITEM_NUM
-- --    and F.UNIQUE_ID = B.UNIQUE_ID
-- GROUP BY
--     B.LOCATION_ID,
--     B.PRODUCT_ID,
--     B.UNIQUE_ID,
--     C.COUNTER,
--     A.COMPONENT,
--     ADD_DAYS("MAT_AVAILDATE", WEEKDAY("MAT_AVAILDATE") * -1), 
--     'Active' ,
--     'PI',
--     A.REF_PRODID,
--     A.COMP_LOC,
--     C.COMPONENT_FLAG
-- ORDER BY 
--     B.LOCATION_ID,
--     B.PRODUCT_ID,
--     B.UNIQUE_ID,
--     C.COUNTER,
--     A.COMPONENT,
--     WEEK_DATE;


WITH RESOLVED_PARENT AS (
     SELECT DISTINCT
        C."LOCATION_ID",
        C."MAT_PARENT",
        C."MAT_CHILD",
        C."CHILD_LOC",
        C."VALID_FROM",
        C."VALID_TO",
        C."COMPONENT_FLAG",
        -- C."COUNTER",
         '' AS COUNTER,
        CASE 
            WHEN D."CLASS_FLG" = 'X' THEN D."MAT_PARENT"
            ELSE C."MAT_PARENT"
        END AS "EFFECTIVE_PARENT",
        CASE 
            WHEN D."CLASS_FLG" = 'X' THEN D."LOCATION_ID"
            ELSE C."LOCATION_ID"
        END AS "EFFECTIVE_LOCATION"
    FROM "CP_BOM_MAT" AS C
    LEFT JOIN "CP_BOM_MAT" AS D
        ON D."MAT_CHILD" = C."MAT_PARENT"
        AND D."CHILD_LOC" = C."LOCATION_ID"
)
 
SELECT
    A."LOCATION_ID",
    B."PRODUCT_ID",                        
    R."COUNTER" AS "ITEM_NUM",
    -- '' AS "ITEM_NUM",
    A."COMPONENT",
    ADD_DAYS(B."MAT_AVAILDATE", WEEKDAY(B."MAT_AVAILDATE") * -1) AS "WEEK_DATE",
    'Active' AS "MODEL_VERSION",
    'PI' AS "TYPE",
    A."REF_PRODID",
    A."COMP_LOC" AS "FACTORY_LOC",
    B."UNIQUE_ID",
    0 AS "CIR_QTY",
    0 AS "COMPCIR_QTY",
    SUM(A."COMP_QTY") AS "ACTUAL_QTY",
    R."COMPONENT_FLAG"
FROM "CP_PROD_ORD_CONSUMPTION" AS A
INNER JOIN "V_SALES_H" AS B
    ON A."SALES_DOC" = B."SALES_DOC"
    AND LTRIM(A."SALESDOC_ITEM", '0') = LTRIM(B."SALESDOC_ITEM", '0')
INNER JOIN RESOLVED_PARENT AS R
    ON A."PARENT_LOC" = R."EFFECTIVE_LOCATION"
    AND A."MAT_PARENT" = R."EFFECTIVE_PARENT"
    AND A."COMPONENT" = R."MAT_CHILD"
    AND A."COMP_LOC" = R."CHILD_LOC"
    AND B."MAT_AVAILDATE" BETWEEN R."VALID_FROM" AND R."VALID_TO"
GROUP BY
    A."LOCATION_ID",
    B."PRODUCT_ID",
    B."UNIQUE_ID",
    R."COUNTER",
    A."COMPONENT",
    ADD_DAYS(B."MAT_AVAILDATE", WEEKDAY(B."MAT_AVAILDATE") * -1),
    A."REF_PRODID",
    A."COMP_LOC",
    R."COMPONENT_FLAG"
ORDER BY 
    A."LOCATION_ID",
    B."PRODUCT_ID",
    B."UNIQUE_ID",
    R."COUNTER",
    A."COMPONENT",
    ADD_DAYS(B."MAT_AVAILDATE", WEEKDAY(B."MAT_AVAILDATE") * -1);