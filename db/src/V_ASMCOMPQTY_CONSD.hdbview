-------------------------------------------------------------------------------------
-- Name:        V_ASMCOMPQTY_CONSD
-- Description: View to add Subcomponent quantity group by Location,Product,Version,
--              Scenario, component, Model version and date
--------------------------------------------------------------------------------------
VIEW "V_ASMCOMPQTY_CONSD" AS
SELECT sum(V_ASMCOMP_REQ.COMP_QTY) AS COMP_QTY,
  V_ASMCOMP_REQ.WEEK_DATE,
  V_ASMCOMP_REQ.LOCATION_ID,
  --added
  V_ASMCOMP_REQ.FACTORY_LOC,
  --end
  -- V_ASMCOMP_REQ.PRODUCT_ID,
  V_ASMCOMP_REQ.VERSION,
  V_ASMCOMP_REQ.SCENARIO,
  V_ASMCOMP_REQ.COMPONENT,
  V_ASMCOMP_REQ.MODEL_VERSION,
  CP_COMPONENT_AVAIL.COMPAVAIL_QTY,
  CP_ASSEMBLY_COMP.COMP_DESC
-- "COMPONENT"
FROM "V_ASMCOMP_REQ"
  LEFT OUTER JOIN "CP_COMPONENT_AVAIL"
 ON V_ASMCOMP_REQ.WEEK_DATE = CP_COMPONENT_AVAIL.WEEK_DATE
  AND V_ASMCOMP_REQ.FACTORY_LOC = CP_COMPONENT_AVAIL.LOCATION_ID
  AND V_ASMCOMP_REQ.COMPONENT = CP_COMPONENT_AVAIL.COMPONENT
  -- AND V_ASMCOMP_REQ.VERSION = CP_COMPONENT_AVAIL.VERSION
  -- AND V_ASMCOMP_REQ.SCENARIO = CP_COMPONENT_AVAIL.SCENARIO
  INNER JOIN "CP_ASSEMBLY_COMP"
   ON V_ASMCOMP_REQ.FACTORY_LOC = CP_ASSEMBLY_COMP.LOCATION_ID
   AND V_ASMCOMP_REQ.COMPONENT = CP_ASSEMBLY_COMP.COMPONENT
GROUP BY V_ASMCOMP_REQ.WEEK_DATE,
  V_ASMCOMP_REQ.LOCATION_ID,
  --added
  V_ASMCOMP_REQ.FACTORY_LOC,
  --end
  V_ASMCOMP_REQ.PRODUCT_ID,
  V_ASMCOMP_REQ.VERSION,
  V_ASMCOMP_REQ.SCENARIO,
  V_ASMCOMP_REQ.COMPONENT,
  V_ASMCOMP_REQ.MODEL_VERSION,
  CP_COMPONENT_AVAIL.COMPAVAIL_QTY,
  CP_ASSEMBLY_COMP.COMP_DESC
ORDER BY WEEK_DATE DESC;



