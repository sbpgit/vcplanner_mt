VIEW "V_BOMODCHAR" AS
SELECT DISTINCT CP_BOM_OBJDEPENDENCY.LOCATION_ID,
  CP_BOM_OBJDEPENDENCY.PRODUCT_ID,
  CP_BOM_OBJDEPENDENCY.ITEM_NUM,
  CP_ASSEMBLY_COMP.ASSEMBLY,
  CP_BOMHEADER.COMP_DESC AS ASSEMBLY_DESC,
  CP_ASSEMBLY_COMP.COMPONENT,
  CP_ASSEMBLY_COMP.COMP_DESC,
  V_ODCHARVAL.OBJ_DEP,
  V_ODCHARVAL.CLASS_NUM,
  V_ODCHARVAL.CLASS_NAME,
  V_ODCHARVAL.CLASS_DESC,
  V_ODCHARVAL.CHAR_NUM,
  V_ODCHARVAL.CHAR_NAME,
  V_ODCHARVAL.CHAR_DESC,
  V_ODCHARVAL.CHARVAL_NUM,
  V_ODCHARVAL.CHAR_VALUE,
  V_ODCHARVAL.CHARVAL_DESC,
  V_ODCHARVAL.OD_CONDITION
FROM "CP_BOM_OBJDEPENDENCY"
  INNER JOIN "CP_ASSEMBLY_COMP"
 ON CP_BOM_OBJDEPENDENCY.LOCATION_ID = CP_ASSEMBLY_COMP.LOCATION_ID
  AND CP_BOM_OBJDEPENDENCY.COMPONENT = CP_ASSEMBLY_COMP.ASSEMBLY
  INNER JOIN "V_ODCHARVAL"
 ON CP_BOM_OBJDEPENDENCY.OBJ_DEP = V_ODCHARVAL.OBJDEP
  INNER JOIN "CP_BOMHEADER"
 ON CP_BOM_OBJDEPENDENCY.LOCATION_ID = CP_BOMHEADER.LOCATION_ID
  AND CP_BOM_OBJDEPENDENCY.PRODUCT_ID = CP_BOMHEADER.PRODUCT_ID
  AND CP_BOM_OBJDEPENDENCY.ITEM_NUM = CP_BOMHEADER.ITEM_NUM
  AND CP_BOM_OBJDEPENDENCY.COMPONENT = CP_BOMHEADER.COMPONENT
  ORDER BY CP_BOM_OBJDEPENDENCY.LOCATION_ID,
  CP_BOM_OBJDEPENDENCY.PRODUCT_ID,
  CP_BOM_OBJDEPENDENCY.ITEM_NUM,
  CP_ASSEMBLY_COMP.ASSEMBLY,
  CP_ASSEMBLY_COMP.COMPONENT;