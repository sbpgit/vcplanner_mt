VIEW "V_PRODCHARTYPE" AS
SELECT distinct A.PRODUCT_ID,
    A.CLASS_NUM,
    B.CLASS_NAME,
    B.CLASS_DESC,
    B.CHAR_NUM,
    B.CHAR_NAME,
    B.CHAR_DESC,
    B.CHARVAL_NUM,
    B.CHAR_VALUE,
    B.CHARVAL_DESC,
    B.MULTI_CHAR,
    B.REF_CHAR_NUM,
    B.REF_CHAR_NAME,
    B.REF_CHAR_DESC,
    B.REF_CHAR_VALUE,
    C.CHAR_TYPE
FROM CP_PRODUCT_CLASS AS A
INNER JOIN "V_CLASSCHARVAL" AS B
ON A.CLASS_NUM = B.CLASS_NUM
INNER JOIN "V_CHARVAL" AS C
on C.CHAR_NUM = B.CHAR_NUM;