VIEW V_HIS_M2_TS_SALESDOC AS
SELECT DISTINCT SHALLCH.*, "SEQUENCE"
FROM   V_HIS_M2_SHBY_PRIMARY SHALLCH
       LEFT OUTER JOIN V_HIS_M2_PRTLCHARVALNUM PRTLCH
                    ON SHALLCH.CHARVAL_NUM = PRTLCH.CHARVAL_NUM
                    AND SHALLCH.LOCATION_ID = PRTLCH.LOCATION_ID
                    AND SHALLCH.PRODUCT_ID = PRTLCH.PRODUCT_ID
INNER JOIN CP_VARCHAR_PS ON 
SHALLCH.CHAR_NUM =CP_VARCHAR_PS.CHAR_NUM
AND CP_VARCHAR_PS.CHAR_TYPE = 'P'
AND SHALLCH.REF_PRODID = CP_VARCHAR_PS.PRODUCT_ID
WHERE  PRTLCH.CHARVAL_NUM IS NULL
ORDER BY CAL_DATE, SALES_DOC, CHAR_NUM, CHAR_NAME;