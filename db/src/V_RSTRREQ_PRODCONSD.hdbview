VIEW "V_RSTRREQ_PRODCONSD" AS
SELECT "V_RTRQTYCONSD"."LOCATION_ID",
  -- "V_RTRQTYCONSD"."PRODUCT_ID",
  "CP_LOCATION"."LOCATION_DESC",
  "V_RTRQTYCONSD"."LINE_ID",
  "CP_LINEMASTER"."LINE_DESC",
  "V_RTRQTYCONSD"."RESTRICTION",
  "CP_RESTRICT_HEADER"."RTR_DESC",
  "V_RTRQTYCONSD"."WEEK_DATE",
  "V_RTRQTYCONSD"."MODEL_VERSION",
  "V_RTRQTYCONSD"."VERSION",
  "V_RTRQTYCONSD"."SCENARIO",
  "CP_IBPVERSIONSCENARIO"."VERSION_NAME",
  "CP_IBPVERSIONSCENARIO"."SCENARIO_NAME",
  "V_RTRQTYCONSD"."RTR_QTY",
  "CP_RESTRICTION_AVAIL"."RESTRICTIONAVAIL_QTY",
  "CP_RESTRICT_HEADER"."VALID_FROM",
  "CP_RESTRICT_HEADER"."VALID_TO",
  B."CALENDAR_WEEK",
  B."TELESCOPIC_WEEK",
  B."WEEK_STARTDATE",
  B."WEEK_ENDDATE"
FROM "V_RTRQTYCONSD"
  INNER JOIN "CP_LOCATION"
 ON "V_RTRQTYCONSD"."LOCATION_ID" = "CP_LOCATION"."LOCATION_ID"
  INNER JOIN "CP_RESTRICT_HEADER"
 ON "V_RTRQTYCONSD"."LOCATION_ID" = "CP_RESTRICT_HEADER"."LOCATION_ID"
  AND "V_RTRQTYCONSD"."LINE_ID" = "CP_RESTRICT_HEADER"."LINE_ID"
  AND "V_RTRQTYCONSD"."RESTRICTION" = "CP_RESTRICT_HEADER"."RESTRICTION"
  INNER JOIN "CP_IBPVERSIONSCENARIO"
 ON "V_RTRQTYCONSD"."VERSION" = "CP_IBPVERSIONSCENARIO"."VERSION"
  AND "V_RTRQTYCONSD"."SCENARIO" = "CP_IBPVERSIONSCENARIO"."SCENARIO"
  LEFT OUTER JOIN "CP_RESTRICTION_AVAIL"
 ON "V_RTRQTYCONSD"."LOCATION_ID" = "CP_RESTRICTION_AVAIL"."LOCATION_ID"
  AND "V_RTRQTYCONSD"."WEEK_DATE" = "CP_RESTRICTION_AVAIL"."WEEK_DATE"
  AND "V_RTRQTYCONSD"."RESTRICTION" = "CP_RESTRICTION_AVAIL"."RESTRICTION"
  INNER JOIN "CP_LINEMASTER"
 ON "V_RTRQTYCONSD"."LOCATION_ID" = "CP_LINEMASTER"."LOCATION_ID"
  AND "V_RTRQTYCONSD"."LINE_ID" = "CP_LINEMASTER"."LINE_ID"
    LEFT OUTER JOIN "V_WEEK_DESCRIPTOR" B
 ON V_RTRQTYCONSD."WEEK_DATE" >= B."WEEK_STARTDATE"
  AND V_RTRQTYCONSD."WEEK_DATE" <= B."WEEK_ENDDATE"