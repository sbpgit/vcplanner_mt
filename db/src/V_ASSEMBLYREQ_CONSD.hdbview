VIEW "V_ASSEMBLYREQ_CONSD" AS
SELECT DISTINCT
	A."LOCATION_ID",
	A."FACTORY_LOC",
	A."REF_PRODID" as PRODUCT_ID,
	A."ITEM_NUM",
	A."COMPONENT",
	A."STRUC_NODE",
	A."VERSION",
	A."SCENARIO",
	A."WEEK_DATE",
	A."MODEL_VERSION",	
	B."LOCATION_DESC",
	C."COMP_DESC",
	D."NODE_DESC",
	SUM(A.COMP_QTY) AS "COMP_QTY"
FROM "V_ASSEMBLYREQ" AS A
INNER JOIN CP_LOCATION AS B
   ON   A.LOCATION_ID = B.LOCATION_ID
INNER JOIN CP_BOMHEADER AS C
   ON A.LOCATION_ID = C.LOCATION_ID
   AND A.COMPONENT = C.COMPONENT 
INNER JOIN CP_PVS_NODES AS D
  ON A.STRUC_NODE = D.CHILD_NODE
GROUP BY A."LOCATION_ID",
         A."FACTORY_LOC",
         A."REF_PRODID",
         A."ITEM_NUM",
         A."COMPONENT",
         A."STRUC_NODE",
         A."VERSION",
         A."SCENARIO",
         A."WEEK_DATE",
         A."MODEL_VERSION",
		 B."LOCATION_DESC",
		 C."COMP_DESC",
		 D."NODE_DESC";

