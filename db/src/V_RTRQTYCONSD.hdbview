VIEW V_RTRQTYCONSD AS
SELECT  "WEEK_DATE",
        "LOCATION_ID",
        "LINE_ID",
        "RESTRICTION",
        "MODEL_VERSION",
        "VERSION",
        "SCENARIO",
      SUM(RTR_QTY) as RTR_QTY
FROM V_RTRLINELIKELIHOOD
GROUP BY "WEEK_DATE",
"LOCATION_ID",
"LINE_ID",
"RESTRICTION",
"MODEL_VERSION",
"VERSION",
"SCENARIO";