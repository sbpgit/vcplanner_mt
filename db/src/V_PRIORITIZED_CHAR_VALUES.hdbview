VIEW "V_PRIORITIZED_CHAR_VALUES" AS 
SELECT DISTINCT VC.PRODUCT_ID,VC.CHAR_NUM,CH.CHAR_NAME,CH.CHAR_DESC,C.CHARVAL_NUM,C.CHARVAL_DESC,VC.SEQUENCE FROM "CP_DERIVED_CHAR_SEQUENCE" AS VC
INNER JOIN "CP_CHAR_VALUES" AS C ON C.CHAR_NUM = VC.CHAR_NUM
INNER JOIN "CP_CHARACTERISTICS" AS CH ON CH.CHAR_NUM = VC.CHAR_NUM 
ORDER BY VC.SEQUENCE