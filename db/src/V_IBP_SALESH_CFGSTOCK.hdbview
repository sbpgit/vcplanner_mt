    ----------------------------------------------------------------------------------------
-- Name:            V_IBP_SALESH_CFGSTOCK
-- Description:     Get SUM OF order quantity for location product on a weekly basis
-- Join Details:    V_IBP_SALESH_ACTDEMD -  weekly sales history with sum of ORD_QTY 
--                  V_SALESH_UID_CONFIG -  Master table for sales history configuration 
-----------------------------------------------------------------------------------------

VIEW "V_IBP_SALESH_CFGSTOCK" AS
SELECT  V_SALES_H."LOCATION_ID",
        V_SALES_H."PRODUCT_ID",
        V_SALES_H."REF_PRODID",
        -- CASE
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 0 THEN ADD_DAYS("MAT_AVAILDATE", 0)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 1 THEN ADD_DAYS("MAT_AVAILDATE", -1)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 2 THEN ADD_DAYS("MAT_AVAILDATE", -2)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 3 THEN ADD_DAYS("MAT_AVAILDATE", -3)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 4 THEN ADD_DAYS("MAT_AVAILDATE", -4)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 5 THEN ADD_DAYS("MAT_AVAILDATE", -5)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 6 THEN ADD_DAYS("MAT_AVAILDATE", -6)
        -- END AS "WEEK_DATE",
        V_SALES_H."TRANS_TO_LOC",
        V_SALES_H."TRANS_FROM_LOC", 
        V_PARTIALPRODCLASSCHAR."CLASS_NUM",
        V_SALESH_UID_CONFIG."CHAR_NUM",
        V_SALESH_UID_CONFIG."CHARVAL_NUM",
        V_SALESH_UID_CONFIG."CHAR_VALUE",
        V_PARTIALPRODCLASSCHAR."IBPCHAR_CHK",
        SUM (CASE WHEN V_SALES_H.IN_TRANSIT = 'Y' THEN "ORD_QTY" else 0 END) AS INTRANSIT_QTY
        FROM V_SALES_H
        INNER JOIN V_SALESH_UID_CONFIG
        ON V_SALES_H.SALES_DOC = V_SALESH_UID_CONFIG.SALES_DOC
        AND V_SALES_H.SALESDOC_ITEM = V_SALESH_UID_CONFIG.SALESDOC_ITEM
        LEFT OUTER JOIN V_PARTIALPRODCLASSCHAR
        ON V_SALES_H.LOCATION_ID = V_PARTIALPRODCLASSCHAR.LOCATION_ID
        AND V_SALES_H.PRODUCT_ID = V_PARTIALPRODCLASSCHAR.PRODUCT_ID
        AND V_SALES_H.REF_PRODID = V_PARTIALPRODCLASSCHAR.REF_PRODID
        AND V_SALESH_UID_CONFIG.CHAR_NUM = V_PARTIALPRODCLASSCHAR.CHAR_NUM
        AND V_SALESH_UID_CONFIG.CHAR_VALUE = V_PARTIALPRODCLASSCHAR.CHAR_VALUE     
        WHERE ("TRANS_TO_LOC" IS NOT NULL AND "TRANS_FROM_LOC" IS NOT NULL)
        GROUP BY V_SALES_H."LOCATION_ID",
        V_SALES_H."PRODUCT_ID",
        V_SALES_H."REF_PRODID",
        -- CASE
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 0 THEN ADD_DAYS("MAT_AVAILDATE", 0)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 1 THEN ADD_DAYS("MAT_AVAILDATE", -1)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 2 THEN ADD_DAYS("MAT_AVAILDATE", -2)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 3 THEN ADD_DAYS("MAT_AVAILDATE", -3)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 4 THEN ADD_DAYS("MAT_AVAILDATE", -4)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 5 THEN ADD_DAYS("MAT_AVAILDATE", -5)
        -- WHEN WEEKDAY("MAT_AVAILDATE") = 6 THEN ADD_DAYS("MAT_AVAILDATE", -6)
        -- END,   
        V_SALES_H."TRANS_TO_LOC",
        V_SALES_H."TRANS_FROM_LOC", 
        V_PARTIALPRODCLASSCHAR."CLASS_NUM",   
        V_SALESH_UID_CONFIG."CHAR_NUM",
        V_SALESH_UID_CONFIG."CHARVAL_NUM",
        V_SALESH_UID_CONFIG."CHAR_VALUE",
        V_PARTIALPRODCLASSCHAR."IBPCHAR_CHK"
        ORDER BY V_SALES_H."LOCATION_ID",
                 V_SALES_H."PRODUCT_ID",
                 V_SALES_H."REF_PRODID" WITH READ ONLY;