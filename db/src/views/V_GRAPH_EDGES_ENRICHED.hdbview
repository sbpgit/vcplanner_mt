VIEW "V_GRAPH_EDGES_ENRICHED" AS
SELECT
  ge.EDGE_ID,
  ge.SOURCE,
  sv.CHAR_KEY   AS SRC_CHAR,
  sv.VALUE_CODE AS SRC_VALUE,
  sv.DERIVE_LEVEL AS SRC_LEVEL,
  ge.TARGET,
  tv.CHAR_KEY   AS TGT_CHAR,
  tv.VALUE_CODE AS TGT_VALUE,
  tv.DERIVE_LEVEL AS TGT_LEVEL,
  ge.RULE_ID,
  ge.EDGE_WEIGHT
FROM "T_GRAPH_EDGES" ge
JOIN "T_GRAPH_VERTICES" sv ON sv.VERTEX_ID = ge.SOURCE
JOIN "T_GRAPH_VERTICES" tv ON tv.VERTEX_ID = ge.TARGET;
