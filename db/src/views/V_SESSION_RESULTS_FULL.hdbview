VIEW "V_SESSION_RESULTS_FULL" AS
SELECT
  dr.SESSION_ID,
  dr.CHAR_KEY,
  cd.CHAR_LABEL,
  cd.DERIVE_LEVEL,
  dr.VALUE_CODE,
  cv.VALUE_LABEL,
  dr.PROBABILITY,
  dr.RULECHAIN,
  dr.STATUS,
  dr.COMPUTED_AT,
  s.PLAN_MODE,
  s.PRODUCT_ID,
  s.REGION_ID
FROM "T_DERIVATION_RESULTS" dr
JOIN "T_CHAR_DEFINITIONS" cd ON cd.CHAR_KEY = dr.CHAR_KEY
LEFT JOIN "T_CHAR_VALUES" cv ON cv.CHAR_KEY = dr.CHAR_KEY AND cv.VALUE_CODE = dr.VALUE_CODE
JOIN "T_SESSIONS" s ON s.SESSION_ID = dr.SESSION_ID
WHERE dr.VALUE_CODE != '__UNRESOLVED__'
   OR dr.VALUE_CODE IS NULL;
