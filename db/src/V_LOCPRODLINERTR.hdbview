----------------------------------------------------------------------------------------
-- Name:            V_LOCPRODLINERTR
-- Description:     Fetch Location and products listed in Products master table
-- Join Details:    A: CP_LOCATION_PRODUCT-  Master table for location and product
--                  B: CP_PRODUCT- Master table for Products
-----------------------------------------------------------------------------------------
VIEW "V_LOCPRODLINERTR"
AS 
SELECT DISTINCT
CP_PARTIALPROD_INTRO.PRODUCT_ID,
CP_PARTIALPROD_INTRO.REF_PRODID,
CP_PARTIALPROD_INTRO.LOCATION_ID,
CP_LINECAPACITY.LOCATION_ID AS FACTORY_LOC,
CP_LINECAPACITY.LINE_ID,
CP_LINEMASTER.LINE_DESC,
CP_RESTRICT_HEADER.RESTRICTION,
CP_RESTRICT_HEADER.RTR_DESC,
CP_RESTRICT_HEADER.VALID_FROM,
CP_RESTRICT_HEADER.VALID_TO
FROM "CP_LINECAPACITY"
INNER JOIN "CP_FACTORY_SALESLOC"
ON CP_LINECAPACITY.LOCATION_ID = CP_FACTORY_SALESLOC.FACTORY_LOC
INNER JOIN "CP_PARTIALPROD_INTRO"
ON CP_FACTORY_SALESLOC.LOCATION_ID = CP_PARTIALPROD_INTRO.LOCATION_ID
 AND CP_FACTORY_SALESLOC.PRODUCT_ID = CP_PARTIALPROD_INTRO.PRODUCT_ID
 AND  CP_LINECAPACITY.PRODID = CP_PARTIALPROD_INTRO.REF_PRODID
LEFT OUTER JOIN "CP_RESTRICT_HEADER"
ON CP_LINECAPACITY."LOCATION_ID" = CP_RESTRICT_HEADER."LOCATION_ID"
AND CP_LINECAPACITY."LINE_ID" = CP_RESTRICT_HEADER."LINE_ID"
INNER JOIN "CP_LINEMASTER"
ON CP_LINECAPACITY.LINE_ID = CP_LINEMASTER.LINE_ID