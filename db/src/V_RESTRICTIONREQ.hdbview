VIEW V_RESTRICTIONREQ AS
SELECT A.CAL_DATE AS WEEK_DATE,
  A."LOCATION_ID",
  B."LINE_ID",
  A."PRODUCT_ID",
  B."REF_PRODID",
  B."FACTORY_LOC",
  B."RESTRICTION",
  A."MODEL_VERSION",
  -- B."RTR_DESC",
  A."VERSION",
  A."SCENARIO",
  A."PREDICTED" AS RTR_QTY,
  C."RESTRICTIONAVAIL_QTY"
FROM V_RTRPREDICTIONS AS A
  INNER JOIN V_LOCPRODLINERTR AS B
 ON A."LOCATION_ID" = B."LOCATION_ID"
  AND A."PRODUCT_ID" = B."PRODUCT_ID"
  AND A."OBJ_DEP" = B."RESTRICTION"
  LEFT OUTER JOIN CP_RESTRICTION_AVAIL AS C
 ON B."FACTORY_LOC" = C."LOCATION_ID"
  AND A."CAL_DATE" = C."WEEK_DATE"
  AND B."RESTRICTION" = C."RESTRICTION"
WHERE  A.CAL_DATE > B.VALID_FROM AND A.CAL_DATE <= B.VALID_TO
