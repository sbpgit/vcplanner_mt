VIEW V_IBP_FOPTQTYPLAN_TELESCOPIC AS
SELECT DISTINCT IFC.LOCATION_ID, IFC.PRODUCT_ID, CLASS_NUM, CHAR_NUM, CHARVAL_NUM, IFC.VERSION, IFC.SCENARIO,
    TSP.PERIODSTART AS WEEK_DATE, MODEL_VERSION,
    SUM(OPT_QTY) AS OPT_QTY
    FROM CP_IBP_FCHARPLAN AS IFC
    INNER JOIN CP_TELESCOPIC_PERIODS AS TSP ON
    TSP.PERIODSTART BETWEEN PERIODSTART AND PERIODEND
    AND (IFC.WEEK_DATE BETWEEN PERIODSTART AND PERIODEND )
    GROUP BY IFC.LOCATION_ID, IFC.PRODUCT_ID, CLASS_NUM, CHAR_NUM, CHARVAL_NUM, IFC.VERSION, IFC.SCENARIO, TSP.PERIODSTART, MODEL_VERSION
    ORDER BY TSP.PERIODSTART, LOCATION_ID, PRODUCT_ID, MODEL_VERSION, CLASS_NUM, CHAR_NUM, CHARVAL_NUM, VERSION, SCENARIO;

