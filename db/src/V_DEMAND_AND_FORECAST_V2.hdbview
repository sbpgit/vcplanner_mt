VIEW V_DEMAND_AND_FORECAST_V2 AS
( 		(WITH 
			"SALES_WEEK_TOTAL" AS
			(
						SELECT 
					LOCATION_ID,
					PRODUCT_ID,
					WEEK_DATE,
					SUM(ORD_QTY) AS SALES_TOT_ORD_QTY
				FROM V_SALESALL_WEEK
				GROUP BY 
					LOCATION_ID,
					PRODUCT_ID,
					WEEK_DATE
			), 
			"FORECAST_WEEK_TOTAL" AS
			(
						SELECT 
					LOCATION_ID,
					PRODUCT_ID,
					MODEL_VERSION,
					VERSION,
					SCENARIO,
					WEEK_DATE,
					SUM(CIR_QTY) AS FORECAST_TOT_CIR_QTY
				FROM CP_CIR_GENERATED
				GROUP BY 
					LOCATION_ID,
					PRODUCT_ID,
					MODEL_VERSION,
					VERSION,
					SCENARIO,
					WEEK_DATE
			)
		SELECT 
			A.LOCATION_ID,
			B.PRODUCT_ID,
			B.UNIQUE_ID,
			C.CHAR_NUM,
			C.CHARVAL_NUM,
			(
				(SELECT MAX(CHAR_DESC)
				FROM CP_CHARACTERISTICS
				WHERE CHAR_NUM = C.CHAR_NUM)
			) AS CHAR_DESC,
			(
				(SELECT DISTINCT CHAR_NAME
				FROM CP_CHARACTERISTICS
				WHERE CHAR_NUM = C.CHAR_NUM)
			) AS CHAR_NAME,
			(
				(SELECT CHARVAL_DESC
				FROM CP_CHAR_VALUES
				WHERE CHAR_NUM = C.CHAR_NUM
					AND CHAR_VALUE = C.CHARVAL_NUM)
			) AS CHARVAL_DESC,
			NULL AS MODEL_VERSION,
			NULL AS VERSION,
			NULL AS SCENARIO,
			NULL AS VERSION_NAME,
			NULL AS SCENARIO_NAME,
			E.LOCATION_DESC,
			F.PROD_DESC,
			DW.WEEK_STARTDATE AS WEEK_DATE,
			TO_VARCHAR(YEAR(DW.WEEK_STARTDATE)) AS "YEAR",
			DW.PERIODDESC AS "WEEK_PERIODDESC",
			DQ.PERIODDESC AS "QUARTER",
			DM.PERIODDESC AS "MONTH",
			'Actual' AS TYPE,
    		TO_VARCHAR( DW.WEEK_STARTDATE, 'YYYY-MM' ) AS YEAR_MONTH,
			SUM(A.ORD_QTY) AS QUANTITY,
			SUM(A.ORD_QTY) AS ACTUAL_QTY,
			SUM(STOT.SALES_TOT_ORD_QTY) AS SALES_TOT_ORD_QTY,
			NULL AS FORECAST_TOT_CIR_QTY,
			SUM(CASE
					WHEN STOT.SALES_TOT_ORD_QTY <> 0 AND STOT.SALES_TOT_ORD_QTY IS NOT NULL THEN TO_DECIMAL( ( ( A.ORD_QTY / STOT.SALES_TOT_ORD_QTY ) * 100 ), 18, 4 )
					ELSE 0
				END) AS PERCENTAGE,
			NULL AS FORECAST_SALES_TOT_QTY,
			NULL AS FORECAST_SALES_PERCENTAGE
		FROM 
			CP_SALESH AS A
			INNER JOIN
			CP_SALES_HM AS B
			ON A.SALES_DOC = B.SALES_DOC
				AND A.SALESDOC_ITEM = B.SALESDOC_ITEM
			INNER JOIN
			CP_UNIQUE_ID_ITEM AS C
			ON B.UNIQUE_ID = C.UNIQUE_ID
			INNER JOIN
			CP_IBPCALENDER_WEEK AS DM
			ON A.MAT_AVAILDATE BETWEEN DM.WEEK_STARTDATE AND DM.WEEK_ENDDATE
				AND DM.LEVEL = 'M'
				AND A.MAT_AVAILDATE <= CURRENT_DATE
			INNER JOIN
			CP_IBPCALENDER_WEEK AS DW
			ON A.MAT_AVAILDATE BETWEEN DW.WEEK_STARTDATE AND DW.WEEK_ENDDATE
				AND DW.LEVEL = 'W'
				AND A.MAT_AVAILDATE <= CURRENT_DATE
			INNER JOIN
			CP_IBPCALENDER_WEEK AS DQ
			ON A.MAT_AVAILDATE BETWEEN DQ.WEEK_STARTDATE AND DQ.WEEK_ENDDATE
				AND DQ.LEVEL = 'Q'
				AND A.MAT_AVAILDATE <= CURRENT_DATE
			INNER JOIN
			SALES_WEEK_TOTAL AS STOT
			ON STOT.LOCATION_ID = A.LOCATION_ID
				AND STOT.PRODUCT_ID = A.PRODUCT_ID
				AND STOT.WEEK_DATE = DW.WEEK_STARTDATE
			INNER JOIN
			CP_LOCATION AS E
			ON A.LOCATION_ID = E.LOCATION_ID
			INNER JOIN
			CP_PRODUCT AS F
			ON B.PRODUCT_ID = F.PRODUCT_ID
		WHERE A.SEEDORD_CHK IS NULL
		GROUP BY 
			A.LOCATION_ID,
			B.PRODUCT_ID,
			B.UNIQUE_ID,
			C.CHAR_NUM,
			C.CHARVAL_NUM,
			E.LOCATION_DESC,
			F.PROD_DESC,
			DW.WEEK_STARTDATE,
			DW.PERIODDESC,
			DQ.PERIODDESC,
			DM.PERIODDESC

		UNION ALL

		(SELECT 
			A.LOCATION_ID,
			A.PRODUCT_ID,
			A.UNIQUE_ID,
			C.CHAR_NUM,
			C.CHARVAL_NUM,
			(
				(SELECT MAX(CHAR_DESC)
				FROM CP_CHARACTERISTICS
				WHERE CHAR_NUM = C.CHAR_NUM)
			) AS CHAR_DESC,
			(
				(SELECT DISTINCT CHAR_NAME
				FROM CP_CHARACTERISTICS
				WHERE CHAR_NUM = C.CHAR_NUM)
			) AS CHAR_NAME,
			(
				(SELECT CHARVAL_DESC
				FROM CP_CHAR_VALUES
				WHERE CHAR_NUM = C.CHAR_NUM
					AND CHAR_VALUE = C.CHARVAL_NUM)
			) AS CHARVAL_DESC,
			A.MODEL_VERSION,
			A.VERSION,
			A.SCENARIO,
			G.VERSION_NAME,
			G.SCENARIO_NAME,
			E.LOCATION_DESC,
			F.PROD_DESC,
			A.WEEK_DATE,
			TO_VARCHAR(YEAR(A.WEEK_DATE)) AS "YEAR",
			DW.PERIODDESC AS "WEEK_PERIODDESC",
			DQ.PERIODDESC AS "QUARTER",
			DM.PERIODDESC AS "MONTH",
			'Forecast' AS TYPE,
    		TO_VARCHAR( A.WEEK_DATE, 'YYYY-MM' ) AS YEAR_MONTH,
			SUM(A.CIR_QTY) AS QUANTITY,
			SUM(A.ACTUAL_QTY) AS ACTUAL_QTY,
			NULL AS SALES_TOT_ORD_QTY,
			SUM(FTOT.FORECAST_TOT_CIR_QTY) AS FORECAST_TOT_CIR_QTY,
			SUM(CASE
					WHEN FTOT.FORECAST_TOT_CIR_QTY <> 0 AND FTOT.FORECAST_TOT_CIR_QTY IS NOT NULL THEN TO_DECIMAL( ( ( A.CIR_QTY / FTOT.FORECAST_TOT_CIR_QTY ) * 100 ), 18, 4 )
					ELSE 0
				END) AS PERCENTAGE,
			SUM(FSTOT.SALES_TOT_ORD_QTY) AS FORECAST_SALES_TOT_QTY,
			SUM(CASE
					WHEN FSTOT.SALES_TOT_ORD_QTY <> 0 AND FSTOT.SALES_TOT_ORD_QTY IS NOT NULL THEN TO_DECIMAL( ( ( A.ACTUAL_QTY / FSTOT.SALES_TOT_ORD_QTY ) * 100 ), 18, 4 )
					ELSE 0
				END) AS FORECAST_SALES_PERCENTAGE
		FROM 
			CP_CIR_GENERATED AS A
			INNER JOIN
			CP_UNIQUE_ID_ITEM AS C
			ON A.UNIQUE_ID = C.UNIQUE_ID
			INNER JOIN
			CP_IBPCALENDER_WEEK AS DW
			ON A.WEEK_DATE BETWEEN DW.WEEK_STARTDATE AND DW.WEEK_ENDDATE
				AND DW.LEVEL = 'W'
			INNER JOIN
			CP_IBPCALENDER_WEEK AS DM
			ON A.WEEK_DATE BETWEEN DM.WEEK_STARTDATE AND DM.WEEK_ENDDATE
				AND DM.LEVEL = 'M'
			INNER JOIN
			CP_IBPCALENDER_WEEK AS DQ
			ON A.WEEK_DATE BETWEEN DQ.WEEK_STARTDATE AND DQ.WEEK_ENDDATE
				AND DQ.LEVEL = 'Q'
			INNER JOIN
			FORECAST_WEEK_TOTAL AS FTOT
			ON FTOT.LOCATION_ID = A.LOCATION_ID
				AND FTOT.PRODUCT_ID = A.PRODUCT_ID
				AND FTOT.MODEL_VERSION = A.MODEL_VERSION
				AND FTOT.VERSION = A.VERSION
				AND FTOT.SCENARIO = A.SCENARIO
				AND FTOT.WEEK_DATE = A.WEEK_DATE
			LEFT OUTER JOIN
			SALES_WEEK_TOTAL AS FSTOT
			ON FSTOT.LOCATION_ID = A.LOCATION_ID
				AND FSTOT.PRODUCT_ID = A.PRODUCT_ID
				AND FSTOT.WEEK_DATE = A.WEEK_DATE
			INNER JOIN
			CP_LOCATION AS E
			ON A.LOCATION_ID = E.LOCATION_ID
			INNER JOIN
			CP_PRODUCT AS F
			ON A.PRODUCT_ID = F.PRODUCT_ID
			INNER JOIN
			CP_IBPVERSIONSCENARIO AS G
			ON A.VERSION = G.VERSION
				AND A.SCENARIO = G.SCENARIO
		GROUP BY 
			A.LOCATION_ID,
			A.PRODUCT_ID,
			A.UNIQUE_ID,
			C.CHAR_NUM,
			C.CHARVAL_NUM,
			A.MODEL_VERSION,
			A.VERSION,
			A.SCENARIO,
			G.VERSION_NAME,
			G.SCENARIO_NAME,
			E.LOCATION_DESC,
			F.PROD_DESC,
			A.WEEK_DATE,
			DW.PERIODDESC,
			DQ.PERIODDESC,
			DM.PERIODDESC)) )
