----------------------------------------------------------------------------------------
-- Name:            V_LOCPRODDATA
-- Description:     Location-Product data with Description
-- Join Details:    A: CP_LOCCATION_PRODUCT -  Location Product
--                  B: CP_PRODUCT - Product
--                  C: CP_LOCATION - Location
-----------------------------------------------------------------------------------------
VIEW "V_LOCPRODDATA" AS
SELECT DISTINCT
CP_LOCATION_PRODUCT.PRODUCT_ID,
CP_LOCATION_PRODUCT.LOCATION_ID,
CP_LOCATION_PRODUCT.LOTSIZE_KEY,
CP_LOCATION_PRODUCT.LOT_SIZE,
CP_LOCATION_PRODUCT.PROCUREMENT_TYPE,
CP_LOCATION_PRODUCT.PLANNING_STRATEGY,
CP_LOCATION_PRODUCT.MRP_TYPE,
CP_LOCATION_PRODUCT.MRP_GROUP,
CASE
WHEN V_PRODCOMPDESC.PROD_DESC IS NULL THEN ' '
ELSE V_PRODCOMPDESC.PROD_DESC 
END AS PROD_DESC,
CASE
    WHEN CP_LOCATION.LOCATION_DESC IS NULL THEN ' '
    ELSE CP_LOCATION.LOCATION_DESC
END AS LOCATION_DESC
FROM "CP_LOCATION_PRODUCT" 
LEFT OUTER JOIN "V_PRODCOMPDESC"
ON CP_LOCATION_PRODUCT."PRODUCT_ID" = V_PRODCOMPDESC."PRODUCT_ID"
LEFT OUTER JOIN "CP_LOCATION"
ON CP_LOCATION_PRODUCT."LOCATION_ID" = CP_LOCATION."LOCATION_ID";