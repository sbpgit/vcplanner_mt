---------------------------------------------------------------------------------
-- Name:            V_BOMOD_DEMDFACLOC_M
-- Description:     Demand location for BOM factory location
-- Join Details:    A: CP_BOM_OD -  BOM OD header
--                  B: CP_FACTORY_SALESLOC - Factory Location
--------------------------------------------------------------------------------------

VIEW "V_BOMOD_DEMDFACLOC_M" AS
SELECT DISTINCT B.LOCATION_ID,
  B.FACTORY_LOC,
  '' AS PRODUCT_ID,
  A.COUNTER AS ITEM_NUM,
  A.MAT_CHILD AS COMPONENT,
  C.PROD_DESC,
  C.CRITICAL_ASM,
  A.OBJ_DEP,
  A.OBJDEP_DESC,
  C.COMPONENT_QTY AS COMP_QTY,
  A.VALID_FROM AS OD_VALID_FROM,
  A.VALID_TO AS OD_VALID_TO,
  C.VALID_FROM,
  C.VALID_TO
FROM CP_BOM_OD AS A
  INNER JOIN "CP_FACTORY_SALESLOC" AS B
 ON A.LOCATION_ID = B.FACTORY_LOC
  INNER JOIN "CP_BOM_MAT" AS C
 ON A.LOCATION_ID = C.LOCATION_ID
  AND A.MAT_CHILD = C.MAT_CHILD
  AND A.COUNTER = C.COUNTER