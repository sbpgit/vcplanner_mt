VIEW V_UNIQUE_LOCPRODCUST_BY_SALESDOC AS
SELECT SALES_DOC, ADD_DAYS (TO_DATE ("MAT_AVAILDATE", 'YYYY-MM-DD'), 7-WEEKDAY (TO_DATE ("MAT_AVAILDATE", 'YYYY-MM-DD'))) AS CAL_DATE,
LOCATION_ID, REF_PRODID, PRODUCT_ID, CUSTOMER_GROUP, UNIQUE_ID, PRIMARY_ID, ORD_QTY FROM V_SALES_H
ORDER BY CAL_DATE, PLAN_LOC, PRODUCT_ID,CUSTOMER_GROUP,  UNIQUE_ID, PRIMARY_ID; 

