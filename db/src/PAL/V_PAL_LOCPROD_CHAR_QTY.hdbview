VIEW V_PAL_LOCPROD_CHAR_QTY AS
SELECT DISTINCT LOCATION_ID, PRODUCT_ID, 
MODEL_VERSION, VERSION, SCENARIO, 
CLASS_NUM,  
WEEK_DATE, CHAR_NUM, SUM(CHARVAL_QTY) AS CHAR_QTY
FROM V_PAL_LOCPROD_UNIQUE_CHAR_CHARVAL_QTY
GROUP BY LOCATION_ID, PRODUCT_ID, 
MODEL_VERSION, VERSION, SCENARIO, 
CLASS_NUM, CHAR_NUM,   
WEEK_DATE
ORDER BY WEEK_DATE, LOCATION_ID, PRODUCT_ID,
MODEL_VERSION, VERSION, SCENARIO, 
CLASS_NUM, CHAR_NUM;