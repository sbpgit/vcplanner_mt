VIEW V_PRIMARY_VALIDITY AS
SELECT DISTINCT VCHTS.LOCATION_ID,VCHTS.PRODUCT_ID, SH.UNIQUE_ID, SH.PRIMARY_ID, VALID_FROM, VALID_TO
FROM V_SALES_H AS SH
INNER JOIN CP_UNIQUE_ID_HEADER AS UHD ON
SH.REF_PRODID = UHD.PRODUCT_ID 
AND SH.UNIQUE_ID = UHD.UNIQUE_ID
INNER JOIN CP_VC_HISTORY_TS AS VCHTS ON
SH.PRODUCT_ID = VCHTS.PRODUCT_ID 
AND VCHTS.GROUP_ID LIKE_REGEXPR  SH.PRIMARY_ID 
ORDER BY UNIQUE_ID, PRIMARY_ID