VIEW CP_V_IBP_FCHARPLAN_BY_PRIMARY_CHARS AS
SELECT DISTINCT IBP.LOCATION_ID, IBP.PRODUCT_ID, 
--IBP.CLASS_NUM,
IBP.CHAR_NUM, IBP.CHARVAL_NUM, 
IBP."VERSION", IBP."SCENARIO", IBP.WEEK_DATE, IBP.OPT_PERCENT, IBP.OPT_QTY, IBP.MODEL_VERSION
FROM V_IBP_FCHARPLAN_TELESCOPIC AS IBP
INNER JOIN CP_V_PREDICTIONS_BY_CHAR AS BTP ON
IBP.LOCATION_ID = BTP.LOCATION_ID
AND IBP.PRODUCT_ID = BTP.PRODUCT_ID
--AND IBP.CLASS_NUM =  BTP.CLASS_NUM
AND IBP.CHAR_NUM = BTP.CHAR_NUM
AND IBP.CHARVAL_NUM = BTP.CHARVAL_NUM 
AND IBP.WEEK_DATE = BTP.CAL_DATE
AND IBP.MODEL_VERSION = BTP.MODEL_VERSION
ORDER BY IBP.WEEK_DATE, IBP.LOCATION_ID, IBP.PRODUCT_ID, 
--IBP.CLASS_NUM,
IBP.CHAR_NUM, IBP.CHARVAL_NUM;