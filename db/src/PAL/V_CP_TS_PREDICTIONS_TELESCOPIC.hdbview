VIEW V_CP_TS_PREDICTIONS_TELESCOPIC AS
SELECT PERIODSTART AS CAL_DATE, LOCATION_ID, PRODUCT_ID, OBJ_TYPE, OBJ_DEP, OBJ_COUNTER,
MODEL_TYPE, MODEL_VERSION, MODEL_PROFILE, VERSION, SCENARIO, ROUND(SUM(PREDICTED),2) AS PREDICTED, MIN(PREDICTED_TIME) AS PREDICTED_TIME,
MIN(OPT_STARTTIME) AS OPT_STARTTIME, MIN(DELTA_TIME) AS DELTA_TIME, PREDICTED_STATUS, 
ROUND(SUM(PRE_OPTIMIZED),2) AS PRE_OPTIMIZED, MIN(PRE_OPTIMIZED_TIME) AS PRE_OPTIMIZED_TIME,
OPT_ALGORITHM
FROM CP_TS_PREDICTIONS AS CP
INNER JOIN CP_TELESCOPIC_PERIODS AS TSP ON
TSP.PERIODSTART BETWEEN PERIODSTART AND PERIODEND
AND (CAL_DATE BETWEEN PERIODSTART AND PERIODEND)
GROUP BY PERIODSTART, LOCATION_ID, PRODUCT_ID, OBJ_TYPE, OBJ_DEP, OBJ_COUNTER,
MODEL_TYPE, MODEL_VERSION, MODEL_PROFILE, VERSION, SCENARIO, PREDICTED_STATUS,OPT_ALGORITHM 
ORDER BY PERIODSTART, LOCATION_ID, PRODUCT_ID, OBJ_TYPE, OBJ_DEP, OBJ_COUNTER,
MODEL_TYPE, MODEL_VERSION, MODEL_PROFILE, VERSION, SCENARIO;

