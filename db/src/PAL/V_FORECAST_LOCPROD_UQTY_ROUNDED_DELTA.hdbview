VIEW V_FORECAST_LOCPROD_UQTY_ROUNDED_DELTA AS
SELECT CAL_DATE, STATF.LOCATION_ID, STATF.PRODUCT_ID, STATF.UNIQUE_ID, 
STATF.MODEL_VERSION, STATF.VERSION, 
STATF.SCENARIO, (UNROUNDED - ROUNDED) AS DEVIATION
FROM CP_FORECAST_UNIQUE_LOCPROD AS STATF 
ORDER BY CAL_DATE, STATF.LOCATION_ID, STATF.PRODUCT_ID, STATF.UNIQUE_ID, STATF.VERSION, STATF.SCENARIO