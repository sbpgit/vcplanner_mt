VIEW V_PRIMARY_LOCPRODCUST_BY_PERCENT_FUTURE AS
SELECT PRIM.CAL_DATE, PRIM.LOCATION_ID, PRIM.PRODUCT_ID,PRIM.CUSTOMER_GROUP, PRIM.PRIMARY_ID, PRIM.PRIMARY_QTY, 
CASE WHEN PRIMARY_AGG > 0 THEN 100.0*(PRIM.PRIMARY_QTY/PRIMARY_AGG) ELSE '0' END AS PRIMARY_PERCENT,
PRIM.MODEL_VERSION, PRIM.VERSION, PRIM.SCENARIO, PRIM.TYPE
FROM V_PRIMARY_LOCPRODCUST_FUTURE AS PRIM
INNER JOIN V_PRIMARY_LOCPRODCUST_AGG_FUTURE AS PAGG ON
PRIM.CAL_DATE = PAGG.CAL_DATE 
AND PRIM.LOCATION_ID = PAGG.LOCATION_ID 
AND PRIM.PRODUCT_ID = PAGG.PRODUCT_ID
AND PRIM.CUSTOMER_GROUP = PAGG.CUSTOMER_GROUP
AND PRIM.MODEL_VERSION = PAGG.MODEL_VERSION
AND PRIM.VERSION = PAGG.VERSION
AND PRIM.SCENARIO = PAGG.SCENARIO
AND PRIM.TYPE = PAGG.TYPE
ORDER BY PRIM.CAL_DATE, PRIM.LOCATION_ID, PRIM.PRODUCT_ID, 
PRIM.PRIMARY_ID,PRIM.MODEL_VERSION, PRIM.VERSION, PRIM.SCENARIO;