COLUMN TABLE "CP_STATFORECAST_UNIQUE_QTYS"(
	"CAL_DATE"  DATE NOT NULL,
	"LOCATION_ID" NVARCHAR(4) NOT NULL,
	"PRODUCT_ID" NVARCHAR(40) NOT NULL,
	"CUSTOMER_GROUP" NVARCHAR(40) NOT NULL,
	"UNIQUE_ID" INTEGER NOT NULL,
	"MODEL_VERSION" NVARCHAR(20) NOT NULL,
	"VERSION" NVARCHAR(10) NOT NULL,
	"SCENARIO" NVARCHAR(32) NOT NULL,
	"UNIQUE_PRECENT" DOUBLE,
	"UNROUNDED" DOUBLE,
	"ROUNDED" DOUBLE,
	"UNIQUE_QTY" DOUBLE,
	PRIMARY KEY (
		"CAL_DATE",
		"LOCATION_ID",
		"PRODUCT_ID",
		"CUSTOMER_GROUP",
		"UNIQUE_ID",
		"MODEL_VERSION",
		"VERSION",
		"SCENARIO"
	)
);