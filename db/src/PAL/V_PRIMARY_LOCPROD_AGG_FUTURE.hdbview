VIEW V_PRIMARY_LOCPROD_AGG_FUTURE AS
SELECT DISTINCT CAL_DATE, LOCATION_ID, PRODUCT_ID, MODEL_VERSION, VERSION, SCENARIO, 
 SUM(PRIMARY_QTY) AS PRIMARY_AGG, "TYPE"
FROM V_PRIMARY_LOCPROD_FUTURE
GROUP BY CAL_DATE, LOCATION_ID, PRODUCT_ID, MODEL_VERSION, VERSION, SCENARIO,"TYPE"
ORDER BY CAL_DATE, LOCATION_ID, PRODUCT_ID, MODEL_VERSION, VERSION, SCENARIO, "TYPE";