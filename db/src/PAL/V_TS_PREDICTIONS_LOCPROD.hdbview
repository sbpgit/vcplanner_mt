VIEW V_TS_PREDICTIONS_LOCPROD AS
SELECT DISTINCT CAL_DATE, LOCATION_ID, PRODUCT_ID, OBJ_TYPE, MODEL_TYPE, MODEL_VERSION, MODEL_PROFILE, VERSION, SCENARIO, SUM(PREDICTED) AS PRED_NORMALIZED 
FROM CP_TS_PREDICTIONS
GROUP BY CAL_DATE, LOCATION_ID, PRODUCT_ID, OBJ_TYPE, MODEL_TYPE, MODEL_VERSION, MODEL_PROFILE, VERSION, SCENARIO
ORDER BY CAL_DATE; 