VIEW CP_V_UNIQUE_CHAR_CHARVAL AS
SELECT DISTINCT CP_V_UNIQUE.LOCATION_ID, CP_V_UNIQUE.PRODUCT_ID, CP_V_UNIQUE.PRIMARY_ID, CP_V_UNIQUE.UNIQUE_ID,
V_PARTIALPRODCLASSCHAR.CLASS_NUM, V_UNIQUE_ID_ITEM.CHAR_NUM, V_UNIQUE_ID_ITEM.CHARVAL_NUM,  
CAL_DATE AS WEEK_DATE,
PRIMARY_QTY,
UNIQUE_PERCENT, 
UNIQUE_QTY, TYPE
FROM CP_V_UNIQUE
INNER JOIN V_UNIQUE_ID_ITEM ON
CP_V_UNIQUE.UNIQUE_ID = V_UNIQUE_ID_ITEM.UNIQUE_ID
AND CP_V_UNIQUE.UNIQUE_ID = V_UNIQUE_ID_ITEM.UNIQUE_ID
INNER JOIN V_PARTIALPRODCLASSCHAR ON
CP_V_UNIQUE.PRODUCT_ID = V_PARTIALPRODCLASSCHAR.PRODUCT_ID
AND CP_V_UNIQUE.LOCATION_ID = V_PARTIALPRODCLASSCHAR.LOCATION_ID
AND CP_V_UNIQUE.PRODUCT_ID = V_PARTIALPRODCLASSCHAR.PRODUCT_ID
AND V_UNIQUE_ID_ITEM.PRODUCT_ID = V_PARTIALPRODCLASSCHAR.REF_PRODID
AND V_UNIQUE_ID_ITEM.CLASS_NUM = V_PARTIALPRODCLASSCHAR.CLASS_NUM
ORDER BY WEEK_DATE, CLASS_NUM, CHAR_NUM, CHARVAL_NUM;