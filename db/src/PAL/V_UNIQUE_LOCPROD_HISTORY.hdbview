VIEW V_UNIQUE_LOCPROD_HISTORY AS
SELECT  USD.CAL_DATE, USD.LOCATION_ID, USD.PRODUCT_ID, USD.UNIQUE_ID, USD.PRIMARY_ID, SUM (ORD_QTY) AS UNIQUE_QTY
FROM V_UNIQUE_LOCPROD_BY_SALESDOC AS USD
INNER JOIN V_PRIMARY_LOCPROD_HISTORY_MAXDATE AS HCUST ON
USD.LOCATION_ID = HCUST.LOCATION_ID
AND USD.PRODUCT_ID = HCUST.PRODUCT_ID
AND HCUST.PRIMARY_ID LIKE_REGEXPR USD.PRIMARY_ID
AND USD.CAL_DATE <= HCUST.MAX_DATE
GROUP BY USD.CAL_DATE, USD.LOCATION_ID, USD.PRODUCT_ID, USD.UNIQUE_ID, USD.PRIMARY_ID
ORDER BY USD.CAL_DATE, USD.LOCATION_ID, USD.PRODUCT_ID, USD.UNIQUE_ID, USD.PRIMARY_ID;