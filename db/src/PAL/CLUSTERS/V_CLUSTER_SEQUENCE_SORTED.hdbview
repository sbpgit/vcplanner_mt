VIEW V_CLUSTER_SEQUENCE_SORTED AS
SELECT LOCATION_ID, PRODUCT_ID, SOURCE_CLUSTER_ID, DISTANCE, TARGET_CLUSTER_ID, TARGET_CLUSTER_ID AS ID,
           ROW_NUMBER() OVER (ORDER BY SOURCE_CLUSTER_ID, DISTANCE, TARGET_CLUSTER_ID) AS SORT_SEQ
    FROM V_CLUSTER_SEQUENCE
    WHERE SOURCE_CLUSTER_ID = 1
    ORDER BY SORT_SEQ;
