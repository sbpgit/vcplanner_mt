VIEW V_CLUSTER_PID_QTY_TS AS
SELECT DISTINCT MAT_AVAILDATE, CPIDS.LOCATION_ID, CPIDS.PRODUCT_ID, CPIDS.PRIMARY_ID,
CPIDS.PROFILE, CLUSTER_ID, 
ORD_QTY FROM V_CLUSTER_PRIMARY_ID_ORDERS_TS AS CPIDS
ORDER BY  MAT_AVAILDATE,CPIDS.LOCATION_ID, CPIDS.PRODUCT_ID, CPIDS.PROFILE, CLUSTER_ID;

