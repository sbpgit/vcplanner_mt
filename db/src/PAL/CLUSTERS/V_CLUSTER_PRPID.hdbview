VIEW V_CLUSTER_PRPID AS
SELECT AR.LOCATION_ID, AR.PRODUCT_ID, AR.UNIQUE_ID, AR.CLUSTER_ID, PR.PROFILE, PR.PRP_PID, PR.PRP_PID_TYPE
FROM CP_AHC_RESULTS AS AR
INNER JOIN CP_PRPIDS AS PR ON
	 AR.LOCATION_ID = PR.LOCATION_ID
	 AND AR.PRODUCT_ID = PR.PRODUCT_ID
	 AND AR.UNIQUE_ID = PR.PRP_PID
	 AND AR.MODEL_PROFILE = PR.PROFILE
	 AND PR.PRP_PID_TYPE = 3