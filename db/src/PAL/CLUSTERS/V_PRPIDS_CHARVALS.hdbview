VIEW V_PRPIDS_CHARVALS AS
SELECT PRPIDS.LOCATION_ID, PRPIDS.PRODUCT_ID,PRPIDS.PROFILE, PRPIDS.PRP_PID,
C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15, C16, C17, C18, C19, C20
FROM  CP_PRPIDS AS PRPIDS 
INNER JOIN CP_CLUSTER_DATA AS CD ON
PRPIDS.LOCATION_ID = CD.LOCATION_ID
--AND PRPIDS.PRODUCT_ID = SUBSTR_BEFORE(CD.PRODUCT_ID,'_ALLPIDS')
AND PRPIDS.PRODUCT_ID = CD.PRODUCT_ID
AND TO_INT(PRPIDS.PRP_PID) = TO_INT(CD.UNIQUE_ID)
ORDER BY PRPIDS.LOCATION_ID, PRPIDS.PRODUCT_ID, PRPIDS.PRP_PID,
C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15, C16, C17, C18, C19, C20;