VIEW V_CLUSTER_PRIMARY_ID_ORDERS_TS AS
SELECT DISTINCT SH.MAT_AVAILDATE, SH.LOCATION_ID, SH.PRODUCT_ID, AHC.PROFILE, SH.UNIQUE_ID, 
--PRPID.PRP_PID_TYPE,
 CASE WHEN AHC.LEFT_ID = SH.PRIMARY_ID THEN AHC.LEFT_ID ELSE AHC.RIGHT_ID END AS PRIMARY_ID, 
 CASE WHEN AHC.LEFT_ID = SH.PRIMARY_ID THEN AHC.LEFT_ID_CLUSTER ELSE AHC.RIGHT_ID_CLUSTER END AS CLUSTER_ID, 
 SH.ORD_QTY,
CASE WHEN LOCPROD_ORDER_QTY > 0 THEN ROUND(PORDS.ORD_QTY/LOCPROD_ORDER_QTY, 5) ELSE 0 END AS GROUP_ID_WEIGHT
FROM V_SALES_H AS SH
INNER JOIN CP_V_AHC_CLUSTER_RESULTS AS AHC ON
(AHC.LEFT_ID = SH.PRIMARY_ID 
AND AHC.LOCATION_ID = SH.LOCATION_ID
AND AHC.PRODUCT_ID = SH.PRODUCT_ID)
OR 
(AHC.RIGHT_ID = SH.PRIMARY_ID
AND AHC.LOCATION_ID = SH.LOCATION_ID
AND AHC.PRODUCT_ID = SH.PRODUCT_ID)
INNER JOIN V_PRIMARY_ID_ORDERS_TS AS PORDS ON
SH.PRIMARY_ID = PORDS.PRIMARY_ID 
AND SH.LOCATION_ID = PORDS.LOCATION_ID
AND SH.PRODUCT_ID = PORDS.PRODUCT_ID
AND SH.MAT_AVAILDATE = PORDS.MAT_AVAILDATE
INNER JOIN V_LOCPROD_ORDERS_TS AS LPOQ ON
SH.LOCATION_ID = LPOQ.LOCATION_ID
AND SH.PRODUCT_ID = LPOQ.PRODUCT_ID
AND SH.MAT_AVAILDATE = LPOQ.MAT_AVAILDATE
--INNER JOIN CP_PRPIDS AS PRPID 
--ON  SH.LOCATION_ID = PRPID.LOCATION_ID  
--AND SH.PRODUCT_ID = PRPID.PRODUCT_ID 
--WHERE PRPID.PRP_PID_TYPE != 1
--AND PRPID.PRP_PID_TYPE != 2
--AND PRPID.PRP_PID_TYPE != 4
-- WHERE SH.LOCATION_ID =  'PLUS' AND SH.PRODUCT_ID = '000000000000000011' 
-- AND PROFILE = 'SBP_AHC_PI'
ORDER BY SH.MAT_AVAILDATE, CLUSTER_ID, SH.LOCATION_ID, SH.PRODUCT_ID;