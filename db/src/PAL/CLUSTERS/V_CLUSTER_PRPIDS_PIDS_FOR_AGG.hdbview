
VIEW V_CLUSTER_PRPIDS_PIDS_FOR_AGGREGATION AS
SELECT DISTINCT MP.LOCATION_ID,
	MP.PRODUCT_ID,
	MP.PROFILE,
	MP.CLUSTER_ID,
	MP.PRPID,
	MP.PID FROM CP_CLUSTER_PRPIDS_MAPPED_PIDS AS MP
MINUS
SELECT 
	IP.LOCATION_ID,
	IP.PRODUCT_ID,
	IP.PROFILE,
	IP.CLUSTER_ID,
	IP.PRPID,
	IP.PID FROM V_INDEPENDENT_PRPIDS AS IP;