VIEW V_PIDS_CLUSTERED_DEMAND AS
SELECT DISTINCT PCA.LOCATION_ID, PCA.PRODUCT_ID, AR.CLUSTER_ID, AR.MODEL_PROFILE, PCA.PID, PCA.X, PCA.Y, PIDMD.START_DATE, PIDMD.END_DATE, 
PIDMD.DEMAND,
CD.C1, CD.C2,CD.C3, CD.C4, CD.C5, CD.C6, CD.C7, CD.C8, CD.C9, CD.C10,
CD.C11, CD.C12,CD.C13, CD.C14, CD.C15, CD.C16, CD.C17, CD.C18, CD.C19, CD.C20,
CD.C21, CD.C22,CD.C23, CD.C24, CD.C25, CD.C26, CD.C27, CD.C28, CD.C29, CD.C30
FROM V_PCA_COMPONENTS_XY AS PCA
INNER JOIN V_PIDS_DEMAND AS PIDMD ON
PCA.LOCATION_ID = PIDMD.LOCATION_ID
AND PCA.PRODUCT_ID = PIDMD.PRODUCT_ID
AND PCA.PID = PIDMD.PRIMARY_ID
AND PIDMD. END_DATE >= PIDMD.START_DATE
INNER JOIN CP_V_AHC_CLUSTERS_SORTED_UNIQUEID AS AR ON
PCA.LOCATION_ID = AR.LOCATION_ID
AND PCA.PRODUCT_ID = AR.PRODUCT_ID
AND PCA.PID = AR.UNIQUE_ID
INNER JOIN CP_CLUSTER_DATA AS CD ON
PCA.LOCATION_ID = CD.LOCATION_ID
AND PCA.PRODUCT_ID = CD.PRODUCT_ID
AND PCA.PID = CD.UNIQUE_ID
GROUP BY PCA.LOCATION_ID, PCA.PRODUCT_ID, AR.MODEL_PROFILE, AR.CLUSTER_ID, PCA.PID, PCA.X, PCA.Y, PIDMD.START_DATE, PIDMD.END_DATE,
PIDMD.DEMAND,
CD.C1, CD.C2,CD.C3, CD.C4, CD.C5, CD.C6, CD.C7, CD.C8, CD.C9, CD.C10,
CD.C11, CD.C12,CD.C13, CD.C14, CD.C15, CD.C16, CD.C17, CD.C18, CD.C19, CD.C20,
CD.C21, CD.C22,CD.C23, CD.C24, CD.C25, CD.C26, CD.C27, CD.C28, CD.C29, CD.C30;