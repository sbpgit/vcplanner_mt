VIEW V_INDEPENDENT_PRPIDS AS
SELECT DISTINCT MP.LOCATION_ID,
	MP.PRODUCT_ID,
	MP.PROFILE,
	MP.CLUSTER_ID,
	MP.PRPID,
	MP.PID
FROM CP_CLUSTER_PRPIDS_MAPPED_PIDS AS MP
INNER JOIN CP_PRPIDS AS PR ON
MP.LOCATION_ID = PR.LOCATION_ID
AND MP.PRODUCT_ID = PR.PRODUCT_ID
AND MP.PROFILE = PR.PROFILE
AND MP.PID = PR.PRP_PID
AND PR.PRP_PID_TYPE != 3;