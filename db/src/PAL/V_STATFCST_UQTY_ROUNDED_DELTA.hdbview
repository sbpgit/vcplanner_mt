VIEW V_STATFCST_UQTY_ROUNDED_DELTA AS
SELECT CAL_DATE, STATF.LOCATION_ID, STATF.PRODUCT_ID, STATF.CUSTOMER_GROUP, STATF.UNIQUE_ID, 
STATF.MODEL_VERSION, STATF.VERSION, 
STATF.SCENARIO, (UNROUNDED - ROUNDED) AS DEVIATION
FROM CP_STATFORECAST_UNIQUE_QTYS AS STATF 
-- WHERE STATF.LOCATION_ID = '1710' AND STATF.PRODUCT_ID = '0000000000000000000000000000000000002250' 
-- AND STATF.CUSTOMER_GROUP = '01' AND STATF.VERSION = '__BASELINE' AND STATF.SCENARIO = '_PLAN' 
ORDER BY CAL_DATE, STATF.LOCATION_ID, STATF.PRODUCT_ID, STATF.CUSTOMER_GROUP, STATF.UNIQUE_ID, STATF.VERSION, STATF.SCENARIO