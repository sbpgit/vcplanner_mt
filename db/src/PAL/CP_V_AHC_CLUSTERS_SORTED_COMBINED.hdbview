VIEW CP_V_AHC_CLUSTERS_SORTED_COMBINED AS
SELECT  A.LOCATION_ID, A.PRODUCT_ID, 
A.CLUSTER_ID, B.SORT_SEQ, A.WEIGHT,
A.UNIQUE_ID, 
START_DATE, END_DATE,
SUM(DEMAND) AS DEMAND, SUM(FORECASTED) AS FORECASTED, SUM(UNCONSUMED) AS UNCONSUMED, 
	SUM(TOTAL_DEMAND) AS TOTAL_DEMAND, MODEL_VERSION, MONTH, YEAR,QUARTER,
	A.C1, A.C2, A.C3, A.C4, A.C5, A.C6, A.C7, A.C8, A.C9, A.C10, A.C11, A.C12, A.C13, A.C14, A.C15,
	A.C16, A.C17, A.C18, A.C19, A.C20, A.C21, A.C22, A.C23, A.C24, A.C25, A.C26, A.C27, A.C28, A.C29, A.C30,
	A.NC1, A.NC2, A.NC3, A.NC4, A.NC5, A.NC6, A.NC7, A.NC8, A.NC9, A.NC10, A.NC11, A.NC12, A.NC13, A.NC14, A.NC15,
	A.NC16, A.NC17, A.NC18, A.NC19, A.NC20, A.NC21, A.NC22, A.NC23, A.NC24, A.NC25, A.NC26, A.NC27, A.NC28, A.NC29, A.NC30
FROM CP_V_AHC_CLUSTERS_PRESORTED_COMBINED A
JOIN V_CLUSTER_SEQUENCE_SORTED B
  ON A.LOCATION_ID = B.LOCATION_ID
 AND A.PRODUCT_ID = B.PRODUCT_ID
 AND A.CLUSTER_ID = B.TARGET_CLUSTER_ID
--  WHERE A.PRODUCT_ID = 'A61A_P' 
--  AND START_DATE >= '2024-01-01'
--  AND END_DATE <= '2024-12-31'
GROUP BY  A.LOCATION_ID, A.PRODUCT_ID, 
A.CLUSTER_ID, B.SORT_SEQ,
A.UNIQUE_ID, MODEL_VERSION, START_DATE, END_DATE, MONTH, YEAR,QUARTER,
	A.C1, A.C2, A.C3, A.C4, A.C5, A.C6, A.C7, A.C8, A.C9, A.C10, A.C11, A.C12, A.C13, A.C14, A.C15,
	A.C16, A.C17, A.C18, A.C19, A.C20, A.C21, A.C22, A.C23, A.C24, A.C25, A.C26, A.C27, A.C28, A.C29, A.C30,
	A.NC1, A.NC2, A.NC3, A.NC4, A.NC5, A.NC6, A.NC7, A.NC8, A.NC9, A.NC10, A.NC11, A.NC12, A.NC13, A.NC14, A.NC15,
	A.NC16, A.NC17, A.NC18, A.NC19, A.NC20, A.NC21, A.NC22, A.NC23, A.NC24, A.NC25, A.NC26, A.NC27, A.NC28, A.NC29, A.NC30,
	A.WEIGHT

UNION ALL

SELECT SH.LOCATION_ID, SH.PRODUCT_ID, 
-- MAX(CS.TARGET_CLUSTER_ID) AS CLUSTER_ID,
999999 AS CLUSTER_ID,
MAX(CS.SORT_SEQ) + 1 AS SORT_SEQ,
1 AS WEIGHT,
999999 AS UNIQUE_ID, 
CURRENT_DATE AS START_DATE,
CURRENT_DATE AS END_DATE,
0 AS DEMAND,
0 AS FORECASTED,
0 AS UNCONSUMED,
0 AS TOTAL_DEMAND,
'NA' AS MODEL_VERSION,
MONTH(CURRENT_DATE) AS MONTH,
YEAR(CURRENT_DATE) AS YEAR,
QUARTER(CURRENT_DATE) AS QUARTER,
MAX(CASE WHEN SEQUENCE = 1 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C1,
MAX(CASE WHEN SEQUENCE = 2 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C2,
MAX(CASE WHEN SEQUENCE = 3 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C3,
MAX(CASE WHEN SEQUENCE = 4 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C4,
MAX(CASE WHEN SEQUENCE = 5 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C5,
MAX(CASE WHEN SEQUENCE = 6 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C6,
MAX(CASE WHEN SEQUENCE = 7 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C7,
MAX(CASE WHEN SEQUENCE = 8 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C8,
MAX(CASE WHEN SEQUENCE = 9 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C9,
MAX(CASE WHEN SEQUENCE = 10 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C10,
MAX(CASE WHEN SEQUENCE = 11 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C11,
MAX(CASE WHEN SEQUENCE = 12 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C12,
MAX(CASE WHEN SEQUENCE = 13 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C13,
MAX(CASE WHEN SEQUENCE = 14 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C14,
MAX(CASE WHEN SEQUENCE = 15 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C15,
MAX(CASE WHEN SEQUENCE = 16 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C16,
MAX(CASE WHEN SEQUENCE = 17 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C17,
MAX(CASE WHEN SEQUENCE = 18 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C18,
MAX(CASE WHEN SEQUENCE = 19 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C19,
MAX(CASE WHEN SEQUENCE = 20 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C20,
MAX(CASE WHEN SEQUENCE = 21 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C21,
MAX(CASE WHEN SEQUENCE = 22 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C22,
MAX(CASE WHEN SEQUENCE = 23 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C23,
MAX(CASE WHEN SEQUENCE = 24 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C24,
MAX(CASE WHEN SEQUENCE = 25 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C25,
MAX(CASE WHEN SEQUENCE = 26 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C26,
MAX(CASE WHEN SEQUENCE = 27 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C27,
MAX(CASE WHEN SEQUENCE = 28 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C28,
MAX(CASE WHEN SEQUENCE = 29 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C29,
MAX(CASE WHEN SEQUENCE = 30 AND CHAR_TYPE = 'P' THEN CHAR_DESC ELSE NULL END) AS C30,
NULL AS NC1, NULL AS NC2, NULL AS NC3, NULL AS NC4, NULL AS NC5, NULL AS NC6, NULL AS NC7, NULL AS NC8, NULL AS NC9, NULL AS NC10,
NULL AS NC11, NULL AS NC12, NULL AS NC13, NULL AS NC14, NULL AS NC15, NULL AS NC16, NULL AS NC17, NULL AS NC18, NULL AS NC19, NULL AS NC20,
NULL AS NC21, NULL AS NC22, NULL AS NC23, NULL AS NC24, NULL AS NC25, NULL AS NC26, NULL AS NC27, NULL AS NC28, NULL AS NC29, NULL AS NC30
FROM V_CHARGROUPWEIGHTAGE AS CW
LEFT JOIN V_SALES_H AS SH ON
SH.REF_PRODID = CW.PRODUCT_ID
LEFT JOIN V_CLUSTER_SEQUENCE_SORTED AS CS ON
SH.LOCATION_ID = CS.LOCATION_ID
AND SH.PRODUCT_ID = CS.PRODUCT_ID
--  WHERE SH.PRODUCT_ID = 'A61A_P'
GROUP BY SH.LOCATION_ID, SH.PRODUCT_ID;

-- ORDER BY B.SORT_SEQ,A.WEIGHT,
-- C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15,
-- C16, C17, C18, C19, C20, C21, C22, C23, C24, C25, C26, C27, C28, C29, C30, START_DATE, END_DATE;