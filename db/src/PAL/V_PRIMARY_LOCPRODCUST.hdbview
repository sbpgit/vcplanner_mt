VIEW V_PRIMARY_LOCPRODCUST AS
SELECT DISTINCT CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, PRIMARY_ID, PRIMARY_QTY, "TYPE" FROM V_PRIMARY_LOCPRODCUST_HISTORY
UNION SELECT CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, PRIMARY_ID, PRIMARY_QTY, "TYPE" FROM V_PRIMARY_LOCPRODCUST_FUTURE
WHERE MODEL_VERSION = 'Active'
ORDER BY CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, PRIMARY_ID, TYPE;