VIEW V_STATFCST_UNIQUE_LOCPROD AS
SELECT CAL_DATE, LOCATION_ID, PRODUCT_ID, UNIQUE_ID, 
MODEL_VERSION, VERSION, SCENARIO, SUM(UNIQUE_QTY) AS FORECAST_QTY 
FROM CP_STATFORECAST_UNIQUE_QTYS
GROUP BY  CAL_DATE, LOCATION_ID, PRODUCT_ID, UNIQUE_ID, MODEL_VERSION, VERSION, SCENARIO
ORDER BY  CAL_DATE, LOCATION_ID, PRODUCT_ID, UNIQUE_ID, MODEL_VERSION, VERSION, SCENARIO;