VIEW V_PRIMARY_LOCPROD_FUTURE AS
SELECT DISTINCT CAL_DATE, LOCATION_ID, PRODUCT_ID, CONCAT(OBJ_DEP, CONCAT('_', OBJ_COUNTER)) AS PRIMARY_ID, 
SUM(PREDICTED) AS PRIMARY_QTY, MODEL_VERSION, VERSION, SCENARIO,  
'FUTURE' AS TYPE
FROM CP_TS_PREDICTIONS
GROUP BY CAL_DATE, LOCATION_ID, PRODUCT_ID,OBJ_DEP,OBJ_COUNTER,MODEL_VERSION, VERSION, SCENARIO 
ORDER BY CAL_DATE,LOCATION_ID, PRODUCT_ID, PRIMARY_ID, MODEL_VERSION, VERSION, SCENARIO ASC;