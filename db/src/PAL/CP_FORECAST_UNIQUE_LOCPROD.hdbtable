COLUMN TABLE "CP_FORECAST_UNIQUE_LOCPROD"(
	"CAL_DATE"  DATE NOT NULL,
	"LOCATION_ID" NVARCHAR(4) NOT NULL,
	"PRODUCT_ID" NVARCHAR(40) NOT NULL,
	"UNIQUE_ID" INTEGER NOT NULL,
	"MODEL_VERSION" NVARCHAR(20) NOT NULL,
	"VERSION" NVARCHAR(10) NOT NULL,
	"SCENARIO" NVARCHAR(32) NOT NULL,
	"UNIQUE_PERCENT" DOUBLE,
	"UNROUNDED" DOUBLE,
	"ROUNDED" DOUBLE,
	"QUANTITY" DOUBLE,
    "OVERRIDE" BOOLEAN,
	PRIMARY KEY (
		"CAL_DATE",
		"LOCATION_ID",
		"PRODUCT_ID",
		"UNIQUE_ID",
		"MODEL_VERSION",
		"VERSION",
		"SCENARIO",
        "OVERRIDE"
	)
);