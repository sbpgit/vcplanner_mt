VIEW CP_V_PREDICTIONS_BY_CHAR AS	
SELECT DISTINCT CAL_DATE, PRED.LOCATION_ID, PRED.PRODUCT_ID, OBJ_DEP, OBJ_COUNTER, OBJ_TYPE, 
MODEL_VERSION, VERSION, SCENARIO, PRTL.CHAR_NUM, 
--CLASS_NUM, 
PRTL.CHAR_NAME, PRTL.CHARVAL_NUM, OPT_STARTTIME, DELTA_TIME, PRE_OPTIMIZED, PRE_OPTIMIZED_TIME
FROM V_CP_TS_PREDICTIONS_TELESCOPIC AS PRED
INNER JOIN V_PARTIALPRODCLASSCHAR AS PRTL ON
PRED.LOCATION_ID = PRTL.LOCATION_ID
AND PRED.PRODUCT_ID = PRTL.PRODUCT_ID
INNER JOIN V_UNIQUE_ID AS UNQ ON
-- PRED.LOCATION_ID = UNQ.LOCATION_ID
-- AND 
PRED.OBJ_DEP = UNQ.UNIQUE_ID
AND PRTL.REF_PRODID = UNQ.PRODUCT_ID
AND PRTL.CHAR_NUM = UNQ.CHAR_NUM
AND PRTL.CHARVAL_NUM = UNQ.CHARVAL_NUM
-- WHERE ( UPPER("MODEL_VERSION") = UPPER('Active') ) AND
WHERE	UNQ.UID_TYPE = 'P'
	ORDER BY CAL_DATE, OBJ_DEP, OBJ_COUNTER, OBJ_TYPE, MODEL_VERSION, VERSION, SCENARIO, CHAR_NUM;