VIEW V_STATFORECAST_PID_UID_QTYS AS
SELECT DISTINCT SUQ.CAL_DATE, SUQ.LOCATION_ID, SUQ.PRODUCT_ID, SUQ.CUSTOMER_GROUP, SUQ.UNIQUE_ID, 
PRIMARY_ID, MODEL_VERSION, VERSION, SCENARIO, SUQ.UNIQUE_QTY
FROM CP_STATFORECAST_UNIQUE_QTYS AS SUQ 
INNER JOIN V_UNIQUE_PRIMARY_MAP AS VSH ON
SUQ.LOCATION_ID = VSH.LOCATION_ID
AND SUQ.PRODUCT_ID = VSH.PRODUCT_ID
AND SUQ.CUSTOMER_GROUP = VSH.CUSTOMER_GROUP
AND SUQ.UNIQUE_ID = VSH.UNIQUE_ID
ORDER BY SUQ.CAL_DATE, PRIMARY_ID;