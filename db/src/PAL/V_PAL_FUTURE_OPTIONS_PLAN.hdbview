VIEW V_PAL_FUTURE_OPTIONS_PLAN AS 
SELECT DISTINCT OPTIONS.LOCATION_ID, OPTIONS.PRODUCT_ID, 
--CLASS_NUM, 
CHAR_NUM, CHARVAL_NUM, VERSION, SCENARIO, 
OPTIONS.WEEK_DATE, OPT_PERCENT AS OPT_PERCENT, (QUANTITY*OPT_PERCENT/100.0) AS OPT_QTY, '0' AS MANUALOPTION
FROM CP_V_UNIQUE_OPTIONS_NORMALIZED AS OPTIONS
INNER JOIN CP_IBP_FUTUREDEMAND AS DEMAND ON
OPTIONS.LOCATION_ID = DEMAND.LOCATION_ID
AND OPTIONS.PRODUCT_ID = DEMAND.PRODUCT_ID
AND OPTIONS.WEEK_DATE = DEMAND.WEEK_DATE
ORDER BY  OPTIONS.WEEK_DATE, OPTIONS.LOCATION_ID,OPTIONS.PRODUCT_ID, CHAR_NUM, CHARVAL_NUM, VERSION, SCENARIO;

