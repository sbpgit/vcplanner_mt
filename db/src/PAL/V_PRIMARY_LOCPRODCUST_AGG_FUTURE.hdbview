VIEW V_PRIMARY_LOCPRODCUST_AGG_FUTURE AS
SELECT DISTINCT CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP,
MODEL_VERSION, VERSION, SCENARIO, 
 SUM(PRIMARY_QTY) AS PRIMARY_AGG, "TYPE"
FROM V_PRIMARY_LOCPRODCUST_FUTURE
GROUP BY CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, MODEL_VERSION, VERSION, SCENARIO,"TYPE"
ORDER BY CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP,MODEL_VERSION, VERSION, SCENARIO, "TYPE";