VIEW CP_V_UNIQUE_OPTIONS_NORMALIZED AS
SELECT OPT.WEEK_DATE, OPT.LOCATION_ID, OPT.PRODUCT_ID, OPT.CLASS_NUM, OPT.CHAR_NUM, OPT.CHARVAL_NUM, 100* (OPT.OPT_QTY/OPTAGG.OPT_SUM) AS OPT_PERCENT
FROM CP_V_UNIQUE_OPTIONS AS OPT
INNER JOIN CP_V_UNIQUE_OPTIONS_AGG AS OPTAGG ON
OPT.LOCATION_ID = OPTAGG.LOCATION_ID
AND OPT.PRODUCT_ID = OPTAGG.PRODUCT_ID
AND OPT.CLASS_NUM = OPTAGG.CLASS_NUM
AND OPT.CHAR_NUM = OPTAGG.CHAR_NUM
AND OPT.WEEK_DATE = OPTAGG.WEEK_DATE
ORDER BY  OPT.WEEK_DATE, OPT.LOCATION_ID, OPT.PRODUCT_ID, OPT.CLASS_NUM, OPT.CHAR_NUM, OPT.CHARVAL_NUM;