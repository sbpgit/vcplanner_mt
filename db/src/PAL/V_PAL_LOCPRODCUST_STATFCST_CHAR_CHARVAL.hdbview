VIEW V_PAL_LOCPRODCUST_STATFCST_CHAR_CHARVAL AS
SELECT DISTINCT CHVAL.WEEK_DATE, CHVAL.LOCATION_ID, CHVAL.PRODUCT_ID, 
CHVAL.CUSTOMER_GROUP, CHVAL.MODEL_VERSION, CHVAL.VERSION, CHVAL.SCENARIO,
--CHVAL.CLASS_NUM,
CHVAL.CHAR_NUM, CHVAL.CHARVAL_NUM, CHVAL.CHARVAL_QTY AS OPT_QTY, 
CASE WHEN (CHAR_QTY!= 0) THEN 100*CHARVAL_QTY/CHAR_QTY ELSE 0 END AS OPT_PERCENT
FROM V_PAL_LOCPRODCUST_CHAR_CHARVAL_QTY AS CHVAL
INNER JOIN V_PAL_LOCPRODCUST_CHAR_QTY AS CHARVAL ON 
CHVAL.WEEK_DATE = CHARVAL.WEEK_DATE
AND CHVAL.LOCATION_ID = CHARVAL.LOCATION_ID
AND CHVAL.PRODUCT_ID = CHARVAL.PRODUCT_ID
AND CHVAL.CUSTOMER_GROUP = CHARVAL.CUSTOMER_GROUP
AND CHVAL.MODEL_VERSION = CHARVAL.MODEL_VERSION
AND CHVAL.VERSION = CHARVAL.VERSION
AND CHVAL.SCENARIO = CHARVAL.SCENARIO
--AND CHVAL.CLASS_NUM = CHARVAL.CLASS_NUM
AND CHVAL.CHAR_NUM = CHARVAL.CHAR_NUM
ORDER BY CHVAL.WEEK_DATE, CHVAL.LOCATION_ID, CHVAL.PRODUCT_ID, CHVAL.CUSTOMER_GROUP,
CHVAL.MODEL_VERSION, CHVAL.VERSION, CHVAL.SCENARIO, 
--CHVAL.CLASS_NUM, 
CHVAL.CHAR_NUM, CHVAL.CHARVAL_NUM;