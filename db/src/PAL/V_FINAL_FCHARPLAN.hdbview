VIEW V_FINAL_FCHARPLAN AS 
SELECT A.LOCATION_ID, A.PRODUCT_ID, A.CUSTOMER_GROUP, A.MODEL_VERSION, A.CLASS_NUM,  A.CHAR_NUM, A.CHARVAL_NUM,
A.VERSION, A.SCENARIO, A.WEEK_DATE, 
CASE WHEN B.CHAR_QTY > 0 THEN 100*(A.OPT_QTY/CHAR_QTY) ELSE 0 END AS OPT_PERCENT, 
A.OPT_QTY, A.TYPE, A.UNROUNDED, A.ROUNDED, A.DELTA
FROM CP_PAL_FCHARPLAN AS A
INNER JOIN V_PAL_FCHARACTERPLAN B ON
A.LOCATION_ID = B.LOCATION_ID
AND A.PRODUCT_ID = B.PRODUCT_ID
AND A.CUSTOMER_GROUP = B.CUSTOMER_GROUP
AND A.MODEL_VERSION = B.MODEL_VERSION
AND A.CLASS_NUM = B.CLASS_NUM
AND A.CHAR_NUM = B.CHAR_NUM
AND A.VERSION = B.VERSION
AND A.SCENARIO = B.SCENARIO
AND A.WEEK_DATE = B.WEEK_DATE