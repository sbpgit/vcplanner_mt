VIEW CP_V_AHC_CLUSTERS_PRESORTED_COMBINED AS
SELECT A.LOCATION_ID, A.PRODUCT_ID, 
A.CLUSTER_ID, D.SORT_SEQ,
A.UNIQUE_ID, C.DISTANCE AS WEIGHT,
A.START_DATE, A.END_DATE, 
CASE WHEN (B.MODEL_VERSION IN ('Active', 'Simulation')) THEN (B.DEMAND) ELSE (A.DEMAND) END AS DEMAND,
CASE WHEN (B.MODEL_VERSION IN ('Active', 'Simulation')) THEN (B.FORECASTED) ELSE 0 END AS FORECASTED,
CASE WHEN (B.MODEL_VERSION IN ('Active', 'Simulation')) THEN (B.UNCONSUMED) ELSE 0 END AS UNCONSUMED,
CASE WHEN (B.MODEL_VERSION IN ('Active', 'Simulation')) THEN ((B.DEMAND) + (B.UNCONSUMED))
	ELSE A.DEMAND END AS TOTAL_DEMAND, B.MODEL_VERSION,
MONTH(A.START_DATE) AS MONTH,
YEAR(A.START_DATE) AS YEAR,
QUARTER(A.START_DATE) AS QUARTER,
A.C1, A.C2, A.C3, A.C4, A.C5, A.C6, A.C7, A.C8, A.C9, A.C10, A.C11, A.C12, A.C13, A.C14, A.C15,
A.C16, A.C17, A.C18, A.C19, A.C20, A.C21, A.C22, A.C23, A.C24, A.C25, A.C26, A.C27, A.C28, A.C29, A.C30,
A.NC1, A.NC2, A.NC3, A.NC4, A.NC5, A.NC6, A.NC7, A.NC8, A.NC9, A.NC10, A.NC11, A.NC12, A.NC13, A.NC14, A.NC15,
A.NC16, A.NC17, A.NC18, A.NC19, A.NC20, A.NC21, A.NC22, A.NC23, A.NC24, A.NC25, A.NC26, A.NC27, A.NC28, A.NC29, A.NC30
FROM V_PID_ACTUALS_CLUSTERED AS A
LEFT JOIN V_CIR_UNCONSUMED AS B
 ON B.LOCATION_ID = A.LOCATION_ID
 AND B.PRODUCT_ID = A.PRODUCT_ID
 AND B.PRIMARY_ID = A.UNIQUE_ID 
 AND B.START_DATE = A.START_DATE
INNER JOIN CP_CLUSTERS_UID_SEQUENCE AS C ON
A.LOCATION_ID = C.LOCATION_ID
AND A.PRODUCT_ID = C.PRODUCT_ID
AND A. UNIQUE_ID = C.UNIQUE_ID
AND A.CLUSTER_ID = C.CLUSTER_ID
INNER JOIN V_CLUSTER_SEQUENCE_SORTED D
  ON A.LOCATION_ID = D.LOCATION_ID
 AND A.PRODUCT_ID = D.PRODUCT_ID
 AND A.CLUSTER_ID = D.TARGET_CLUSTER_ID
 GROUP BY
 A.LOCATION_ID, A.PRODUCT_ID, 
 	A.CLUSTER_ID, D.SORT_SEQ,
	A.UNIQUE_ID,  C.DISTANCE,
	A.START_DATE, A.END_DATE, 
	B.MODEL_VERSION, B.DEMAND, A.DEMAND, B.FORECASTED, B.UNCONSUMED,
	A.C1, A.C2, A.C3, A.C4, A.C5, A.C6, A.C7, A.C8, A.C9, A.C10, A.C11, A.C12, A.C13, A.C14, A.C15,
	A.C16, A.C17, A.C18, A.C19, A.C20, A.C21, A.C22, A.C23, A.C24, A.C25, A.C26, A.C27, A.C28, A.C29, A.C30,
	A.NC1, A.NC2, A.NC3, A.NC4, A.NC5, A.NC6, A.NC7, A.NC8, A.NC9, A.NC10, A.NC11, A.NC12, A.NC13, A.NC14, A.NC15,
	A.NC16, A.NC17, A.NC18, A.NC19, A.NC20, A.NC21, A.NC22, A.NC23, A.NC24, A.NC25, A.NC26, A.NC27, A.NC28, A.NC29, A.NC30
	--, A.WEIGHT
UNION ALL
SELECT
B.LOCATION_ID, B.PRODUCT_ID, 
B.CLUSTER_ID, D.SORT_SEQ,
B.PRIMARY_ID AS UNIQUE_ID, C.DISTANCE AS WEIGHT,
B.START_DATE, B.END_DATE, 
(B.DEMAND) AS DEMAND,
(B.FORECASTED) AS FORECASTED,
(B.UNCONSUMED) AS UNCONSUMED,
((B.DEMAND) + (B.UNCONSUMED)) AS TOTAL_DEMAND,
B.MODEL_VERSION,
MONTH(B.START_DATE) AS MONTH,
YEAR(B.START_DATE) AS YEAR,
QUARTER(B.START_DATE) AS QUARTER,
B.C1, B.C2, B.C3, B.C4, B.C5, B.C6, B.C7, B.C8, B.C9, B.C10, B.C11, B.C12, B.C13, B.C14, B.C15,
B.C16, B.C17, B.C18, B.C19, B.C20, B.C21, B.C22, B.C23, B.C24, B.C25, B.C26, B.C27, B.C28, B.C29, B.C30,
B.NC1, B.NC2, B.NC3, B.NC4, B.NC5, B.NC6, B.NC7, B.NC8, B.NC9, B.NC10, B.NC11, B.NC12, B.NC13, B.NC14, B.NC15,
B.NC16, B.NC17, B.NC18, B.NC19, B.NC20, B.NC21, B.NC22, B.NC23, B.NC24, B.NC25, B.NC26, B.NC27, B.NC28, B.NC29, 
B.NC30
FROM V_CIR_UNCONSUMED AS B
 LEFT JOIN V_PID_ACTUALS_CLUSTERED AS A ON
B.LOCATION_ID = A.LOCATION_ID
 AND B.PRODUCT_ID = A.PRODUCT_ID
 AND B.PRIMARY_ID = A.UNIQUE_ID
 AND B.START_DATE = A.START_DATE
INNER JOIN CP_CLUSTERS_UID_SEQUENCE AS C ON
 B.LOCATION_ID = C.LOCATION_ID
AND B.PRODUCT_ID = C.PRODUCT_ID
AND B. UNIQUE_ID = C.UNIQUE_ID
AND B.CLUSTER_ID = C.CLUSTER_ID
INNER JOIN V_CLUSTER_SEQUENCE_SORTED D
  ON B.LOCATION_ID = D.LOCATION_ID
 AND B.PRODUCT_ID = D.PRODUCT_ID
 AND B.CLUSTER_ID = D.TARGET_CLUSTER_ID
-- WHERE A.UNIQUE_ID IS NULL
GROUP BY
B.LOCATION_ID, B.PRODUCT_ID, 
B.CLUSTER_ID, D.SORT_SEQ,
B.PRIMARY_ID, C.DISTANCE, 
B.START_DATE, B.END_DATE, 
B.MODEL_VERSION, B.DEMAND, A.DEMAND, B.FORECASTED, B.UNCONSUMED,
B.C1, B.C2, B.C3, B.C4, B.C5, B.C6, B.C7, B.C8, B.C9, B.C10, B.C11, B.C12, B.C13, B.C14, B.C15,
B.C16, B.C17, B.C18, B.C19, B.C20, B.C21, B.C22, B.C23, B.C24, B.C25, B.C26, B.C27, B.C28, B.C29, B.C30,
B.NC1, B.NC2, B.NC3, B.NC4, B.NC5, B.NC6, B.NC7, B.NC8, B.NC9, B.NC10, B.NC11, B.NC12, B.NC13, B.NC14, B.NC15,
B.NC16, B.NC17, B.NC18, B.NC19, B.NC20, B.NC21, B.NC22, B.NC23, B.NC24, B.NC25, B.NC26, B.NC27, B.NC28, B.NC29, B.NC30

