VIEW V_TS_PREDICTIONS_NORMALIZED AS
SELECT DISTINCT PRED."CAL_DATE",
	PRED."LOCATION_ID",
	PRED."PRODUCT_ID",
	PRED."OBJ_TYPE",
	PRED."OBJ_DEP",
	PRED."OBJ_COUNTER",
	PRED."MODEL_TYPE",
	PRED."MODEL_VERSION",
	PRED."MODEL_PROFILE",
	PRED."VERSION",
	PRED."SCENARIO",
	100*PREDICTED/PRED_NORMALIZED,
	PRED."PREDICTED_TIME"
FROM CP_TS_PREDICTIONS AS PRED
INNER JOIN V_TS_PREDICTIONS_LOCPROD AS PRED_LOCPROD ON
PRED."CAL_DATE" = PRED_LOCPROD."CAL_DATE"
AND PRED."LOCATION_ID" = PRED_LOCPROD."LOCATION_ID"
AND PRED."PRODUCT_ID" = PRED_LOCPROD."PRODUCT_ID"
AND PRED."OBJ_TYPE" = PRED_LOCPROD."OBJ_TYPE"
AND PRED."MODEL_TYPE" = PRED_LOCPROD."MODEL_TYPE"
AND PRED."MODEL_VERSION" = PRED_LOCPROD."MODEL_VERSION"
AND PRED."MODEL_PROFILE" = PRED_LOCPROD."MODEL_PROFILE"
AND PRED."VERSION" = PRED_LOCPROD."VERSION"
AND PRED."SCENARIO" = PRED_LOCPROD."SCENARIO"
WHERE PRED.OBJ_TYPE = 'OP'
ORDER BY PRED."CAL_DATE", PRED."LOCATION_ID",
	PRED."PRODUCT_ID",
	PRED."OBJ_TYPE",
	PRED."OBJ_DEP",
	PRED."OBJ_COUNTER",
	PRED."MODEL_TYPE",
	PRED."MODEL_VERSION",
	PRED."MODEL_PROFILE",
	PRED."VERSION",
	PRED."SCENARIO";