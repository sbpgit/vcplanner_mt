VIEW V_UNIQUE_LOCPRODCUST_HISTORY_AVG_PERCENT AS
SELECT TUQ.LOCATION_ID,TUQ.PRODUCT_ID, TUQ.CUSTOMER_GROUP, TUQ.PRIMARY_ID, TUQ.UNIQUE_ID, TPQ.PRIMARY_QTY, UNIQUE_QTY,
CASE WHEN PRIMARY_QTY > 0 THEN 100.0 *(UNIQUE_QTY/PRIMARY_QTY) ELSE 0 END AS UNIQUE_PERCENT
FROM V_UNIQUE_LOCPRODCUST_HISTORY_QTY  AS TUQ
INNER JOIN V_PRIMARY_LOCPRODCUST_HISTORY_QTY AS TPQ ON
TUQ.LOCATION_ID =  TPQ.LOCATION_ID
AND TUQ.PRODUCT_ID =  TPQ.PRODUCT_ID
AND TUQ.PRIMARY_ID =  TPQ.PRIMARY_ID
AND TUQ.CUSTOMER_GROUP =  TPQ.CUSTOMER_GROUP
ORDER BY TUQ.LOCATION_ID, TUQ.PRODUCT_ID,TUQ.CUSTOMER_GROUP,TUQ.PRIMARY_ID,TUQ.UNIQUE_ID;