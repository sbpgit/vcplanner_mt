VIEW V_UNIQUE_LOCPROD_PERCENT_FUTURE AS
SELECT DISTINCT PP.CAL_DATE, PP.LOCATION_ID, PP.PRODUCT_ID,UH.PRIMARY_ID, 
UH.UNIQUE_ID, PP.PRIMARY_QTY, (PP.PRIMARY_QTY*UNIQUE_PERCENT)/100 AS UNIQUE_QTY,
UNIQUE_PERCENT, PP.MODEL_VERSION, VERSION, SCENARIO, 
'FUTURE' AS TYPE 
FROM V_PRIMARY_LOCPROD_BY_PERCENT_FUTURE AS PP
INNER JOIN V_UNIQUE_LOCPROD_HISTORY_AVG_PERCENT AS UH ON
PP.PRIMARY_ID LIKE_REGEXPR UH.PRIMARY_ID
AND PP.LOCATION_ID = UH.LOCATION_ID
AND PP.PRODUCT_ID = UH.PRODUCT_ID
AND PP.TYPE = 'FUTURE'
ORDER BY PP.CAL_DATE,PP.LOCATION_ID, PP.PRODUCT_ID, 
UH.PRIMARY_ID, UH.UNIQUE_ID, PP.MODEL_VERSION;