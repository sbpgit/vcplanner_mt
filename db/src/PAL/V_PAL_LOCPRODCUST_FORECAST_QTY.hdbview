VIEW V_PAL_LOCPRODCUST_FORECAST_QTY AS
SELECT CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, MODEL_VERSION, VERSION, SCENARIO, SUM(PRIMARY_QTY) AS FORECAST_QTY
FROM V_PRIMARY_LOCPRODCUST_FUTURE 
GROUP BY CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, MODEL_VERSION, VERSION, SCENARIO 
ORDER BY CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, MODEL_VERSION, VERSION, SCENARIO;
        