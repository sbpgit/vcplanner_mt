VIEW V_UNIQUE_LOCPRODCUST_PERCENT_FUTURE AS
SELECT DISTINCT PP.CAL_DATE, PP.LOCATION_ID,PP.CUSTOMER_GROUP, PP.PRODUCT_ID,UH.PRIMARY_ID, 
UH.UNIQUE_ID, PP.PRIMARY_QTY, 
CASE WHEN UNIQUE_PERCENT != 0 THEN (PP.PRIMARY_QTY*UNIQUE_PERCENT)/100 ELSE 0 END AS UNIQUE_QTY,
UNIQUE_PERCENT, PP.MODEL_VERSION, VERSION, SCENARIO, 
'FUTURE' AS TYPE 
FROM V_PRIMARY_LOCPRODCUST_BY_PERCENT_FUTURE AS PP
INNER JOIN V_UNIQUE_LOCPRODCUST_HISTORY_AVG_PERCENT AS UH ON
--PP.PRIMARY_ID LIKE_REGEXPR UH.PRIMARY_ID
--TO_INT(SUBSTR_BEFORE(PP.PRIMARY_ID,'_')) = TO_INT(UH.PRIMARY_ID)
SUBSTR_BEFORE(PP.PRIMARY_ID,'_') = CAST(UH.PRIMARY_ID AS NVARCHAR)
AND PP.LOCATION_ID = UH.LOCATION_ID
AND PP.PRODUCT_ID = UH.PRODUCT_ID
AND PP.CUSTOMER_GROUP = UH.CUSTOMER_GROUP
AND PP.TYPE = 'FUTURE'
ORDER BY PP.CAL_DATE,PP.LOCATION_ID, PP.PRODUCT_ID, PP.CUSTOMER_GROUP,
UH.PRIMARY_ID, UH.UNIQUE_ID, PP.MODEL_VERSION;