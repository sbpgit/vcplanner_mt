VIEW V_CIR_UNCONSUMED AS
SELECT DISTINCT CG.LOCATION_ID, CG.PRODUCT_ID, VSH.PRIMARY_ID, VSH.UNIQUE_ID, 
CASE WHEN VSH.WEEK_DATE != CG.WEEK_DATE THEN 0 ELSE CIR_QTY END AS FORECASTED, 
CASE WHEN VSH.WEEK_DATE != CG.WEEK_DATE THEN VSH.ORD_QTY ELSE ACTUAL_QTY END AS DEMAND, 
CASE WHEN VSH.WEEK_DATE != CG.WEEK_DATE THEN 0 ELSE COALESCE(UNCONSUMED_FORECAST,0) END AS UNCONSUMED,
AR.CLUSTER_ID, VSH.WEEK_DATE AS START_DATE, VSH.WEEK_DATE AS END_DATE, 
CG.MODEL_VERSION, VERSION, SCENARIO,
CD.C1, CD.C2, CD.C3, CD.C4, CD.C5, CD.C6, CD.C7, CD.C8, CD.C9, CD.C10, CD.C11, CD.C12, CD.C13, CD.C14, CD.C15,
CD.C16, CD.C17, CD.C18, CD.C19, CD.C20, CD.C21, CD.C22, CD.C23, CD.C24, CD.C25, CD.C26, CD.C27, CD.C28, CD.C29, CD.C30,
CDC.C1 AS NC1, CDC.C2 AS NC2, CDC.C3 AS NC3, CDC.C4 AS NC4, CDC.C5 AS NC5, CDC.C6 AS NC6, CDC.C7 AS NC7, CDC.C8 AS NC8, 
CDC.C9 AS NC9, CDC.C10 AS NC10, CDC.C11 AS NC11, CDC.C12 AS NC12, CDC.C13 AS NC13, CDC.C14 AS NC14, CDC.C15 AS NC15,
CDC.C16 AS NC16, CDC.C17 AS NC17, CDC.C18 AS NC18, CDC.C19 AS NC19, CDC.C20 AS NC20, CDC.C21 AS NC21, CDC.C22 AS NC22,
CDC.C23 AS NC23, CDC.C24 AS NC24, CDC.C25 AS NC25, CDC.C26 AS NC26, CDC.C27 AS NC27, CDC.C28 AS NC28, CDC.C29 AS NC29, CDC.C30 AS NC30,
CDC.WEIGHT
FROM V_SALESORDER_FUTURE AS  VSH
LEFT JOIN  CP_CIR_GENERATED  AS CG ON
CG.LOCATION_ID = VSH.LOCATION_ID 
AND CG.PRODUCT_ID = VSH.PRODUCT_ID
AND CG.UNIQUE_ID = VSH.UNIQUE_ID
INNER JOIN CP_CLUSTER_DATA AS CD ON
CG.LOCATION_ID = CD.LOCATION_ID
AND CG.PRODUCT_ID = CD.PRODUCT_ID 
AND VSH.PRIMARY_ID = CD.UNIQUE_ID
INNER JOIN CP_CLUSTER_DATA_CATEGORICAL AS CDC ON
CD.LOCATION_ID = CDC.LOCATION_ID
AND CD.PRODUCT_ID = CDC.PRODUCT_ID 
AND CD.UNIQUE_ID = CDC.UNIQUE_ID
INNER JOIN CP_AHC_RESULTS AS AR ON
CD.LOCATION_ID = AR.LOCATION_ID
AND CD.PRODUCT_ID = AR.PRODUCT_ID 
AND CD.UNIQUE_ID = AR.UNIQUE_ID

UNION ALL

SELECT DISTINCT CG.LOCATION_ID, CG.PRODUCT_ID, VSH.PRIMARY_ID, CG.UNIQUE_ID, 
CASE WHEN VSH.WEEK_DATE = CG.WEEK_DATE THEN CIR_QTY ELSE 0 END AS FORECASTED, 
CASE WHEN VSH.WEEK_DATE = CG.WEEK_DATE THEN ACTUAL_QTY ELSE ORD_QTY END AS DEMAND, 
CASE WHEN VSH.WEEK_DATE = CG.WEEK_DATE THEN COALESCE(UNCONSUMED_FORECAST,0) ELSE 0 END AS UNCONSUMED,
-- CIR_QTY AS FORECASTED, ACTUAL_QTY AS DEMAND, COALESCE(UNCONSUMED_FORECAST,0) AS UNCONSUMED,
AR.CLUSTER_ID, CG.WEEK_DATE AS START_DATE, CG.WEEK_DATE AS END_DATE, 
CG.MODEL_VERSION, VERSION, SCENARIO,
CD.C1, CD.C2, CD.C3, CD.C4, CD.C5, CD.C6, CD.C7, CD.C8, CD.C9, CD.C10, CD.C11, CD.C12, CD.C13, CD.C14, CD.C15,
CD.C16, CD.C17, CD.C18, CD.C19, CD.C20, CD.C21, CD.C22, CD.C23, CD.C24, CD.C25, CD.C26, CD.C27, CD.C28, CD.C29, CD.C30,
CDC.C1 AS NC1, CDC.C2 AS NC2, CDC.C3 AS NC3, CDC.C4 AS NC4, CDC.C5 AS NC5, CDC.C6 AS NC6, CDC.C7 AS NC7, CDC.C8 AS NC8, 
CDC.C9 AS NC9, CDC.C10 AS NC10, CDC.C11 AS NC11, CDC.C12 AS NC12, CDC.C13 AS NC13, CDC.C14 AS NC14, CDC.C15 AS NC15,
CDC.C16 AS NC16, CDC.C17 AS NC17, CDC.C18 AS NC18, CDC.C19 AS NC19, CDC.C20 AS NC20, CDC.C21 AS NC21, CDC.C22 AS NC22,
CDC.C23 AS NC23, CDC.C24 AS NC24, CDC.C25 AS NC25, CDC.C26 AS NC26, CDC.C27 AS NC27, CDC.C28 AS NC28, CDC.C29 AS NC29, CDC.C30 AS NC30,
CDC.WEIGHT
FROM CP_CIR_GENERATED  AS CG
LEFT JOIN V_SALESORDER_FUTURE AS  VSH ON
CG.LOCATION_ID = VSH.LOCATION_ID 
AND CG.PRODUCT_ID = VSH.PRODUCT_ID
AND CG.UNIQUE_ID = VSH.UNIQUE_ID
INNER JOIN CP_CLUSTER_DATA AS CD ON
CG.LOCATION_ID = CD.LOCATION_ID
AND CG.PRODUCT_ID = CD.PRODUCT_ID 
AND VSH.PRIMARY_ID = CD.UNIQUE_ID
INNER JOIN CP_CLUSTER_DATA_CATEGORICAL AS CDC ON
CD.LOCATION_ID = CDC.LOCATION_ID
AND CD.PRODUCT_ID = CDC.PRODUCT_ID 
AND CD.UNIQUE_ID = CDC.UNIQUE_ID
INNER JOIN CP_AHC_RESULTS AS AR ON
CD.LOCATION_ID = AR.LOCATION_ID
AND CD.PRODUCT_ID = AR.PRODUCT_ID 
AND CD.UNIQUE_ID = AR.UNIQUE_ID