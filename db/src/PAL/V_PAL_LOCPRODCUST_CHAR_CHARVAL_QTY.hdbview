VIEW V_PAL_LOCPRODCUST_CHAR_CHARVAL_QTY AS
SELECT DISTINCT LOCATION_ID, PRODUCT_ID, 
CUSTOMER_GROUP, MODEL_VERSION, VERSION, SCENARIO, 
--CLASS_NUM, 
CHAR_NUM, CHARVAL_NUM,  
WEEK_DATE, SUM(CHARVAL_QTY) AS CHARVAL_QTY
FROM V_PAL_LOCPRODCUST_UNIQUE_CHAR_CHARVAL_QTY
GROUP BY LOCATION_ID, PRODUCT_ID, 
CUSTOMER_GROUP, MODEL_VERSION, VERSION, SCENARIO, 
--CLASS_NUM, 
CHAR_NUM, CHARVAL_NUM,  
WEEK_DATE
ORDER BY WEEK_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP,
MODEL_VERSION, VERSION, SCENARIO, 
--CLASS_NUM, 
CHAR_NUM, CHARVAL_NUM;