VIEW V_PRIMARY_LOCPRODCUST_FUTURE AS
SELECT DISTINCT CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, CONCAT(OBJ_DEP, CONCAT('_', OBJ_COUNTER)) AS PRIMARY_ID, 
SUM(PREDICTED) AS PRIMARY_QTY, MODEL_VERSION, VERSION, SCENARIO,  
'FUTURE' AS TYPE
FROM CP_TS_PREDICTIONS_CUST
GROUP BY CAL_DATE, LOCATION_ID, PRODUCT_ID,CUSTOMER_GROUP,OBJ_DEP,OBJ_COUNTER,MODEL_VERSION, VERSION, SCENARIO 
ORDER BY CAL_DATE,LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP,PRIMARY_ID, MODEL_VERSION, VERSION, SCENARIO ASC;