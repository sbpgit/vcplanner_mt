VIEW CP_V_UNIQUE_OPTIONS AS
SELECT LOCATION_ID, PRODUCT_ID,CLASS_NUM,CHAR_NUM,CHARVAL_NUM,
WEEK_DATE,
SUM(UNIQUE_QTY) AS OPT_QTY
FROM CP_V_UNIQUE_CHAR_CHARVAL
WHERE TYPE = 'FUTURE'
GROUP BY LOCATION_ID, PRODUCT_ID, 
CLASS_NUM, CHAR_NUM, CHARVAL_NUM, WEEK_DATE
ORDER BY  LOCATION_ID, PRODUCT_ID, 
CLASS_NUM, CHAR_NUM, CHARVAL_NUM, WEEK_DATE;
