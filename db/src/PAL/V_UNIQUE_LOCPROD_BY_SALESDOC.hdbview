VIEW V_UNIQUE_LOCPROD_BY_SALESDOC AS
SELECT SALES_DOC, ADD_DAYS (TO_DATE ("MAT_AVAILDATE", 'YYYY-MM-DD'), 7-WEEKDAY (TO_DATE ("MAT_AVAILDATE", 'YYYY-MM-DD'))) AS CAL_DATE,
PLAN_LOC AS LOCATION_ID, PRODUCT_ID, UNIQUE_ID, PRIMARY_ID, SUM(ORD_QTY) AS ORD_QTY FROM V_SALES_H
GROUP BY SALES_DOC, MAT_AVAILDATE, PLAN_LOC,PRODUCT_ID, UNIQUE_ID, PRIMARY_ID
ORDER BY CAL_DATE, PLAN_LOC, PRODUCT_ID, UNIQUE_ID, PRIMARY_ID; 