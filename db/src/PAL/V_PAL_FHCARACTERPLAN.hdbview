VIEW V_PAL_FCHARACTERPLAN AS
SELECT LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, MODEL_VERSION, CLASS_NUM,  CHAR_NUM, VERSION,
SCENARIO, WEEK_DATE, SUM(OPT_QTY) AS CHAR_QTY FROM CP_PAL_FCHARPLAN
GROUP BY WEEK_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, MODEL_VERSION, CLASS_NUM,  CHAR_NUM, VERSION, SCENARIO
ORDER BY WEEK_DATE,  LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, MODEL_VERSION, CLASS_NUM,  CHAR_NUM, VERSION, SCENARIO;