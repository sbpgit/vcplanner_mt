VIEW V_PAL_LOCPROD_UNIQUE_CHAR_CHARVAL_QTY AS
SELECT DISTINCT SFU.LOCATION_ID, SFU.PRODUCT_ID, 
SFU.UNIQUE_ID, SFU.MODEL_VERSION, SFU.VERSION, SFU.SCENARIO, 
V_PARTIALPRODCLASSCHAR.CLASS_NUM, V_UNIQUE_ID_ITEM.CHAR_NUM, V_UNIQUE_ID_ITEM.CHARVAL_NUM,  
SFU.CAL_DATE AS WEEK_DATE,
QUANTITY AS CHARVAL_QTY
FROM CP_FORECAST_UNIQUE_LOCPROD AS SFU
INNER JOIN V_UNIQUE_ID_ITEM ON
SFU.UNIQUE_ID = V_UNIQUE_ID_ITEM.UNIQUE_ID
AND SFU.UNIQUE_ID = V_UNIQUE_ID_ITEM.UNIQUE_ID
INNER JOIN V_PARTIALPRODCLASSCHAR ON
SFU.PRODUCT_ID = V_PARTIALPRODCLASSCHAR.PRODUCT_ID
AND SFU.LOCATION_ID = V_PARTIALPRODCLASSCHAR.LOCATION_ID
AND SFU.PRODUCT_ID = V_PARTIALPRODCLASSCHAR.PRODUCT_ID
AND V_UNIQUE_ID_ITEM.PRODUCT_ID = V_PARTIALPRODCLASSCHAR.REF_PRODID
AND V_UNIQUE_ID_ITEM.CLASS_NUM = V_PARTIALPRODCLASSCHAR.CLASS_NUM
ORDER BY WEEK_DATE, SFU.LOCATION_ID, SFU.PRODUCT_ID, SFU.UNIQUE_ID,
SFU.MODEL_VERSION, SFU.VERSION, SFU.SCENARIO, 
CLASS_NUM, CHAR_NUM, CHARVAL_NUM;