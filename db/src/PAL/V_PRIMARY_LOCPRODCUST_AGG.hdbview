VIEW V_PRIMARY_LOCPRODCUST_AGG AS
SELECT DISTINCT CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, SUM(PRIMARY_QTY) AS PRIMARY_AGG, "TYPE"
FROM V_PRIMARY_LOCPRODCUST
GROUP BY CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, "TYPE"
ORDER BY CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP,"TYPE";