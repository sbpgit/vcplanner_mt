-- GROUP BY CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, UNIQUE_ID, PRIMARY_ID
-- ORDER BY CAL_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, UNIQUE_ID, PRIMARY_ID;