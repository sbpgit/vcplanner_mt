VIEW V_UNIQUE_LOCPRODCUST_HISTORY AS
SELECT  USD.CAL_DATE, USD.LOCATION_ID, USD.PRODUCT_ID, USD.CUSTOMER_GROUP, USD.UNIQUE_ID, USD.PRIMARY_ID, SUM (ORD_QTY) AS UNIQUE_QTY
FROM V_UNIQUE_LOCPRODCUST_BY_SALESDOC AS USD
INNER JOIN V_PRIMARY_LOCPRODCUST_HISTORY_MAXDATE AS HCUST ON
USD.LOCATION_ID = HCUST.LOCATION_ID
AND USD.PRODUCT_ID = HCUST.PRODUCT_ID
AND USD.CUSTOMER_GROUP = HCUST.CUSTOMER_GROUP
AND HCUST.PRIMARY_ID LIKE_REGEXPR USD.PRIMARY_ID
AND USD.CAL_DATE <= HCUST.MAX_DATE
INNER JOIN CP_UNIQUE_ID_HEADER AS UHD ON
--USD.LOCATION_ID = UHD.LOCATION_ID AND
USD.REF_PRODID = UHD.PRODUCT_ID AND
USD.UNIQUE_ID = UHD.UNIQUE_ID
WHERE
UHD.VALID_TO > CURRENT_DATE
GROUP BY USD.CAL_DATE, USD.LOCATION_ID, USD.PRODUCT_ID, USD.CUSTOMER_GROUP, USD.UNIQUE_ID, USD.PRIMARY_ID
ORDER BY USD.CAL_DATE, USD.LOCATION_ID, USD.PRODUCT_ID, USD.CUSTOMER_GROUP, USD.UNIQUE_ID, USD.PRIMARY_ID;

