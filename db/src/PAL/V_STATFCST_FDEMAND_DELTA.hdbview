VIEW V_STATFCST_FDEMAND_DELTA AS 
SELECT CAL_DATE, STATF.LOCATION_ID, STATF.PRODUCT_ID, STATF.CUSTOMER_GROUP, 
STATF.MODEL_VERSION, STATF.VERSION, 
STATF.SCENARIO, (SUM(ROUNDED) - IFD.QUANTITY) AS DEVIATION
FROM CP_STATFORECAST_UNIQUE_QTYS AS STATF 
INNER JOIN CP_IBP_FUTUREDEMAND_LOCPRODCUST AS IFD ON 
STATF.CAL_DATE = IFD.WEEK_DATE
AND STATF.LOCATION_ID = IFD.LOCATION_ID 
AND STATF.PRODUCT_ID = IFD.PRODUCT_ID
AND STATF.CUSTOMER_GROUP = IFD.CUSTOMER_GROUP 
AND STATF.VERSION = IFD.VERSION 
AND STATF.SCENARIO = IFD.SCENARIO  
-- WHERE STATF.LOCATION_ID = '1710' AND STATF.PRODUCT_ID = '0000000000000000000000000000000000002250' 
-- AND STATF.CUSTOMER_GROUP = '01' AND STATF.VERSION = '__BASELINE' AND STATF.SCENARIO = '_PLAN' 
GROUP BY CAL_DATE, STATF.LOCATION_ID, STATF.PRODUCT_ID, STATF.CUSTOMER_GROUP, STATF.MODEL_VERSION, STATF.VERSION, STATF.SCENARIO, QUANTITY
ORDER BY CAL_DATE, STATF.LOCATION_ID, STATF.PRODUCT_ID, STATF.CUSTOMER_GROUP, STATF.MODEL_VERSION, STATF.VERSION, STATF.SCENARIO;