VIEW V_PID_ACTUALS_CLUSTERED AS
SELECT  DISTINCT CD.LOCATION_ID, CD.PRODUCT_ID, MODEL_PROFILE, AR.CLUSTER_ID,
CD.UNIQUE_ID, 
SH.WEEK_DATE AS START_DATE, SH.WEEK_DATE  AS END_DATE, 
ORD_QTY AS DEMAND,
MONTH(SH.WEEK_DATE) AS MONTH,
YEAR(SH.WEEK_DATE) AS YEAR,
QUARTER(SH.WEEK_DATE) AS QUARTER,
CD.C1, CD.C2, CD.C3, CD.C4, CD.C5, CD.C6, CD.C7, CD.C8, CD.C9, CD.C10, CD.C11, CD.C12, CD.C13, CD.C14, CD.C15,
CD.C16, CD.C17, CD.C18, CD.C19, CD.C20, CD.C21, CD.C22, CD.C23, CD.C24, CD.C25, CD.C26, CD.C27, CD.C28, CD.C29, CD.C30,
CDC.C1 AS NC1, CDC.C2 AS NC2, CDC.C3 AS NC3, CDC.C4 AS NC4, CDC.C5 AS NC5, CDC.C6 AS NC6, CDC.C7 AS NC7, CDC.C8 AS NC8, 
CDC.C9 AS NC9, CDC.C10 AS NC10, CDC.C11 AS NC11, CDC.C12 AS NC12, CDC.C13 AS NC13, CDC.C14 AS NC14, CDC.C15 AS NC15,
CDC.C16 AS NC16, CDC.C17 AS NC17, CDC.C18 AS NC18, CDC.C19 AS NC19, CDC.C20 AS NC20, CDC.C21 AS NC21, CDC.C22 AS NC22,
CDC.C23 AS NC23, CDC.C24 AS NC24, CDC.C25 AS NC25, CDC.C26 AS NC26, CDC.C27 AS NC27, CDC.C28 AS NC28, CDC.C29 AS NC29, CDC.C30 AS NC30,
CDC.WEIGHT
FROM V_SALESORDER_FUTURE AS  SH 
LEFT JOIN  CP_CLUSTER_DATA AS CD ON 
CD.LOCATION_ID = SH.LOCATION_ID
AND CD.PRODUCT_ID = SH.PRODUCT_ID 
AND CD.UNIQUE_ID = SH.PRIMARY_ID
INNER JOIN CP_CLUSTER_DATA_CATEGORICAL AS CDC ON
CD.LOCATION_ID = CDC.LOCATION_ID
AND CD.PRODUCT_ID = CDC.PRODUCT_ID 
AND CD.UNIQUE_ID = CDC.UNIQUE_ID
INNER JOIN CP_AHC_RESULTS AS AR ON
CD.LOCATION_ID = AR.LOCATION_ID
AND CD.PRODUCT_ID = AR.PRODUCT_ID 
AND CD.UNIQUE_ID = AR.UNIQUE_ID
GROUP BY CD.LOCATION_ID, CD.PRODUCT_ID, MODEL_PROFILE, AR.CLUSTER_ID,
CD.UNIQUE_ID, SH.WEEK_DATE, 
--CG.WEEK_DATE, 
ORD_QTY,
CDC.C1, CDC.C2, CDC.C3, CDC.C4, CDC.C5, CDC.C6, CDC.C7, CDC.C8, CDC.C9, CDC.C10, CDC.C11, CDC.C12, CDC.C13, CDC.C14, CDC.C15,
CDC.C16, CDC.C17, CDC.C18, CDC.C19, CDC.C20, CDC.C21, CDC.C22, CDC.C23, CDC.C24, CDC.C25, CDC.C26, CDC.C27, CDC.C28, CDC.C29, CDC.C30,
CD.C1, CD.C2, CD.C3, CD.C4, CD.C5, CD.C6, CD.C7, CD.C8, CD.C9, CD.C10, CD.C11, CD.C12, CD.C13, CD.C14, CD.C15,
CD.C16, CD.C17, CD.C18, CD.C19, CD.C20, CD.C21, CD.C22, CD.C23, CD.C24, CD.C25, CD.C26, CD.C27, CD.C28, CD.C29, CD.C30, CDC.WEIGHT


UNION ALL

SELECT  DISTINCT CD.LOCATION_ID, CD.PRODUCT_ID, MODEL_PROFILE, AR.CLUSTER_ID,
CD.UNIQUE_ID, 
CG.WEEK_DATE AS START_DATE, CG.WEEK_DATE  AS END_DATE, 
CASE WHEN SH.WEEK_DATE != CG.WEEK_DATE THEN ACTUAL_QTY ELSE ORD_QTY END AS DEMAND,
MONTH(CG.WEEK_DATE) AS MONTH,
YEAR(CG.WEEK_DATE) AS YEAR,
QUARTER(CG.WEEK_DATE) AS QUARTER,
CD.C1, CD.C2, CD.C3, CD.C4, CD.C5, CD.C6, CD.C7, CD.C8, CD.C9, CD.C10, CD.C11, CD.C12, CD.C13, CD.C14, CD.C15,
CD.C16, CD.C17, CD.C18, CD.C19, CD.C20, CD.C21, CD.C22, CD.C23, CD.C24, CD.C25, CD.C26, CD.C27, CD.C28, CD.C29, CD.C30,
CDC.C1 AS NC1, CDC.C2 AS NC2, CDC.C3 AS NC3, CDC.C4 AS NC4, CDC.C5 AS NC5, CDC.C6 AS NC6, CDC.C7 AS NC7, CDC.C8 AS NC8, 
CDC.C9 AS NC9, CDC.C10 AS NC10, CDC.C11 AS NC11, CDC.C12 AS NC12, CDC.C13 AS NC13, CDC.C14 AS NC14, CDC.C15 AS NC15,
CDC.C16 AS NC16, CDC.C17 AS NC17, CDC.C18 AS NC18, CDC.C19 AS NC19, CDC.C20 AS NC20, CDC.C21 AS NC21, CDC.C22 AS NC22,
CDC.C23 AS NC23, CDC.C24 AS NC24, CDC.C25 AS NC25, CDC.C26 AS NC26, CDC.C27 AS NC27, CDC.C28 AS NC28, CDC.C29 AS NC29, CDC.C30 AS NC30,
CDC.WEIGHT
FROM CP_CIR_GENERATED  AS CG
LEFT JOIN V_SALESORDER_FUTURE AS  SH ON
CG.LOCATION_ID = SH.LOCATION_ID 
AND CG.PRODUCT_ID = SH.PRODUCT_ID
AND CG.UNIQUE_ID = SH.UNIQUE_ID
LEFT JOIN  CP_CLUSTER_DATA AS CD ON 
CD.LOCATION_ID = SH.LOCATION_ID
AND CD.PRODUCT_ID = SH.PRODUCT_ID 
AND CD.UNIQUE_ID = SH.PRIMARY_ID
INNER JOIN CP_CLUSTER_DATA_CATEGORICAL AS CDC ON
CD.LOCATION_ID = CDC.LOCATION_ID
AND CD.PRODUCT_ID = CDC.PRODUCT_ID 
AND CD.UNIQUE_ID = CDC.UNIQUE_ID
INNER JOIN CP_AHC_RESULTS AS AR ON
CD.LOCATION_ID = AR.LOCATION_ID
AND CD.PRODUCT_ID = AR.PRODUCT_ID 
AND CD.UNIQUE_ID = AR.UNIQUE_ID
GROUP BY CD.LOCATION_ID, CD.PRODUCT_ID, MODEL_PROFILE, AR.CLUSTER_ID,
CD.UNIQUE_ID, SH.WEEK_DATE, CG.WEEK_DATE, ORD_QTY, ACTUAL_QTY,
CDC.C1, CDC.C2, CDC.C3, CDC.C4, CDC.C5, CDC.C6, CDC.C7, CDC.C8, CDC.C9, CDC.C10, CDC.C11, CDC.C12, CDC.C13, CDC.C14, CDC.C15,
CDC.C16, CDC.C17, CDC.C18, CDC.C19, CDC.C20, CDC.C21, CDC.C22, CDC.C23, CDC.C24, CDC.C25, CDC.C26, CDC.C27, CDC.C28, CDC.C29, CDC.C30,
CD.C1, CD.C2, CD.C3, CD.C4, CD.C5, CD.C6, CD.C7, CD.C8, CD.C9, CD.C10, CD.C11, CD.C12, CD.C13, CD.C14, CD.C15,
CD.C16, CD.C17, CD.C18, CD.C19, CD.C20, CD.C21, CD.C22, CD.C23, CD.C24, CD.C25, CD.C26, CD.C27, CD.C28, CD.C29, CD.C30, CDC.WEIGHT;

