VIEW V_PAL_UNIQUE_LOCPRODCUST_FORECAST AS
SELECT UNF.CAL_DATE, UNF.LOCATION_ID,  UNF.PRODUCT_ID,UNF.CUSTOMER_GROUP,
UNF.PRIMARY_ID, 
UNF.UNIQUE_ID, UNF.MODEL_VERSION, UNF.VERSION, UNF.SCENARIO,
UNF.PRIMARY_QTY, 
UNF.UNIQUE_QTY, 
CASE WHEN (PMF.FORECAST_QTY!= 0 ) THEN ROUND(100*(UNF.UNIQUE_QTY/PMF.FORECAST_QTY),2,ROUND_HALF_UP) ELSE 0 END AS UNIQUE_PRECENT
FROM V_UNIQUE_LOCPRODCUST_PERCENT_FUTURE AS UNF
INNER JOIN V_PAL_LOCPRODCUST_FORECAST_QTY AS PMF ON
UNF.CAL_DATE = PMF.CAL_DATE
AND UNF.LOCATION_ID = PMF.LOCATION_ID
AND UNF.PRODUCT_ID = PMF.PRODUCT_ID
AND UNF.CUSTOMER_GROUP = PMF.CUSTOMER_GROUP
AND UNF.MODEL_VERSION = PMF.MODEL_VERSION
AND UNF.VERSION = PMF.VERSION
AND UNF.SCENARIO = PMF.SCENARIO
-- WHERE UNF.PRODUCT_ID = '0000000000000000000000000000000000002251' AND UNF.CUSTOMER_GROUP = '02'
ORDER BY UNF.CAL_DATE, UNF.LOCATION_ID,  UNF.PRODUCT_ID,UNF.CUSTOMER_GROUP,
UNF.PRIMARY_ID, UNF.UNIQUE_ID, UNF.MODEL_VERSION;