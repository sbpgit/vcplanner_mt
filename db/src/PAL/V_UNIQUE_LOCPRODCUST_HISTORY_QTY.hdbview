VIEW V_UNIQUE_LOCPRODCUST_HISTORY_QTY AS
SELECT LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP,PRIMARY_ID, UNIQUE_ID, SUM(UNIQUE_QTY) AS UNIQUE_QTY
FROM V_UNIQUE_LOCPRODCUST_HISTORY 
GROUP BY LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, PRIMARY_ID, UNIQUE_ID
ORDER BY LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, PRIMARY_ID, UNIQUE_ID;