VIEW V_FORECAST_LOCPROD_FDEMAND_DELTA AS 
SELECT CAL_DATE, STATF.LOCATION_ID, STATF.PRODUCT_ID,
STATF.MODEL_VERSION, STATF.VERSION, 
STATF.SCENARIO, (SUM(ROUNDED) - IFD.QUANTITY) AS DEVIATION
FROM CP_FORECAST_UNIQUE_LOCPROD AS STATF 
INNER JOIN CP_IBP_FUTUREDEMAND AS IFD ON 
STATF.CAL_DATE = IFD.WEEK_DATE
AND STATF.LOCATION_ID = IFD.LOCATION_ID 
AND STATF.PRODUCT_ID = IFD.PRODUCT_ID
AND STATF.VERSION = IFD.VERSION 
AND STATF.SCENARIO = IFD.SCENARIO  
GROUP BY CAL_DATE, STATF.LOCATION_ID, STATF.PRODUCT_ID, STATF.MODEL_VERSION, STATF.VERSION, STATF.SCENARIO, IFD.QUANTITY
ORDER BY CAL_DATE, STATF.LOCATION_ID, STATF.PRODUCT_ID, STATF.MODEL_VERSION, STATF.VERSION, STATF.SCENARIO;