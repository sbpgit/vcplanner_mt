VIEW V_PRIMARY_LOCPRODCUST_HISTORY AS
SELECT  DISTINCT ADD_DAYS(ADD_DAYS(TO_DATE('01/01/'||substr("PERIOD_NUM",1,4),'DD/MM/YYYY'),
-WEEKDAY (TO_DATE ('01/01/'||substr("PERIOD_NUM",1,4),'DD/MM/YYYY'))),
substr("PERIOD_NUM",5,2)*7) AS CAL_DATE,
VPHC.LOCATION_ID, VPHC.PRODUCT_ID, VPHC.CUSTOMER_GROUP, GROUP_ID AS PRIMARY_ID, GROUP_COUNT AS PRIMARY_QTY,
'HISTORY' AS TYPE
FROM CP_VC_HISTORY_TS_CUST AS VPHC
INNER JOIN V_PRIMARY_VALIDITY_CUST AS PV ON
VPHC.LOCATION_ID = PV.LOCATION_ID 
AND VPHC.PRODUCT_ID = PV.PRODUCT_ID 
AND VPHC.CUSTOMER_GROUP = PV.CUSTOMER_GROUP 
--AND TO_INT(SUBSTR_BEFORE(VPHC.GROUP_ID,'_')) = TO_INT(PV.PRIMARY_ID)
AND SUBSTR_BEFORE(VPHC.GROUP_ID,'_') = CAST(PV.PRIMARY_ID AS NVARCHAR)
AND PV.VALID_TO > CURRENT_DATE
ORDER BY CAL_DATE, VPHC.LOCATION_ID, VPHC.PRODUCT_ID, VPHC.CUSTOMER_GROUP,  PRIMARY_ID ASC;