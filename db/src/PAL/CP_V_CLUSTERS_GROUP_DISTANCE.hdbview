VIEW CP_V_CLUSTERS_GROUP_DISTANCES AS 
SELECT GD.LOCATION_ID, GD.PRODUCT_ID, GD.MODEL_PROFILE, GD.SOURCE_CLUSTER_ID, GD.TARGET_CLUSTER_ID,GD.SOURCE_PID, GD.TARGET_PID, PD.DISTANCE
FROM CP_AHC_CLUSTER_GROUPAVG_DISTANCES AS GD 
INNER JOIN CP_PRECALCULATED_DISTANCE_DATA AS PD ON
GD.LOCATION_ID = PD.LOCATION_ID
AND GD.PRODUCT_ID = PD.PRODUCT_ID
AND GD.SOURCE_PID = PD.LEFT_POINT
AND GD.TARGET_PID = PD.RIGHT_POINT
ORDER BY  GD.SOURCE_CLUSTER_ID, GD.TARGET_CLUSTER_ID,GD.SOURCE_PID, GD.TARGET_PID;