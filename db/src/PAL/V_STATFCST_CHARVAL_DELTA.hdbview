VIEW V_STATFCST_CHARVAL_DELTA AS
SELECT LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, MODEL_VERSION, CLASS_NUM , CHAR_NUM, VERSION, SCENARIO, WEEK_DATE,
ROUND(SUM(DELTA),0) AS DELTA  FROM CP_PAL_FCHARPLAN  
GROUP BY LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, MODEL_VERSION, CLASS_NUM,  CHAR_NUM, VERSION, SCENARIO, WEEK_DATE
ORDER BY WEEK_DATE, LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, MODEL_VERSION, CLASS_NUM,  CHAR_NUM, VERSION, SCENARIO;