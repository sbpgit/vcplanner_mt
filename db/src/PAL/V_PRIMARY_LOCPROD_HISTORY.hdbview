VIEW V_PRIMARY_LOCPROD_HISTORY AS
SELECT  DISTINCT ADD_DAYS(ADD_DAYS(TO_DATE('01/01/'||substr("PERIOD_NUM",1,4),'DD/MM/YYYY'),
-WEEKDAY (TO_DATE ('01/01/'||substr("PERIOD_NUM",1,4),'DD/MM/YYYY'))),
substr("PERIOD_NUM",5,2)*7) AS CAL_DATE,
LOCATION_ID, PRODUCT_ID, GROUP_ID AS PRIMARY_ID, GROUP_COUNT AS PRIMARY_QTY,
'HISTORY' AS TYPE
FROM CP_VC_HISTORY_TS
ORDER BY CAL_DATE, LOCATION_ID, PRODUCT_ID, PRIMARY_ID ASC;