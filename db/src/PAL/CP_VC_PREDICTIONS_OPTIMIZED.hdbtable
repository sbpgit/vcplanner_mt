COLUMN TABLE "CP_VC_PREDICTIONS_OPTIMIZED"(
	"CAL_DATE" DATE NOT NULL,
	"LOCATION_ID" NVARCHAR(5) NOT NULL,
	"PRODUCT_ID" NVARCHAR(40) NOT NULL,
	"MODEL_VERSION" NVARCHAR(20) NOT NULL,
	"VERSION" NVARCHAR(10) NOT NULL,
	"SCENARIO" NVARCHAR(32) NOT NULL,
	"ALGORITHM" NVARCHAR(10) NOT NULL,
	"CHAR_NUM" NVARCHAR(100) NOT NULL default 'NA',
	"CHARVAL_NUM" NVARCHAR(70) NOT NULL,
	"PREDICTED_QTY" DOUBLE,
	"IBP_PLANNED_QTY" DOUBLE,
	"BTP_REVISED_QTY" DOUBLE,
	"PREDICTED_DEVIATION" DOUBLE,
	"POST_PREDICTED_DEVIATION" DOUBLE,
	"NORMALIZED_DEVIATION" DOUBLE,
	PRIMARY KEY INVERTED INDIVIDUAL(
		"CAL_DATE",
		"LOCATION_ID",
		"PRODUCT_ID",
		"MODEL_VERSION",
		"VERSION",
		"SCENARIO",
		"ALGORITHM",
		"CHAR_NUM",
		"CHARVAL_NUM"
	)
);