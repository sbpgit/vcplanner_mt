VIEW CP_V_AHC_CLUSTERS_SORTED_UNIQUEID AS
SELECT CD.LOCATION_ID, CD.PRODUCT_ID, MODEL_PROFILE, AR.CLUSTER_ID,
CD.UNIQUE_ID,
C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15,
C16, C17, C18, C19, C20, C21, C22, C23, C24, C25, C26, C27, C28, C29, C30
FROM CP_CLUSTER_DATA_CATEGORICAL AS CD
--FROM CP_CLUSTER_DATA AS CD
INNER JOIN CP_AHC_RESULTS AS AR ON
CD.LOCATION_ID = AR.LOCATION_ID
AND CD.PRODUCT_ID = AR.PRODUCT_ID 
AND CD.UNIQUE_ID = AR.UNIQUE_ID
INNER JOIN V_SALES_H AS SH ON
CD.LOCATION_ID = SH.LOCATION_ID
AND CD.PRODUCT_ID = SH.PRODUCT_ID 
AND CD.UNIQUE_ID = SH.PRIMARY_ID
ORDER BY  CD.LOCATION_ID, CD.PRODUCT_ID, AR.CLUSTER_ID, CD.UNIQUE_ID, 
C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15,
C16, C17, C18, C19, C20, C21, C22, C23, C24, C25, C26, C27, C28, C29, C30;