VIEW V_PAL_UNIQUE_LOCPROD_FORECAST AS
    SELECT UNF.CAL_DATE, UNF.LOCATION_ID,  UNF.PRODUCT_ID,
    UNF.UNIQUE_ID, UNF.MODEL_VERSION, UNF.VERSION, UNF.SCENARIO,
    CASE WHEN (PMF.FORECAST_QTY!= 0) THEN ROUND(100*(UNF.UNIQUE_QTY/PMF.FORECAST_QTY),2,ROUND_HALF_UP) ELSE 0 END AS UNIQUE_PERCENT,
    (IFD.QUANTITY* (CASE WHEN (PMF.FORECAST_QTY!= 0) THEN ROUND(100*(UNF.UNIQUE_QTY/PMF.FORECAST_QTY),2,ROUND_HALF_UP) ELSE 0 END ))/100 AS UNIQUE_QTY 
    FROM V_UNIQUE_LOCPROD_PERCENT_FUTURE AS UNF
    INNER JOIN V_PAL_LOCPROD_FORECAST_QTY AS PMF ON
    UNF.CAL_DATE = PMF.CAL_DATE
    AND UNF.LOCATION_ID = PMF.LOCATION_ID
    AND UNF.PRODUCT_ID = PMF.PRODUCT_ID
    AND UNF.MODEL_VERSION = PMF.MODEL_VERSION
    AND UNF.VERSION = PMF.VERSION
    AND UNF.SCENARIO = PMF.SCENARIO
    INNER JOIN CP_IBP_FUTUREDEMAND AS IFD ON 
        UNF.CAL_DATE = IFD.WEEK_DATE
        AND UNF.LOCATION_ID = IFD.LOCATION_ID
        AND UNF.PRODUCT_ID = IFD.PRODUCT_ID
        AND UNF.VERSION = IFD.VERSION
        AND UNF.SCENARIO = IFD.SCENARIO
    ORDER BY UNF.CAL_DATE, UNF.LOCATION_ID,  UNF.PRODUCT_ID,
    UNF.UNIQUE_ID, UNF.MODEL_VERSION;