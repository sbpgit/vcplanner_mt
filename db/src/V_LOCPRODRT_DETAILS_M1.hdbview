VIEW "V_LOCPRODRT_DETAILS_M1" AS
SELECT DISTINCT
	V_LOCPRODRT_DETAILS."LOCATION_ID" AS FACTORY_LOC,
	CP_FACTORY_SALESLOC."LOCATION_ID",
	V_LOCPRODRT_DETAILS."LINE_ID",
	V_LOCPRODRT_DETAILS."PRODUCT_ID" AS REF_PRODID,
	CP_PARTIALPROD_INTRO."PRODUCT_ID",
	V_LOCPRODRT_DETAILS."RESTRICTION",
	V_LOCPRODRT_DETAILS."RTR_COUNTER",
	V_LOCPRODRT_DETAILS."RTR_QTY",
	V_LOCPRODRT_DETAILS."CLASS_NUM",
	V_LOCPRODRT_DETAILS."CHAR_NUM",
	V_LOCPRODRT_DETAILS."CHARVAL_NUM",
	V_LOCPRODRT_DETAILS."OD_CONDITION",
	V_LOCPRODRT_DETAILS."CHAR_COUNTER",
	V_LOCPRODRT_DETAILS."ROW_ID",
	V_LOCPRODRT_DETAILS."VALID_FROM",
	V_LOCPRODRT_DETAILS."VALID_TO"
FROM "V_LOCPRODRT_DETAILS"
inner join CP_FACTORY_SALESLOC 
ON V_LOCPRODRT_DETAILS.LOCATION_ID = CP_FACTORY_SALESLOC.FACTORY_LOC
inner join CP_PARTIALPROD_INTRO
ON CP_PARTIALPROD_INTRO.LOCATION_ID = CP_FACTORY_SALESLOC.LOCATION_ID
AND CP_PARTIALPROD_INTRO.REF_PRODID = V_LOCPRODRT_DETAILS.PRODUCT_ID