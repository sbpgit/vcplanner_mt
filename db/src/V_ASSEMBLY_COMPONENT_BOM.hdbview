VIEW V_ASSEMBLY_COMPONENT_BOM AS
SELECT 
   -- A table (CP_ASSEMBLY_REQ)
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."ITEM_NUM",
    A."COMPONENT"                AS ASSEMBLY,
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    A."TYPE"                     AS RULE_TYPE,
    A."TYPE",
    A."REF_PRODID",
    A."FACTORY_LOC",
    A."UNIQUE_ID",

    -- B table (CP_LOCATION)
    B.LOCATION_DESC AS FACTORY_LOCATION_DESC,
    D.MAT_CHILD as COMPONENT,

    -- B table (CP_LOCATION)
    H.LOCATION_DESC AS LOCATION_DESC,

    -- C table (CP_PRODUCT)
    C.PROD_DESC,

    -- D table (CP_BOM_MAT)
    -- D.MRP_GROUP,
    D."PHANTOM_IND",
    D."CONFIGURABLE",
    CP_IBPVERSIONSCENARIO.VERSION_NAME,
    CP_IBPVERSIONSCENARIO.SCENARIO_NAME,

    -- Derived ASM_DESC
 (SELECT MAX(PROD_DESC) FROM CP_BOM_MAT AS D WHERE D.MAT_CHILD = A."COMPONENT") as ASM_DESC,

    -- E table (V_WEEK_DESCRIPTOR)
    E."CALENDAR_WEEK",
    E."TELESCOPIC_WEEK",
    E."WEEK_STARTDATE",
    E."WEEK_ENDDATE",

    -- Aggregates
    -- SUM(COALESCE(A."COMPCIR_QTY", 0) * COALESCE(D."COMPONENT_QTY", 0)) AS TOTAL_COMPONENT_QTY,

    SUM(
    (COALESCE(A."COMPCIR_QTY", 0) + COALESCE(A."ACTUAL_QTY", 0)) 
    * COALESCE(D."COMPONENT_QTY", 0)
) AS TOTAL_COMPONENT_QTY,

    -- Constants
    'OD'                         AS REQ_TYPE,
    '' AS USER
    --     CP_LOCATION_PRODUCT.MRP_GROUP,
    -- CP_LOCATION_PRODUCT.MRP_TYPE,
    -- V_ROLES_LOCPROD.USER AS USER

FROM CP_ASSEMBLY_REQ AS A

     -- Join with Location
    INNER JOIN CP_LOCATION AS B
        ON A."FACTORY_LOC" = B."LOCATION_ID"

     -- Join with Location
    INNER JOIN CP_LOCATION AS H
        ON A."LOCATION_ID" = H."LOCATION_ID"

    -- Join with Product
    INNER JOIN CP_PRODUCT AS C
        ON C.PRODUCT_ID = A."REF_PRODID"

    -- Join with BOM Material
   INNER JOIN CP_BOM_MAT AS D
        ON D.MAT_PARENT = A."COMPONENT"
       AND D.LOCATION_ID = A."FACTORY_LOC"
       AND A.WEEK_DATE >= D.VALID_FROM
       AND A.WEEK_DATE <= D.VALID_TO
       AND D.COMPONENT_FLAG = 'X'

    -- Join with Week Descriptor
    LEFT OUTER JOIN "V_WEEK_DESCRIPTOR" AS E
        ON A.WEEK_DATE >= E."WEEK_STARTDATE"
       AND A."WEEK_DATE" <= E."WEEK_ENDDATE"   

      LEFT OUTER JOIN CP_IBPVERSIONSCENARIO
 ON CP_IBPVERSIONSCENARIO.VERSION = A."VERSION"
 AND CP_IBPVERSIONSCENARIO.SCENARIO = A."SCENARIO"

 LEFT OUTER JOIN "CP_LOCATION_PRODUCT" ON A.LOCATION_ID=CP_LOCATION_PRODUCT.LOCATION_ID AND A.PRODUCT_ID=CP_LOCATION_PRODUCT.PRODUCT_ID

-- INNER JOIN "V_ROLES_LOCPROD" ON A.LOCATION_ID=V_ROLES_LOCPROD.DEMAND_LOC AND A.PRODUCT_ID=V_ROLES_LOCPROD.PRODUCT_ID
-- AND A.FACTORY_LOC=V_ROLES_LOCPROD.FACTORY_LOC AND A.REF_PRODID=V_ROLES_LOCPROD.REF_PRODID


GROUP BY 
    A."LOCATION_ID",
    B.LOCATION_DESC,
    A."PRODUCT_ID",
    C.PROD_DESC,
    A."ITEM_NUM",
    A."COMPONENT",
    -- D.PROD_DESC,
     D.MAT_CHILD,
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    A."TYPE",
    A."REF_PRODID",
    A."FACTORY_LOC",
    -- D.MRP_GROUP,
    D."PHANTOM_IND",
    D."CONFIGURABLE",
    A."UNIQUE_ID",
    E."CALENDAR_WEEK",
    E."TELESCOPIC_WEEK",
    E."WEEK_STARTDATE",
    E."WEEK_ENDDATE",
    H.LOCATION_DESC,
    CP_IBPVERSIONSCENARIO.VERSION_NAME,
    CP_IBPVERSIONSCENARIO.SCENARIO_NAME,
    -- CP_LOCATION_PRODUCT.MRP_GROUP,
    -- CP_LOCATION_PRODUCT.MRP_TYPE,
    -- V_ROLES_LOCPROD.USER,
    'OD'