VIEW "V_ASSEMBLY_PROD_DEMAND" AS
SELECT A."LOCATION_ID",
  A."PRODUCT_ID",
  A."ITEM_NUM",
  A."COMPONENT" AS ASSEMBLY,
  A."MODEL_VERSION",
  A."VERSION",
  A."SCENARIO",
  A."TYPE" AS RULE_TYPE,
  A."TYPE",
  A."REF_PRODID",
  A."FACTORY_LOC",
  A."UNIQUE_ID",
  -- D table (CP_BOM_MAT)
  -- D.MRP_GROUP,
  D."PHANTOM_IND",
  D."CONFIGURABLE",
  E."CALENDAR_WEEK",
  E."TELESCOPIC_WEEK",
  E."WEEK_STARTDATE",
  E."WEEK_ENDDATE",
  -- Aggregates
  SUM(F.QUANTITY) AS PROD_DEM,
  -- Calculated Coefficients
  CASE
    WHEN SUM(
      COALESCE(A."COMPCIR_QTY", 0) + COALESCE(A."ACTUAL_QTY", 0)
    ) = 0
    OR SUM(F.QUANTITY) = 0 THEN 0
    ELSE ROUND(
      SUM(
        COALESCE(A."COMPCIR_QTY", 0) + COALESCE(A."ACTUAL_QTY", 0)
      ) / SUM(F.QUANTITY),
      3
    )
  END AS COEFFICIENTS,
  -- Constants
  'OD' AS REQ_TYPE
FROM CP_ASSEMBLY_REQ AS A 
-- Join with BOM Material
  LEFT OUTER JOIN CP_BOM_MAT AS D
 ON D.MAT_CHILD = A."COMPONENT"
  AND D.COUNTER = A."ITEM_NUM"
  AND D.MAT_PARENT = A."REF_PRODID"
  AND D.CHILD_LOC = A."FACTORY_LOC"
  AND A.WEEK_DATE >= D.VALID_FROM
  AND A.WEEK_DATE <= D.VALID_TO 
-- Join with Week Descriptor
  LEFT OUTER JOIN "V_WEEK_DESCRIPTOR" AS E
 ON A.WEEK_DATE >= E."WEEK_STARTDATE"
  AND A."WEEK_DATE" <= E."WEEK_ENDDATE" 
-- Future Demand
  RIGHT OUTER JOIN CP_IBP_FUTUREDEMAND AS F
 ON A.LOCATION_ID = F.LOCATION_ID
  AND A.PRODUCT_ID = F.PRODUCT_ID
  AND A.VERSION = F.VERSION
  AND A.SCENARIO = F.SCENARIO
  AND A.WEEK_DATE = F.WEEK_DATE
GROUP BY A."LOCATION_ID",
  A."PRODUCT_ID",
  A."ITEM_NUM",
  A."COMPONENT",
  D.PROD_DESC,
  A."MODEL_VERSION",
  A."VERSION",
  A."SCENARIO",
  A."TYPE",
  A."REF_PRODID",
  A."FACTORY_LOC",
  -- D.MRP_GROUP,
  D."PHANTOM_IND",
  D."CONFIGURABLE",
  A."UNIQUE_ID",
  E."CALENDAR_WEEK",
  E."TELESCOPIC_WEEK",
  E."WEEK_STARTDATE",
  E."WEEK_ENDDATE",
  'OD';