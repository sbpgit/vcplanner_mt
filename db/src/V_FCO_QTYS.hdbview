VIEW "V_FCO_QTYS" AS
SELECT TOP 1000 A."LOCATION_ID",
  A."PRODUCT_ID",
  A."WEEK_DATE",
  A."MODEL_VERSION",
  A."VERSION",
  A."SCENARIO",
  A."CHAR_NUM",
  A."CHARVAL_NUM",
  SUM(TO_INTEGER("OPT_QTY")) AS OPT_QTY,
  SUM("CIR_QTY") AS CIR_QTY,
  TO_INTEGER(SUM("OPT_QTY")) - SUM("CIR_QTY") AS DIFF_QTY,
  ABS(TO_INTEGER(SUM("OPT_QTY")) - SUM("CIR_QTY")) AS ABS_DIFF,
  B."CHAR_DESC",
  B."CHARVAL_DESC",
  B."CHAR_NAME",
  B."CHAR_VALUE"
FROM V_CIRQTY_UNIQUECHAR AS A
  INNER JOIN V_PRODCLSCHARVAL AS B
 ON B.CHAR_NUM = A.CHAR_NUM
  AND B.CHARVAL_NUM = A.CHARVAL_NUM
GROUP BY A."LOCATION_ID",
  A."PRODUCT_ID",
  A."WEEK_DATE",
  A."MODEL_VERSION",
  A."VERSION",
  A."SCENARIO",
  A."CHAR_NUM",
  A."CHARVAL_NUM",
  B."CHAR_DESC",
  B."CHARVAL_DESC",
  B."CHAR_NAME",
  B."CHAR_VALUE"