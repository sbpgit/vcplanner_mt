VIEW "V_ASMBCOMP_LOCM1" AS
SELECT 
SUM (A.COMP_QTY) AS COMP_QTY,
  A.WEEK_DATE,
  B.FACTORY_LOC,
  A.COMPONENT,
  A.VERSION,
  A.SCENARIO,
  A.MODEL_VERSION
  FROM "V_ASSEMBLYREQ" AS A
    INNER JOIN "CP_FACTORY_SALESLOC" AS B
 ON A."LOCATION_ID" = B."FACTORY_LOC"
 GROUP BY  A.WEEK_DATE,
 B.FACTORY_LOC,
 A.COMPONENT,
 A.VERSION,
 A.SCENARIO,
 A.MODEL_VERSION;