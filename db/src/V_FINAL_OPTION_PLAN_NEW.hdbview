 VIEW V_FINAL_OPTION_PLAN_NEW AS

/* Branch 1: V_OPTION_PERCENTAGE_NEW (TYPE < 1000) */
SELECT
    A.LOCATION_ID,
    A.PRODUCT_ID,
    A.CUSTOMER_GROUP,
    A.MODEL_VERSION,
    A.CHAR_NUM,
    A.CHARVAL_NUM,
    A.VERSION,
    A.SCENARIO,
    CAST(A.TYPE AS NVARCHAR(10)) AS TYPE,
    A.OPT_PERCENT,
    A.OPT_QTY,
    A.CHAR_DESC,
    A.CHAR_NAME,
    B.CHAR_TYPE,
    A.CHARVAL_DESC,
    A.VERSION_NAME,
    A.SCENARIO_NAME,
    A.LOCATION_DESC,
    A.PROD_DESC,
    CAST(A.KEY_FIG_ID AS NVARCHAR(10)) AS KEY_FIG_ID,
    A.KEY_FIG_DESC,
    A.DISPLAY_ORDER,
    A.PRIORITY_ORDER,
    C.CALENDAR_WEEK,
    C.TELESCOPIC_WEEK,
    C.WEEK_STARTDATE,
    C.WEEK_ENDDATE,
    C.PERIODSTART,
    C.PERIODEND,
    A.LOCK,
    A.COMMENTS,
    A.USER,
    A.OLD_VALUE,
    A.DATE_TIME,
    NULL AS ACT_DEM_VC,
    NULL AS ACT_DEM_PERCENT
FROM V_OPTION_PERCENTAGE_NEW AS A
LEFT JOIN CP_VARCHAR_PS AS B
       ON A.PRODUCT_ID = B.PRODUCT_ID
      AND A.CHAR_NUM = B.CHAR_NUM
LEFT JOIN V_WEEK_DESCRIPTOR AS C
       ON A.WEEK_DATE BETWEEN C.WEEK_STARTDATE AND C.WEEK_ENDDATE
WHERE A.TYPE <> '102'

UNION ALL

/* Branch 2: Effective % (1000) */
SELECT
    A.LOCATION_ID,
    A.PRODUCT_ID,
    A.CUSTOMER_GROUP,
    A.MODEL_VERSION,
    A.CHAR_NUM,
    A.CHARVAL_NUM,
    A.VERSION,
    A.SCENARIO,
    '1000' AS TYPE,
    A.EFFECTIVE_PER AS OPT_PERCENT,
    A.EFFECTIVE_QTY AS OPT_QTY,
    A.CHAR_DESC,
    A.CHAR_NAME,
    B.CHAR_TYPE,
    A.CHARVAL_DESC,
    A.VERSION_NAME,
    A.SCENARIO_NAME,
    A.LOCATION_DESC,
    A.PROD_DESC,
    '1000' AS KEY_FIG_ID,
    D.KEY_FIG_DESC,
    D.DISPLAY_ORDER,
    D.PRIORITY_ORDER,
    C.CALENDAR_WEEK,
    C.TELESCOPIC_WEEK,
    C.WEEK_STARTDATE,
    C.WEEK_ENDDATE,
    C.PERIODSTART,
    C.PERIODEND,
    NULL AS LOCK,
    NULL AS COMMENTS,
    NULL AS USER,
    NULL AS OLD_VALUE,
    NULL AS DATE_TIME,
    NULL AS ACT_DEM_VC,
    NULL AS ACT_DEM_PERCENT
FROM V_EFFECTIVE_OPTION_PLAN_NEW AS A
LEFT JOIN CP_VARCHAR_PS AS B
       ON A.PRODUCT_ID = B.PRODUCT_ID
      AND A.CHAR_NUM = B.CHAR_NUM
INNER JOIN CP_KEY_FIGURE_MASTER AS D
        ON D.KEY_FIG_ID = '1000'
LEFT JOIN V_WEEK_DESCRIPTOR AS C
       ON A.WEEK_DATE BETWEEN C.WEEK_STARTDATE AND C.WEEK_ENDDATE

UNION ALL

/* Branch 3: Effective Qty (1001) */
SELECT
    A.LOCATION_ID,
    A.PRODUCT_ID,
    A.CUSTOMER_GROUP,
    A.MODEL_VERSION,
    A.CHAR_NUM,
    A.CHARVAL_NUM,
    A.VERSION,
    A.SCENARIO,
    '1001' AS TYPE,
    A.EFFECTIVE_PER AS OPT_PERCENT,
    A.EFFECTIVE_QTY AS OPT_QTY,
    A.CHAR_DESC,
    A.CHAR_NAME,
    B.CHAR_TYPE,
    A.CHARVAL_DESC,
    A.VERSION_NAME,
    A.SCENARIO_NAME,
    A.LOCATION_DESC,
    A.PROD_DESC,
    '1001' AS KEY_FIG_ID,
    D.KEY_FIG_DESC,
    D.DISPLAY_ORDER,
    D.PRIORITY_ORDER,
    C.CALENDAR_WEEK,
    C.TELESCOPIC_WEEK,
    C.WEEK_STARTDATE,
    C.WEEK_ENDDATE,
    C.PERIODSTART,
    C.PERIODEND,
    NULL AS LOCK,
    NULL AS COMMENTS,
    NULL AS USER,
    NULL AS OLD_VALUE,
    NULL AS DATE_TIME,
    NULL AS ACT_DEM_VC,
    NULL AS ACT_DEM_PERCENT
FROM V_EFFECTIVE_OPTION_PLAN_NEW AS A
LEFT JOIN CP_VARCHAR_PS AS B
       ON A.PRODUCT_ID = B.PRODUCT_ID
      AND A.CHAR_NUM = B.CHAR_NUM
INNER JOIN CP_KEY_FIGURE_MASTER AS D
        ON D.KEY_FIG_ID = '1001'
LEFT JOIN V_WEEK_DESCRIPTOR AS C
       ON A.WEEK_DATE BETWEEN C.WEEK_STARTDATE AND C.WEEK_ENDDATE

ORDER BY
    LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP,
    MODEL_VERSION, CHAR_NUM, CHARVAL_NUM,
    VERSION, SCENARIO, TYPE, WEEK_STARTDATE;

