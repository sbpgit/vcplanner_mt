VIEW "V_SNAPDATE" AS
SELECT 
	A."SNAP_TIMESTAMP",
	A."SNAPSHOT_DESC",
	A."FROM_DATE",
	A."TO_DATE",
	B."LOCATION_ID",
	B."PRODUCT_ID",
	B."UNIQUE_ID",
	B."WEEK_DATE",
	A."TYPE",
	MAX(B."SNAP_TIMESTAMP") AS "SNAP_TIMESTAMP_DATA"
FROM 
	"V_SNAPHEAD" AS A
	--"CP_SNAPSHOT_HEAD" AS A
	LEFT OUTER JOIN
	"V_SNAPDATA" AS B
	--"CP_SNAPSHOT_DATA" AS B
	ON B."SNAP_TIMESTAMP" <= A."SNAP_TIMESTAMP"
WHERE A."TYPE" = 'CIR'
GROUP BY 
	A."SNAP_TIMESTAMP",
	A."SNAPSHOT_DESC",
	A."FROM_DATE",
	A."TO_DATE",
	B."LOCATION_ID",
	B."PRODUCT_ID",
	B."UNIQUE_ID",
	B."WEEK_DATE",
	A."TYPE";