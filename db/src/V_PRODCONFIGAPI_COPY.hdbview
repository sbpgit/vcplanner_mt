----------------------------------------------------------------------------------------
-- Name:            V_PRODCONFIGAPI
-- Description:     Get All Sales Config Details
-- Join Details:    A: V_SALESH_CONFIG -  Sales Configuration Details
--                  B: CP_LOCATION - Location Description
--                  C: V_PARTIALPRODCHAR - Partial Product Description, Type
--                  D: V_SALESHCUST - IBP Customer, Customer Group
--                  E: V_UNIQUE_ID_ITEM - Unique Id Class Number
--                  F: V_CLASSCHARVAL - Class Name , Class Description and IBPChar check
----------------------------------------------------------------------------------------- 


VIEW V_PRODCONFIGAPI_COPY AS
SELECT DISTINCT 
	V_SALESH_CONFIG."LOCATION_ID",
	CP_LOCATION."LOCATION_DESC",
	V_SALESH_CONFIG."PRODUCT_ID",
	V_PARTIALPRODCHAR."PROD_DESC",
	V_PARTIALPRODCHAR."PROD_TYPE",
	V_SALESHCUST."CUSTOMER_GROUP",
	V_SALESHCUST."IBP_CUSTOMER",
	V_UNIQUE_ID_ITEM."CLASS_NUM",
	V_CLASSCHARVAL."CLASS_NAME",
	V_CLASSCHARVAL."CLASS_DESC",
	V_SALESH_CONFIG."CHAR_DESC",
	V_SALESH_CONFIG."CHAR_NUM",	
	V_SALESH_CONFIG."CHAR_NAME",	
	V_SALESH_CONFIG."CHARVAL_NUM",
	V_SALESH_CONFIG."CHAR_VALUE",
	V_SALESH_CONFIG."CHARVAL_DESC",
	V_CLASSCHARVAL."IBPCHAR_CHK",
	CP_PARTIALPROD_CHAR_VALIDITY."VALID_FROM",
    CP_PARTIALPROD_CHAR_VALIDITY."VALID_TO"
FROM 
	"V_SALESH_CONFIG"
	INNER JOIN V_UNIQUE_ID_ITEM
	   ON V_UNIQUE_ID_ITEM.UNIQUE_ID = V_SALESH_CONFIG.UNIQUE_ID
	  AND V_UNIQUE_ID_ITEM.CHAR_NUM = V_SALESH_CONFIG.CHAR_NUM
	  AND V_UNIQUE_ID_ITEM.CHARVAL_NUM = V_SALESH_CONFIG.CHARVAL_NUM
    INNER JOIN V_PARTIALPRODCHAR
      ON V_PARTIALPRODCHAR.LOCATION_ID = V_SALESH_CONFIG.LOCATION_ID
	 AND V_PARTIALPRODCHAR.PRODUCT_ID = V_SALESH_CONFIG.PRODUCT_ID
	INNER JOIN V_CLASSCHARVAL
	   ON V_CLASSCHARVAL.CLASS_NUM = V_UNIQUE_ID_ITEM.CLASS_NUM
	  AND V_CLASSCHARVAL.CHAR_NUM = V_SALESH_CONFIG.CHAR_NUM
	  AND V_CLASSCHARVAL.CHARVAL_NUM = V_SALESH_CONFIG.CHARVAL_NUM
    INNER JOIN V_SALESHCUST
	  ON V_SALESHCUST.LOCATION_ID = V_PARTIALPRODCHAR.LOCATION_ID
	 AND V_SALESHCUST.PRODUCT_ID  = V_PARTIALPRODCHAR.PRODUCT_ID
	INNER JOIN 	CP_LOCATION
  	   ON V_PARTIALPRODCHAR.LOCATION_ID = CP_LOCATION.LOCATION_ID
	INNER JOIN "CP_PARTIALPROD_CHAR_VALIDITY"
	   ON CP_PARTIALPROD_CHAR_VALIDITY.PRODUCT_ID = V_PARTIALPRODCHAR.PRODUCT_ID  
	  AND CP_PARTIALPROD_CHAR_VALIDITY.CLASS_NUM = V_UNIQUE_ID_ITEM.CLASS_NUM  
	  AND CP_PARTIALPROD_CHAR_VALIDITY.CHAR_NUM = V_SALESH_CONFIG.CHAR_NUM  
	  AND CP_PARTIALPROD_CHAR_VALIDITY.CHARVAL_NUM = V_SALESH_CONFIG.CHARVAL_NUM
	ORDER BY 
	V_SALESH_CONFIG."LOCATION_ID" ASC, 
	V_SALESH_CONFIG."PRODUCT_ID" ASC, 
	V_SALESHCUST."IBP_CUSTOMER" ASC;