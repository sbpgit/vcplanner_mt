VIEW "V_PROD_CHARBUCKET" AS 
SELECT DISTINCT 
	A.CLASS_NUM,
	A.CHAR_NUM,
	A.CHAR_NAME,
	A.CHAR_DESC,
	A.CHAR_TYPE,
	B.PRODUCT_ID,
	C.PROD_DESC
FROM 
	CP_CHARACTERISTICS AS A
	INNER JOIN
	CP_PRODUCT_CLASS AS B
	ON A.CLASS_NUM = B.CLASS_NUM
	INNER JOIN
	CP_PRODUCT AS C
	ON B.PRODUCT_ID = C.PRODUCT_ID
WHERE A.CHAR_TYPE = 'NUM';
