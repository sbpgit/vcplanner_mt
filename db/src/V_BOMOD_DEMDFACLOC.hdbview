----------------------------------------------------------------------------------------
-- Name:            V_BOMOD_DEMDFACLOC
-- Description:     Demand location for BOM factory location
-- Join Details:    A: CP_BOM_OBJDEPENDENCY -  BOM OD header
--                  B: CP_FACTORY_SALESLOC - Factory Location
-----------------------------------------------------------------------------------------
VIEW "V_BOMOD_DEMDFACLOC" AS
SELECT DISTINCT B.LOCATION_ID,
  B.FACTORY_LOC,
  A.PRODUCT_ID,
  A.ITEM_NUM,
  A.COMPONENT,
  C.COMP_DESC,
  C.CRITICAL_ASM,
  A.OBJ_DEP,
  A.OBJDEP_DESC,
  A.COMP_QTY,
  A.VALID_FROM as OD_VALID_FROM,
  A.VALID_TO as OD_VALID_TO,
  C.VALID_FROM,
  C.VALID_TO
FROM "CP_BOM_OBJDEPENDENCY" AS A
  INNER JOIN "CP_FACTORY_SALESLOC" AS B
 ON A.LOCATION_ID = B.FACTORY_LOC
 INNER JOIN "CP_BOMHEADER" AS C
 ON A.LOCATION_ID = C.LOCATION_ID
 AND A.PRODUCT_ID = C.PRODUCT_ID
 AND A.COMPONENT = C.COMPONENT
 AND A.ITEM_NUM = C.ITEM_NUM;