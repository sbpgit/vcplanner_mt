----------------------------------------------------------------------------------------
-- Name:            V_COMP_DEMDFACLOC
-- Description:     Demand location for BOM factory location
-- Join Details:    A: CP_BOMHEADER -  BOM header
--                  B: CP_FACTORY_SALESLOC - Factory Location
-----------------------------------------------------------------------------------------
VIEW "V_COMP_DEMDFACLOC" AS
SELECT DISTINCT B.LOCATION_ID,
  B.FACTORY_LOC,
  A.ASSEMBLY,
  A.COMPONENT,
  A.COMP_TYPE,
  A.COMP_DESC,
  A.COMP_QTY,
  A.CRITICAL_COMP,
  A.VALID_FROM,
  A.VALID_TO,
  C.MRP_GROUP,
  C.MRP_TYPE
FROM "CP_ASSEMBLY_COMP" AS A
  INNER JOIN "CP_FACTORY_SALESLOC" AS B
 ON A.LOCATION_ID = B.FACTORY_LOC
 INNER JOIN "CP_LOCATION_PRODUCT" AS C
 ON A.LOCATION_ID = C.LOCATION_ID
 AND A.COMPONENT = C.PRODUCT_ID