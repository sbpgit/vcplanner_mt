VIEW "V_ASSEMBLYREQ_FORCREQ" AS
  SELECT "CP_ASSEMBLY_REQ"."LOCATION_ID",
    "CP_FACTORY_SALESLOC"."FACTORY_LOC",
    "CP_ASSEMBLY_REQ"."PRODUCT_ID",
    "CP_ASSEMBLY_REQ"."REF_PRODID",
    "CP_ASSEMBLY_REQ"."COMPONENT",
    "CP_ASSEMBLY_REQ"."WEEK_DATE",
    "CP_ASSEMBLY_REQ"."TYPE",
    "CP_ASSEMBLY_REQ"."MODEL_VERSION",
    "CP_ASSEMBLY_REQ"."VERSION",
    "CP_ASSEMBLY_REQ"."SCENARIO",
    SUM("CP_ASSEMBLY_REQ"."COMPCIR_QTY") AS COMP_QTY
  FROM "CP_ASSEMBLY_REQ"
    INNER JOIN "CP_FACTORY_SALESLOC"
   ON "CP_FACTORY_SALESLOC"."LOCATION_ID" = "CP_ASSEMBLY_REQ"."LOCATION_ID"
    AND "CP_FACTORY_SALESLOC"."PRODUCT_ID" = "CP_ASSEMBLY_REQ"."PRODUCT_ID"
  --   INNER JOIN "CP_BOMHEADER"
  --  ON "CP_BOMHEADER"."LOCATION_ID" = "CP_FACTORY_SALESLOC"."FACTORY_LOC"
  --   AND "CP_BOMHEADER"."PRODUCT_ID" = "CP_ASSEMBLY_REQ"."REF_PRODID"
  --   AND "CP_BOMHEADER"."ITEM_NUM" = "CP_ASSEMBLY_REQ"."ITEM_NUM"
  --   AND "CP_BOMHEADER"."COMPONENT" = "CP_ASSEMBLY_REQ"."COMPONENT"
  -- WHERE "CP_ASSEMBLY_REQ"."WEEK_DATE" >= "CP_BOMHEADER"."VALID_FROM"
  --   AND "CP_ASSEMBLY_REQ"."WEEK_DATE" <= "CP_BOMHEADER"."VALID_TO"
  GROUP BY "CP_ASSEMBLY_REQ"."LOCATION_ID",
    "CP_FACTORY_SALESLOC"."FACTORY_LOC",
    "CP_ASSEMBLY_REQ"."PRODUCT_ID",
    "CP_ASSEMBLY_REQ"."REF_PRODID",
    "CP_ASSEMBLY_REQ"."COMPONENT",
    "CP_ASSEMBLY_REQ"."WEEK_DATE",
    "CP_ASSEMBLY_REQ"."TYPE",
    "CP_ASSEMBLY_REQ"."MODEL_VERSION",
    "CP_ASSEMBLY_REQ"."VERSION",
    "CP_ASSEMBLY_REQ"."SCENARIO";