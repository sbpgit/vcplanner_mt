VIEW "V_SNAPSHOT" AS
SELECT DISTINCT A."SNAP_TIMESTAMP",
  A."SNAPSHOT_DESC",
  A."FROM_DATE",
  A."TO_DATE",
  A."TYPE",
  A."LOCATION_ID",
  C.LOCATION_DESC,
  A."PRODUCT_ID",
  D."PROD_DESC",
  A."UNIQUE_ID",
  E."UNIQUE_DESC",
  A."WEEK_DATE",
  A."SNAP_TIMESTAMP_DATA",
  B.CIR_QTY
FROM V_SNAPDATE AS A
  INNER JOIN "V_SNAPDATA" AS B
 ON 
--"CP_SNAPSHOT_DATA" AS D
  A."LOCATION_ID" = B."LOCATION_ID"
  AND A."PRODUCT_ID" = B."PRODUCT_ID"
  AND A."UNIQUE_ID" = B."UNIQUE_ID"
  AND A."WEEK_DATE" = B."WEEK_DATE"
  AND A."SNAP_TIMESTAMP_DATA" = B."SNAP_TIMESTAMP"
  LEFT OUTER JOIN CP_LOCATION AS C
 ON A."LOCATION_ID" = C."LOCATION_ID"
  LEFT OUTER JOIN "CP_PRODUCT" AS D
 ON A."PRODUCT_ID" = D."PRODUCT_ID"
  LEFT OUTER JOIN "V_UNIQUE_ID" AS E
 ON A."UNIQUE_ID" = E."UNIQUE_ID";