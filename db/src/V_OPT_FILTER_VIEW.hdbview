VIEW V_OPT_FILTER_VIEW AS 
SELECT DISTINCT 
	A.LOCATION_ID,
	A.PRODUCT_ID,
	B.LOCATION_DESC,
	B.PROD_DESC,
	A.CUSTOMER_GROUP,
	A.CHAR_NUM,
	A.CHARVAL_NUM,
	(
		(SELECT MAX(CHAR_DESC)
		FROM CP_CHARACTERISTICS
		WHERE CHAR_NUM = A.CHAR_NUM)
	) AS CHAR_DESC,
	(
		(SELECT DISTINCT CHAR_NAME
		FROM CP_CHARACTERISTICS
		WHERE CHAR_NUM = A.CHAR_NUM)
	) AS CHAR_NAME,
	(
		(SELECT CHARVAL_DESC
		FROM CP_CHAR_VALUES
		WHERE CHAR_NUM = A.CHAR_NUM
			AND CHAR_VALUE = A.CHARVAL_NUM)
	) AS CHARVAL_DESC,
	A.MODEL_VERSION,
	A.VERSION,
	C.VERSION_NAME,
    C.SCENARIO_NAME,
	A.SCENARIO,
	ROLES.USER AS USER
FROM 
	CP_PAL_FCHARPLAN AS A
	INNER JOIN
	V_PARTIALPRODDESC AS B
	ON A.LOCATION_ID = B.LOCATION_ID
		AND A.PRODUCT_ID = B.PRODUCT_ID
	INNER JOIN
	CP_IBPVERSIONSCENARIO AS C
	ON A.VERSION = C.VERSION
		AND A.SCENARIO = C.SCENARIO
  INNER JOIN "V_ROLES_LOCPROD" AS ROLES ON
      ROLES.DEMAND_LOC = A.LOCATION_ID AND ROLES.PRODUCT_ID = A.PRODUCT_ID
ORDER BY 
	A.LOCATION_ID ASC, 
	A.PRODUCT_ID ASC, 
	A.CUSTOMER_GROUP ASC, 
	A.CHAR_NUM ASC, 
	A.CHARVAL_NUM ASC, 
	A.MODEL_VERSION ASC, 
	A.VERSION ASC, 
	A.SCENARIO ASC;