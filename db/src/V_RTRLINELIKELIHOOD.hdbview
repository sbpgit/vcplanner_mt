VIEW V_RTRLINELIKELIHOOD AS
-- SELECT DISTINCT 
-- 	A."WEEK_DATE",
-- 	A."PRODUCT_ID",
-- 	D."FACTORY_LOC" AS LOCATION_ID,
-- 	-- B."LINE_ID",
-- 	 (SELECT MAX(LINE_ID) FROM V_LOCPRODLINERTR AS B WHERE D."LOCATION_ID" = B."LOCATION_ID"
--         AND A."COMPONENT" = B."RESTRICTION" )  AS "LINE_ID",
-- 	B."RESTRICTION",
-- 	A."MODEL_VERSION",
-- 	A."VERSION",
-- 	A."SCENARIO",
-- 	SUM(A.COMPCIR_QTY) AS RTR_QTY
-- FROM 
-- 	CP_ASSEMBLY_REQ AS A
-- 	INNER JOIN
-- 	CP_FACTORY_SALESLOC AS D
-- 	ON A.LOCATION_ID = D.LOCATION_ID
-- 	INNER JOIN
-- 	-- V_LOCPRODLINERTR AS B
-- 	-- -- ON D."FACTORY_LOC" = B."LOCATION_ID"
-- 	-- ON D."LOCATION_ID" = B."LOCATION_ID"
-- 	-- AND  A."PRODUCT_ID" = D.PRODUCT_ID
-- 		-- AND A."COMPONENT" = B."RESTRICTION"
-- -- WHERE A.WEEK_DATE >= B.VALID_FROM
-- -- 	AND A.WEEK_DATE <= B.VALID_TO
-- GROUP BY
-- A."WEEK_DATE",
-- 	A."PRODUCT_ID",
-- 	D."FACTORY_LOC" ,
-- 	B."LINE_ID",
-- 	B."RESTRICTION",
-- 	A."MODEL_VERSION",
-- 	A."VERSION",
-- 	A."SCENARIO"
-- ORDER BY 
-- 	A."WEEK_DATE" ASC, 
-- 	B."RESTRICTION" ASC;


SELECT DISTINCT
    A."WEEK_DATE",
    A."PRODUCT_ID",
    D."FACTORY_LOC" AS LOCATION_ID,
    (SELECT MAX(LINE_ID) FROM V_LOCPRODLINERTR AS B WHERE D."LOCATION_ID" = B."LOCATION_ID"
        AND A."COMPONENT" = B."RESTRICTION" )  AS "LINE_ID",
    A."COMPONENT" as RESTRICTION,
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    SUM(A.COMPCIR_QTY) AS RTR_QTY
FROM
    CP_ASSEMBLY_REQ AS A
    INNER JOIN
    CP_FACTORY_SALESLOC AS D
    ON A.LOCATION_ID = D.LOCATION_ID
    AND  A."PRODUCT_ID" = D.PRODUCT_ID
    -- INNER JOIN
    -- V_LOCPRODLINERTR AS B
    -- -- ON D."FACTORY_LOC" = B."LOCATION_ID"
    -- ON D."LOCATION_ID" = B."LOCATION_ID"
    --     AND A."COMPONENT" = B."RESTRICTION"
-- WHERE A.WEEK_DATE >= B.VALID_FROM
--  AND A.WEEK_DATE <= B.VALID_TO
  WHERE TYPE = 'RT'
GROUP BY
    D."LOCATION_ID",
    A."WEEK_DATE",
    A."PRODUCT_ID",
    A."COMPONENT",
    D."FACTORY_LOC" ,
    -- B."LINE_ID",
    -- B."RESTRICTION",
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO"
ORDER BY
    A."WEEK_DATE" ASC;
    -- B."RESTRICTION" ASC;