VIEW "V_SALESH_CONFIG" AS
SELECT
 V_SALES_H.LOCATION_ID,
 V_SALES_H.PRODUCT_ID,
 V_UNIQUE_ID.UNIQUE_ID,
 V_UNIQUE_ID.UNIQUE_DESC,
 V_UNIQUE_ID.CHAR_NUM,
 V_PARTIALPRODCHAR.CHAR_NAME,
 V_PARTIALPRODCHAR.CHAR_DESC,
 V_UNIQUE_ID.CHARVAL_NUM,
 V_PARTIALPRODCHAR.CHAR_VALUE,
 V_PARTIALPRODCHAR.CHARVAL_DESC, 
 SUM("ORD_QTY") AS ORD_QTY
FROM
 V_SALES_H
 INNER JOIN
 V_UNIQUE_ID
 ON V_SALES_H.UNIQUE_ID = V_UNIQUE_ID.UNIQUE_ID
  INNER JOIN 
  V_PARTIALPRODCHAR 
  ON V_PARTIALPRODCHAR.LOCATION_ID = V_SALES_H.LOCATION_ID
  AND V_PARTIALPRODCHAR.REF_PRODID = V_SALES_H.REF_PRODID
  AND V_PARTIALPRODCHAR.CHAR_NUM = V_UNIQUE_ID.CHAR_NUM
  AND V_PARTIALPRODCHAR.CHARVAL_NUM = V_UNIQUE_ID.CHARVAL_NUM
GROUP BY
 V_SALES_H.LOCATION_ID,
 V_SALES_H.PRODUCT_ID,
 V_UNIQUE_ID.UNIQUE_ID,
 V_UNIQUE_ID.UNIQUE_DESC,
 V_UNIQUE_ID.CHAR_NUM,
 V_PARTIALPRODCHAR.CHAR_NAME,
 V_PARTIALPRODCHAR.CHAR_DESC,
 V_UNIQUE_ID.CHARVAL_NUM,
 V_PARTIALPRODCHAR.CHAR_VALUE,
 V_PARTIALPRODCHAR.CHARVAL_DESC