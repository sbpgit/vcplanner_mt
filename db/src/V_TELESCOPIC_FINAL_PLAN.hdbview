 VIEW "V_TELESCOPIC_FINAL_PLAN" AS

WITH PRODEMAND AS (
    SELECT FD."LOCATION_ID",
           FD."PRODUCT_ID",
           FD."CUSTOMER_GROUP",
           FD."VERSION",
           FD."SCENARIO",
           B."TELESCOPIC_WEEK",
           SUM(FD."QUANTITY") AS QUANTITY
    FROM "CP_IBP_FUTUREDEMAND_LOCPRODCUST" FD
    LEFT JOIN "V_WEEK_DESCRIPTOR" B
      ON FD."WEEK_DATE" BETWEEN B."WEEK_STARTDATE" AND B."WEEK_ENDDATE"
    GROUP BY FD."LOCATION_ID",
             FD."PRODUCT_ID",
             FD."CUSTOMER_GROUP",
             FD."VERSION",
             FD."SCENARIO",
             B."TELESCOPIC_WEEK"
),

/* Product-level forecast total (TYPE 102) */
FORECAST_TOTAL AS (
    SELECT FO."LOCATION_ID",
           FO."PRODUCT_ID",
           FO."VERSION",
           FO."SCENARIO",
           FO."MODEL_VERSION",
           B."TELESCOPIC_WEEK",
           SUM(FO."CIR_QTY") AS QUANTITY
    FROM "CP_CIR_GENERATED" FO
    LEFT JOIN "V_WEEK_DESCRIPTOR" B
      ON FO."WEEK_DATE" BETWEEN B."WEEK_STARTDATE" AND B."WEEK_ENDDATE"
    GROUP BY FO."LOCATION_ID",
             FO."PRODUCT_ID",
             FO."VERSION",
             FO."SCENARIO",
             FO."MODEL_VERSION",
             B."TELESCOPIC_WEEK"
)

SELECT 
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."CUSTOMER_GROUP",
    A."MODEL_VERSION",
    A."CHAR_NUM",
    A."CHARVAL_NUM",
    A."VERSION",
    A."SCENARIO",
    A."TYPE",

   
    CASE
        
        WHEN A."TYPE" = '101' THEN
            MAX(A."OPT_PERCENT")
       
        WHEN A."KEY_FIG_ID" = '102' THEN
            CASE
                WHEN MAX(FO.QUANTITY) IS NULL OR MAX(FO.QUANTITY) = 0 THEN 0
                ELSE ROUND((MAX(A."OPT_QTY") / MAX(FO.QUANTITY)) * 100, 2)
            END

        ELSE
            CASE
                WHEN MAX(FD.QUANTITY) IS NULL OR MAX(FD.QUANTITY) = 0 THEN 0
                ELSE ROUND((MAX(A."OPT_QTY") / MAX(FD.QUANTITY)) * 100, 2)
            END
    END AS "OPT_PERCENT",

    /* ===== OPT_QTY FIX ===== */
    MAX(A."OPT_QTY") AS "OPT_QTY",

    A."CHAR_DESC",
    A."CHAR_NAME",
    A."CHAR_TYPE",
    A."CHARVAL_DESC",
    A."VERSION_NAME",
    A."SCENARIO_NAME",
    A."LOCATION_DESC",
    A."PROD_DESC",
    A."KEY_FIG_ID",
    A."KEY_FIG_DESC",
    A."DISPLAY_ORDER",
    A."PRIORITY_ORDER",
    A."TELESCOPIC_WEEK",
    A."PERIODSTART",
    A."PERIODEND",
    A."ACT_DEM_VC",
    A."ACT_DEM_PERCENT"

FROM "V_FINAL_OPTION_PLAN" A  


LEFT JOIN PRODEMAND FD 
    ON FD."LOCATION_ID" = A."LOCATION_ID"
   AND FD."PRODUCT_ID" = A."PRODUCT_ID"
   AND FD."CUSTOMER_GROUP" = A."CUSTOMER_GROUP"
   AND FD."VERSION" = A."VERSION"
   AND FD."SCENARIO" = A."SCENARIO"
   AND FD."TELESCOPIC_WEEK" = A."TELESCOPIC_WEEK"

LEFT JOIN FORECAST_TOTAL FO 
    ON FO."LOCATION_ID" = A."LOCATION_ID"
   AND FO."PRODUCT_ID" = A."PRODUCT_ID"
   AND FO."VERSION" = A."VERSION"
   AND FO."SCENARIO" = A."SCENARIO"
   AND FO."MODEL_VERSION" = A."MODEL_VERSION"
   AND FO."TELESCOPIC_WEEK" = A."TELESCOPIC_WEEK"

GROUP BY 
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."CUSTOMER_GROUP",
    A."MODEL_VERSION",
    A."CHAR_NUM",
    A."CHARVAL_NUM",
    A."VERSION",
    A."SCENARIO",
    A."TYPE",
    A."CHAR_DESC",
    A."CHAR_NAME",
    A."CHAR_TYPE",
    A."CHARVAL_DESC",
    A."VERSION_NAME",
    A."SCENARIO_NAME",
    A."LOCATION_DESC",
    A."PROD_DESC",
    A."KEY_FIG_ID",
    A."KEY_FIG_DESC",
    A."DISPLAY_ORDER",
    A."PRIORITY_ORDER",
    A."TELESCOPIC_WEEK",
    A."PERIODSTART",
    A."PERIODEND",
    A."ACT_DEM_VC",
    A."ACT_DEM_PERCENT"

ORDER BY 
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."CUSTOMER_GROUP",
    A."CHAR_NUM",
    A."PERIODSTART";
