VIEW "V_CAPACITY_CONSUMPTION" AS
SELECT 
A."LOCATION_ID",
A."FACTORY_LOC",
A."PRODUCT_ID",
A."COMPONENT",
-- A."WEEK_DATE",
(SELECT TO_DATE(PERIODSTART) from CP_IBPCALENDER_WEEK where WEEK_STARTDATE = A."WEEK_DATE" and LEVEL = 'W') AS WEEK_DATE,
C."LINE_ID",
E.RESTRICTION,
SUM(A."COMPCIR_QTY") AS COMPCIR_QTY,
A."MODEL_VERSION",
A."VERSION",
A."SCENARIO",
B."QUANTITY",
CASE WHEN SUM(B.QUANTITY) = 0 Then 0
       ELSE  ROUND(SUM(A."COMPCIR_QTY")/ B.QUANTITY ,4) END
       as Coeffcient
FROM "CP_ASSEMBLY_REQ" as A
INNER JOIN "CP_LINECAPACITY" as C ON A.FACTORY_LOC = C.LOCATION_ID
                                 AND A.REF_PRODID = C.PRODID
INNER JOIN "CP_RESTRICT_HEADER" as E ON A.FACTORY_LOC = E.LOCATION_ID
    						        AND E.LINE_ID = C.LINE_ID     			
INNER JOIN  "CP_IBP_FUTUREDEMAND" as B
     ON A.WEEK_DATE  = B.WEEK_DATE
     AND A.LOCATION_ID = B.LOCATION_ID
    AND A.PRODUCT_ID = B.PRODUCT_ID
   AND ( UPPER(A."VERSION") = UPPER(B."VERSION") )
AND ( UPPER(A."SCENARIO") = UPPER(B."SCENARIO") )
WHERE A.TYPE = 'RT' 

GROUP BY
A."LOCATION_ID",
A."FACTORY_LOC",
A."PRODUCT_ID",
A."COMPONENT",
A."WEEK_DATE",
-- (SELECT TO_DATE(PERIODSTART) from CP_IBPCALENDER_WEEK where WEEK_STARTDATE = A."WEEK_DATE" and LEVEL = 'W') AS WEEK_DATE,
C."LINE_ID",
E.RESTRICTION,
-- SUM(A."COMPCIR_QTY"),
A."MODEL_VERSION",
A."VERSION",
A."SCENARIO",
B."QUANTITY";


