VIEW V_ASSEMBLY_COMP_BOM AS
SELECT 
   -- A table (CP_ASSEMBLY_REQ)
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."ITEM_NUM",
    A."COMPONENT"                AS ASSEMBLY,
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    A."TYPE"                     AS RULE_TYPE,
    A."TYPE",
    A."REF_PRODID",
    A."FACTORY_LOC",
    TO_VARCHAR(A."UNIQUE_ID") AS "UNIQUE_ID",

    -- B table (CP_LOCATION)
    B.LOCATION_DESC AS FACTORY_LOCATION_DESC,

    -- B table (CP_LOCATION)
    H.LOCATION_DESC AS LOCATION_DESC,

    -- C table (CP_PRODUCT)
    C.PROD_DESC,

    -- D table (CP_BOM_MAT)
    -- D.MRP_GROUP,
    D."PHANTOM_IND",
    D."CONFIGURABLE",
    CP_IBPVERSIONSCENARIO.VERSION_NAME,
    CP_IBPVERSIONSCENARIO.SCENARIO_NAME,

    -- Derived ASM_DESC
 (SELECT MAX(PROD_DESC) FROM CP_BOM_MAT AS D WHERE D.MAT_CHILD = A."COMPONENT") as ASM_DESC,

    -- E table (V_WEEK_DESCRIPTOR)
    E."CALENDAR_WEEK",
    E."TELESCOPIC_WEEK",
    E."WEEK_STARTDATE",
    E."WEEK_ENDDATE",

    -- Aggregates
    SUM(COALESCE(A."COMPCIR_QTY", 0) * COALESCE(D."COMPONENT_QTY", 0)) AS TOTAL_COMPONENT_QTY,
    -- Constants
    'OD'                         AS REQ_TYPE

FROM CP_ASSEMBLY_REQ AS A

     -- Join with Location
    INNER JOIN CP_LOCATION AS B
        ON A."FACTORY_LOC" = B."LOCATION_ID"

     -- Join with Location
    INNER JOIN CP_LOCATION AS H
        ON A."LOCATION_ID" = H."LOCATION_ID"

    -- Join with Product
    INNER JOIN CP_PRODUCT AS C
        ON C.PRODUCT_ID = A."REF_PRODID"

    -- Join with BOM Material
    LEFT OUTER JOIN CP_BOM_MAT AS D
        ON D.MAT_PARENT = A."COMPONENT"
       AND D.CHILD_LOC = A."FACTORY_LOC"
       AND A.WEEK_DATE >= D.VALID_FROM
       AND A.WEEK_DATE <= D.VALID_TO    

    -- Join with Week Descriptor
    LEFT OUTER JOIN "V_WEEK_DESCRIPTOR" AS E
        ON A.WEEK_DATE >= E."WEEK_STARTDATE"
       AND A."WEEK_DATE" <= E."WEEK_ENDDATE"   

      LEFT OUTER JOIN CP_IBPVERSIONSCENARIO
 ON CP_IBPVERSIONSCENARIO.VERSION = A."VERSION"
 AND CP_IBPVERSIONSCENARIO.SCENARIO = A."SCENARIO"


GROUP BY 
    A."LOCATION_ID",
    B.LOCATION_DESC,
    A."PRODUCT_ID",
    C.PROD_DESC,
    A."ITEM_NUM",
    A."COMPONENT",
    D.PROD_DESC,
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    A."TYPE",
    A."REF_PRODID",
    A."FACTORY_LOC",
    -- D.MRP_GROUP,
    D."PHANTOM_IND",
    D."CONFIGURABLE",
    A."UNIQUE_ID",
    E."CALENDAR_WEEK",
    E."TELESCOPIC_WEEK",
    E."WEEK_STARTDATE",
    E."WEEK_ENDDATE",
    H.LOCATION_DESC,
    CP_IBPVERSIONSCENARIO.VERSION_NAME,
    CP_IBPVERSIONSCENARIO.SCENARIO_NAME,
    'OD';