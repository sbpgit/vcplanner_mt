VIEW "V_ASMREQ_PRODCONSD" AS
SELECT 
	"CP_ASSEMBLY_REQ"."LOCATION_ID",
	"CP_FACTORY_SALESLOC"."FACTORY_LOC",
	"CP_ASSEMBLY_REQ"."REF_PRODID" AS PRODUCT_ID,
	"CP_ASSEMBLY_REQ"."ITEM_NUM",
	"CP_ASSEMBLY_REQ"."COMPONENT",
	"CP_ASSEMBLY_REQ"."WEEK_DATE",
	"CP_ASSEMBLY_REQ"."MODEL_VERSION",
	"CP_ASSEMBLY_REQ"."VERSION",
	"CP_ASSEMBLY_REQ"."SCENARIO",
	"CP_PVS_BOM"."STRUC_NODE",
	"CP_LOCATION"."LOCATION_DESC",
	"CP_BOMHEADER"."COMP_DESC",
	"CP_PVS_NODES"."NODE_DESC",
	SUM("COMPCIR_QTY") AS COMP_QTY
FROM 
	"CP_ASSEMBLY_REQ"
	INNER JOIN
	"CP_FACTORY_SALESLOC"
	ON "CP_FACTORY_SALESLOC"."LOCATION_ID" = "CP_ASSEMBLY_REQ"."LOCATION_ID"
		AND "CP_FACTORY_SALESLOC"."PRODUCT_ID" = "CP_ASSEMBLY_REQ"."PRODUCT_ID"
	INNER JOIN
	"CP_PVS_BOM"
	ON "CP_FACTORY_SALESLOC"."FACTORY_LOC" = "CP_PVS_BOM"."LOCATION_ID"
		AND "CP_ASSEMBLY_REQ"."REF_PRODID" = "CP_PVS_BOM"."PRODUCT_ID"
		AND "CP_ASSEMBLY_REQ"."ITEM_NUM" = "CP_PVS_BOM"."ITEM_NUM"
		AND "CP_ASSEMBLY_REQ"."COMPONENT" = "CP_PVS_BOM"."COMPONENT"
	INNER JOIN CP_LOCATION
	ON CP_ASSEMBLY_REQ.LOCATION_ID = CP_LOCATION.LOCATION_ID
	INNER JOIN CP_BOMHEADER
	ON CP_FACTORY_SALESLOC.FACTORY_LOC = CP_BOMHEADER.LOCATION_ID
	AND CP_ASSEMBLY_REQ.COMPONENT = CP_BOMHEADER.COMPONENT
	INNER JOIN CP_PVS_NODES
	ON CP_PVS_BOM.STRUC_NODE = CP_PVS_NODES.CHILD_NODE
   AND CP_PVS_NODES.NODE_TYPE = 'SN'
   WHERE CP_ASSEMBLY_REQ.TYPE = 'PI'
GROUP BY 
	"CP_ASSEMBLY_REQ"."LOCATION_ID",
	"CP_FACTORY_SALESLOC"."FACTORY_LOC",
	"CP_ASSEMBLY_REQ"."REF_PRODID",
	"CP_ASSEMBLY_REQ"."ITEM_NUM",
	"CP_ASSEMBLY_REQ"."COMPONENT",
	"CP_ASSEMBLY_REQ"."WEEK_DATE",
	"CP_ASSEMBLY_REQ"."MODEL_VERSION",
	"CP_ASSEMBLY_REQ"."VERSION",
	"CP_ASSEMBLY_REQ"."SCENARIO",
	"CP_PVS_BOM"."STRUC_NODE",
	"CP_LOCATION"."LOCATION_DESC",
	"CP_BOMHEADER"."COMP_DESC",
	"CP_PVS_NODES"."NODE_DESC";


