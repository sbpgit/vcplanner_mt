VIEW V_IBP_FUTUREDEMAND_TELESCOPIC AS
SELECT PERIODSTART AS WEEK_DATE, LOCATION_ID, PRODUCT_ID, VERSION, SCENARIO, SUM(QUANTITY) AS QUANTITY
FROM CP_IBP_FUTUREDEMAND 
AS IFC
INNER JOIN CP_TELESCOPIC_PERIODS AS TSP ON
TSP.PERIODSTART BETWEEN PERIODSTART AND PERIODEND
AND (WEEK_DATE BETWEEN PERIODSTART AND PERIODEND )
GROUP BY PERIODSTART, LOCATION_ID, PRODUCT_ID, VERSION, SCENARIO;
