VIEW "V_FCHARPLANTELEWEEK" AS 
SELECT 
  A."LOCATION_ID",
  A."PRODUCT_ID",
  A."CHAR_NUM",
  A."CHARVAL_NUM",
  A."VERSION",
  A."SCENARIO",
   B."PERIODSTART",
   B."PERIODEND",
  B."TELESCOPIC_WEEK",
  AVG(A."OPT_PERCENT") AS "PERCENT",
  SUM(A."OPT_QTY") AS "QUANTITY"
FROM "CP_IBP_FCHARPLAN" A
  LEFT OUTER JOIN "V_WEEK_DESCRIPTOR" AS B
 ON A."WEEK_DATE" >= B."WEEK_STARTDATE"
  AND A."WEEK_DATE" <= B."WEEK_ENDDATE"
  
  GROUP BY 
   A."LOCATION_ID",
  A."PRODUCT_ID",
  A."CHAR_NUM",
  A."CHARVAL_NUM",
  A."VERSION",
  A."SCENARIO",
  B."PERIODSTART",
   B."PERIODEND",
  B."TELESCOPIC_WEEK";