 VIEW V_OPT_MANUAL AS
WITH PRODEMAND AS (
    SELECT
        FD."LOCATION_ID",
        FD."PRODUCT_ID",
        FD."CUSTOMER_GROUP",
        FD."VERSION",
        FD."SCENARIO",
        B."TELESCOPIC_WEEK",
        SUM(FD."QUANTITY") AS QUANTITY
    FROM "CP_IBP_FUTUREDEMAND_LOCPRODCUST" FD
    LEFT JOIN "V_WEEK_DESCRIPTOR" B
      ON FD."WEEK_DATE" BETWEEN B."WEEK_STARTDATE" AND B."WEEK_ENDDATE"
    GROUP BY
        FD."LOCATION_ID",
        FD."PRODUCT_ID",
        FD."CUSTOMER_GROUP",
        FD."VERSION",
        FD."SCENARIO",
        B."TELESCOPIC_WEEK"
)
SELECT
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."CUSTOMER_GROUP",
    A."MODEL_VERSION",
    A."CHAR_NUM",
    A."CHARVAL_NUM",
    A."VERSION",
    A."SCENARIO",
    '1000' AS "TYPE",

    CASE
        WHEN MAX(FD."QUANTITY") IS NULL OR MAX(FD."QUANTITY") = 0
        THEN 0
        ELSE ROUND(
            (SUM(A."OPT_QTY") / MAX(FD."QUANTITY")) * 100,
            2
        )
    END AS "OPT_PERCENT",

    SUM(A."OPT_QTY") AS "OPT_QTY",
    A."TELESCOPIC_WEEK",
    A."PERIODSTART",
    A."PERIODEND"

FROM V_FINAL_OPTION_PLAN_NEW A
LEFT JOIN PRODEMAND FD
    ON FD."LOCATION_ID"     = A."LOCATION_ID"
   AND FD."PRODUCT_ID"      = A."PRODUCT_ID"
   AND FD."CUSTOMER_GROUP"  = A."CUSTOMER_GROUP"
   AND FD."VERSION"         = A."VERSION"
   AND FD."SCENARIO"        = A."SCENARIO"
   AND FD."TELESCOPIC_WEEK" = A."TELESCOPIC_WEEK"
WHERE A."TYPE" = '1000'
GROUP BY
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."CUSTOMER_GROUP",
    A."MODEL_VERSION",
    A."CHAR_NUM",
    A."CHARVAL_NUM",
    A."VERSION",
    A."SCENARIO",
    A."TELESCOPIC_WEEK",
    A."PERIODSTART",
    A."PERIODEND";