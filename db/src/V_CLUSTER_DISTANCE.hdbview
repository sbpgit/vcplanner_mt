VIEW "V_CLUSTER_DISTANCE" AS
SELECT DISTINCT A.LOCATION_ID,
                A.PRODUCT_ID,
                A.CLUSTER_ID,
                A.PRPID,
                B.TARGET_CLUSTER_ID,
                B.DISTANCE
        FROM CP_CLUSTER_PRPIDS_MAPPED_PIDS AS A
  INNER JOIN CP_AHC_CLUSTER_DISTANCES AS B
        ON A.CLUSTER_ID = B.SOURCE_CLUSTER_ID
        AND A.LOCATION_ID = B.LOCATION_ID
        AND A.PRODUCT_ID = B.PRODUCT_ID
        AND A.CLUSTER_ID != B.TARGET_CLUSTER_ID
    ORDER BY A.CLUSTER_ID,
             A.PRPID,
             B.DISTANCE;