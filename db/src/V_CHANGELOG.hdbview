
VIEW "V_CHANGELOG" AS
-- 		-- SELECT DISTINCT B.DESCRIPTION,
-- 		-- 		A.PARAMETER_ID,
-- 		-- 		A.LOCATION_ID,
-- 		-- 		A.OLD_VALUE,
-- 		-- 		A.NEW_VALUE,
-- 		-- 		A.CHANGED_BY,
-- 		-- 		A.CHANGED_DATE,
-- 		-- 		A.CHANGED_TIME
-- 		-- from CP_CONFIGURATION_CHANGE_LOGS as A
-- 		-- INNER JOIN CP_PLANNED_PARAMETERS as B
-- 		-- on A.PARAMETER_ID = B.PARAMETER_ID
-- 		-- WHERE A.CHANGED_BY != 'X'
-- 		-- ORDER BY A.CHANGED_DATE DESC;

-- 		SELECT 
--     B.DESCRIPTION, 
--     A.PARAMETER_ID,
--     MIN(A.LOCATION_ID) AS LOCATION_ID, -- or MAX() if you prefer
--     A.OLD_VALUE,
--     A.NEW_VALUE,
--     A.CHANGED_BY,
--     A.CHANGED_DATE,
--     A.CHANGED_TIME
-- FROM CP_CONFIGURATION_CHANGE_LOGS AS A
-- INNER JOIN CP_PLANNED_PARAMETERS AS B
--        ON A.PARAMETER_ID = B.PARAMETER_ID
-- WHERE A.CHANGED_BY != 'X'
-- GROUP BY 
--     B.DESCRIPTION,
--     A.PARAMETER_ID,
--     A.OLD_VALUE,
--     A.NEW_VALUE,
--     A.CHANGED_BY,
--     A.CHANGED_DATE,
--     A.CHANGED_TIME
-- ORDER BY A.CHANGED_DATE DESC;

		SELECT 
    B.DESCRIPTION, 
    A.PARAMETER_ID,
    CASE 
        WHEN COUNT(DISTINCT A.LOCATION_ID) > 1 THEN 'All Locations'
        ELSE MIN(A.LOCATION_ID)
    END AS LOCATION_ID,
    A.OLD_VALUE,
    A.NEW_VALUE,
    A.CHANGED_BY,
    A.CHANGED_DATE,
    A.CHANGED_TIME
FROM CP_CONFIGURATION_CHANGE_LOGS AS A
INNER JOIN CP_PLANNED_PARAMETERS AS B
       ON A.PARAMETER_ID = B.PARAMETER_ID
WHERE A.CHANGED_BY != 'X'
GROUP BY 
    B.DESCRIPTION,
    A.PARAMETER_ID,
    A.OLD_VALUE,
    A.NEW_VALUE,
    A.CHANGED_BY,
    A.CHANGED_DATE,
    A.CHANGED_TIME
ORDER BY A.CHANGED_DATE DESC