VIEW "V_ROLES_LOCPROD" AS 

WITH ROLE_INFO AS (
    SELECT 
        U."USER",
        R.ROLE_NAME,
        R.PARAMETER,
        R.VALUE
    FROM "CP_ROLE_DETAILS" R
    JOIN "CP_ROLES" RH 
      ON R.ROLE_NAME = RH.ROLE_NAME 
     AND RH.ACTIVE = TRUE
    JOIN "CP_USER_ROLES" U 
      ON R.ROLE_NAME = U.ROLE_NAME 
     AND R.READ = TRUE
),

ROLES AS (
    SELECT DISTINCT "USER", ROLE_NAME
    FROM ROLE_INFO
)

SELECT DISTINCT
    V.*,
    R."USER"
FROM "V_FACTORYLOC" V
CROSS JOIN ROLES R
WHERE EXISTS (
    SELECT 1
    FROM ROLE_INFO RI

    WHERE RI.ROLE_NAME = R.ROLE_NAME
      AND RI."USER" = R."USER"

      -- LOCATION
      AND (
            NOT EXISTS (
                SELECT 1 FROM ROLE_INFO X
                WHERE X.ROLE_NAME = R.ROLE_NAME
                  AND X.PARAMETER='LOCATION_ID'
            )
         OR EXISTS (
                SELECT 1 FROM ROLE_INFO X
                WHERE X.ROLE_NAME = R.ROLE_NAME
                  AND X.PARAMETER='LOCATION_ID'
                  AND (X.VALUE='*'
                       OR X.VALUE = V.DEMAND_LOC
                       OR X.VALUE = V.FACTORY_LOC)
            )
      )

      -- MATERIAL TYPE
      AND (
            NOT EXISTS (
                SELECT 1 FROM ROLE_INFO X
                WHERE X.ROLE_NAME = R.ROLE_NAME
                  AND X.PARAMETER='MATERIAL_TYPE'
            )
         OR EXISTS (
                SELECT 1 FROM ROLE_INFO X
                WHERE X.ROLE_NAME = R.ROLE_NAME
                  AND X.PARAMETER='MATERIAL_TYPE'
                  AND (X.VALUE='*' OR X.VALUE = V.MATERIAL_TYPE)
            )
      )

      -- MRP GROUP
      AND (
            NOT EXISTS (
                SELECT 1 FROM ROLE_INFO X
                WHERE X.ROLE_NAME = R.ROLE_NAME
                  AND X.PARAMETER='MRP_GROUP'
            )
         OR EXISTS (
                SELECT 1 FROM ROLE_INFO X
                WHERE X.ROLE_NAME = R.ROLE_NAME
                  AND X.PARAMETER='MRP_GROUP'
                  AND (X.VALUE='*' OR X.VALUE = V.MRP_GROUP)
            )
      )

      -- Configurable PRODUCT
      AND (
            NOT EXISTS (
                SELECT 1 FROM ROLE_INFO X
                WHERE X.ROLE_NAME = R.ROLE_NAME
                  AND X.PARAMETER='REF_PRODID'
            )
         OR EXISTS (
                SELECT 1 FROM ROLE_INFO X
                WHERE X.ROLE_NAME = R.ROLE_NAME
                  AND X.PARAMETER='REF_PRODID'
                  AND (X.VALUE='*' OR X.VALUE = V.REF_PRODID)
            )
      )
);


