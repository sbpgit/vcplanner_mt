VIEW "V_ROLES_ACCESS_DESC" AS 
SELECT R.FACTORY_LOC,
	   F.LOCATION_DESC,
	   F.PLAN_LOC,
	   F.PLANLOC_DESC,
	   R.DEMAND_LOC,
	   F.DEMAND_DESC,
	   R.PRODUCT_ID,
	   F.PROD_DESC,
	   R.REF_PRODID,
	   F.REFPROD_DESC,
	   R.MRP_GROUP,
	   R.MATERIAL_TYPE,
	   R.USER,
	   R.CREATE,
	   R.UPDATE,
	   R.DELETE
	   FROM "V_ROLES_ACCESS" AS R
INNER JOIN "V_FACTORYLOC" AS F 
ON R.FACTORY_LOC = F.FACTORY_LOC AND R.DEMAND_LOC = F.DEMAND_LOC AND R.PRODUCT_ID = F.PRODUCT_ID AND R.REF_PRODID = F.REF_PRODID