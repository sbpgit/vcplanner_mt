VIEW "V_PROD_ORDER_CONSUMPTION_NEW"
AS SELECT DISTINCT 
    CP_PROD_ORD_CONSUMPTION.LOCATION_ID,
    LTRIM (CP_PROD_ORD_CONSUMPTION.SALES_DOC, '0') AS SALES_DOC,
    LTRIM (CP_PROD_ORD_CONSUMPTION.SALESDOC_ITEM, '0') AS SALESDOC_ITEM,
    CP_PROD_ORD_CONSUMPTION.REF_PRODID,
    -- LTRIM (CP_PROD_ORD_CONSUMPTION.PROD_ORDER, '0') AS PROD_ORDER,
    CP_PROD_ORD_CONSUMPTION.COMPONENT,
    CP_PROD_ORD_CONSUMPTION.COMP_LOC as MANU_LOC,
    CP_PROD_ORD_CONSUMPTION.MAT_PARENT,
    CP_PROD_ORD_CONSUMPTION.PARENT_LOC,
    CP_PROD_ORD_CONSUMPTION.COMP_PROCURE_TYPE,
    CP_PROD_ORD_CONSUMPTION.COMP_QTY,
    -- CP_PROD_ORD_CONSUMPTION.ORD_TYPE,
    CP_PROD_ORD_CONSUMPTION.WEEK_DATE,
    TO_VARCHAR(CP_SALES_HM.UNIQUE_ID) AS UNIQUE_ID,
    V_LOCPROD.LOCATION_DESC,
    V_LOCPROD.PROD_DESC,
    B.CALENDAR_WEEK,
    B.TELESCOPIC_WEEK,
    SUM(CP_PROD_ORD_CONSUMPTION.COMP_QTY) AS CP_PROD_ORD_CONSUMPTION_SUM
FROM
    CP_PROD_ORD_CONSUMPTION
    INNER JOIN CP_SALES_HM ON LTRIM (CP_PROD_ORD_CONSUMPTION.SALES_DOC, '0') = LTRIM (CP_SALES_HM.SALES_DOC, '0')
    AND LTRIM (CP_PROD_ORD_CONSUMPTION.SALESDOC_ITEM, '0') = LTRIM (CP_SALES_HM.SALESDOC_ITEM, '0')
    LEFT OUTER JOIN V_LOCPROD ON CP_PROD_ORD_CONSUMPTION.LOCATION_ID = V_LOCPROD.LOCATION_ID
    AND CP_PROD_ORD_CONSUMPTION.REF_PRODID = V_LOCPROD.PRODUCT_ID
    LEFT OUTER JOIN V_WEEK_DESCRIPTOR AS B ON CP_PROD_ORD_CONSUMPTION.WEEK_DATE >= B.WEEK_STARTDATE
    AND CP_PROD_ORD_CONSUMPTION.WEEK_DATE <= B.WEEK_ENDDATE
GROUP BY
    CP_PROD_ORD_CONSUMPTION.LOCATION_ID,
    LTRIM (CP_PROD_ORD_CONSUMPTION.SALES_DOC, '0'),
    LTRIM (CP_PROD_ORD_CONSUMPTION.SALESDOC_ITEM, '0'),
    CP_PROD_ORD_CONSUMPTION.REF_PRODID,
    -- LTRIM (CP_PROD_ORD_CONSUMPTION.PROD_ORDER, '0'),
    CP_PROD_ORD_CONSUMPTION.COMPONENT,
    CP_PROD_ORD_CONSUMPTION.COMP_LOC,
    CP_PROD_ORD_CONSUMPTION.MAT_PARENT,
    CP_PROD_ORD_CONSUMPTION.PARENT_LOC,
    CP_PROD_ORD_CONSUMPTION.COMP_PROCURE_TYPE,
    CP_PROD_ORD_CONSUMPTION.COMP_QTY,
    -- CP_PROD_ORD_CONSUMPTION.ORD_TYPE,
    CP_PROD_ORD_CONSUMPTION.WEEK_DATE,
    CP_SALES_HM.UNIQUE_ID,
    V_LOCPROD.LOCATION_DESC,
    V_LOCPROD.PROD_DESC,
    B.CALENDAR_WEEK,
    B.TELESCOPIC_WEEK
    ORDER BY 
    CP_PROD_ORD_CONSUMPTION.COMPONENT;
 