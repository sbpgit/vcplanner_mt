--------------------------------------------------------------------------------------------
-- Name:            V_LOCPRODRT_DETAILS
-- Description:     Get Object dependency profiles and structure node for products
-- Join Details:    CP_RESTRICT_DETAILS -  Master table for restriction
--                  CP_PROD_LOC_LINE - table for Location, Product and Restriction
--                  CP_RESTRICT_HEADER - Restriction header table
--------------------------------------------------------------------------------------------
VIEW "V_LOCPRODRT_DETAILS" AS
SELECT DISTINCT CP_LINEMASTER.LOCATION_ID,
  CP_LINEMASTER.LINE_ID,
  CP_LINECAPACITY.PRODID AS PRODUCT_ID,
  CP_RESTRICT_HEADER.RESTRICTION,
  CP_RESTRICT_DETAILS.RTR_COUNTER,
  CP_RESTRICT_HEADER.RTR_QTY AS "ASMB_RTR_QTY",
   (CP_RESTRICT_HEADER.RTR_QTY * IFNULL(CP_RESTRICT_DETAILS.QUANTITY,1)) AS RTR_QTY,  
  CP_RESTRICT_DETAILS.CLASS_NUM,
  CP_RESTRICT_DETAILS.CHAR_NUM,
  CP_RESTRICT_DETAILS.CHARVAL_NUM,
  CP_RESTRICT_DETAILS.CHAR_VALUE,
  CP_RESTRICT_DETAILS.OD_CONDITION,
  CP_RESTRICT_DETAILS.CHAR_COUNTER,
  CP_RESTRICT_DETAILS.ROW_ID,
  CP_RESTRICT_HEADER.VALID_FROM,
  CP_RESTRICT_HEADER.VALID_TO
FROM "CP_LINEMASTER"
  INNER JOIN "CP_LINECAPACITY"
 ON CP_LINEMASTER.LOCATION_ID = CP_LINECAPACITY.LOCATION_ID
  AND CP_LINEMASTER.LINE_ID = CP_LINECAPACITY.LINE_ID
  INNER JOIN "CP_RESTRICT_HEADER"
 ON CP_LINECAPACITY.LOCATION_ID = CP_RESTRICT_HEADER.LOCATION_ID
  AND CP_LINECAPACITY.LINE_ID = CP_RESTRICT_HEADER.LINE_ID
  INNER JOIN "CP_RESTRICT_DETAILS"
 ON CP_RESTRICT_HEADER.LOCATION_ID = CP_RESTRICT_DETAILS.LOCATION_ID
 AND CP_RESTRICT_HEADER.LINE_ID = CP_RESTRICT_DETAILS.LINE_ID
 and CP_RESTRICT_HEADER.RESTRICTION = CP_RESTRICT_DETAILS.RESTRICTION;