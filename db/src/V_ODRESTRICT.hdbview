----------------------------------------------------------------------------------------
-- Name:            V_ODRESTRICT
-- Description:     Get Object dependency profiles and structure node for products
-- Join Details:    A: CP_RESTRICT_DETAILS -  Master table for restriction
--                  B: V_CLASSCHARVAL - View to fetch class charateristic and its values
-----------------------------------------------------------------------------------------

VIEW "V_ODRESTRICT"
AS SELECT 
A.RESTRICTION,
A.RTR_COUNTER,
A.LOCATION_ID,
A.LINE_ID,
A.CLASS_NUM,
(SELECT CP_CLASS.CLASS_NAME 
   FROM CP_CLASS
   WHERE CP_CLASS.CLASS_NUM = A.CLASS_NUM) AS CLASS_NAME,
(SELECT CP_CLASS.CLASS_DESC 
   FROM CP_CLASS
   WHERE CP_CLASS.CLASS_NUM = A.CLASS_NUM) AS CLASS_DESC,
A.CHAR_NUM,
(SELECT CP_CHARACTERISTICS.CHAR_NAME
   FROM CP_CHARACTERISTICS
   WHERE CP_CHARACTERISTICS.CLASS_NUM = A.CLASS_NUM AND CP_CHARACTERISTICS.CHAR_NUM = A.CHAR_NUM) AS CHAR_NAME,
(SELECT CP_CHARACTERISTICS.CHAR_DESC
   FROM CP_CHARACTERISTICS
   WHERE CP_CHARACTERISTICS.CLASS_NUM = A.CLASS_NUM AND CP_CHARACTERISTICS.CHAR_NUM = A.CHAR_NUM) AS CHAR_DESC,
A.CHARVAL_NUM,
A. CHAR_VALUE,
(SELECT  CP_CHAR_VALUES.CHARVAL_DESC 
   FROM CP_CHAR_VALUES
   WHERE  CP_CHAR_VALUES.CHAR_NUM = A.CHAR_NUM AND CP_CHAR_VALUES.CHAR_VALUE = A.CHAR_VALUE) AS CHARVAL_DESC,
A.OD_CONDITION,
A.CHAR_COUNTER,
A.ROW_ID,
A.QUANTITY
FROM "CP_RESTRICT_DETAILS" AS A
ORDER BY 
  A.RESTRICTION,
  A.LOCATION_ID,
  A.CLASS_NUM;