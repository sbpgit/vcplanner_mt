 VIEW "V_ACT_FOR_UNC_KEYFIGS_NEW" AS


/* ============================================================
    101 – Actual Demand % at VC
   ============================================================ */
SELECT
    A.LOCATION_ID,
    A.PRODUCT_ID,
    A.CUSTOMER_GROUP,
    'EMPTY_MV'      AS MODEL_VERSION,
    A.CHAR_NUM,
    A.CHARVAL_NUM,
    'EMPTY_VER'     AS VERSION,
    'EMPTY_SCEN'    AS SCENARIO,
    A.WEEK_DATE,

    CAST(
        CASE
            WHEN T.TOTAL_ORD_QTY = 0 OR T.TOTAL_ORD_QTY IS NULL THEN 0
            ELSE ROUND(SUM(A.ORD_QTY) * 100.0 / T.TOTAL_ORD_QTY, 2)
        END AS DECIMAL(15,2)
    ) AS OPT_PERCENT,

    CAST(SUM(A.ORD_QTY) AS DECIMAL(15,0)) AS OPT_QTY,

    101 AS TYPE,

    (SELECT MAX(CHAR_DESC)
        FROM CP_CHARACTERISTICS C1
        WHERE C1.CHAR_NUM = A.CHAR_NUM) AS CHAR_DESC,

    (SELECT MAX(CHAR_NAME)
        FROM CP_CHARACTERISTICS C2
        WHERE C2.CLASS_NUM = A.CLASS_NUM
          AND C2.CHAR_NUM = A.CHAR_NUM) AS CHAR_NAME,

    (SELECT MAX(CHARVAL_DESC)
        FROM CP_CHAR_VALUES V1
        WHERE V1.CHAR_NUM = A.CHAR_NUM
          AND V1.CHAR_VALUE = A.CHARVAL_NUM) AS CHARVAL_DESC,

    PS.CHAR_TYPE,

    '' AS VERSION_NAME,
    '' AS SCENARIO_NAME,

    D.LOCATION_DESC,
    D.PROD_DESC,

    101 AS KEY_FIG_ID,
    'Actual Demand % at VC' AS KEY_FIG_DESC,
    101 AS DISPLAY_ORDER,
    101 AS PRIORITY_ORDER,

    CAST(SUM(A.ORD_QTY) AS DECIMAL(15,0)) AS ACT_DEM_VC,
    CAST(NULL AS DECIMAL(15,2)) AS ACT_DEM_PERCENT

FROM V_SALESUNQ_DATA_FOR_OPT A
LEFT JOIN CP_VARCHAR_PS PS
    ON A.PRODUCT_ID = PS.PRODUCT_ID
   AND A.CHAR_NUM   = PS.CHAR_NUM
INNER JOIN V_PARTIALPRODDESC D
    ON A.LOCATION_ID = D.LOCATION_ID
   AND A.PRODUCT_ID  = D.PRODUCT_ID
LEFT JOIN (
    SELECT LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, WEEK_DATE,
           SUM(ORD_QTY) AS TOTAL_ORD_QTY
    FROM V_SALESALL_WEEK
    WHERE SEEDORD_CHK IS NULL
    GROUP BY LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP, WEEK_DATE
) T
    ON T.LOCATION_ID    = A.LOCATION_ID
   AND T.PRODUCT_ID     = A.PRODUCT_ID
   AND T.CUSTOMER_GROUP = A.CUSTOMER_GROUP
   AND T.WEEK_DATE      = A.WEEK_DATE

WHERE A.SEEDORD_CHK IS NULL

GROUP BY
    A.LOCATION_ID, A.PRODUCT_ID, A.CUSTOMER_GROUP, A.CLASS_NUM,
    A.CHAR_NUM, A.CHARVAL_NUM, A.WEEK_DATE, D.LOCATION_DESC,
    D.PROD_DESC, T.TOTAL_ORD_QTY, PS.CHAR_TYPE

UNION ALL


/* ============================================================
    998 – Actual Demand (Product Level)
   ============================================================ */
SELECT
    A.LOCATION_ID,
    A.PRODUCT_ID,
    A.CUSTOMER_GROUP,
    'EMPTY_MV',
    NULL AS CHAR_NUM,
    NULL AS CHARVAL_NUM,
    'EMPTY_VER',
    'EMPTY_SCEN',
    A.WEEK_DATE,

    CAST(NULL AS DECIMAL(15,2)) AS OPT_PERCENT,
    CAST(SUM(A.ORD_QTY) AS DECIMAL(15,0)) AS OPT_QTY,

    998 AS TYPE,

    NULL AS CHAR_DESC,
    NULL AS CHAR_NAME,
    NULL AS CHARVAL_DESC,
    NULL AS CHAR_TYPE,

    '' AS VERSION_NAME,
    '' AS SCENARIO_NAME,

    D.LOCATION_DESC,
    D.PROD_DESC,

    998 AS KEY_FIG_ID,
    'Actual Demand' AS KEY_FIG_DESC,
    998 AS DISPLAY_ORDER,
    998 AS PRIORITY_ORDER,

    NULL AS ACT_DEM_VC,
    CAST(NULL AS DECIMAL(15,2)) AS ACT_DEM_PERCENT

FROM V_SALESALL_WEEK A
INNER JOIN V_PARTIALPRODDESC D
    ON A.LOCATION_ID = D.LOCATION_ID
   AND A.PRODUCT_ID  = D.PRODUCT_ID
WHERE A.SEEDORD_CHK IS NULL
GROUP BY
    A.LOCATION_ID, A.PRODUCT_ID, A.CUSTOMER_GROUP,
    A.WEEK_DATE, D.LOCATION_DESC, D.PROD_DESC

UNION ALL


/* ============================================================
    995 – Forecast Quantity (Product Level)
   ============================================================ */
SELECT
    A.LOCATION_ID,
    A.PRODUCT_ID,
    NULL AS CUSTOMER_GROUP,
    'EMPTY_MV',
    NULL AS CHAR_NUM,
    NULL AS CHARVAL_NUM,
    A.VERSION,
    A.SCENARIO,
    A.WEEK_DATE,

    CAST(NULL AS DECIMAL(15,2)) AS OPT_PERCENT,
    CAST(SUM(A.CIR_QTY) AS DECIMAL(15,0)) AS OPT_QTY,
    995 AS TYPE,

    NULL AS CHAR_DESC,
    NULL AS CHAR_NAME,
    NULL AS CHARVAL_DESC,
    NULL AS CHAR_TYPE,

    VS.VERSION_NAME,
    VS.SCENARIO_NAME,

    D.LOCATION_DESC,
    D.PROD_DESC,

    995 AS KEY_FIG_ID,
    'Forecast Quantity' AS KEY_FIG_DESC,
    995 AS DISPLAY_ORDER,
    995 AS PRIORITY_ORDER,

    NULL AS ACT_DEM_VC,
    CAST(NULL AS DECIMAL(15,2)) AS ACT_DEM_PERCENT

FROM CP_CIR_GENERATED A
INNER JOIN CP_IBPVERSIONSCENARIO VS
    ON A.VERSION  = VS.VERSION
   AND A.SCENARIO = VS.SCENARIO
INNER JOIN V_PARTIALPRODDESC D
    ON A.LOCATION_ID = D.LOCATION_ID
   AND A.PRODUCT_ID  = D.PRODUCT_ID

GROUP BY
    A.LOCATION_ID, A.PRODUCT_ID, A.MODEL_VERSION,
    A.VERSION, A.SCENARIO, A.WEEK_DATE,
    VS.VERSION_NAME, VS.SCENARIO_NAME,
    D.LOCATION_DESC, D.PROD_DESC

UNION ALL


/* ============================================================
    102 – Forecast at VC Level
   ============================================================ */
SELECT
    A.LOCATION_ID,
    A.PRODUCT_ID,
    NULL AS CUSTOMER_GROUP,
    A.MODEL_VERSION,
    A.CHAR_NUM,
    A.CHARVAL_NUM,
    A.VERSION,
    A.SCENARIO,
    A.WEEK_DATE,

    CAST(SUM(A.CIR_QTY_PERCENT) AS DECIMAL(15,2)) AS OPT_PERCENT,
    CAST(SUM(A.CIR_QTY) AS DECIMAL(15,0)) AS OPT_QTY,

    102 AS TYPE,

    A.CHAR_DESC,
    A.CHAR_NAME,
    A.CHARVAL_DESC,
    PS.CHAR_TYPE,

    A.VERSION_NAME,
    A.SCENARIO_NAME,

    D.LOCATION_DESC,
    D.PROD_DESC,

    102 AS KEY_FIG_ID,
    'Forecast at VC' AS KEY_FIG_DESC,
    102 AS DISPLAY_ORDER,
    102 AS PRIORITY_ORDER,

    NULL AS ACT_DEM_VC,
    CAST(NULL AS DECIMAL(15,2)) AS ACT_DEM_PERCENT

FROM V_CIRUNIQUECHAR A
LEFT JOIN CP_VARCHAR_PS PS
    ON A.PRODUCT_ID = PS.PRODUCT_ID
   AND A.CHAR_NUM   = PS.CHAR_NUM
INNER JOIN V_PARTIALPRODDESC D
    ON A.LOCATION_ID = D.LOCATION_ID
   AND A.PRODUCT_ID  = D.PRODUCT_ID

GROUP BY
    A.LOCATION_ID, A.PRODUCT_ID, A.MODEL_VERSION,
    A.CHAR_NUM, A.CHARVAL_NUM, A.VERSION, A.SCENARIO,
    A.WEEK_DATE, A.CHAR_DESC, A.CHAR_NAME, A.CHARVAL_DESC,
    PS.CHAR_TYPE, A.VERSION_NAME, A.SCENARIO_NAME,
    D.LOCATION_DESC, D.PROD_DESC

UNION ALL


/* ============================================================
    103 – Unconsumed Forecast at VC Level
   ============================================================ */
SELECT
    B.LOCATION_ID,
    B.PRODUCT_ID,
    B.CUSTOMER_GROUP,
    B.MODEL_VERSION,
    B.CHAR_NUM,
    B.CHARVAL_NUM,
    B.VERSION,
    B.SCENARIO,
    B.WEEK_DATE,

    CAST(
        CASE 
            WHEN F.CIR_QTY IS NULL OR F.CIR_QTY = 0 THEN 0
            ELSE ROUND((COALESCE(F.CIR_QTY,0) - COALESCE(A.ACT_DEM_VC,0)) * 100.0 / F.CIR_QTY, 2)
        END AS DECIMAL(15,2)
    ) AS OPT_PERCENT,

    CAST((COALESCE(F.CIR_QTY,0) - COALESCE(A.ACT_DEM_VC,0)) AS DECIMAL(15,0)) AS OPT_QTY,

    103 AS TYPE,

    B.CHAR_DESC,
    B.CHAR_NAME,
    B.CHARVAL_DESC,
    PS.CHAR_TYPE,

    B.VERSION_NAME,
    B.SCENARIO_NAME,

    D.LOCATION_DESC,
    D.PROD_DESC,

    103 AS KEY_FIG_ID,
    'Unconsumed Forecast at VC' AS KEY_FIG_DESC,
    103 AS DISPLAY_ORDER,
    103 AS PRIORITY_ORDER,

    A.ACT_DEM_VC,

    CAST(
        CASE 
            WHEN F.CIR_QTY IS NULL OR F.CIR_QTY = 0 THEN 0
            ELSE ((COALESCE(F.CIR_QTY,0) - COALESCE(A.ACT_DEM_VC,0)) / F.CIR_QTY) * 100
        END AS DECIMAL(15,2)
    ) AS ACT_DEM_PERCENT

FROM (
    SELECT
        FD.LOCATION_ID, FD.PRODUCT_ID, FD.CUSTOMER_GROUP,
        FD.MODEL_VERSION, FD.CHAR_NUM, FD.CHARVAL_NUM,
        FD.VERSION, FD.SCENARIO, FD.WEEK_DATE,

        (SELECT MAX(CHAR_DESC)
            FROM CP_CHARACTERISTICS C1
            WHERE C1.CHAR_NUM = FD.CHAR_NUM) AS CHAR_DESC,

        (SELECT MAX(CHAR_NAME)
            FROM CP_CHARACTERISTICS C2
            WHERE C2.CHAR_NUM = FD.CHAR_NUM) AS CHAR_NAME,

        (SELECT MAX(CHARVAL_DESC)
            FROM CP_CHAR_VALUES V1
            WHERE V1.CHAR_NUM = FD.CHAR_NUM
              AND V1.CHAR_VALUE = FD.CHARVAL_NUM) AS CHARVAL_DESC,

        VS.VERSION_NAME,
        VS.SCENARIO_NAME

    FROM CP_PAL_FCHARPLAN FD
    INNER JOIN CP_IBPVERSIONSCENARIO VS
        ON FD.VERSION  = VS.VERSION
       AND FD.SCENARIO = VS.SCENARIO

    GROUP BY
        FD.LOCATION_ID, FD.PRODUCT_ID, FD.CUSTOMER_GROUP, FD.MODEL_VERSION,
        FD.CHAR_NUM, FD.CHARVAL_NUM, FD.VERSION, FD.SCENARIO, FD.WEEK_DATE,
        VS.VERSION_NAME, VS.SCENARIO_NAME
) B

LEFT JOIN (
    SELECT LOCATION_ID, PRODUCT_ID, MODEL_VERSION,
           CHAR_NUM, CHARVAL_NUM, VERSION, SCENARIO,
           WEEK_DATE, SUM(CIR_QTY) AS CIR_QTY
    FROM V_CIRUNIQUECHAR
    GROUP BY LOCATION_ID, PRODUCT_ID, MODEL_VERSION,
             CHAR_NUM, CHARVAL_NUM, VERSION,
             SCENARIO, WEEK_DATE
) F
    ON F.LOCATION_ID = B.LOCATION_ID
   AND F.PRODUCT_ID  = B.PRODUCT_ID
   AND F.MODEL_VERSION = B.MODEL_VERSION
   AND F.CHAR_NUM      = B.CHAR_NUM
   AND F.CHARVAL_NUM   = B.CHARVAL_NUM
   AND F.VERSION       = B.VERSION
   AND F.SCENARIO      = B.SCENARIO
   AND F.WEEK_DATE     = B.WEEK_DATE

LEFT JOIN (
    SELECT LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP,
           CHAR_NUM, CHARVAL_NUM, WEEK_DATE,
           CAST(SUM(ORD_QTY) AS DECIMAL(15,0)) AS ACT_DEM_VC
    FROM V_SALESUNQ_DATA
    GROUP BY LOCATION_ID, PRODUCT_ID, CUSTOMER_GROUP,
             CHAR_NUM, CHARVAL_NUM, WEEK_DATE
) A
    ON A.LOCATION_ID = B.LOCATION_ID
   AND A.PRODUCT_ID  = B.PRODUCT_ID
   AND A.CUSTOMER_GROUP = B.CUSTOMER_GROUP
   AND A.CHAR_NUM       = B.CHAR_NUM
   AND A.CHARVAL_NUM    = B.CHARVAL_NUM
   AND A.WEEK_DATE      = B.WEEK_DATE

LEFT JOIN CP_VARCHAR_PS PS
    ON B.PRODUCT_ID = PS.PRODUCT_ID
   AND B.CHAR_NUM   = PS.CHAR_NUM

INNER JOIN V_PARTIALPRODDESC D
    ON B.LOCATION_ID = D.LOCATION_ID
   AND B.PRODUCT_ID  = D.PRODUCT_ID

UNION ALL


/* ============================================================
    994 – Unconsumed Forecast (Product Level)
   ============================================================ */
SELECT DISTINCT
    A.LOCATION_ID,
    A.PRODUCT_ID,
    ''   AS CUSTOMER_GROUP,
    'EMPTY_MV' AS MODEL_VERSION,
    NULL AS CHAR_NUM,
    NULL AS CHARVAL_NUM,
    A.VERSION,
    A.SCENARIO,
    A.WEEK_DATE,

    CAST(NULL AS DECIMAL(15,2)) AS OPT_PERCENT,
    CAST(SUM(A.UNCONSUMED_FORECAST) AS DECIMAL(15,0)) AS OPT_QTY,

    994 AS TYPE,

    NULL AS CHAR_DESC,
    NULL AS CHAR_NAME,
    NULL AS CHARVAL_DESC,
    NULL AS CHAR_TYPE,

    '' AS VERSION_NAME,
    '' AS SCENARIO_NAME,

    LP.LOCATION_DESC,
    LP.PROD_DESC,

    994 AS KEY_FIG_ID,
    'Unconsumed Forecast' AS KEY_FIG_DESC,
    994 AS DISPLAY_ORDER,
    994 AS PRIORITY_ORDER,

    NULL AS ACT_DEM_VC,
    CAST(NULL AS DECIMAL(15,2)) AS ACT_DEM_PERCENT

FROM CP_CIR_GENERATED A
LEFT JOIN V_FACTORYLOC LP
       ON LP.DEMAND_LOC = A.LOCATION_ID
      AND LP.PRODUCT_ID = A.PRODUCT_ID
GROUP BY
    A.LOCATION_ID, A.PRODUCT_ID, A.VERSION, A.SCENARIO,
    A.WEEK_DATE, LP.LOCATION_DESC, LP.PROD_DESC;

