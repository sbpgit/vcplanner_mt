VIEW "V_SALESH_UID_CONFIG" AS
SELECT DISTINCT CP_SALES_HM.SALES_DOC,
  CP_SALES_HM.SALESDOC_ITEM,
  CP_SALES_HM.PRODUCT_ID,
  CP_PARTIALPROD_INTRO.REF_PRODID,
  CP_UNIQUE_ID_ITEM.CHAR_NUM,
  CP_UNIQUE_ID_ITEM.CHARVAL_NUM,
  CP_UNIQUE_ID_ITEM.CHAR_VALUE
FROM CP_SALES_HM
  INNER JOIN CP_PARTIALPROD_INTRO
  ON CP_PARTIALPROD_INTRO.PRODUCT_ID = CP_SALES_HM.PRODUCT_ID
  INNER JOIN CP_UNIQUE_ID_ITEM
 ON CP_SALES_HM.UNIQUE_ID = CP_UNIQUE_ID_ITEM.UNIQUE_ID
  AND CP_PARTIALPROD_INTRO.REF_PRODID = CP_UNIQUE_ID_ITEM.PRODUCT_ID;