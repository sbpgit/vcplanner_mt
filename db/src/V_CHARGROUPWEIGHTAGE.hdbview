VIEW "V_CHARGROUPWEIGHTAGE" AS
-- SELECT DISTINCT A."PRODUCT_ID",A."CHAR_NUM",C."CHAR_NAME",C."CHAR_DESC",A."CHAR_TYPE",A."SEQUENCE",A."GROUP_NAME", IFNULL(D."WEIGHTAGE", 1 ) AS "WEIGHTAGE" FROM "CP_VARCHAR_PS" AS A
--     INNER JOIN CP_PRODUCT_CLASS AS B
--        ON A.PRODUCT_ID = B.PRODUCT_ID
--        INNER JOIN V_CLASSCHARVAL AS C
--        ON  B.CLASS_NUM   = C.CLASS_NUM
--        AND A.CHAR_NUM    = C.CHAR_NUM
--    LEFT OUTER JOIN "CP_CHARACTERISTIC_GROUPS" AS D
--    ON A.GROUP_NAME = D.GROUP_NAME
--    ORDER BY WEIGHTAGE DESC;

SELECT DISTINCT A."PRODUCT_ID",A."CHAR_NUM",C."CHAR_NAME",C."CHAR_DESC",A."CHAR_TYPE",A."SEQUENCE",A."GROUP_NAME", 
                
CASE
        WHEN D."WEIGHTAGE" IS NULL AND A."CHAR_TYPE" = 'P' THEN 1
        ELSE D."WEIGHTAGE"
    END AS "WEIGHTAGE",
    A."CHANGED_BY" , A."CHANGED_DATE", A.CHANGED_TIME
FROM "CP_VARCHAR_PS" AS A
 INNER JOIN CP_PRODUCT_CLASS AS B
    ON A.PRODUCT_ID = B.PRODUCT_ID
    INNER JOIN V_CLASSCHARVAL AS C
    ON  B.CLASS_NUM   = C.CLASS_NUM
    AND A.CHAR_NUM    = C.CHAR_NUM
LEFT OUTER JOIN "CP_CHARACTERISTIC_GROUPS" AS D
ON A.GROUP_NAME = D.GROUP_NAME
AND A.PRODUCT_ID = D.PRODUCT_ID
ORDER BY WEIGHTAGE DESC