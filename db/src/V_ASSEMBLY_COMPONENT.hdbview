VIEW "V_ASSEMBLY_COMPONENT" AS
 
SELECT
   -- A table (CP_ASSEMBLY_REQ)
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."ITEM_NUM",
    A."COMPONENT"                AS ASSEMBLY,
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    A."TYPE"                     AS RULE_TYPE,
    A."TYPE",
    A."REF_PRODID",
    A."FACTORY_LOC",
    TO_VARCHAR(A."UNIQUE_ID") AS "UNIQUE_ID",
    CP_IBPVERSIONSCENARIO.VERSION_NAME,
    CP_IBPVERSIONSCENARIO.SCENARIO_NAME,
    -- B table (CP_LOCATION)
    B.LOCATION_DESC AS FACTORY_LOCATION_DESC,
 
    -- B table (CP_LOCATION)
    H.LOCATION_DESC AS LOCATION_DESC,
 
    -- C table (CP_PRODUCT)
    C.PROD_DESC,
 
    -- D table (CP_LOCATION_PRODUCT)
    CP_LOCATION_PRODUCT.MRP_GROUP,
    CP_LOCATION_PRODUCT.MRP_TYPE,
    -- D."PHANTOM_IND",
    -- D."CONFIGURABLE",
 
    -- Derived ASM_DESC
 
    (SELECT MAX(PROD_DESC) FROM CP_BOM_MAT AS D WHERE D.MAT_CHILD = A."COMPONENT") as ASM_DESC,
    -- CASE
    --     WHEN D.PROD_DESC IS NULL THEN G.COMP_DESC
    --     ELSE D.PROD_DESC
    -- END                          AS ASM_DESC,
 
 
    -- E table (V_WEEK_DESCRIPTOR)
    E."CALENDAR_WEEK",
    E."TELESCOPIC_WEEK",
    E."WEEK_STARTDATE",
    E."WEEK_ENDDATE",
 
    -- Aggregates
    SUM(A."CIR_QTY")             AS ASMB_QTY,
    SUM(A."CIR_QTY")             AS CIR_QTY,
    SUM(A."COMPCIR_QTY")         AS CIR_ASMB_QTY,
    SUM(A."ACTUAL_QTY")          AS ACTUAL_QTY,
    SUM(F.QUANTITY)              AS PROD_DEM,
    SUM(COALESCE(A."COMPCIR_QTY", 0) + COALESCE(A."ACTUAL_QTY", 0)) AS TOTAL_QTY,
 
    -- Calculated Coefficients
    CASE
        WHEN SUM(COALESCE(A."COMPCIR_QTY", 0) + COALESCE(A."ACTUAL_QTY", 0)) = 0
          OR SUM(F.QUANTITY) = 0
        THEN 0
        ELSE ROUND(
            SUM(COALESCE(A."COMPCIR_QTY", 0) + COALESCE(A."ACTUAL_QTY", 0))
            / SUM(F.QUANTITY), 3
        )
    END                          AS COEFFICIENTS,
 
    -- Constants
    'OD'                         AS REQ_TYPE,
    '' AS USER
    -- V_ROLES_LOCPROD.USER AS USER
 
FROM CP_ASSEMBLY_REQ AS A
 
     -- Join with Location
    INNER JOIN CP_LOCATION AS B
        ON A."FACTORY_LOC" = B."LOCATION_ID"
 
     -- Join with Location
    INNER JOIN CP_LOCATION AS H
        ON A."LOCATION_ID" = H."LOCATION_ID"
 
    -- Join with Product
    INNER JOIN CP_PARTIALPROD_INTRO AS C
        ON C.PRODUCT_ID = A."PRODUCT_ID"
        AND C.LOCATION_ID = A.LOCATION_ID
 
    -- -- Join with BOM Material
    -- LEFT OUTER JOIN CP_BOM_MAT AS D
    --     ON D.MAT_CHILD = A."COMPONENT"
    --     AND D.COUNTER = A.ITEM_NUM
          
 
    -- Join with Week Descriptor
    LEFT OUTER JOIN "V_WEEK_DESCRIPTOR" AS E
        ON A.WEEK_DATE >= E."WEEK_STARTDATE"
       AND A."WEEK_DATE" <= E."WEEK_ENDDATE"   
 
    -- Future Demand
    LEFT OUTER JOIN CP_IBP_FUTUREDEMAND AS F
        ON A.LOCATION_ID = F.LOCATION_ID
       AND A.PRODUCT_ID = F.PRODUCT_ID
       AND A.VERSION = F.VERSION
       AND A.SCENARIO = F.SCENARIO
       AND A.WEEK_DATE = F.WEEK_DATE
     
    --  -- Join with Assembly Component
    -- LEFT OUTER JOIN CP_ASSEMBLY_COMP AS G
    --     ON G.COMPONENT = A."COMPONENT"
    --    AND G.LOCATION_ID = A."FACTORY_LOC"  
    LEFT OUTER JOIN CP_IBPVERSIONSCENARIO
ON CP_IBPVERSIONSCENARIO.VERSION = A."VERSION"
AND CP_IBPVERSIONSCENARIO.SCENARIO = A."SCENARIO"
LEFT OUTER JOIN "CP_LOCATION_PRODUCT" ON A.LOCATION_ID=CP_LOCATION_PRODUCT.LOCATION_ID AND A.PRODUCT_ID=CP_LOCATION_PRODUCT.PRODUCT_ID

-- INNER JOIN "V_ROLES_LOCPROD" ON A.LOCATION_ID=V_ROLES_LOCPROD.DEMAND_LOC AND A.PRODUCT_ID=V_ROLES_LOCPROD.PRODUCT_ID
-- AND A.FACTORY_LOC=V_ROLES_LOCPROD.FACTORY_LOC 
-- AND A.REF_PRODID=V_ROLES_LOCPROD.REF_PRODID AND CP_LOCATION_PRODUCT.MRP_GROUP=V_ROLES_LOCPROD.MRP_GROUP
 
GROUP BY
    A."LOCATION_ID",
    B.LOCATION_DESC,
    A."PRODUCT_ID",
    C.PROD_DESC,
    A."ITEM_NUM",
    A."COMPONENT",
    -- D.PROD_DESC,
    -- G.COMP_DESC,
    A."MODEL_VERSION",
    A."VERSION",
    A."SCENARIO",
    A."TYPE",
    A."REF_PRODID",
    A."FACTORY_LOC",
    CP_LOCATION_PRODUCT.MRP_GROUP,
    CP_LOCATION_PRODUCT.MRP_TYPE,
    -- D."PHANTOM_IND",
    -- D."CONFIGURABLE",
    A."UNIQUE_ID",
    E."CALENDAR_WEEK",
    E."TELESCOPIC_WEEK",
    E."WEEK_STARTDATE",
    E."WEEK_ENDDATE",
    H.LOCATION_DESC,
    CP_IBPVERSIONSCENARIO.VERSION_NAME,
    CP_IBPVERSIONSCENARIO.SCENARIO_NAME,
    'OD'