VIEW "V_OPT_PER_CAL" AS

		(SELECT 
			V1."LOCATION_ID",
			V1."PRODUCT_ID",
			V1."CUSTOMER_GROUP",
			V1."MODEL_VERSION",
			V1."CHAR_NUM",
			 
			V1."CHARVAL_NUM",
			V1."VERSION",
			V1."SCENARIO",
			V1."WEEK_DATE",
			V1."TYPE",
			V1."CHAR_DESC",
			V1."CHAR_NAME",
			V1."CHARVAL_DESC",
			V1."VERSION_NAME",
			V1."SCENARIO_NAME",
			V1."LOCATION_DESC",
			V1."PROD_DESC",
			V1."OPT_PERCENT",
			V1."OPT_QTY",
			(
				(SELECT DISTINCT SUM(QUANTITY)
				FROM CP_IBP_FUTUREDEMAND_LOCPRODCUST AS V2
				WHERE V2."LOCATION_ID" = V1."LOCATION_ID"
					AND V2."PRODUCT_ID" = V1."PRODUCT_ID"
					AND V2."CUSTOMER_GROUP" = V1."CUSTOMER_GROUP"
					AND V2."WEEK_DATE" = V1."WEEK_DATE"
					AND V2."VERSION" = V1."VERSION"
					AND V2."SCENARIO" = V1."SCENARIO")
			) AS "PROD_DEMAND",
			(
				(SELECT DISTINCT SUM(ORD_QTY)
				FROM V_SALESUNQ_DATA AS V3
				WHERE V1."LOCATION_ID" = V3."LOCATION_ID"
					AND V1."PRODUCT_ID" = V3."PRODUCT_ID"
					AND V1."CUSTOMER_GROUP" = V3."CUSTOMER_GROUP"
					AND V1."CHAR_NUM" = V3."CHAR_NUM"
					AND V1."CHARVAL_NUM" = V3."CHARVAL_NUM"
					AND V1."WEEK_DATE" = V3."WEEK_DATE")
			) AS "ACT_DEM_VC",
			(
				(SELECT DISTINCT SUM(ORD_QTY)
				FROM V_SALESALL_WEEK AS V4
				WHERE V1."LOCATION_ID" = V4."LOCATION_ID"
					AND V1."PRODUCT_ID" = V4."PRODUCT_ID"
					AND V1."CUSTOMER_GROUP" = V4."CUSTOMER_GROUP"
					AND V1."WEEK_DATE" = V4."WEEK_DATE")
			) AS "ACT_DEM",
			(
				(SELECT DISTINCT SUM(CIR_QTY)
				FROM CP_CIR_GENERATED AS V5
				WHERE V1."LOCATION_ID" = V5."LOCATION_ID"
					AND V1."PRODUCT_ID" = V5."PRODUCT_ID"
					AND V1."VERSION" = V5."VERSION"
					AND V1."MODEL_VERSION" = V5."MODEL_VERSION"
					AND V1."SCENARIO" = V5."SCENARIO"
					AND V1."WEEK_DATE" = V5."WEEK_DATE")
			) AS "FORECAST_QTY"
			-- (
			-- 	(SELECT DISTINCT SUM(CIR_QTY)
			-- 	FROM V_CIRUNIQUECHAR AS V6
			-- 	WHERE V1."LOCATION_ID" = V6."LOCATION_ID"
			-- 		AND V1."PRODUCT_ID" = V6."PRODUCT_ID"
			-- 		AND V1."CHAR_NUM" = V6."CHAR_NUM"
			-- 		AND V1."CHARVAL_NUM" = V6."CHARVAL_NUM"
			-- 		AND V1."VERSION" = V6."VERSION"
			-- 		AND V1."MODEL_VERSION" = V6."MODEL_VERSION"
			-- 		AND V1."SCENARIO" = V6."SCENARIO"
			-- 		AND V1."WEEK_DATE" = V6."WEEK_DATE")
			-- ) AS "FORECAST_QTY_VC"
		FROM "V_OPTION_PERCENTAGE" AS V1
		WHERE V1."TYPE" < '200'
			AND V1."TYPE" = ( 				(SELECT MAX("TYPE")
				FROM "V_OPTION_PERCENTAGE" AS V2
				WHERE V1."LOCATION_ID" = V2."LOCATION_ID"
					AND V1."PRODUCT_ID" = V2."PRODUCT_ID"
					AND V1."CUSTOMER_GROUP" = V2."CUSTOMER_GROUP"
					AND V1."MODEL_VERSION" = V2."MODEL_VERSION"
					AND V1."CHAR_NUM" = V2."CHAR_NUM"
					AND V1."CHARVAL_NUM" = V2."CHARVAL_NUM"
					AND V1."VERSION" = V2."VERSION"
					AND V1."SCENARIO" = V2."SCENARIO"
					AND V1."WEEK_DATE" = V2."WEEK_DATE") ))
	
