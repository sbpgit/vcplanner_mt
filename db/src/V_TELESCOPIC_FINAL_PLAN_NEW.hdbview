VIEW V_TELESCOPIC_FINAL_PLAN_NEW AS
WITH 
PRODEMAND AS
(
    SELECT 
        FD."LOCATION_ID",
        FD."PRODUCT_ID",
        FD."CUSTOMER_GROUP",
        FD."VERSION",
        FD."SCENARIO",
        B."TELESCOPIC_WEEK",
        SUM(FD."QUANTITY") AS QUANTITY
    FROM "CP_IBP_FUTUREDEMAND_LOCPRODCUST" FD
    LEFT JOIN "V_WEEK_DESCRIPTOR" B
        ON FD."WEEK_DATE" BETWEEN B."WEEK_STARTDATE" AND B."WEEK_ENDDATE"
    GROUP BY 
        FD."LOCATION_ID",
        FD."PRODUCT_ID",
        FD."CUSTOMER_GROUP",
        FD."VERSION",
        FD."SCENARIO",
        B."TELESCOPIC_WEEK"
),
FORECAST_TOTAL AS
(
    SELECT 
        FO."LOCATION_ID",
        FO."PRODUCT_ID",
        FO."VERSION",
        FO."SCENARIO",
        FO."MODEL_VERSION",
        B."TELESCOPIC_WEEK",
        SUM(FO."CIR_QTY") AS QUANTITY
    FROM "CP_CIR_GENERATED" FO
    LEFT JOIN "V_WEEK_DESCRIPTOR" B
        ON FO."WEEK_DATE" BETWEEN B."WEEK_STARTDATE" AND B."WEEK_ENDDATE"
    GROUP BY 
        FO."LOCATION_ID",
        FO."PRODUCT_ID",
        FO."VERSION",
        FO."SCENARIO",
        FO."MODEL_VERSION",
        B."TELESCOPIC_WEEK"
)
SELECT 
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."CUSTOMER_GROUP",
    A."MODEL_VERSION",
    A."CHAR_NUM",
    A."CHARVAL_NUM",
    A."VERSION",
    A."SCENARIO",
    A."TYPE",

   
    CASE
     /* For  single Calender week, Manaul Option% assigned  */
    WHEN A."TYPE" = '3' AND DAYS_BETWEEN( A."PERIODSTART", A."PERIODEND" ) <= 7 THEN MAX(A."OPT_PERCENT")
    /* “For Telescopic, Manual Option% is assigned from Option% TYPE 1000, sourced from the V_OPT_MANUAL view.” */
    WHEN A."TYPE" = '3' AND DAYS_BETWEEN( A."PERIODSTART", A."PERIODEND" ) > 7
        THEN
            (
                SELECT MAX(B."OPT_PERCENT")
                FROM V_OPT_MANUAL B
                WHERE B."LOCATION_ID"     = A."LOCATION_ID"
                  AND B."PRODUCT_ID"      = A."PRODUCT_ID"
                  AND B."CUSTOMER_GROUP"  = A."CUSTOMER_GROUP"
                  AND B."MODEL_VERSION"   = A."MODEL_VERSION"
                  AND B."CHAR_NUM"        = A."CHAR_NUM"
                  AND B."CHARVAL_NUM"     = A."CHARVAL_NUM"
                  AND B."VERSION"         = A."VERSION"
                  AND B."SCENARIO"        = A."SCENARIO"
                  AND B."TELESCOPIC_WEEK" = A."TELESCOPIC_WEEK"
            )
            /* For  Remaining types  */
        ELSE
            CASE
                WHEN MAX(FD."QUANTITY") IS NULL OR MAX(FD."QUANTITY") = 0 THEN 0
                ELSE ROUND( ( SUM(A."OPT_QTY") / MAX(FD."QUANTITY") ) * 100, 2 )
            END
    END AS OPT_PERCENT,

    SUM(A."OPT_QTY") AS "OPT_QTY",
    A."CHAR_DESC",
    A."CHAR_NAME",
    A."CHAR_TYPE",
    A."CHARVAL_DESC",
    A."VERSION_NAME",
    A."SCENARIO_NAME",
    A."LOCATION_DESC",
    A."PROD_DESC",
    A."KEY_FIG_ID",
    A."KEY_FIG_DESC",
    A."DISPLAY_ORDER",
    A."PRIORITY_ORDER",
    A."TELESCOPIC_WEEK",
    A."PERIODSTART",
    A."PERIODEND",
    A."ACT_DEM_VC",
    A."ACT_DEM_PERCENT"
FROM V_FINAL_OPTION_PLAN_NEW A
LEFT JOIN PRODEMAND FD
    ON FD."LOCATION_ID" = A."LOCATION_ID"
   AND FD."PRODUCT_ID" = A."PRODUCT_ID"
   AND FD."CUSTOMER_GROUP" = A."CUSTOMER_GROUP"
   AND (
        A."TYPE" = '101'
        OR (
            A."TYPE" <> '101'
            AND FD."VERSION" = A."VERSION"
            AND FD."SCENARIO" = A."SCENARIO"
        )
   )
   AND FD."TELESCOPIC_WEEK" = A."TELESCOPIC_WEEK"
LEFT JOIN FORECAST_TOTAL FO
    ON FO."LOCATION_ID" = A."LOCATION_ID"
   AND FO."PRODUCT_ID" = A."PRODUCT_ID"
   AND FO."VERSION" = A."VERSION"
   AND FO."SCENARIO" = A."SCENARIO"
   AND FO."MODEL_VERSION" = A."MODEL_VERSION"
   AND FO."TELESCOPIC_WEEK" = A."TELESCOPIC_WEEK"
GROUP BY 
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."CUSTOMER_GROUP",
    A."MODEL_VERSION",
    A."CHAR_NUM",
    A."CHARVAL_NUM",
    A."VERSION",
    A."SCENARIO",
    A."TYPE",
    A."CHAR_DESC",
    A."CHAR_NAME",
    A."CHAR_TYPE",
    A."CHARVAL_DESC",
    A."VERSION_NAME",
    A."SCENARIO_NAME",
    A."LOCATION_DESC",
    A."PROD_DESC",
    A."KEY_FIG_ID",
    A."KEY_FIG_DESC",
    A."DISPLAY_ORDER",
    A."PRIORITY_ORDER",
    A."TELESCOPIC_WEEK",
    A."PERIODSTART",
    A."PERIODEND",
    A."ACT_DEM_VC",
    A."ACT_DEM_PERCENT"
ORDER BY 
    A."LOCATION_ID",
    A."PRODUCT_ID",
    A."CUSTOMER_GROUP",
    A."CHAR_NUM",
    A."PERIODSTART";