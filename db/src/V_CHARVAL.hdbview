------------------------------------------------------------------------------------------------
-- Name:            V_CHARVAL
-- Description:     View to fetch int. number and its values for Characteristics and its values
-- Join Details:    A: CP_CHARACTERISTICS -  Table for int. number of characteristics and values
--                  B: CP_CHAR_VALUES - Table for int. number of characteristic values
-------------------------------------------------------------------------------------------------
VIEW "V_CHARVAL" AS
SELECT DISTINCT 
	A.CLASS_NUM,
	A.CHAR_NUM,
	A.CHAR_NAME,
	A.CHAR_DESC,
	A.CHAR_GROUP,
	A.CHAR_TYPE,
	A.ENTRY_REQ,
	A.CHAR_CATGRY,
	A.MULTI_CHAR,
	A.REF_CHAR_NUM,
	A.REF_CHAR_NAME,
	A.REF_CHAR_DESC,
	CASE
		WHEN A.CHAR_TYPE = 'NUM' THEN 
		CASE
		WHEN CP_CHARVAL_BUCKET.CHAR_VALUE IS NOT NULL THEN CP_CHARVAL_BUCKET.CHAR_VALUE
		ELSE '0'
		END 
		ELSE 
		CASE
		WHEN B.CHAR_VALUE IS NOT NULL THEN B.CHAR_VALUE
		ELSE '0'
		END
	END AS CHAR_VALUE,
	CASE
		WHEN A.CHAR_TYPE = 'NUM' THEN CP_CHARVAL_BUCKET.CHAR_VALUE
		ELSE B.CHARVAL_NUM
	END AS CHARVAL_NUM,
	CASE
		WHEN A.CHAR_TYPE = 'NUM' THEN CP_CHARVAL_BUCKET.CHAR_VALUE
		ELSE B.CHARVAL_DESC
	END AS CHARVAL_DESC,
	B.CATCH_ALL,
	CASE
		WHEN A.CHAR_TYPE = 'NUM' THEN CP_CHARVAL_BUCKET.CHAR_VALUE
		ELSE B.REF_CHARVAL_NUM
	END AS REF_CHARVAL_NUM,
	CASE
		WHEN A.CHAR_TYPE = 'NUM' THEN CP_CHARVAL_BUCKET.CHAR_VALUE
		ELSE B.REF_CHAR_VALUE
	END AS REF_CHAR_VALUE,
	CASE
		WHEN B.GENFLAG IS NULL THEN ' '
		ELSE B.GENFLAG
	END AS GENFLAG
FROM 
	CP_CHARACTERISTICS AS A
	LEFT OUTER JOIN
	CP_CHAR_VALUES AS B
	ON A.CHAR_NUM = B.CHAR_NUM
	LEFT OUTER JOIN
	CP_CHARVAL_BUCKET
	ON  A.CHAR_NUM = CP_CHARVAL_BUCKET.CHAR_NUM;
	

