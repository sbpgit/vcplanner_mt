VIEW "V_SNAPDATA" AS
SELECT
    "SNAP_TIMESTAMP",
    "LOCATION_ID",
    "PRODUCT_ID",
    "UNIQUE_ID",
    "WEEK_DATE",
    "CIR_QTY"
FROM
    "CP_SNAPSHOT_DATA"
union all
   Select
    CURRENT_TIMESTAMP AS "SNAP_TIMESTAMP",
    "LOCATION_ID",
    "PRODUCT_ID",
    "UNIQUE_ID",
    "WEEK_DATE",
    "CIR_QTY"
FROM "CP_CIR_GENERATED"
WHERE   "VERSION"  = '__BASELINE' AND
        "SCENARIO"  = '_PLAN'