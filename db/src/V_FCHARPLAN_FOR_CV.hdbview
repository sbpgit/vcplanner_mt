VIEW "V_FCHARPLAN_FOR_CV" AS
SELECT DISTINCT 
	A."LOCATION_ID",
	A."PRODUCT_ID",
	A."WEEK_DATE",
	A."CHAR_NUM",
	B."CHAR_NAME",
	B."CHAR_DESC", 
	A."CHARVAL_NUM",
	B."CHAR_VALUE",
	B."CHARVAL_DESC",
	A."VERSION",
	A."SCENARIO",
	A."MODEL_VERSION",
	AVG(A.OPT_PERCENT) AS OPT_PERCENT,
	AVG(A.OPT_QTY) AS OPT_QTY
FROM 
	"CP_IBP_FCHARPLAN" AS A
	INNER JOIN
	"V_CLASSCHARVAL" AS B
	ON A.CHAR_NUM = B.CHAR_NUM
		AND A.CHARVAL_NUM = B.CHARVAL_NUM
GROUP BY 
	A."LOCATION_ID",
	A."PRODUCT_ID",
	A."WEEK_DATE",
	A."CHAR_NUM",
	B."CHAR_NAME",
	B."CHAR_DESC",
	A."CHARVAL_NUM",
	B."CHAR_VALUE",
	B."CHARVAL_DESC",
	A."VERSION",
	A."SCENARIO",
	A."MODEL_VERSION";
