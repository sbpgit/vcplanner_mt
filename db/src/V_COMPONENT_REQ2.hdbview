VIEW "V_COMPONENT_REQ2" AS
SELECT A.LOCATION_ID,
  A.PRODUCT_ID,
  A.WEEK_DATE,
  A.FACTORY_LOC,
  A.VERSION,
  A.SCENARIO,
  A.ITEM_NUM,
  B."ASSEMBLY",
  B.COMPONENT,
  B.COMP_DESC,
  A.MODEL_VERSION,
  A."PERCENTAGE",
  A.COMP_QTY AS ASSEM_QTY,
  A.IBP_DEMAND,
  B.ASMB_DESC,
  B.COMP_QTY AS ASM_COM_QTY,
  (B.COMP_QTY * A.COMP_QTY) AS COMP_QTY,
  C.STRUC_NODE,
  CASE
    WHEN A.PRODUCT_ID IS NOT NULL THEN ROUND (1)
    WHEN A.PRODUCT_ID IS NULL THEN ROUND (1)
  END AS ROW_COUNT
FROM "V_COMPREQ_REP" AS A
  INNER JOIN "V_ASSEMBLYCOMP_DESC" AS B
 ON A.FACTORY_LOC = B.LOCATION_ID
  AND A.COMPONENT = B."ASSEMBLY"
  INNER JOIN "V_BOMPVS" AS C
 ON A.FACTORY_LOC = C.LOCATION_ID
  AND A.COMPONENT = C.COMPONENT
  AND A.ITEM_NUM = C.ITEM_NUM;