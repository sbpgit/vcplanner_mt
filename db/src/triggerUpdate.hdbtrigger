TRIGGER "triggerUpdate"
AFTER UPDATE ON "CP_IBP_FCHARPLAN"
REFERENCING NEW ROW AS MYNEWROW, OLD ROW AS MYOLDROW
FOR EACH ROW
BEGIN
        -- Check if OPT_PERCENT or OPT_QTY has changed
            IF :MYNEWROW.OPT_PERCENT != :MYOLDROW.OPT_PERCENT OR :MYNEWROW.OPT_QTY != :MYOLDROW.OPT_QTY THEN
   
                -- Delete existing record
                DELETE FROM CP_DEMAND_OPT_QUANTITY_DELTA
                WHERE LOCATION_ID = :MYNEWROW.LOCATION_ID
                  AND PRODUCT_ID = :MYNEWROW.PRODUCT_ID
                  AND VERSION = :MYNEWROW.VERSION
                  AND SCENARIO = :MYNEWROW.SCENARIO
                  AND WEEK_DATE = :MYNEWROW.WEEK_DATE;
               
                -- Insert new record
                INSERT INTO "CP_DEMAND_OPT_QUANTITY_DELTA"
                VALUES (:MYNEWROW.LOCATION_ID,
                        :MYNEWROW.PRODUCT_ID,
                        :MYNEWROW.VERSION,
                        :MYNEWROW.SCENARIO,
                        :MYNEWROW.WEEK_DATE,
                        :MYNEWROW.MODEL_VERSION);
                        -- ,
                        --  CURRENT_TIMESTAMP);
            END IF;
END