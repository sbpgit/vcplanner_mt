VIEW V_TS_HISTORY_CUSTOMER_NEW as
SELECT DISTINCT CP_PARTIALPROD_INTRO.PRODUCT_ID,
       CP_PARTIALPROD_INTRO.LOCATION_ID,
       ADD_DAYS(
        ADD_DAYS(
            TO_DATE( '01/01/' || substr( "PERIOD_NUM", 1, 4 ), 'DD/MM/YYYY' ),
            - (WEEKDAY(TO_DATE( '01/01/' || substr( "PERIOD_NUM", 1, 4 ), 'DD/MM/YYYY' )))
        ),
        (substr( "PERIOD_NUM", 5, 2 ) - 1 ) * 7
    ) AS CAL_DATE,
       CP_VC_HISTORY_TS_CUST.PERIOD_NUM,
       CP_VC_HISTORY_TS_CUST.TYPE,
       CP_VC_HISTORY_TS_CUST.GROUP_ID,
       CP_VC_HISTORY_TS_CUST.GROUP_COUNT,
       CP_VC_HISTORY_TS_CUST.GROUP_COUNT_RATE,
       CP_VC_HISTORY_TS_CUST.CUSTOMER_GROUP
from CP_PARTIALPROD_INTRO
join CP_VARCHAR_PS
on CP_PARTIALPROD_INTRO.REF_PRODID = CP_VARCHAR_PS.PRODUCT_ID
and CP_VARCHAR_PS.CHAR_TYPE = 'P'
JOIN CP_VC_HISTORY_TS_CUST
ON CP_VC_HISTORY_TS_CUST.LOCATION_ID = CP_PARTIALPROD_INTRO.LOCATION_ID
AND CP_VC_HISTORY_TS_CUST.PRODUCT_ID = CP_PARTIALPROD_INTRO.PRODUCT_ID
 ORDER BY
CAL_DATE,CP_PARTIALPROD_INTRO.LOCATION_ID,CP_PARTIALPROD_INTRO.PRODUCT_ID,CP_VC_HISTORY_TS_CUST.GROUP_ID;
 