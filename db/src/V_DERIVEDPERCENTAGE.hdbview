VIEW "V_DERIVEDPERCENTAGE" AS
SELECT A.WEEK_DATE,
  A.LOCATION_ID,
  A.PRODUCT_ID,
  A.CLASS_NUM,
  C.CLASS_NAME,
  D.CLASS_DESC,
  A.CHAR_NUM,
  C.CHAR_NAME,
  C.CHAR_DESC,
  A.CHARVAL_NUM,
  C.CHAR_VALUE,
  C.CHARVAL_DESC,
  A.VERSION,
  A.SCENARIO,
  A.OPT_PERCENT
FROM CP_MARKETAUTH_CFG AS A
  INNER JOIN CP_PARTIALPROD_INTRO AS B
 ON B.PRODUCT_ID = A.PRODUCT_ID
  AND B.LOCATION_ID = A.LOCATION_ID
  INNER JOIN V_PARTIALPRODCHAR AS C
 ON C.LOCATION_ID = A.LOCATION_ID
  AND C.PRODUCT_ID = B.REF_PRODID
  AND C.CLASS_NUM = A.CLASS_NUM
  AND C.CHAR_NUM = A.CHAR_NUM
  AND C.CHARVAL_NUM = A.CHARVAL_NUM
  INNER JOIN CP_CLASS AS D
 ON (A.CLASS_NUM = D.CLASS_NUM)