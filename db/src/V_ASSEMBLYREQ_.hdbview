
--
-- Name:            V_COMPOD_TSPRED
-- Description:     Get component requirement for location product component based on Version scenario and week date
-- Join Details:    V_BOM_CONFIG_PARTIAL -  Master table for BOM
--                  CP_IBP_FUTUREDEMAND - IBP future demand tables
--                  CP_PVS_BOM -  PVS-BOM assignment table
--                  V_BOM_TSPREDICTIONV2-  View to fet BOM timeseries predictions for Object dependency
--                  V_STRUC_NODE_QTY-    View to get structure node quantity
--

VIEW "V_ASSEMBLYREQ" AS
SELECT DISTINCT V_BOM_CONFIG_PARTIAL.LOCATION_ID,
  CP_FACTORY_SALESLOC.FACTORY_LOC,
  V_BOM_CONFIG_PARTIAL.REF_PRODID,
  V_BOM_CONFIG_PARTIAL.PRODUCT_ID,
  V_BOM_CONFIG_PARTIAL.ITEM_NUM,
  V_BOM_CONFIG_PARTIAL.COMPONENT,
  CP_PVS_BOM.STRUC_NODE,
  CP_IBP_FUTUREDEMAND.VERSION,
  CP_IBP_FUTUREDEMAND.SCENARIO,
  CP_IBP_FUTUREDEMAND.WEEK_DATE,
  CP_IBP_FUTUREDEMAND.QUANTITY,
  V_BOM_CONFIG_PARTIAL.COMP_QTY AS COMPONENT_QTY,
  V_BOM_TSPREDICTIONV2.MODEL_VERSION,
  CASE
    WHEN V_BOM_TSPREDICTIONV2.PREDICTED IS NULL THEN ROUND(
      CP_IBP_FUTUREDEMAND.QUANTITY * V_BOM_CONFIG_PARTIAL.COMP_QTY,
      2
    )
    ELSE ROUND(
      V_BOM_TSPREDICTIONV2.PREDICTED * V_BOM_CONFIG_PARTIAL.COMP_QTY,
      2
    )
  END AS ACT_COMP_QTY,
  V_STRUC_NODE_QTY.STRUC_QTY,
  V_STRUC_NODE_QTY.UPPER_LIMIT,
  V_STRUC_NODE_QTY.LOWER_LIMIT,
  CASE
    WHEN V_STRUC_NODE_QTY.STRUC_QTY < V_STRUC_NODE_QTY.LOWER_LIMIT
    AND V_STRUC_NODE_QTY.STRUC_QTY > 0 THEN CEIL(
      CASE
        WHEN V_BOM_TSPREDICTIONV2.PREDICTED IS NULL THEN ROUND(
          CP_IBP_FUTUREDEMAND.QUANTITY * V_BOM_CONFIG_PARTIAL.COMP_QTY,
          2
        )
        ELSE ROUND(
          V_BOM_TSPREDICTIONV2.PREDICTED * V_BOM_CONFIG_PARTIAL.COMP_QTY,
          2
        )
      END * (
        V_STRUC_NODE_QTY.LOWER_LIMIT / V_STRUC_NODE_QTY.STRUC_QTY
      ) * V_BOM_CONFIG_PARTIAL.COMP_QTY
    )
    WHEN V_STRUC_NODE_QTY.STRUC_QTY > V_STRUC_NODE_QTY.UPPER_LIMIT
    AND V_STRUC_NODE_QTY.STRUC_QTY > 0 THEN CEIL(
      CASE
        WHEN V_BOM_TSPREDICTIONV2.PREDICTED IS NULL THEN ROUND(
          CP_IBP_FUTUREDEMAND.QUANTITY * V_BOM_CONFIG_PARTIAL.COMP_QTY,
          2
        )
        ELSE ROUND(
          V_BOM_TSPREDICTIONV2.PREDICTED * V_BOM_CONFIG_PARTIAL.COMP_QTY,
          2
        )
      END * (
        V_STRUC_NODE_QTY.UPPER_LIMIT / V_STRUC_NODE_QTY.STRUC_QTY
      ) * V_BOM_CONFIG_PARTIAL.COMP_QTY
    )
    ELSE ROUND(
      V_BOM_TSPREDICTIONV2.PREDICTED * V_BOM_CONFIG_PARTIAL.COMP_QTY
    )
  END AS COMP_QTY
FROM V_BOM_CONFIG_PARTIAL
  INNER JOIN CP_IBP_FUTUREDEMAND
 ON CP_IBP_FUTUREDEMAND.LOCATION_ID = V_BOM_CONFIG_PARTIAL.LOCATION_ID
  AND CP_IBP_FUTUREDEMAND.PRODUCT_ID = V_BOM_CONFIG_PARTIAL.PRODUCT_ID
  LEFT OUTER JOIN CP_PVS_BOM
 ON V_BOM_CONFIG_PARTIAL.FACTORY_LOC = CP_PVS_BOM.LOCATION_ID
  AND V_BOM_CONFIG_PARTIAL.REF_PRODID = CP_PVS_BOM.PRODUCT_ID
  AND V_BOM_CONFIG_PARTIAL.ITEM_NUM = CP_PVS_BOM.ITEM_NUM
  AND V_BOM_CONFIG_PARTIAL.COMPONENT = CP_PVS_BOM.COMPONENT
  LEFT OUTER JOIN V_BOM_TSPREDICTIONV2
 ON V_BOM_TSPREDICTIONV2.LOCATION_ID = CP_IBP_FUTUREDEMAND.LOCATION_ID
  AND V_BOM_TSPREDICTIONV2.PRODUCT_ID = CP_IBP_FUTUREDEMAND.PRODUCT_ID
  AND V_BOM_TSPREDICTIONV2.ITEM_NUM = CP_PVS_BOM.ITEM_NUM
  AND V_BOM_TSPREDICTIONV2.COMPONENT = CP_PVS_BOM.COMPONENT
  AND V_BOM_TSPREDICTIONV2.VERSION = CP_IBP_FUTUREDEMAND.VERSION
  AND V_BOM_TSPREDICTIONV2.SCENARIO = CP_IBP_FUTUREDEMAND.SCENARIO
  AND V_BOM_TSPREDICTIONV2.CAL_DATE = CP_IBP_FUTUREDEMAND.WEEK_DATE
  LEFT OUTER JOIN V_STRUC_NODE_QTY
 ON V_STRUC_NODE_QTY.LOCATION_ID = CP_IBP_FUTUREDEMAND.LOCATION_ID
  AND V_STRUC_NODE_QTY.PRODUCT_ID = CP_IBP_FUTUREDEMAND.PRODUCT_ID
  AND V_STRUC_NODE_QTY.STRUC_NODE = CP_PVS_BOM.STRUC_NODE
  AND V_STRUC_NODE_QTY.VERSION = CP_IBP_FUTUREDEMAND.VERSION
  AND V_STRUC_NODE_QTY.SCENARIO = CP_IBP_FUTUREDEMAND.SCENARIO
  AND V_STRUC_NODE_QTY.WEEK_DATE = CP_IBP_FUTUREDEMAND.WEEK_DATE
  AND V_STRUC_NODE_QTY.MODEL_VERSION = V_BOM_TSPREDICTIONV2.MODEL_VERSION
  INNER JOIN CP_FACTORY_SALESLOC
  ON V_BOM_CONFIG_PARTIAL.LOCATION_ID = CP_FACTORY_SALESLOC.PLAN_LOC
  AND CP_IBP_FUTUREDEMAND.PRODUCT_ID  = CP_FACTORY_SALESLOC.PRODUCT_ID