VIEW "V_UNIQUE_ID_ITEMS"
AS SELECT DISTINCT 
CP_UNIQUE_ID_ITEM.UNIQUE_ID,
CP_UNIQUE_ID_ITEM.PRODUCT_ID,
CP_UNIQUE_ID_HEADER.UNIQUE_DESC,
CP_UNIQUE_ID_ITEM.CHAR_NUM,          
CP_CHARACTERISTICS.CHAR_NAME,
CP_CHARACTERISTICS.CHAR_DESC,
CP_UNIQUE_ID_ITEM.CHARVAL_NUM,
CP_UNIQUE_ID_ITEM.CHAR_VALUE,
CP_UNIQUE_ID_ITEM.UID_CHAR_RATE,
CP_UNIQUE_ID_HEADER.VALID_FROM,
CP_UNIQUE_ID_HEADER.VALID_TO,
CP_UNIQUE_ID_HEADER.UID_TYPE, 
CP_CHARACTERISTICS.MULTI_CHAR,         
CP_CHARACTERISTICS.REF_CHAR_NUM,
CP_CHARACTERISTICS.REF_CHAR_NAME,
CP_CHARACTERISTICS.REF_CHAR_DESC
FROM CP_UNIQUE_ID_ITEM
INNER JOIN CP_UNIQUE_ID_HEADER
ON CP_UNIQUE_ID_ITEM.UNIQUE_ID = CP_UNIQUE_ID_HEADER.UNIQUE_ID
AND CP_UNIQUE_ID_ITEM.PRODUCT_ID = CP_UNIQUE_ID_HEADER.PRODUCT_ID
AND CP_UNIQUE_ID_HEADER.ACTIVE = true
INNER JOIN CP_CHARACTERISTICS
ON CP_CHARACTERISTICS.CHAR_NUM = CP_UNIQUE_ID_ITEM.CHAR_NUM