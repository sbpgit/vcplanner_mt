VIEW "V_COMPREQ_MULTI" AS
SELECT "CP_ASSEMBLY_REQ"."LOCATION_ID",
  "CP_ASSEMBLY_REQ"."PRODUCT_ID",
  "CP_ASSEMBLY_REQ"."COMPONENT",
  "CP_ASSEMBLY_REQ"."WEEK_DATE",
  "CP_ASSEMBLY_REQ"."FACTORY_LOC",
  "CP_ASSEMBLY_REQ"."VERSION",
  "CP_ASSEMBLY_REQ"."SCENARIO",
  "CP_ASSEMBLY_REQ"."MODEL_VERSION",
  MAX(
    CASE
      WHEN (
        "CP_ASSEMBLY_REQ"."CIR_QTY" IS NOT NULL
        OR "CP_ASSEMBLY_REQ"."CIR_QTY" > 0
      ) THEN "CP_ASSEMBLY_REQ"."CIR_QTY"
      ELSE 0
    END
  ) AS CIR_QTY,
  ROUND(
    (
      SUM("COMPCIR_QTY") / SUM("CP_IBP_FUTUREDEMAND"."QUANTITY")
    ) * 100
  ) AS PERCENTAGE,
  SUM("COMPCIR_QTY") AS COMP_QTY,
  SUM("CP_IBP_FUTUREDEMAND"."QUANTITY") AS IBP_DEMAND
FROM "CP_ASSEMBLY_REQ"
INNER JOIN "CP_BOM_MAT"
   ON "CP_BOM_MAT"."MAT_CHILD" = "CP_ASSEMBLY_REQ"."COMPONENT"
  AND "CP_BOM_MAT"."CHILD_LOC" = "CP_ASSEMBLY_REQ"."FACTORY_LOC"
  AND "CP_BOM_MAT"."COUNTER" = "CP_ASSEMBLY_REQ"."ITEM_NUM"
  INNER JOIN "CP_IBP_FUTUREDEMAND"
 ON "CP_IBP_FUTUREDEMAND"."LOCATION_ID" = "CP_ASSEMBLY_REQ"."LOCATION_ID"
  AND "CP_IBP_FUTUREDEMAND"."PRODUCT_ID" = "CP_ASSEMBLY_REQ"."PRODUCT_ID"
  AND "CP_IBP_FUTUREDEMAND"."VERSION" = "CP_ASSEMBLY_REQ"."VERSION"
  AND "CP_IBP_FUTUREDEMAND"."SCENARIO" = "CP_ASSEMBLY_REQ"."SCENARIO"
  AND "CP_IBP_FUTUREDEMAND"."WEEK_DATE" = "CP_ASSEMBLY_REQ"."WEEK_DATE"
WHERE "CP_ASSEMBLY_REQ"."MODEL_VERSION" = 'Active'
  AND "CP_ASSEMBLY_REQ"."WEEK_DATE" >= "CP_BOM_MAT"."VALID_FROM"
  AND "CP_ASSEMBLY_REQ"."WEEK_DATE" <= "CP_BOM_MAT"."VALID_TO"
  AND "CP_IBP_FUTUREDEMAND"."QUANTITY" > 0
GROUP BY "CP_ASSEMBLY_REQ"."LOCATION_ID",
  "CP_ASSEMBLY_REQ"."PRODUCT_ID",
  "CP_ASSEMBLY_REQ"."COMPONENT",
  "CP_ASSEMBLY_REQ"."WEEK_DATE",
  "CP_ASSEMBLY_REQ"."FACTORY_LOC",
  "CP_ASSEMBLY_REQ"."VERSION",
  "CP_ASSEMBLY_REQ"."SCENARIO",
  "CP_ASSEMBLY_REQ"."MODEL_VERSION" ORDER BY "CP_ASSEMBLY_REQ"."LOCATION_ID",
  "CP_ASSEMBLY_REQ"."PRODUCT_ID",
  "CP_ASSEMBLY_REQ"."COMPONENT",
  "CP_ASSEMBLY_REQ"."WEEK_DATE",
  "CP_ASSEMBLY_REQ"."VERSION",
  "CP_ASSEMBLY_REQ"."SCENARIO",
  "CP_ASSEMBLY_REQ"."MODEL_VERSION"