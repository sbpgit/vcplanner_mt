FUNCTION "F_BOM_CONFIG_PARTIAL_M"()
RETURNS TABLE (
  FACTORY_LOC     NVARCHAR(40),
  REF_PRODID      NVARCHAR(40),
  LOCATION_ID     NVARCHAR(40),
  PRODUCT_ID      NVARCHAR(40),
  ITEM_NUM        NVARCHAR(10),
  MAT_PARENT      NVARCHAR(40),
  COMPONENT       NVARCHAR(40),
  COMP_DESC       NVARCHAR(100),
  COMP_QTY        DECIMAL(13,3),
  CONFIGURABLE    NVARCHAR(1),
  PHANTOM_IND     NVARCHAR(1),
  CLASS_FLG       NVARCHAR(1),
  VALID_FROM      DATE,
  VALID_TO        DATE,
  OBJ_DEP         NVARCHAR(100),
  OBJDEP_DESC     NVARCHAR(255),
  BOM_LEVEL       INTEGER,
  ROOT_MAT_PARENT NVARCHAR(40),
  ROOT_LOCATION_ID NVARCHAR(40)
)
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
AS
BEGIN
  DECLARE lv_count INTEGER;
  DECLARE lv_level INTEGER := 1;

  -- Anchor: level-1 components whose parent is a partial product reference
  lt_current = SELECT
    A.CHILD_LOC, A.COUNTER, A.MAT_PARENT, A.MAT_CHILD, A.PROD_DESC,
    A.COMPONENT_QTY, A.CONFIGURABLE, A.PHANTOM_IND, A.CLASS_FLG,
    A.VALID_FROM, A.VALID_TO, A.LOCATION_ID,
    1 AS BOM_LEVEL,
    A.MAT_PARENT AS ROOT_MAT_PARENT,
    A.LOCATION_ID AS ROOT_LOCATION_ID
  FROM "CP_BOM_MAT" AS A
  INNER JOIN "CP_PARTIALPROD_INTRO" AS P
    ON  P.LOCATION_ID = A.LOCATION_ID
    AND P.REF_PRODID  = A.MAT_PARENT;

  lt_all = SELECT * FROM :lt_current;

  SELECT COUNT(*) INTO lv_count FROM :lt_current;

  -- Iterative expansion: each pass resolves one more BOM level
  WHILE :lv_count > 0 AND :lv_level < 99 DO
    lv_level := :lv_level + 1;

    lt_next = SELECT
      A.CHILD_LOC, A.COUNTER, A.MAT_PARENT, A.MAT_CHILD, A.PROD_DESC,
      A.COMPONENT_QTY, A.CONFIGURABLE, A.PHANTOM_IND, A.CLASS_FLG,
      A.VALID_FROM, A.VALID_TO, A.LOCATION_ID,
      :lv_level AS BOM_LEVEL,
      H.ROOT_MAT_PARENT,
      H.ROOT_LOCATION_ID
    FROM "CP_BOM_MAT" AS A
    INNER JOIN :lt_current AS H
      ON  A.MAT_PARENT  = H.MAT_CHILD
      AND A.LOCATION_ID = H.CHILD_LOC;

    SELECT COUNT(*) INTO lv_count FROM :lt_next;

    lt_all     = SELECT * FROM :lt_all UNION ALL SELECT * FROM :lt_next;
    lt_current = SELECT * FROM :lt_next;
  END WHILE;

  RETURN SELECT DISTINCT
    H.CHILD_LOC      AS FACTORY_LOC,
    C.REF_PRODID,
    D.LOCATION_ID,
    D.PRODUCT_ID,
    H.COUNTER        AS ITEM_NUM,
    H.MAT_PARENT,
    H.MAT_CHILD      AS COMPONENT,
    H.PROD_DESC      AS COMP_DESC,
    H.COMPONENT_QTY  AS COMP_QTY,
    H.CONFIGURABLE,
    H.PHANTOM_IND,
    H.CLASS_FLG,
    H.VALID_FROM,
    H.VALID_TO,
    B.OBJ_DEP,
    B.OBJDEP_DESC,
    H.BOM_LEVEL,
    H.ROOT_MAT_PARENT,
    H.ROOT_LOCATION_ID
  FROM :lt_all AS H
    LEFT OUTER JOIN "CP_BOM_OD" AS B
      ON  H.MAT_PARENT  = B.MAT_PARENT
      AND H.MAT_CHILD   = B.MAT_CHILD
      AND H.LOCATION_ID = B.LOCATION_ID
    INNER JOIN "CP_PARTIALPROD_INTRO" AS C
      ON  C.LOCATION_ID = H.ROOT_LOCATION_ID
      AND C.REF_PRODID  = H.ROOT_MAT_PARENT
    INNER JOIN "CP_FACTORY_SALESLOC" AS D
      ON  D.FACTORY_LOC = H.ROOT_LOCATION_ID
      AND D.PRODUCT_ID  = C.PRODUCT_ID
  ORDER BY D.PRODUCT_ID ASC, H.BOM_LEVEL ASC;
END;