    type uniqueConfig {
        CLASS_NUM    : String(18);
        CHAR_NUM     : String(100);
        CHAR_NAME    : String(80);
        CHAR_DESC    : String(160);
        CHARVAL_NUM  : String(80);
        CHAR_VALUE   : String(80);
        CHARVAL_DESC : String(160);
    }

    type uniqueCharacteristics {
        UNIQUE_ID   : Integer;
        UNIQUE_DESC : String(100);
        CONFIG      : array of uniqueConfig;
        TOTAL       : Integer;
    }

    type PIDuniqueCharacteristics {
        PRIMARY_ID   : Integer;
        PRIMARY_ID_DESC : String(100);
        CONFIG      : array of uniqueConfig;
        TOTAL       : Integer;
    }

    type partialProdLoc {
        REF_PRODID       : String(40);
        PARTIALPROD      : String(40);
        PARTIALPROD_DESC : String(40);
        FACTORY_LOC      : String(4);
        FACTORYLOC_DESC  : String(30);
        DEMAND_LOC       : String(4);
        DEMANDLOC_DESC   : String(30);
        PLANNING_LOC     : String(4);
        PLANNINGLOC_DESC : String(30);
    }

    type locProdChars {
        LOCATION_ID   : String(4);
        PRODUCT_ID    : String(40);
        REF_PRODID    : String(40);
        CLASS_NUM     : String(18);
        CLASS_NAME    : String(20);
        CHAR_NUM     : String(100);
        CHAR_NAME    : String(80);
        CHAR_DESC    : String(160);
        CHARVAL_NUM  : String(80);
        CHAR_VALUE   : String(80);
        CHARVAL_DESC : String(160);
        UNIQUE_ID     : Integer;
        UNIQUE_DESC   : String(100);
        UID_CHAR_RATE : Decimal(13, 2);
    }


    // Assembly Components Where Used
    type asmCompWhrUsd {
        LOCATION_ID   : String(4);
        PRODUCT_ID    : String(40);
        ITEM_NUM      : String(6);
        ASSEMBLY      : String(40);
        COMPONENT     : String(40);
        ASSEMBLY_DESC : String(4);
        CLASS_NUM     : String(18);
        COMP_DESC     : String(4);
        CLASS_DESC    : String(150);
        CHAR_DESC     : String(160);
        CHAR_NUM      : String(100);
        CHAR_VALUE    : String(80);
        CHARVAL_DESC  : String(160);
        OD_CONDITION  : String(2);
        VALID_FROM    : Date;
        VALID_TO      : Date;
    }

    // Saved Config  - Characteristics
    type UniqueItems {
        characteristic      : String(100);
        characteristicValue : String(80);
    }

    // Saved Config - Unique Id Details
    type UniqueIdDetails {
        product        : String(40);
        externalIdentification : String(40);
        uniqueIDDescription       : String(100);
        validFrom        : String(10);
        validTo          : String(10);
        characteristics   : array of UniqueItems;
    }
    type uniqueIdResponse{
        JOB_ID : Integer;
        MESSAGE: String(200);
    }   

    type prodList{
        PRODUCT_ID: String(40);
        PROD_DESC: String(40);
        IDENTIFICATION: String(1);
    } 

    type forecastDemand{
        FACTORY_LOC :String(4);
        PRODUCT_ID: String(40);
        SCENARIO : String(32);
        DEMAND_QTY : Decimal(13, 3);
        VERSION : String(10);
        WEEK_DATE : String;
        WEEK_NUMBER:String;
    }

    type uniqueIDFnResponse{
        Type: String(15);
        Description: String;
        statusCode: Integer;
        resultData:String;
    }

    type alllocProd{

        LOCATION_ID:String(4);
        PRODUCT_ID: String(40);
        CONFIGPROD_CHK:String(1);
    }

      type UniqueIdStatus {
        product        : String(40);
        externalIdentification : String(40);
    }
     type CFUsers{
        USERNAME : String;
    }
   type UID{
        REF_UNIQUE_ID : Integer;
        PRODUCT_ID : String(40);
        PROJECT_ID : String(40);
        UID_TYPE : String(1);
        UNIQUE_DESC :String(100);
    }

    type CHARVALUES{
        CHAR_VALUE: String(70);
        REF_CHAR_VALUE:String(70);
        WEIGHT : Integer;
        VALID_FROM: String;
        VALID_TO : String;
    }
    type ITEMDATA{
        UNIQUE_ID : Integer;
        UNIQUE_DESC: String(100);
        PRODUCT_ID : String(40); 
        CHAR_NUM: String(100);
        CHAR_NAME: String(80);
        CHAR_DESC: String(160);
        CHARVAL_NUM: String(80);
        CHARVAL_DESC: String(160);
        CHAR_VALUE: String(80);
      }

     type tmpuid{
        // UID : array of UID;
        UID : String;
        // CHARVALUES : array of CHARVALUES;
        // ITEMDATA : String;
        GenFlag : String(1);
        MaxValue : Integer;
       
    }
    //Log structure for Job Feed
    type Varaint_Feed_Log{
        jobName : String;
        Template    : String(50);
        Activity    : String(50);
        Step        : Integer;
        stepStatus  : String(20);
        jobStatus  : String(20);
        Log         : String;
    }
    type Variant_JobFeed{
        Variant : String(50);
        JobTemplateName: String(50);
        JobTemplateText: String(150); 
    }

    type jobFeedFormat{
        Type:String;
        Description:String;
        statusCode:Integer;
    }

}
