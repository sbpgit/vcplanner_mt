using V_BOMODCHAR from '../db/data-model';

context cp_ds {
    type objectDep {
        LOCATION_ID : String(4);
        PRODUCT_ID  : String(40);
        OBJ_DEP     : String(30);
        OBJ_COUNTER : Integer;
    }

    type locProd {
        LOCATION_ID : String(4);
        PRODUCT_ID  : String(40);
        PROD_DESC   : String(40);
    }

    type prodVerScen {
        LOCATION_ID : String(4);
        REF_PRODID  : String(40);
        FACTORY_LOC : String(4);
        PRODUCT_ID  : String(40);
        VERSION     : String(10);
        SCENARIO    : String(32);
    }

    type odprofiles {
        LOCATION_ID : String(4);
        PRODUCT_ID  : String(40);
        COMPONENT   : String(40);
        PROFILE     : String(50);
        OBJ_DEP     : String(30);
        OBJDEP_DESC : String(30);
        STRUC_NODE  : String(50);
    }

    type prodpredictchk {
        PRODUCT_ID     : String(40);
        PROD_DESC      : String(40);
        PREDICTION_CHK : String(1);
    }

    type asmblyProdUID {
        LOCATION_ID : String(4);
        LOCATION_DESC : String(30);
        ASSEMBLY    : String(40);
        ASSEMBLY_DESC : String(40);
        PRODUCT_ID  : String(40);
        PRODUCT_DESC  : String(40);
        UNIQUE_ID   : Integer;
        UNIQUE_DESC : String(100);
        CIR_QTY     : Integer;
        ORD_QTY     : Integer;
    }

    type seedorddata {
        SEED_ORDER        : String(10);
        LOCATION_ID       : String(4);
        PRODUCT_ID        : String(40);
        CUSTOMER_GROUP    : String(20);
        UNIQUE_ID         : Integer;
        ORD_QTY           : Decimal(13, 3);
        MAT_AVAILDATE     : Date;
        UNIQUE_DESC       : String(100);
        EX_IDENTIFICATION : String(40);

    }

    type seedordErrorLog {
        ID             : String(20);
        LOCATION_ID    : String(4);
        PRODUCT_ID     : String(40);
        CUSTOMER_GROUP : String(20);
        UNIQUE_ID      : Integer;
        ERROR          : String(40);
        CREATED_DATE   : Date;
    }

    type CompProdUID {
        LOCATION_ID : String(4);
        LOCATION_DESC : String(30);
        ASSEMBLY    : String(40);
        COMPONENT    : String(40);
        COMP_DESC   : String(40);
        PRODUCT_ID  : String(40);
        PRODUCT_DESC  : String(40);
        UNIQUE_ID   : Integer;
        UNIQUE_DESC : String(100);
        CIR_QTY     : Integer;
        ORD_QTY     : Integer;
    }

    type restrprodqty {
        LOCATION_ID : String(4);
        PRODUCT_ID  : String(40);
        PRDRTR_QTY  : Integer;
        LOCATION_DESC : String(40);
        PROD_DESC  : String(40);
    }

    type assemblycompdata {
