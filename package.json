  "scripts": {
    "start": "NODE_ENV=production cds serve --profile hybrid",
    "watch-cfgprd_pvsroot": "cds serve --open cfgprd_pvsroot/webapp/index.html#fe-lrop-v4",
    "undeploy": "cf undeploy config_products --delete-services --delete-service-keys --delete-service-brokers",
    "watch-project1": "cds serve --open project1/webapp/index.html#fe-lrop-v4",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "eslintConfig": {
    "extends": "eslint:recommended",
    "env": {
      "es2020": true,
      "node": true,
      "jest": true,
      "mocha": true
