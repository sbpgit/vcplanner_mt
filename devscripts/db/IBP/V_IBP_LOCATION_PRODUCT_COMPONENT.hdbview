VIEW V_IBP_LOCATION_PRODUCT_COMPONENT AS
SELECT DISTINCT "V_BOM_DEMDFACLOC"."LOCATION_ID" AS LOCID, "V_BOM_DEMDFACLOC"."PRODUCT_ID" AS PRDID,
       "V_BOM_DEMDFACLOC"."COMPONENT" AS PRDFR,"STRUC_NODE" AS VCSTRUCTURENODE
FROM "V_BOM_DEMDFACLOC" 
LEFT OUTER JOIN "CP_PVS_BOM" ON
 "V_BOM_DEMDFACLOC"."LOCATION_ID" = "CP_PVS_BOM"."LOCATION_ID"
 AND  "V_BOM_DEMDFACLOC"."PRODUCT_ID" = "CP_PVS_BOM"."PRODUCT_ID"
 AND  "V_BOM_DEMDFACLOC"."COMPONENT" = "CP_PVS_BOM"."COMPONENT";

--SELECT LOCATION_ID AS LOCID, PRODUCT_ID AS PRDID, COMPONENT AS PRDFR, 
--STRUC_NODE AS VCSTRUCTURENODE FROM CP_PVS_BOM;