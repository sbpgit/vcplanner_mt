VIEW V_IBP_SALESH AS
SELECT CP_SALESH.SALES_DOC, CP_SALESH.MAT_AVAILDATE, CP_SALESH.LOCATION_ID, CP_SALESH.PRODUCT_ID, CUSTOMER_GROUP, ORD_QTY, "VCCLASS", CHAR_NUM, CHARVAL_NUM 
FROM CP_SALESH
INNER JOIN V_SALESH_UID_CONFIG ON
CP_SALESH.SALES_DOC = V_SALESH_UID_CONFIG.SALES_DOC
AND CP_SALESH.PRODUCT_ID = V_SALESH_UID_CONFIG.PRODUCT_ID
LEFT OUTER JOIN IBP_CLASS ON
V_SALESH_UID_CONFIG.CHAR_NUM = IBP_CLASS."VCCHAR" 
AND V_SALESH_UID_CONFIG.CHARVAL_NUM = IBP_CLASS."VCCHARVALUE"
LEFT OUTER JOIN CP_PRODUCT_CLASS ON
CP_SALESH.PRODUCT_ID = CP_PRODUCT_CLASS."PRODUCT_ID"
LEFT OUTER JOIN CP_CLASS ON
CP_PRODUCT_CLASS.CLASS_NUM = CP_CLASS.CLASS_NUM;