VIEW GRAPHS_V_K_SHORTEST_PATHS AS
SELECT DISTINCT GKSP.LOCATION_ID, GKSP.PRODUCT_ID, GKSP.OBJ_TYPE, START_VERTEX_ID, 
END_VERTEX_ID,
SOURCE, TARGET, 
PATH_ID, PATH_LENGTH, PATH_WEIGHT, WEIGHT,
EDGE_ID, EDGE_ORDER 
FROM GRAPHS_K_SHORTEST_PATHS  AS GKSP
INNER JOIN GRAPHS_EDGES AS GE ON
GKSP.LOCATION_ID = GE.LOCATION_ID
AND GKSP.PRODUCT_ID = GE.PRODUCT_ID 
AND GKSP.OBJ_TYPE = GE.OBJ_TYPE
AND GKSP.EDGE_ID = GE.ID
ORDER BY  START_VERTEX_ID,END_VERTEX_ID,PATH_WEIGHT, PATH_ID, EDGE_ORDER, WEIGHT;